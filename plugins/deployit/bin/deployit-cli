#!/usr/bin/env python3
"""deployit CLI — orchestrates archive/export/serve/push.

Subcommands:
  bootstrap          one-time per-machine setup
  deploy             archive and publish a build
  list               show recent builds across the tailnet
  url                print this machine's listing URL
  status             backend health + recent local deploys
  gc                 prune local artifacts; archive in index
"""

import argparse
import datetime as _dt
import json
import re as _re
import shutil as _shutil
import string
import sys
import urllib.request
from pathlib import Path
from urllib.parse import urlparse

import os
import shutil
import subprocess
from textwrap import dedent

__version__ = "0.1.0"


def ok(payload):
    payload["ok"] = True
    print(json.dumps(payload, indent=2))


def fail(message, **extra):
    payload = {"ok": False, "display": message, **extra}
    print(json.dumps(payload, indent=2))
    sys.exit(1)


def not_implemented(name):
    fail(f"{name}: not implemented yet")


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        fail(f"argument error: {message}")


def _state_dir() -> Path:
    """Per-machine state directory. Overridable for tests via DEPLOYIT_STATE_DIR."""
    override = os.environ.get("DEPLOYIT_STATE_DIR")
    if override:
        return Path(override)
    return Path.home() / "Library" / "Application Support" / "deployit"


def _tailscale_bin() -> str:
    return os.environ.get("DEPLOYIT_TAILSCALE_BIN", "tailscale")


def _derive_base_url() -> str:
    """Build the listing base URL from `tailscale status --json`."""
    try:
        res = subprocess.run(
            [_tailscale_bin(), "status", "--json"],
            capture_output=True, text=True, check=True, timeout=5,
        )
    except FileNotFoundError:
        fail(f"tailscale binary not found at {_tailscale_bin()!r} — install Tailscale or set DEPLOYIT_TAILSCALE_BIN")
    except subprocess.CalledProcessError as exc:
        fail(f"tailscale status failed: {exc.stderr.strip() or exc}")
    except subprocess.TimeoutExpired:
        fail("tailscale status timed out after 5s — is the daemon running?")
    try:
        data = json.loads(res.stdout)
        dns = data["Self"]["DNSName"].rstrip(".")
    except (json.JSONDecodeError, KeyError) as exc:
        fail(f"could not parse tailscale status output: {exc}")
    return f"https://{dns}/deployit"


def _write_config(state: Path, plugin_root: Path, base_url: str) -> Path:
    """Write config.toml on first run; preserve user edits on re-run."""
    cfg = state / "config.toml"
    if cfg.exists():
        return cfg
    template = (plugin_root / "assets" / "config.example.toml").read_text()
    template = template.replace(
        'base_url = "https://<host>.<tailnet>.ts.net/deployit"',
        f'base_url = "{base_url}"',
    )
    cfg.write_text(template)
    return cfg


def _ensure_dirs(state: Path):
    for sub in ("serve", "index", "logs", "bin"):
        (state / sub).mkdir(parents=True, exist_ok=True)


def _symlink_plugin_root(state: Path, plugin_root: Path):
    """Create or refresh <state>/_plugin_root → plugin_root. Backend uses this
    to find assets (templates) on disk without knowing the plugin's install path."""
    link = state / "_plugin_root"
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(plugin_root)


def _clone_index(state: Path):
    """Clone the shared index repo. Skipped in tests via DEPLOYIT_SKIP_INDEX_CLONE."""
    if os.environ.get("DEPLOYIT_SKIP_INDEX_CLONE"):
        (state / "index" / "builds.json").write_text(
            json.dumps({"version": 1, "builds": []}))
        return
    index_dir = state / "index"
    if (index_dir / ".git").is_dir():
        return
    # Re-clone fresh; the placeholder builds.json from _ensure_dirs is overwritten.
    shutil.rmtree(index_dir)
    subprocess.run(
        ["git", "clone", "https://github.com/mikeydotio/deployit-index.git", str(index_dir)],
        check=True, timeout=30,
    )


def _configure_tailscale_serve(port: int):
    """Front the local backend with HTTPS via Tailscale Serve. Idempotent."""
    if os.environ.get("DEPLOYIT_SKIP_TAILSCALE_SERVE"):
        return
    subprocess.run(
        [_tailscale_bin(), "serve", "--bg", str(port)],
        check=False, timeout=10,
    )


def _launchd_plist(plugin_root: Path, state: Path, port: int) -> str:
    return dedent(f"""\
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
          <key>Label</key><string>com.mikeydotio.deployit.backend</string>
          <key>ProgramArguments</key>
          <array>
            <string>/usr/bin/env</string>
            <string>python3</string>
            <string>{plugin_root}/bin/deployit-backend</string>
            <string>--port</string><string>{port}</string>
            <string>--root</string><string>{state}</string>
            <string>--plugin-root</string><string>{plugin_root}</string>
          </array>
          <key>RunAtLoad</key><true/>
          <key>KeepAlive</key><true/>
          <key>StandardOutPath</key><string>{state}/logs/backend.log</string>
          <key>StandardErrorPath</key><string>{state}/logs/backend.err.log</string>
        </dict>
        </plist>
        """)


def _install_launchd(plugin_root: Path, state: Path, port: int) -> dict:
    """Write and load the launchd agent. Skipped in tests via DEPLOYIT_SKIP_LAUNCHD."""
    if os.environ.get("DEPLOYIT_SKIP_LAUNCHD"):
        return {"loaded": False, "skipped": True}
    plist_dir = Path.home() / "Library" / "LaunchAgents"
    plist_dir.mkdir(parents=True, exist_ok=True)
    plist_path = plist_dir / "com.mikeydotio.deployit.backend.plist"
    plist_path.write_text(_launchd_plist(plugin_root, state, port))
    launchctl = os.environ.get("DEPLOYIT_LAUNCHCTL_BIN", "launchctl")
    subprocess.run([launchctl, "bootout", f"gui/{os.getuid()}/com.mikeydotio.deployit.backend"],
                   check=False)
    res = subprocess.run([launchctl, "bootstrap", f"gui/{os.getuid()}", str(plist_path)],
                         capture_output=True, text=True, check=False)
    return {
        "loaded": res.returncode == 0,
        "skipped": False,
        "launchctl_stderr": res.stderr.strip() if res.returncode != 0 else None,
    }


_PLATFORM_SUFFIX = {"ios": "iOS", "macos": "macOS", "visionos": "visionOS"}


def _find_workspace(cwd: Path):
    for p in cwd.glob("*.xcworkspace"):
        return p
    return None


def _find_xcodeproj(cwd: Path):
    for p in cwd.glob("*.xcodeproj"):
        return p
    return None


def _find_apps_project_yml(cwd: Path, platform: str):
    """Return the first project.yml under Apps/ whose name suggests the platform.
    Falls back to any Apps/*/project.yml."""
    suffix = _PLATFORM_SUFFIX[platform]
    candidates = sorted(cwd.glob(f"Apps/*-{suffix}/project.yml")) \
              or sorted(cwd.glob("Apps/*/project.yml"))
    return candidates[0] if candidates else None


def _read_yaml_scalar(text: str, key: str):
    """Return the first occurrence of `key: value` in `text`, accepting either a
    double-quoted value (`KEY: "v"`) or a bare scalar (`KEY: v`). Returns None
    if the key is not present."""
    m = _re.search(rf'\b{_re.escape(key)}\s*:\s*(?:"([^"\n]+)"|(\S+))', text)
    if not m:
        return None
    return m.group(1) if m.group(1) is not None else m.group(2)


def _read_marketing_version(project_yml: Path) -> str:
    v = _read_yaml_scalar(project_yml.read_text(), "MARKETING_VERSION")
    if v is None:
        fail(f"Could not parse MARKETING_VERSION from {project_yml}")
    return v


def _read_bundle_id(project_yml: Path) -> str:
    v = _read_yaml_scalar(project_yml.read_text(), "PRODUCT_BUNDLE_IDENTIFIER")
    if v is None:
        fail(f"Could not parse PRODUCT_BUNDLE_IDENTIFIER from {project_yml}")
    return v


def _short_sha(cwd: Path) -> str:
    try:
        res = subprocess.run(
            ["git", "-C", str(cwd), "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True, check=True, timeout=5,
        )
    except FileNotFoundError:
        fail("git binary not found on PATH")
    except subprocess.CalledProcessError as exc:
        fail(f"git rev-parse failed (not a git repo or no commits?): {exc.stderr.strip() or exc}")
    except subprocess.TimeoutExpired:
        fail("git rev-parse timed out")
    return res.stdout.strip()


def _derive_metadata(cwd: Path, platform: str) -> dict:
    """Detect the Xcode project + spec layout. Supports two shapes:

    Apps-layout (Lillist):   ./Foo.xcworkspace + ./Apps/Foo-<Platform>/project.yml
                             default scheme = "<Project>-<Platform>"

    Single-app layout:       ./Foo.xcodeproj   + ./project.yml
                             default scheme = "<project>" (the .xcodeproj stem)

    Apps-layout takes precedence when both signals are present, so existing
    consumers keep working unchanged.
    """
    workspace      = _find_workspace(cwd)
    apps_yml       = _find_apps_project_yml(cwd, platform)
    xcodeproj      = _find_xcodeproj(cwd)
    root_yml       = cwd / "project.yml"
    suffix         = _PLATFORM_SUFFIX[platform]

    if workspace is not None and apps_yml is not None:
        project_name   = workspace.stem
        container_flag = "-workspace"
        container_path = str(workspace)
        project_yml    = apps_yml
        default_scheme = f"{project_name}-{suffix}"
    elif xcodeproj is not None and root_yml.is_file():
        project_name   = xcodeproj.stem
        container_flag = "-project"
        container_path = str(xcodeproj)
        project_yml    = root_yml
        default_scheme = project_name
    else:
        fail(
            "no recognised Xcode project layout in cwd. "
            "deployit looks for one of:\n"
            "  • <Name>.xcworkspace + Apps/<Name>-{Platform}/project.yml (monorepo)\n"
            "  • <Name>.xcodeproj  + ./project.yml                       (single-app)\n"
            f"cwd: {cwd}"
        )

    return {
        "project": project_name,
        "platform": platform,
        "bundle_id": _read_bundle_id(project_yml),
        "marketing_version": _read_marketing_version(project_yml),
        "commit": _short_sha(cwd),
        "project_yml": str(project_yml),
        "xcode_container_flag": container_flag,
        "xcode_container_path": container_path,
        "default_scheme": default_scheme,
    }


def _read_config(state: Path) -> dict:
    """Parse the bits we need out of config.toml. Use tomllib when available
    (Python 3.11+), fall back to regex on older Pythons. macOS 26 ships 3.13."""
    try:
        import tomllib
        return tomllib.loads((state / "config.toml").read_text())
    except ModuleNotFoundError:
        text = (state / "config.toml").read_text()
        port_m = _re.search(r'port\s*=\s*(\d+)', text)
        base_m = _re.search(r'base_url\s*=\s*"([^"]+)"', text)
        if port_m is None or base_m is None:
            fail("config.toml missing required server.port or server.base_url")
        notarize = bool(_re.search(r'notarize\s*=\s*true', text))
        notary_profile_m = _re.search(r'notary_profile\s*=\s*"([^"]+)"', text)
        return {
            "server": {"port": int(port_m.group(1)), "base_url": base_m.group(1)},
            "macos":  {"notarize": notarize,
                       "notary_profile": notary_profile_m.group(1) if notary_profile_m else ""},
        }


def _build_id(project: str, platform: str, commit: str) -> str:
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    return f"{project.lower()}-{platform}-{stamp}-{commit}"


def _destination_for(platform: str) -> str:
    return {
        "ios":      "generic/platform=iOS",
        "visionos": "generic/platform=visionOS",
        "macos":    "generic/platform=macOS",
    }[platform]


def _xcodebuild_archive(meta: dict, archive_path: Path, scheme):
    cmd = [
        "xcodebuild",
        meta["xcode_container_flag"], meta["xcode_container_path"],
        "-scheme", scheme or meta["default_scheme"],
        "-configuration", "Debug",
        "-destination", _destination_for(meta["platform"]),
        "-archivePath", str(archive_path),
        "-allowProvisioningUpdates",
        "archive",
    ]
    res = subprocess.run(cmd)
    if res.returncode != 0:
        fail("xcodebuild archive failed — see Xcode output above; "
             "common causes in references/troubleshooting.md")


def _read_archive_build_number(archive_path: Path, project: str) -> str:
    plist = archive_path / "Products" / "Applications" / f"{project}.app" / "Info.plist"
    if not plist.is_file():
        fail(f"built Info.plist not found at {plist}")
    res = subprocess.run(
        ["/usr/libexec/PlistBuddy", "-c", "Print :CFBundleVersion", str(plist)],
        capture_output=True, text=True, check=True,
    )
    return res.stdout.strip()


def _xcodebuild_export(archive_path: Path, export_dir: Path, plugin_root: Path, platform: str):
    options = plugin_root / "assets" / f"ExportOptions.{platform}.plist"
    if not options.is_file():
        fail(f"missing export options plist: {options}")
    cmd = [
        "xcodebuild", "-exportArchive",
        "-archivePath", str(archive_path),
        "-exportOptionsPlist", str(options),
        "-exportPath", str(export_dir),
        "-allowProvisioningUpdates",
    ]
    res = subprocess.run(cmd)
    if res.returncode != 0:
        fail("xcodebuild -exportArchive failed — see Xcode output above")


def _stage_ios_or_visionos(state: Path, plugin_root: Path,
                           build_id: str, ipa_src: Path, meta_full: dict):
    """Move the IPA into serve/<build_id>/, render manifest.plist and _meta.json.
    Returns (artifact_name, ipa_url, manifest_url)."""
    dst = state / "serve" / build_id
    if dst.exists():
        _shutil.rmtree(dst)
    dst.mkdir(parents=True)

    artifact_name = ipa_src.name
    _shutil.move(str(ipa_src), dst / artifact_name)

    ipa_url      = f"{meta_full['origin_base_url']}/{build_id}/{artifact_name}"
    manifest_url = f"{meta_full['origin_base_url']}/{build_id}/manifest.plist"

    manifest_tmpl = string.Template(
        (plugin_root / "assets" / "manifest.template.plist").read_text())
    (dst / "manifest.plist").write_text(manifest_tmpl.substitute(
        IPA_URL=ipa_url,
        BUNDLE_ID=meta_full["bundle_id"],
        BUNDLE_VERSION=meta_full["marketing_version"],
        TITLE=meta_full["project"],
    ))

    (dst / "_meta.json").write_text(json.dumps({
        **{k: meta_full[k] for k in (
            "id", "platform", "project", "bundle_id",
            "marketing_version", "build_number", "commit",
            "timestamp", "origin_host", "origin_base_url",
        )},
        "install": {
            "kind": "itms-services",
            "manifest_url": manifest_url,
            "ipa_url": ipa_url,
        },
        "primary_artifact": artifact_name,
    }, indent=2))

    return artifact_name, ipa_url, manifest_url


def _stage_macos(state: Path, plugin_root: Path, build_id: str,
                 app_src: Path, meta_full: dict, notarize: bool,
                 notary_profile: str):
    """Wrap the exported .app in a .dmg, optionally notarize + staple,
    write _meta.json. Returns (dmg_name, dmg_url)."""
    dst = state / "serve" / build_id
    if dst.exists():
        _shutil.rmtree(dst)
    dst.mkdir(parents=True)

    dmg_name = f"{meta_full['project']}.dmg"
    dmg_path = dst / dmg_name

    staging_app = dst / app_src.name
    _shutil.move(str(app_src), staging_app)

    res = subprocess.run([
        "hdiutil", "create",
        "-srcfolder", str(staging_app),
        "-volname", meta_full["project"],
        "-format", "UDZO",
        "-ov",
        str(dmg_path),
    ], capture_output=True, text=True)
    if res.returncode != 0:
        fail(f"hdiutil create failed: {res.stderr.strip() or res.stdout.strip()}")
    _shutil.rmtree(staging_app)

    if notarize:
        if not notary_profile:
            fail("macos.notarize=true but macos.notary_profile is empty in config.toml")
        notary = subprocess.run([
            "xcrun", "notarytool", "submit", str(dmg_path),
            "--keychain-profile", notary_profile,
            "--wait",
        ], capture_output=True, text=True)
        if notary.returncode != 0:
            fail(f"notarytool submit failed: {notary.stderr.strip() or notary.stdout.strip()}")
        staple = subprocess.run(["xcrun", "stapler", "staple", str(dmg_path)],
                                capture_output=True, text=True)
        if staple.returncode != 0:
            fail(f"stapler staple failed: {staple.stderr.strip() or staple.stdout.strip()}")

    dmg_url = f"{meta_full['origin_base_url']}/{build_id}/{dmg_name}"
    (dst / "_meta.json").write_text(json.dumps({
        **{k: meta_full[k] for k in (
            "id", "platform", "project", "bundle_id",
            "marketing_version", "build_number", "commit",
            "timestamp", "origin_host", "origin_base_url",
        )},
        "install": {"kind": "direct-download", "dmg_url": dmg_url},
        "primary_artifact": dmg_name,
    }, indent=2))
    return dmg_name, dmg_url


PRUNE_KEEP_PER_PRODUCT = 10


def _prune_old_builds(state: Path, data: dict, new_entry: dict) -> int:
    """Hard-delete this machine's older builds of the same (bundle_id, platform).

    Mutates `data["builds"]` in place. Removes the entry from the index AND
    deletes serve/<id>/ from disk. Returns the number of pruned entries.

    Only touches builds matching the new entry's `origin_base_url` — other
    machines manage their own pruning.
    """
    origin = new_entry["origin_base_url"]
    bundle = new_entry["bundle_id"]
    platform = new_entry["platform"]
    same_product = [b for b in data["builds"]
                    if b.get("origin_base_url") == origin
                    and b.get("bundle_id") == bundle
                    and b.get("platform") == platform]
    same_product.sort(key=lambda b: b["timestamp"], reverse=True)
    to_drop = same_product[PRUNE_KEEP_PER_PRODUCT:]
    if not to_drop:
        return 0
    drop_ids = {b["id"] for b in to_drop}
    data["builds"] = [b for b in data["builds"] if b["id"] not in drop_ids]
    for b in to_drop:
        _shutil.rmtree(state / "serve" / b["id"], ignore_errors=True)
    return len(to_drop)


def _append_to_index(state: Path, entry: dict, attempts: int = 3):
    """Pull, prepend entry to builds.json (newest first), prune this product's
    older builds beyond PRUNE_KEEP_PER_PRODUCT on this origin, commit, push.
    Retry up to `attempts` times on push conflict; on final failure, raise via fail()."""
    index_dir = state / "index"
    builds_path = index_dir / "builds.json"

    last_stderr = ""
    for attempt in range(1, attempts + 1):
        subprocess.run(["git", "-C", str(index_dir), "pull", "--rebase", "--quiet"],
                       check=True, timeout=30)
        data = json.loads(builds_path.read_text())
        data["builds"].insert(0, entry)
        pruned = _prune_old_builds(state, data, entry)
        builds_path.write_text(json.dumps(data, indent=2) + "\n")

        suffix = f" [pruned {pruned}]" if pruned else ""
        msg = (f"feat(deploy): {entry['project']} {entry['platform']} "
               f"{entry['marketing_version']} (build {entry['build_number']}) "
               f"from {entry['origin_host']}{suffix}")
        subprocess.run(["git", "-C", str(index_dir), "add", "builds.json"], check=True)
        subprocess.run(["git", "-C", str(index_dir), "commit", "-m", msg], check=True)
        try:
            push = subprocess.run(
                ["git", "-c", "url.https://github.com/.insteadOf=git@github.com:",
                 "-C", str(index_dir), "push", "origin", "main"],
                capture_output=True, text=True, timeout=60,
            )
        except subprocess.TimeoutExpired:
            last_stderr = "git push timed out after 60s"
            subprocess.run(["git", "-C", str(index_dir), "reset", "--hard", "origin/main"],
                           check=True)
            continue
        if push.returncode == 0:
            return
        last_stderr = push.stderr.strip()
        subprocess.run(["git", "-C", str(index_dir), "reset", "--hard", "origin/main"],
                       check=True)

    fail("push to deployit-index failed after retries; local artifacts retained",
         stderr=last_stderr)


def _refresh_local_backend(port: int):
    try:
        req = urllib.request.Request(
            f"http://127.0.0.1:{port}/deployit/_internal/refresh", method="POST")
        urllib.request.urlopen(req, timeout=3).read()
    except Exception as exc:
        sys.stderr.write(f"warning: local backend refresh failed: {exc}\n")


def cmd_bootstrap(args):
    args.plugin_root = args.plugin_root.resolve()
    state = _state_dir()
    state.mkdir(parents=True, exist_ok=True)
    _ensure_dirs(state)
    _symlink_plugin_root(state, args.plugin_root)
    base_url = _derive_base_url()
    cfg_path = _write_config(state, args.plugin_root, base_url)
    _clone_index(state)
    _configure_tailscale_serve(8729)
    launchd_status = _install_launchd(args.plugin_root, state, 8729)
    display = f"deployit bootstrapped. Bookmark on iPhone: {base_url}/"
    if not launchd_status["skipped"] and not launchd_status["loaded"]:
        display += f"\nWARNING: launchctl bootstrap failed: {launchd_status['launchctl_stderr']}"
    ok({
        "display": display,
        "state_dir": str(state),
        "config_path": str(cfg_path),
        "base_url": base_url,
        "launchd": launchd_status,
    })


def cmd_deploy(args):
    if not args.platform:
        fail("--platform required (one of ios | macos | visionos)")
    cwd = Path.cwd()
    meta = _derive_metadata(cwd, args.platform)
    if getattr(args, "dump_metadata", False):
        ok({"display": "metadata", **meta})
        return

    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")
    origin_host = urlparse(base_url).netloc

    build_id = _build_id(meta["project"], meta["platform"], meta["commit"])
    timestamp = _dt.datetime.now().astimezone().isoformat(timespec="seconds")

    builds_dir = state / "builds"
    builds_dir.mkdir(exist_ok=True)
    archive_path = builds_dir / f"{build_id}.xcarchive"
    export_dir = builds_dir / f"{build_id}.export"
    if archive_path.exists(): _shutil.rmtree(archive_path)
    if export_dir.exists():   _shutil.rmtree(export_dir)
    export_dir.mkdir(parents=True)

    _xcodebuild_archive(meta, archive_path, args.scheme)
    build_number = _read_archive_build_number(archive_path, meta["project"])
    _xcodebuild_export(archive_path, export_dir, args.plugin_root, args.platform)

    meta_full = {
        **meta,
        "id": build_id,
        "build_number": build_number,
        "timestamp": timestamp,
        "origin_host": origin_host,
        "origin_base_url": base_url,
    }

    if args.platform in ("ios", "visionos"):
        ipa = next(export_dir.glob("*.ipa"), None)
        if ipa is None:
            fail("export produced no .ipa")
        _stage_ios_or_visionos(state, args.plugin_root, build_id, ipa, meta_full)
    elif args.platform == "macos":
        app = next(export_dir.glob("*.app"), None)
        if app is None:
            fail("export produced no .app")
        notarize = cfg["macos"]["notarize"]
        notary_profile = cfg["macos"].get("notary_profile", "")
        _stage_macos(state, args.plugin_root, build_id, app, meta_full,
                     notarize, notary_profile)
    else:
        fail(f"unsupported platform: {args.platform}")

    _shutil.rmtree(archive_path, ignore_errors=True)
    _shutil.rmtree(export_dir, ignore_errors=True)

    entry = json.loads((state / "serve" / build_id / "_meta.json").read_text())
    primary = entry.pop("primary_artifact")
    artifact_path = state / "serve" / build_id / primary
    entry["size_bytes"] = artifact_path.stat().st_size
    entry["archived"] = False
    entry["notes"] = None

    _append_to_index(state, entry)
    _refresh_local_backend(cfg["server"]["port"])

    install_url = f"{base_url}/{build_id}/"
    listing_url = f"{base_url}/"
    ok({
        "display": (
            f"deployed: {entry['project']} {entry['platform']} "
            f"{entry['marketing_version']} (build {entry['build_number']})\n"
            f"install:  {install_url}\n"
            f"listing:  {listing_url}"
        ),
        "build_id": build_id,
        "install_url": install_url,
        "listing_url": listing_url,
    })
def cmd_url(args):
    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")
    ok({"display": f"{base_url}/", "url": f"{base_url}/"})


def cmd_status(args):
    state = _state_dir()
    cfg = _read_config(state)
    port = cfg["server"]["port"]
    base_url = cfg["server"]["base_url"].rstrip("/")
    try:
        with urllib.request.urlopen(
                f"http://127.0.0.1:{port}/deployit/_healthz", timeout=2) as r:
            health = json.loads(r.read())
            backend_ok = bool(health.get("ok"))
    except Exception:
        backend_ok = False

    builds_path = state / "index" / "builds.json"
    try:
        data = json.loads(builds_path.read_text())
        local_builds = [b for b in data["builds"]
                        if b["origin_base_url"] == base_url]
    except FileNotFoundError:
        local_builds = []

    lines = [
        f"backend:  {'up' if backend_ok else 'DOWN'} (port {port})",
        f"base_url: {base_url}/",
        f"recent local deploys:",
    ]
    for b in local_builds[:5]:
        lines.append(f"  - {b['id']}  {b['project']} {b['platform']} "
                     f"{b['marketing_version']} ({b['timestamp']})")
    if not local_builds:
        lines.append("  (none)")
    ok({"display": "\n".join(lines), "backend_ok": backend_ok})


def cmd_list(args):
    state = _state_dir()
    builds_path = state / "index" / "builds.json"
    if not builds_path.exists():
        fail("no local index — run /deployit bootstrap")
    data = json.loads(builds_path.read_text())
    rows = data["builds"]
    if args.platform:
        rows = [b for b in rows if b["platform"] == args.platform]
    if args.project:
        rows = [b for b in rows if b["project"].lower() == args.project.lower()]
    lines = []
    for b in rows[:30]:
        flag = " [archived]" if b.get("archived") else ""
        lines.append(f"{b['id']}{flag}\n"
                     f"  {b['project']} {b['platform']} {b['marketing_version']} "
                     f"(build {b['build_number']}) · {b['timestamp']} · {b['origin_host']}")
    ok({"display": "\n".join(lines) if lines else "(no builds)",
        "count": len(rows)})


def cmd_gc(args):
    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")
    builds_path = state / "index" / "builds.json"
    data = json.loads(builds_path.read_text())

    local = [b for b in data["builds"]
             if b["origin_base_url"] == base_url and not b.get("archived")]
    local.sort(key=lambda b: b["timestamp"], reverse=True)

    if args.keep is not None:
        to_archive = local[args.keep:]
    elif getattr(args, "older_than", None) is not None:
        cutoff = _dt.datetime.now(_dt.timezone.utc) - _dt.timedelta(days=args.older_than)
        to_archive = [b for b in local
                      if _dt.datetime.fromisoformat(b["timestamp"]).astimezone(_dt.timezone.utc) < cutoff]
    else:
        fail("gc requires --keep N or --older-than DAYS")

    removed = 0
    for b in to_archive:
        d = state / "serve" / b["id"]
        if d.exists():
            _shutil.rmtree(d)
            removed += 1
        b["archived"] = True

    builds_path.write_text(json.dumps(data, indent=2) + "\n")
    if to_archive and not os.environ.get("DEPLOYIT_SKIP_GC_PUSH"):
        subprocess.run(["git", "-C", str(state / "index"), "add", "builds.json"], check=True)
        subprocess.run(["git", "-C", str(state / "index"), "commit", "-m",
                        f"chore(deploy): archive {len(to_archive)} build(s) from {base_url}"],
                       check=True)
        subprocess.run(["git", "-c", "url.https://github.com/.insteadOf=git@github.com:",
                        "-C", str(state / "index"), "push", "origin", "main"],
                       check=True, timeout=60)
        _refresh_local_backend(cfg["server"]["port"])

    ok({"display": f"archived {len(to_archive)} build(s); removed {removed} local dir(s)",
        "archived": len(to_archive), "removed_local": removed})


def build_parser():
    parser = JsonArgumentParser(prog="deployit")
    parser.add_argument("--plugin-root", required=True, type=Path)
    parser.add_argument("--version", action="store_true")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("bootstrap").set_defaults(func=cmd_bootstrap)

    p_deploy = sub.add_parser("deploy")
    p_deploy.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_deploy.add_argument("--scheme")
    p_deploy.add_argument("--__dump-metadata", action="store_true",
                          help=argparse.SUPPRESS, dest="dump_metadata")
    p_deploy.set_defaults(func=cmd_deploy)

    p_list = sub.add_parser("list")
    p_list.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_list.add_argument("--project")
    p_list.set_defaults(func=cmd_list)

    sub.add_parser("url").set_defaults(func=cmd_url)
    sub.add_parser("status").set_defaults(func=cmd_status)

    p_gc = sub.add_parser("gc")
    p_gc.add_argument("--keep", type=int)
    p_gc.add_argument("--older-than", type=int, help="days")
    p_gc.set_defaults(func=cmd_gc)

    return parser


def main(argv):
    args = build_parser().parse_args(argv)
    if args.version:
        ok({"version": __version__})
        return
    if not args.cmd:
        fail("no subcommand given")
    args.func(args)


if __name__ == "__main__":
    main(sys.argv[1:])
