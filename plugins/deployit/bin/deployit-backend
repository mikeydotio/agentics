#!/usr/bin/env python3
"""deployit backend — long-running http server.

Endpoints:
  GET  /deployit/                       listing (git pull + render)
  GET  /deployit/<build_id>/            per-build landing page
  GET  /deployit/<build_id>/<artifact>  manifest.plist / ipa / dmg
  POST /deployit/_internal/refresh      force git pull
  GET  /deployit/_healthz               liveness probe

Stdlib only. Designed to be supervised by launchd.
"""

import argparse
import datetime as _dt
import html
import json
import mimetypes
import re
import string
import subprocess
import sys
import threading
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


_BUILD_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
_pull_lock = threading.Lock()
_last_pull = "never"

# Static assets served from <plugin_root>/assets/. URL → (relative path, content-type).
# Listed explicitly (not directory-served) so the backend's exposed filesystem
# surface stays a closed allowlist.
_STATIC_ASSETS = {
    "/deployit/manifest.webmanifest":             ("manifest.webmanifest",          "application/manifest+json"),
    "/deployit/app.css":                          ("app.css",                       "text/css; charset=utf-8"),
    "/deployit/app.js":                           ("app.js",                        "application/javascript; charset=utf-8"),
    "/deployit/icon.svg":                         ("icons/icon.svg",                "image/svg+xml"),
    "/deployit/apple-touch-icon.png":             ("icons/apple-touch-icon.png",    "image/png"),
    "/deployit/apple-touch-icon-precomposed.png": ("icons/apple-touch-icon.png",    "image/png"),
    "/deployit/icons/icon-192.png":               ("icons/icon-192.png",            "image/png"),
    "/deployit/icons/icon-512.png":               ("icons/icon-512.png",            "image/png"),
    "/deployit/icons/icon-maskable-512.png":      ("icons/icon-maskable-512.png",   "image/png"),
}


def _read_index(root: Path):
    try:
        return json.loads((root / "index" / "builds.json").read_text())
    except FileNotFoundError:
        return {"version": 1, "builds": []}
    except json.JSONDecodeError as exc:
        sys.stderr.write(f"backend: corrupt index/builds.json: {exc}\n")
        return {"version": 1, "builds": []}


def _relative_time(iso: str) -> str:
    when = _dt.datetime.fromisoformat(iso)
    now = _dt.datetime.now(when.tzinfo)
    delta = now - when
    secs = int(delta.total_seconds())
    if secs < 60:    return f"{secs}s ago"
    if secs < 3600:  return f"{secs // 60}m ago"
    if secs < 86400: return f"{secs // 3600}h ago"
    return f"{secs // 86400}d ago"


def _install_link(build):
    inst = build["install"]
    if inst["kind"] == "itms-services":
        href = "itms-services://?action=download-manifest&url=" + inst["manifest_url"]
        return href, "Install"
    return inst["dmg_url"], "Download"


_ROW_TEMPLATE = string.Template("""<li class="$archived_class"$data_href_attr>
  <div class="row">
    <span class="title">$project · $platform · $version (build $build_number)</span>
    <a class="install" href="$install_href">$install_label</a>
  </div>
  <div class="sub">$origin_host · $commit · $rel$older_html</div>
</li>""")


def _product_path(bundle_id: str, platform: str) -> str:
    return f"/deployit/p/{urllib.parse.quote(bundle_id, safe='')}/{platform}/"


def _render_row(build, *, older_count: int, link_to_product: bool) -> str:
    href, label = _install_link(build)
    if link_to_product:
        data_attr = f' data-href="{html.escape(_product_path(build["bundle_id"], build["platform"]), quote=True)}"'
    else:
        data_attr = ""
    if older_count > 0:
        older_html = (
            f' · <span class="older">+{older_count} older</span>'
        )
    else:
        older_html = ""
    return _ROW_TEMPLATE.substitute(
        archived_class="archived" if build.get("archived") else "",
        data_href_attr=data_attr,
        project=html.escape(build["project"]),
        platform=html.escape(build["platform"]),
        version=html.escape(build["marketing_version"]),
        build_number=html.escape(build["build_number"]),
        install_href=html.escape(href, quote=True),
        install_label=label,
        origin_host=html.escape(build["origin_host"]),
        commit=html.escape(build["commit"][:7]),
        rel=html.escape(_relative_time(build["timestamp"])),
        older_html=older_html,
    )


def _git_pull(root: Path):
    """Pull the index repo. Best-effort; logs and returns on failure."""
    global _last_pull
    with _pull_lock:
        try:
            subprocess.run(
                ["git", "-C", str(root / "index"), "pull", "--rebase", "--quiet"],
                check=True, timeout=15,
            )
            _last_pull = _dt.datetime.now().isoformat(timespec="seconds")
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
            sys.stderr.write(f"backend: git pull failed: {exc}\n")


_TRUST_NOTE_HTML = (
    '<p style="color:#888;font-size:13px;">'
    '<strong>First install only:</strong> if iOS warns about an '
    'untrusted developer, open <em>Settings → General → VPN &amp; '
    'Device Management</em> and trust your team, then re-tap Install.'
    '</p>'
)


def _read_build_meta(root: Path, build_id: str):
    meta_path = root / "serve" / build_id / "_meta.json"
    if not meta_path.is_file():
        return None
    return json.loads(meta_path.read_text())


def _render_build_landing(root: Path, build) -> bytes:
    href, label = _install_link(build)
    tmpl = string.Template((root / "_plugin_root" / "assets" / "index.template.html").read_text())
    return tmpl.substitute(
        TITLE=html.escape(build["project"]),
        PLATFORM=html.escape(build["platform"]),
        ORIGIN_HOST=html.escape(build["origin_host"]),
        VERSION=html.escape(build["marketing_version"]),
        BUILD_NUMBER=html.escape(build["build_number"]),
        COMMIT=html.escape(build["commit"][:7]),
        TIMESTAMP=html.escape(build["timestamp"]),
        INSTALL_HREF=html.escape(href, quote=True),
        INSTALL_LABEL=label,
        TRUST_NOTE=_TRUST_NOTE_HTML if build["platform"] in ("ios", "visionos") else "",
    ).encode()


def _group_by_product(builds):
    """Return (newest_per_product, counts) preserving input order.

    Input is expected newest-first (matching builds.json ordering). The first
    occurrence of each (bundle_id, platform) is its newest; subsequent
    occurrences increment its older-count.
    """
    newest = []
    counts = {}
    seen_index = {}
    for b in builds:
        key = (b.get("bundle_id"), b.get("platform"))
        if key not in seen_index:
            seen_index[key] = len(newest)
            newest.append(b)
            counts[key] = 0
        else:
            counts[key] += 1
    return newest, counts


def _render_listing(root: Path, local_host: str) -> bytes:
    data = _read_index(root)
    newest, counts = _group_by_product(data["builds"])
    rows = []
    for b in newest:
        key = (b.get("bundle_id"), b.get("platform"))
        rows.append(_render_row(b, older_count=counts[key], link_to_product=True))
    template_path = root / "_plugin_root" / "assets" / "listing.template.html"
    tmpl = string.Template(template_path.read_text())
    return tmpl.substitute(
        LAST_PULL=html.escape(f"last pull: {_last_pull}"),
        TOTAL_PRODUCTS=str(len(newest)),
        TOTAL_BUILDS=str(len(data["builds"])),
        LOCAL_HOST=html.escape(local_host),
        ROWS="\n".join(rows),
    ).encode()


def _render_product(root: Path, bundle_id: str, platform: str):
    """Return (200, html) for a product page, or (404, None) if no builds match."""
    data = _read_index(root)
    matches = [b for b in data["builds"]
               if b.get("bundle_id") == bundle_id and b.get("platform") == platform]
    if not matches:
        return 404, None
    matches.sort(key=lambda b: b["timestamp"], reverse=True)
    rows = [_render_row(b, older_count=0, link_to_product=False) for b in matches]
    template_path = root / "_plugin_root" / "assets" / "product.template.html"
    tmpl = string.Template(template_path.read_text())
    body = tmpl.substitute(
        LAST_PULL=html.escape(f"last pull: {_last_pull}"),
        PROJECT=html.escape(matches[0]["project"]),
        PLATFORM=html.escape(platform),
        BUNDLE_ID=html.escape(bundle_id),
        TOTAL_BUILDS=str(len(matches)),
        ROWS="\n".join(rows),
    ).encode()
    return 200, body


class Handler(BaseHTTPRequestHandler):
    root: Path = Path()

    def log_message(self, fmt, *args):
        if self.path == "/deployit/_healthz":
            return
        sys.stderr.write("backend: " + fmt % args + "\n")

    def _send_json(self, status, payload):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_bytes(self, status, ctype, body):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_file(self, status, ctype, path: Path, cache_seconds=None):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(path.stat().st_size))
        if cache_seconds is not None:
            self.send_header("Cache-Control", f"public, max-age={cache_seconds}")
        self.end_headers()
        with path.open("rb") as f:
            while chunk := f.read(64 * 1024):
                self.wfile.write(chunk)

    def do_GET(self):
        try:
            self._dispatch_get()
        except Exception as exc:
            sys.stderr.write(f"backend: GET {self.path} failed: {exc!r}\n")
            self._send_json(500, {"ok": False, "error": "internal_error"})

    def _dispatch_get(self):
        path = self.path
        if path == "/deployit/_healthz":
            self._send_json(200, {"ok": True})
            return
        if path in ("/deployit/", "/deployit"):
            if self.server.git_pull_enabled:
                _git_pull(self.root)
            body = _render_listing(self.root, self.server.local_host)
            self._send_bytes(200, "text/html; charset=utf-8", body)
            return

        static = _STATIC_ASSETS.get(path)
        if static is not None:
            rel, ctype = static
            asset_path = self.root / "_plugin_root" / "assets" / rel
            if not asset_path.is_file():
                self._send_json(404, {"ok": False, "error": "missing_asset"})
                return
            self._send_file(200, ctype, asset_path, cache_seconds=86400)
            return

        product_m = re.match(r"^/deployit/p/([^/]+)/(ios|macos|visionos)/?$", path)
        if product_m:
            bundle_id = urllib.parse.unquote(product_m.group(1))
            platform = product_m.group(2)
            status, body = _render_product(self.root, bundle_id, platform)
            if status == 404:
                self._send_json(404, {"ok": False, "error": "unknown_product"})
                return
            self._send_bytes(200, "text/html; charset=utf-8", body)
            return

        m = re.match(r"^/deployit/([^/]+)/(.*)$", path)
        if not m:
            self._send_json(404, {"ok": False, "error": "not_found"})
            return
        build_id, sub = m.group(1), m.group(2)
        if not _BUILD_ID_RE.match(build_id):
            self._send_json(404, {"ok": False, "error": "bad_build_id"})
            return
        build = _read_build_meta(self.root, build_id)
        if not build:
            self._send_json(404, {"ok": False, "error": "unknown_build"})
            return

        if sub == "" or sub == "/":
            self._send_bytes(200, "text/html; charset=utf-8",
                             _render_build_landing(self.root, build))
            return

        if "/" in sub or sub.startswith(".") or ".." in sub:
            self._send_json(404, {"ok": False, "error": "bad_artifact"})
            return
        artifact_path = self.root / "serve" / build_id / sub
        if not artifact_path.is_file():
            self._send_json(404, {"ok": False, "error": "missing_artifact"})
            return
        ctype, _ = mimetypes.guess_type(sub)
        if sub.endswith(".ipa"):
            ctype = "application/octet-stream"
        elif sub.endswith(".plist"):
            ctype = "application/x-plist"
        self._send_file(200, ctype or "application/octet-stream", artifact_path)

    def do_POST(self):
        try:
            self._dispatch_post()
        except Exception as exc:
            sys.stderr.write(f"backend: POST {self.path} failed: {exc!r}\n")
            self._send_json(500, {"ok": False, "error": "internal_error"})

    def _dispatch_post(self):
        if self.path == "/deployit/_internal/refresh":
            if self.server.git_pull_enabled:
                _git_pull(self.root)
            self._send_json(200, {"ok": True, "last_pull": _last_pull})
            return
        self._send_json(404, {"ok": False, "error": "not_found"})


def make_handler(root: Path):
    return type("Handler", (Handler,), {"root": root})


def main(argv):
    p = argparse.ArgumentParser()
    p.add_argument("--port", type=int, required=True)
    p.add_argument("--root", type=Path, required=True)
    p.add_argument("--plugin-root", type=Path,
                   help="Plugin root (for template lookup). Defaults to a symlink at <root>/_plugin_root.")
    p.add_argument("--no-git-pull", action="store_true",
                   help="Disable git pull on listing requests (for tests).")
    p.add_argument("--local-host", default="localhost")
    args = p.parse_args(argv)

    if args.plugin_root:
        link = args.root / "_plugin_root"
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(args.plugin_root)

    handler_cls = make_handler(args.root)
    server = ThreadingHTTPServer(("127.0.0.1", args.port), handler_cls)
    server.git_pull_enabled = not args.no_git_pull
    server.local_host = args.local_host
    sys.stderr.write(f"backend: listening on 127.0.0.1:{args.port}, root={args.root}\n")
    server.serve_forever()


if __name__ == "__main__":
    main(sys.argv[1:])
