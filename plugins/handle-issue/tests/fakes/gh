#!/usr/bin/env bash
# Fake `gh` for handle-issue tests. Emits canned output driven by env knobs:
#   FAKE_GH_LOG=path         append each invocation's args (one line) here
#   FAKE_GH_AUTH_FAIL=1      `gh auth status` exits non-zero (unauthenticated)
#   FAKE_GH_ISSUES_JSON=...  JSON array emitted by `gh issue list --json ...` (default [])
#   FAKE_GH_VIEW_FAIL=1      `gh issue view <n>` exits non-zero (issue not found)
#   FAKE_GH_STATE=OPEN|CLOSED  state field for `gh issue view` (default OPEN)
#   FAKE_GH_VIEW_TITLE=...   title field for `gh issue view` (default "Fake issue <n>")
[ -n "${FAKE_GH_LOG:-}" ] && printf '%s\n' "$*" >> "$FAKE_GH_LOG"

case "${1:-} ${2:-}" in
  "auth status")
    if [ -n "${FAKE_GH_AUTH_FAIL:-}" ]; then echo "not logged in" >&2; exit 1; fi
    echo "Logged in to github.com"; exit 0 ;;
  "issue list")
    printf '%s' "${FAKE_GH_ISSUES_JSON:-[]}"; exit 0 ;;
  "issue view")
    n="${3:-0}"
    if [ -n "${FAKE_GH_VIEW_FAIL:-}" ]; then echo "not found" >&2; exit 1; fi
    printf '{"number":%s,"title":"%s","state":"%s","url":"https://github.com/fake/repo/issues/%s"}' \
      "$n" "${FAKE_GH_VIEW_TITLE:-Fake issue $n}" "${FAKE_GH_STATE:-OPEN}" "$n"
    exit 0 ;;
  "label create")
    # Idempotent create-if-missing in the real gh; the fake just succeeds unless
    # FAKE_GH_LABEL_CREATE_FAIL is set (used to prove add-label still runs).
    if [ -n "${FAKE_GH_LABEL_CREATE_FAIL:-}" ]; then echo "label already exists" >&2; exit 1; fi
    exit 0 ;;
  "issue edit")
    # `gh issue edit <n> --add-label <label>`. Fails on FAKE_GH_EDIT_FAIL so the
    # helper's non-fatal warning path can be exercised.
    if [ -n "${FAKE_GH_EDIT_FAIL:-}" ]; then echo "could not add label" >&2; exit 1; fi
    exit 0 ;;
  *)
    echo "fake-gh: unhandled: $*" >&2; exit 0 ;;
esac
