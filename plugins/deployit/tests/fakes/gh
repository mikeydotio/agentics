#!/usr/bin/env bash
# Fake `gh` for deployit tests. Records each invocation to $FAKE_GH_LOG (when set)
# and emits canned output. Behaviour knobs (env):
#   FAKE_GH_LOG=path          append each invocation's args (one line) here
#   FAKE_GH_AUTH_FAIL=1       `gh auth status` exits non-zero
#   FAKE_GH_RELEASE_EXISTS=1  `gh release view <tag>` succeeds (release exists)
#   FAKE_GH_TAG_EXISTS=1      `gh api .../git/ref/tags/<tag>` succeeds (tag exists)
#   FAKE_GH_PREV_TAG=v1.2.3   tag emitted by `gh release view --json tagName`
#   FAKE_GH_ISSUES_JSON=...   JSON emitted by `gh issue list --json ...`
#   FAKE_GH_PR_URL=...        URL emitted by `gh pr create` / `pr view` (default
#                             https://github.com/fake/repo/pull/1)
#   FAKE_GH_PR_CREATE_FAIL=1  `gh pr create` exits non-zero (no PR opened)
#   FAKE_GH_PR_EXISTS=1       `gh pr create` reports "a pull request already
#                             exists" (exit 1); `pr view` then returns the URL
#   FAKE_GH_PR_MERGE_FAIL=1   `gh pr merge` exits non-zero (not mergeable)
[ -n "${FAKE_GH_LOG:-}" ] && printf '%s\n' "$*" >> "$FAKE_GH_LOG"

case "${1:-} ${2:-}" in
  "auth status")
    if [ -n "${FAKE_GH_AUTH_FAIL:-}" ]; then echo "not logged in" >&2; exit 1; fi
    echo "Logged in to github.com"; exit 0 ;;
  "release view")
    # `release view --repo R --json tagName -q .tagName` -> previous tag.
    if printf '%s ' "$@" | grep -q -- '--json tagName'; then
      printf '%s\n' "${FAKE_GH_PREV_TAG:-}"
      [ -n "${FAKE_GH_PREV_TAG:-}" ] && exit 0 || exit 1
    fi
    # `release view <tag> ... --json url -q .url` -> the release URL.
    if printf '%s ' "$@" | grep -q -- '--json url'; then
      echo "https://github.com/fake/repo/releases/tag/${3:-}"; exit 0
    fi
    # `release view <tag> -R repo` -> existence probe.
    [ -n "${FAKE_GH_RELEASE_EXISTS:-}" ] && exit 0 || { echo "release not found" >&2; exit 1; } ;;
  "release create")
    echo "https://github.com/fake/repo/releases/tag/${3:-}"; exit 0 ;;
  "release upload"|"release edit")
    exit 0 ;;
  "issue list")
    printf '%s' "${FAKE_GH_ISSUES_JSON:-[]}"; exit 0 ;;
  "pr create")
    if [ -n "${FAKE_GH_PR_EXISTS:-}" ]; then
      echo "a pull request for branch already exists" >&2; exit 1
    fi
    if [ -n "${FAKE_GH_PR_CREATE_FAIL:-}" ]; then
      echo "failed to create pull request" >&2; exit 1
    fi
    echo "${FAKE_GH_PR_URL:-https://github.com/fake/repo/pull/1}"; exit 0 ;;
  "pr view")
    # `pr view <branch> --json url -q .url` -> the PR URL.
    echo "${FAKE_GH_PR_URL:-https://github.com/fake/repo/pull/1}"; exit 0 ;;
  "pr merge")
    [ -n "${FAKE_GH_PR_MERGE_FAIL:-}" ] && { echo "not mergeable" >&2; exit 1; }
    exit 0 ;;
  "api "*)
    # `api repos/<R>/git/ref/tags/<tag>` -> tag existence probe (404 -> absent).
    if printf '%s ' "$@" | grep -q 'git/ref/tags/'; then
      [ -n "${FAKE_GH_TAG_EXISTS:-}" ] && exit 0 || { echo "Not Found" >&2; exit 1; }
    fi
    exit 0 ;;
  *)
    echo "fake-gh: $*" >&2; exit 0 ;;
esac
