{
  "description": "Freshen hooks — automatic /clear and re-invocation via tmux send-keys",
  "hooks": {
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/host-dispatch.sh on-stop.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/host-dispatch.sh on-clear.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/host-dispatch.sh cleanup-session-start.sh",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
