#!/usr/bin/env python3
"""atlas-cli: Deterministic operations for the atlas codebase-mapping plugin.

All output is JSON to stdout. Errors are JSON with ok=false.
Exit codes: 0=success, 1=operation failed, 2=usage error.

Subcommands (phase 1):
  scan       Enumerate mappable files (git ls-files ∩ config globs) with sizes.
  partition  Deterministically partition mappable files into modules.

Design record: plugins/atlas/references/design.md
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time


# ─── Constants ───────────────────────────────────────────────────────────────

DEFAULT_MAX_FILES = 1500          # scan ceiling — full maps beyond this are refused

DEFAULT_PARTITION = {
    "min_files": 3,               # partitions smaller than this coalesce into (misc)
    "max_files": 15,              # per-mapper attention cap
    "max_bytes": 120_000,         # ~30k tokens of source per mapper
}

# Always excluded, in addition to user config excludes. Atlas's own artifacts
# first, then generated/locked/minified files that carry no mappable signal.
DEFAULT_EXCLUDES = [
    "docs/atlas/**",
    ".atlas/**",
    "**/CLAUDE.md",          # atlas injects a managed block — instructions, not source
    "**/.gitignore",         # VCS config, no mappable code
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/Cargo.lock",
    "**/Gemfile.lock",
    "**/poetry.lock",
    "**/uv.lock",
    "**/composer.lock",
    "**/go.sum",
    "**/Package.resolved",
    "**/Package.swift",      # SwiftPM manifest — declares the package, no module structure
    "**/*.lock",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.map",
    "**/.DS_Store",
]

# Extension-based binary exclusion; the NUL sniff below catches the rest.
BINARY_EXTENSIONS = {
    "png", "jpg", "jpeg", "gif", "webp", "ico", "icns", "bmp", "tiff", "tif",
    "pdf", "zip", "tar", "gz", "tgz", "bz2", "xz", "7z", "rar",
    "jar", "war", "ear", "bin", "exe", "dll", "dylib", "so", "a", "o", "obj",
    "class", "pyc", "pyo", "wasm",
    "woff", "woff2", "ttf", "otf", "eot",
    "mp3", "mp4", "m4a", "m4v", "mov", "avi", "mkv", "wav", "flac", "ogg",
    "heic", "heif", "sketch", "fig", "psd", "ai", "eps",
    "db", "sqlite", "sqlite3", "realm", "car", "nib", "ipa", "apk",
    "dmg", "pkg", "iso",
}

SNIFF_BYTES = 8192                # leading bytes checked for NUL (binary sniff)

CONFIG_RELPATH = os.path.join("docs", "atlas", "config.yaml")


# ─── Output helpers ──────────────────────────────────────────────────────────

def emit(data):
    print(json.dumps(data, indent=2))


def emit_ok(**fields):
    out = {"ok": True}
    out.update(fields)
    emit(out)
    return 0


def emit_fail(error, message, **fields):
    out = {"ok": False, "error": error, "message": message}
    out.update(fields)
    emit(out)
    return 1


# ─── Git helpers ─────────────────────────────────────────────────────────────

def run_git(args, cwd):
    """Run a git command; returns (exit_code, stdout_bytes)."""
    proc = subprocess.run(
        ["git"] + args, cwd=cwd,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    return proc.returncode, proc.stdout


def git_toplevel(project_dir):
    """Absolute repo root for project_dir, or None when not in a git repo."""
    code, out = run_git(["rev-parse", "--show-toplevel"], cwd=project_dir)
    if code != 0:
        return None
    return out.decode("utf-8", errors="replace").strip()


def git_listed_files(root):
    """Tracked + untracked-but-not-ignored files, relative to root, deduped."""
    code, out = run_git(
        ["ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        cwd=root,
    )
    if code != 0:
        return []
    paths = out.decode("utf-8", errors="replace").split("\0")
    return sorted({p for p in paths if p})


# ─── Config (restricted YAML subset) ─────────────────────────────────────────
#
# Supported on purpose: top-level scalars, one level of nested map, lists of
# scalars, and lists of {key: value} maps (for `modules:`). Comments and blank
# lines are skipped. Anything fancier is unsupported — see design.md.

def strip_inline_comment(s):
    """Strip a trailing ` # comment` from a YAML-subset value — but never
    inside quotes or `[...]`, and only when the `#` follows whitespace, so a
    quoted value that legitimately contains `#` (e.g. a `read_when` of
    "Touching the C# bridge", or a quoted glob) survives byte-for-byte. Only
    whole-line comments were stripped before this; an inline `# …` after a
    list item used to become part of the value and silently break globs."""
    out, quote, depth, i = [], None, 0, 0
    while i < len(s):
        c = s[i]
        if quote:
            out.append(c)
            if c == quote:
                quote = None
        elif c in ('"', "'"):
            quote = c
            out.append(c)
        elif c == "[":
            depth += 1
            out.append(c)
        elif c == "]":
            depth = max(0, depth - 1)
            out.append(c)
        elif c == "#" and depth == 0 and (i == 0 or s[i - 1] in " \t"):
            break
        else:
            out.append(c)
        i += 1
    return "".join(out).rstrip()


def parse_scalar(s):
    s = strip_inline_comment(s.strip())
    if s.startswith("[") and s.endswith("]"):
        inner = s[1:-1].strip()
        return [parse_scalar(x) for x in inner.split(",")] if inner else []
    if len(s) >= 2 and s[0] == s[-1] and s[0] == '"':
        # Double-quoted scalars are written by yaml_scalar via json.dumps —
        # decode with json.loads so escapes round-trip exactly. Asymmetry
        # here corrupts non-ASCII frontmatter a little more on every write.
        try:
            return json.loads(s)
        except ValueError:
            return s[1:-1]
    if len(s) >= 2 and s[0] == s[-1] and s[0] == "'":
        return s[1:-1]
    if s.lower() in ("true", "false"):
        return s.lower() == "true"
    if s.lower() in ("null", "~"):
        return None
    if re.fullmatch(r"-?\d+", s):
        return int(s)
    return s


def parse_yaml_subset(text):
    lines = []
    for raw in text.splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        lines.append((indent, stripped))

    pos = [0]

    def parse_value_block(parent_indent):
        """Parse the block nested under a `key:` line, or None if absent."""
        if pos[0] >= len(lines) or lines[pos[0]][0] <= parent_indent:
            return None
        child_indent = lines[pos[0]][0]
        if lines[pos[0]][1].startswith("- ") or lines[pos[0]][1] == "-":
            return parse_list(child_indent)
        return parse_map(child_indent)

    def parse_map(indent):
        out = {}
        while pos[0] < len(lines):
            i, content = lines[pos[0]]
            if i != indent or content.startswith("- "):
                break
            key, _, rest = content.partition(":")
            key, rest = key.strip(), rest.strip()
            pos[0] += 1
            out[key] = parse_scalar(rest) if rest else parse_value_block(i)
        return out

    def parse_list(indent):
        out = []
        while pos[0] < len(lines):
            i, content = lines[pos[0]]
            if i != indent or not (content.startswith("- ") or content == "-"):
                break
            item = content[1:].strip()
            pos[0] += 1
            if ":" not in item:
                out.append(parse_scalar(item))
                continue
            # Map item: "- key: value" (or "- key:" opening a nested block),
            # with continuation keys indented past the dash.
            key, _, rest = item.partition(":")
            entry = {}
            entry[key.strip()] = parse_scalar(rest.strip()) if rest.strip() \
                else parse_value_block(i)
            while pos[0] < len(lines):
                ci, ccontent = lines[pos[0]]
                if ci <= i or ccontent.startswith("- "):
                    break
                k2, _, r2 = ccontent.partition(":")
                pos[0] += 1
                entry[k2.strip()] = parse_scalar(r2.strip()) if r2.strip() \
                    else parse_value_block(ci)
            out.append(entry)
        return out

    if not lines:
        return {}
    return parse_map(lines[0][0])


def load_config(root):
    path = os.path.join(root, CONFIG_RELPATH)
    if not os.path.isfile(path):
        return {}
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        parsed = parse_yaml_subset(f.read())
    return parsed if isinstance(parsed, dict) else {}


def partition_caps(config):
    caps = dict(DEFAULT_PARTITION)
    user = config.get("partition")
    if isinstance(user, dict):
        for key in caps:
            if isinstance(user.get(key), int) and user[key] > 0:
                caps[key] = user[key]
    return caps


# ─── Frontmatter (module/overview doc ledger entries) ───────────────────────
#
# Doc frontmatter is the ledger's source of truth; atlas-ledger.json is a
# derived reverse index. Serialization is canonical (fixed key order, stable
# quoting) so regenerated docs only churn where content actually changed.

FRONTMATTER_KEY_ORDER = [
    "module", "summary", "read_when", "sources", "scopes",
    "references_modules", "generator", "baseline", "verified",
]

BARE_SCALAR_RE = re.compile(r"[A-Za-z0-9._/-]+")


def split_frontmatter(text):
    """Returns (frontmatter_text, body_text) or (None, text) when absent."""
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        return None, text
    for idx in range(1, len(lines)):
        if lines[idx].strip() == "---":
            return "".join(lines[1:idx]), "".join(lines[idx + 1:])
    return None, text


def yaml_scalar(value):
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    s = str(value)
    if BARE_SCALAR_RE.fullmatch(s):
        return s
    return json.dumps(s, ensure_ascii=False)


def serialize_frontmatter(fm):
    keys = [k for k in FRONTMATTER_KEY_ORDER if k in fm]
    keys += sorted(k for k in fm if k not in FRONTMATTER_KEY_ORDER)
    out = ["---"]
    for key in keys:
        value = fm[key]
        if key in ("sources", "scopes") and isinstance(value, list):
            out.append("{}:".format(key))
            for entry in value:
                if not isinstance(entry, dict):
                    continue
                first = True
                for ek in ("path", "blob", "tree", "sha"):
                    if ek not in entry:
                        continue
                    prefix = "  - " if first else "    "
                    out.append("{}{}: {}".format(prefix, ek, yaml_scalar(entry[ek])))
                    first = False
        elif isinstance(value, list):
            out.append("{}: [{}]".format(
                key, ", ".join(yaml_scalar(v) for v in value)))
        else:
            out.append("{}: {}".format(key, yaml_scalar(value)))
    out.append("---")
    return "\n".join(out) + "\n"


# Frontmatter keys that `ledger finalize` adds to a projected doc in place
# (content addresses + advisory baseline + verdict). project does not write them
# and must not treat them as a change, so staleness comparisons normalize them
# away — a doc is "current" when its projection matches modulo these keys.
FINALIZE_FM_KEYS = ("baseline", "verified")


def strip_finalize_fm(fm):
    fm = json.loads(json.dumps(fm))  # deep copy; never mutate the caller's dict
    for k in FINALIZE_FM_KEYS:
        fm.pop(k, None)
    for entry in fm.get("sources") or []:
        if isinstance(entry, dict):
            entry.pop("blob", None)
    for entry in fm.get("scopes") or []:
        if isinstance(entry, dict):
            entry.pop("sha", None)
    return fm


def canonical_doc_text(text):
    """A doc's bytes with finalize-managed frontmatter normalized away, so a
    freshly-projected doc and its finalized committed form compare equal."""
    fm_text, body = split_frontmatter(text)
    if fm_text is None:
        return text
    fm = parse_yaml_subset(fm_text)
    if not fm:
        return text
    return serialize_frontmatter(strip_finalize_fm(fm)) + body


# ─── Git plumbing for the ledger ─────────────────────────────────────────────

def git_head(root):
    code, out = run_git(["rev-parse", "HEAD"], cwd=root)
    if code != 0:
        return None
    return out.decode("utf-8", errors="replace").strip()


def git_ls_tree_blobs(root):
    """{path: blob_oid} for HEAD; empty when there is no HEAD yet."""
    code, out = run_git(["ls-tree", "-r", "-z", "HEAD"], cwd=root)
    if code != 0:
        return {}
    blobs = {}
    for entry in out.decode("utf-8", errors="replace").split("\0"):
        if not entry:
            continue
        meta, _, path = entry.partition("\t")
        fields = meta.split()
        if len(fields) == 3 and fields[1] == "blob":
            blobs[path] = fields[2]
    return blobs


def git_status_paths(root):
    """All paths git status reports as differing from HEAD (incl. untracked)."""
    code, out = run_git(
        ["status", "--porcelain", "-z", "--untracked-files=all"], cwd=root)
    if code != 0:
        return set()
    entries = out.decode("utf-8", errors="replace").split("\0")
    paths = set()
    i = 0
    while i < len(entries):
        entry = entries[i]
        i += 1
        if not entry or len(entry) < 4:
            continue
        xy, path = entry[:2], entry[3:]
        paths.add(path)
        if xy[0] in ("R", "C") and i < len(entries):
            paths.add(entries[i])  # original path travels as the next record
            i += 1
    return paths


def git_hash_paths(root, paths):
    """{path: blob_oid} for working-tree bytes — the hash-what-you-read rule."""
    paths = [p for p in paths if os.path.isfile(os.path.join(root, p))]
    if not paths:
        return {}
    proc = subprocess.run(
        ["git", "hash-object", "--stdin-paths"], cwd=root,
        input=("\n".join(paths) + "\n").encode("utf-8", errors="replace"),
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    if proc.returncode == 0:
        hashes = proc.stdout.decode().split()
        if len(hashes) == len(paths):
            return dict(zip(paths, hashes))
    out = {}
    for p in paths:  # batch failed (e.g. one unreadable file) — fall back
        code, single = run_git(["hash-object", "--", p], cwd=root)
        if code == 0:
            out[p] = single.decode().strip()
    return out


def current_blob_map(root):
    """{path: blob} for the repo as it exists NOW: HEAD blobs overridden by
    working-tree hashes for every path git status reports as changed."""
    blobs = git_ls_tree_blobs(root)
    dirty = git_status_paths(root)
    rehashed = git_hash_paths(root, sorted(dirty))
    for path in dirty:
        if path in rehashed:
            blobs[path] = rehashed[path]
        else:
            blobs.pop(path, None)  # deleted from the worktree
    return blobs


def git_tree_oid(root, treepath):
    code, out = run_git(["rev-parse", "HEAD:{}".format(treepath)], cwd=root)
    if code != 0:
        return None
    return out.decode().strip()


def git_commit_exists(root, sha):
    code, _ = run_git(["cat-file", "-e", "{}^{{commit}}".format(sha)], cwd=root)
    return code == 0


def git_is_ancestor(root, ancestor, descendant):
    code, _ = run_git(
        ["merge-base", "--is-ancestor", ancestor, descendant], cwd=root)
    return code == 0


def git_commits_behind(root, baseline):
    code, out = run_git(
        ["rev-list", "--count", "{}..HEAD".format(baseline)], cwd=root)
    if code != 0:
        return None
    try:
        return int(out.decode().strip())
    except ValueError:
        return None


# ─── Map doc discovery and validation ────────────────────────────────────────

MAP_DIR = os.path.join("docs", "atlas")
LEDGER_RELPATH = os.path.join(MAP_DIR, "atlas-ledger.json")
INDEX_RELPATH = os.path.join(MAP_DIR, "INDEX.md")


def doc_module_id(doc_id):
    """modules/src-auth.md → src-auth (the id used in references_modules)."""
    return os.path.basename(doc_id)[:-3]


def discover_docs(root):
    """Map docs as doc_ids relative to docs/atlas/ (modules/* then overview/*)."""
    doc_ids = []
    for sub in ("modules", "overview"):
        absdir = os.path.join(root, MAP_DIR, sub)
        if not os.path.isdir(absdir):
            continue
        for name in sorted(os.listdir(absdir)):
            if name.endswith(".md"):
                doc_ids.append("{}/{}".format(sub, name))
    return doc_ids


def load_doc(root, doc_id):
    abspath = os.path.join(root, MAP_DIR, doc_id)
    with open(abspath, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    fm_text, body = split_frontmatter(text)
    fm = parse_yaml_subset(fm_text) if fm_text is not None else None
    return {"doc_id": doc_id, "abspath": abspath, "fm": fm, "body": body}


def validate_doc(doc):
    errors = []
    fm = doc["fm"]
    if fm is None:
        return ["missing frontmatter block"]
    for key in ("module", "summary", "generator"):
        if not isinstance(fm.get(key), str) or not fm.get(key).strip():
            errors.append("missing or empty `{}`".format(key))
    if doc["doc_id"].startswith("modules/") and not isinstance(fm.get("read_when"), str):
        errors.append("missing `read_when` (required for module docs)")
    sources = fm.get("sources")
    if not isinstance(sources, list) or not sources:
        errors.append("`sources` must be a non-empty list")
    else:
        for entry in sources:
            if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
                errors.append("every `sources` entry needs a `path`")
                break
    scopes = fm.get("scopes")
    if scopes is not None and not isinstance(scopes, list):
        errors.append("`scopes` must be a list when present")
    refs = fm.get("references_modules")
    if refs is not None and not isinstance(refs, list):
        errors.append("`references_modules` must be a list when present")
    return errors


def load_validated_docs(root):
    """Returns (docs, errors). errors is a list of (doc_id, [messages])."""
    docs = []
    errors = []
    for doc_id in discover_docs(root):
        doc = load_doc(root, doc_id)
        doc_errors = validate_doc(doc)
        if doc_errors:
            errors.append((doc_id, doc_errors))
        else:
            docs.append(doc)
    return docs, errors


# ─── ledger ──────────────────────────────────────────────────────────────────

def write_doc(doc):
    text = serialize_frontmatter(doc["fm"]) + doc["body"]
    with open(doc["abspath"], "w", encoding="utf-8") as f:
        f.write(text)


def build_ledger(root, docs, structure=None, judgment_keys=None):
    """Build the derived reverse index. With a `structure` block and/or per-doc
    `judgment_keys` (v2 mode), the ledger is stamped version 2 and carries those
    blocks; without them it is the unchanged v1 ledger."""
    head = git_head(root)
    ledger = {
        "version": 2 if (structure is not None or judgment_keys is not None) else 1,
        "baseline": head,
        "docs": {},
        "paths": {},
        "referenced_by": {},
    }
    if structure is not None:
        ledger["structure"] = structure
    if judgment_keys is not None:
        ledger["judgment_keys"] = judgment_keys
    for doc in docs:
        fm = doc["fm"]
        sources = {e["path"]: e.get("blob") for e in fm.get("sources", [])}
        ledger["docs"][doc["doc_id"]] = {
            "module": fm.get("module"),
            "summary": fm.get("summary"),
            "sources": sources,
            "references_modules": fm.get("references_modules") or [],
            "generator": fm.get("generator"),
            "verified": fm.get("verified"),
        }
        if doc["doc_id"].startswith("modules/"):
            for path in sources:
                ledger["paths"][path] = doc["doc_id"]
        for ref in fm.get("references_modules") or []:
            ledger["referenced_by"].setdefault(str(ref), []).append(doc["doc_id"])
    for ref in ledger["referenced_by"]:
        ledger["referenced_by"][ref].sort()
    return ledger


def check_duplicate_ownership(docs):
    """Each non-map source path is owned by exactly one module doc."""
    owners = {}
    duplicates = []
    for doc in docs:
        if not doc["doc_id"].startswith("modules/"):
            continue
        for entry in doc["fm"].get("sources", []):
            path = entry["path"]
            if path.startswith("docs/atlas/"):
                continue
            if path in owners and owners[path] != doc["doc_id"]:
                duplicates.append((path, owners[path], doc["doc_id"]))
            owners[path] = doc["doc_id"]
    return duplicates


def cmd_ledger_finalize(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    docs, errors = load_validated_docs(root)
    if errors:
        return emit_fail(
            "invalid_frontmatter",
            "Some map docs have invalid frontmatter; fix or regenerate them.",
            docs={doc_id: msgs for doc_id, msgs in errors},
        )

    duplicates = check_duplicate_ownership(docs)
    if duplicates:
        return emit_fail(
            "duplicate_source",
            "Each source file must be owned by exactly one module doc.",
            duplicates=[
                {"path": p, "docs": [a, b]} for p, a, b in duplicates
            ],
        )

    baseline = git_head(root)
    sources_count = 0
    docs_rewritten = 0
    if args.refresh_hashes:
        except_docs = set(getattr(args, "except_docs", None) or [])
        # Module docs first, then overview docs — overview sources are module
        # doc files, which must carry their final bytes before being hashed.
        ordered = ([d for d in docs if d["doc_id"].startswith("modules/")] +
                   [d for d in docs if not d["doc_id"].startswith("modules/")])
        for doc in ordered:
            # Excepted docs keep their recorded blobs and frontmatter verbatim:
            # /atlas repair body-fixes a drift doc but must leave it flagged
            # stale, so its source blobs must NOT advance to the working tree.
            if doc["doc_id"] in except_docs:
                continue
            fm = doc["fm"]
            missing = [e["path"] for e in fm["sources"]
                       if not os.path.isfile(os.path.join(root, e["path"]))]
            if missing:
                return emit_fail(
                    "missing_source",
                    "{}: source files not found: {}".format(
                        doc["doc_id"], ", ".join(missing)),
                )
            snapshot = json.dumps(fm, sort_keys=True, default=str)
            hashes = git_hash_paths(root, [e["path"] for e in fm["sources"]])
            for entry in fm["sources"]:
                entry["blob"] = hashes.get(entry["path"])
                sources_count += 1
            for scope in fm.get("scopes") or []:
                if isinstance(scope, dict) and isinstance(scope.get("tree"), str):
                    scope["sha"] = git_tree_oid(root, scope["tree"])
            if args.generator:
                fm["generator"] = args.generator
            # Hash-gating: a doc whose recorded inputs are unchanged must
            # stay byte-identical across updates, so the advisory baseline
            # only moves when something else in the frontmatter did.
            if ("baseline" not in fm
                    or json.dumps(fm, sort_keys=True, default=str) != snapshot):
                fm["baseline"] = baseline
            new_text = serialize_frontmatter(fm) + doc["body"]
            with open(doc["abspath"], "r", encoding="utf-8",
                      errors="replace") as f:
                old_text = f.read()
            if new_text != old_text:
                write_doc(doc)
                docs_rewritten += 1
    else:
        for doc in docs:
            for entry in doc["fm"]["sources"]:
                if not entry.get("blob"):
                    return emit_fail(
                        "missing_blobs",
                        "{}: sources lack blob hashes — run "
                        "`ledger finalize --refresh-hashes`.".format(doc["doc_id"]),
                    )
                sources_count += 1

    # v2 mode (a Judgment Cache exists): record the structure fingerprint and
    # per-doc judgment-key dependency alongside the v1 reverse index.
    structure = None
    judgment_keys = None
    if os.path.isfile(judgments_path(root)):
        index, _ = load_or_build_index(root)
        if "symbols" in index:
            structure = structure_ledger_block(index)
            judgment_keys = judgment_keys_by_doc(root, index, load_judgments(root))

    ledger = build_ledger(root, docs, structure=structure,
                          judgment_keys=judgment_keys)
    ledger_path = os.path.join(root, LEDGER_RELPATH)
    os.makedirs(os.path.dirname(ledger_path), exist_ok=True)
    with open(ledger_path, "w", encoding="utf-8") as f:
        json.dump(ledger, f, indent=2, sort_keys=True)
        f.write("\n")

    return emit_ok(
        docs_count=len(docs), sources_count=sources_count,
        docs_rewritten=docs_rewritten, baseline=baseline,
        ledger_version=ledger["version"],
    )


def assign_new_files(root, docs, new_files):
    """Deterministic destinations for unmapped files. A module doc that
    already owns sources in the file's directory wins (majority, then
    lexicographic doc id); otherwise the partition claiming the file points
    at a doc (module-id match, then majority owner of the partition's other
    files); whatever remains is proposed as a new module."""
    out = {"to_existing": [], "new_modules": []}
    if not new_files:
        return out

    path_owner = {}
    dir_owners = {}
    module_docs = {}
    for doc in docs:
        if not doc["doc_id"].startswith("modules/"):
            continue
        module_docs[doc_module_id(doc["doc_id"])] = doc["doc_id"]
        for entry in doc["fm"].get("sources", []):
            path = entry["path"]
            if path.startswith("docs/atlas/"):
                continue
            path_owner[path] = doc["doc_id"]
            parent = path.rsplit("/", 1)[0] if "/" in path else ""
            counts = dir_owners.setdefault(parent, {})
            counts[doc["doc_id"]] = counts.get(doc["doc_id"], 0) + 1

    claiming = {}
    part = do_partition(root)
    if part.get("ok"):
        for module in part["modules"]:
            for path in module["paths"]:
                claiming[path] = module

    def majority(counts):
        return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[0][0]

    to_existing = {}
    new_modules = {}
    for path in new_files:
        parent = path.rsplit("/", 1)[0] if "/" in path else ""
        if parent in dir_owners:
            doc_id = majority(dir_owners[parent])
            entry = to_existing.setdefault(
                doc_id, {"via": "directory", "files": []})
            entry["files"].append(path)
            continue
        module = claiming.get(path)
        if module is not None:
            doc_id = module_docs.get(module["id"])
            if doc_id is None:
                mates = {}
                for mate in module["paths"]:
                    owner = path_owner.get(mate)
                    if owner:
                        mates[owner] = mates.get(owner, 0) + 1
                if mates:
                    doc_id = majority(mates)
            if doc_id is not None:
                entry = to_existing.setdefault(
                    doc_id, {"via": "partition", "files": []})
                entry["files"].append(path)
            else:
                proposal = new_modules.setdefault(
                    module["id"], {"label": module["label"], "files": []})
                proposal["files"].append(path)
            continue
        # Unclaimed by any partition (over-ceiling repo, scan hiccup) — still
        # deterministic: propose a module named after the file's directory.
        seed = sanitize_id(parent or "root")
        proposal = new_modules.setdefault(
            seed, {"label": parent or "root", "files": []})
        proposal["files"].append(path)

    out["to_existing"] = [
        {"doc": doc_id, "module": doc_module_id(doc_id),
         "via": data["via"], "files": sorted(data["files"])}
        for doc_id, data in sorted(to_existing.items())
    ]
    out["new_modules"] = [
        {"module": module_id, "label": data["label"],
         "files": sorted(data["files"])}
        for module_id, data in sorted(new_modules.items())
    ]
    return out


def compute_diff(root, generator=None):
    """Classify every map doc against the repo as it exists now."""
    docs, errors = load_validated_docs(root)
    if errors:
        return {
            "ok": False, "error": "invalid_frontmatter",
            "message": "Some map docs have invalid frontmatter; fix or "
                       "regenerate them before diffing.",
            "docs": {doc_id: msgs for doc_id, msgs in errors},
        }

    current = current_blob_map(root)
    blob_to_paths = {}
    for path, blob in current.items():
        blob_to_paths.setdefault(blob, []).append(path)
    for blob in blob_to_paths:
        blob_to_paths[blob].sort()

    stale_docs = []
    renamed_docs = []
    orphaned_docs = []
    fingerprint_stale = []
    unchanged_docs = []
    covered_paths = set()

    for doc in docs:
        fm = doc["fm"]
        doc_id = doc["doc_id"]
        if doc_id.startswith("modules/"):
            covered_paths.update(e["path"] for e in fm["sources"])

        edited, deleted, renames = [], [], []
        for entry in fm["sources"]:
            path, recorded = entry["path"], entry.get("blob")
            cur = current.get(path)
            if cur is None:
                candidates = [p for p in blob_to_paths.get(recorded, []) if p != path]
                if recorded and candidates:
                    renames.append({"from": path, "to": candidates[0]})
                else:
                    deleted.append(path)
            elif recorded is None or cur != recorded:
                edited.append(path)

        scope_changed = []
        for scope in fm.get("scopes") or []:
            if not isinstance(scope, dict):
                continue
            tree, recorded_sha = scope.get("tree"), scope.get("sha")
            if not tree or not recorded_sha:
                continue
            if git_tree_oid(root, tree) != recorded_sha:
                scope_changed.append(tree)

        if fm["sources"] and len(deleted) == len(fm["sources"]):
            orphaned_docs.append({"doc": doc_id, "deleted": deleted})
        elif edited or deleted or scope_changed:
            reasons = ([{"path": p, "kind": "edited"} for p in edited] +
                       [{"path": p, "kind": "deleted"} for p in deleted] +
                       [{"path": t, "kind": "scope_changed"} for t in scope_changed])
            stale_docs.append({"doc": doc_id, "reasons": reasons, "renames": renames})
        elif renames:
            renamed_docs.append({"doc": doc_id, "renames": renames})
        elif generator and fm.get("generator") != generator:
            fingerprint_stale.append({"doc": doc_id, "generator": fm.get("generator")})
        else:
            unchanged_docs.append(doc_id)

    affected_ids = {doc_module_id(d["doc"]) for d in stale_docs + orphaned_docs
                    if d["doc"].startswith("modules/")}
    affected_doc_ids = {d["doc"] for d in
                        stale_docs + orphaned_docs + renamed_docs + fingerprint_stale}
    ripple_docs = []
    for doc in docs:
        if doc["doc_id"] in affected_doc_ids:
            continue
        refs = set(str(r) for r in doc["fm"].get("references_modules") or [])
        via = sorted(refs & affected_ids)
        if via:
            ripple_docs.append({"doc": doc["doc_id"], "via": via})
            affected_doc_ids.add(doc["doc_id"])

    scan = do_scan(root, enforce_ceiling=False)
    new_files = [f["path"] for f in scan.get("files", [])
                 if f["path"] not in covered_paths] if scan.get("ok") else []

    # Dirty-tree honesty: paths whose working-tree bytes diverge from HEAD
    # and that feed the map (covered sources or unmapped candidates). The
    # diff above already hashed these as they exist NOW; this list lets the
    # update flow say so in its summary.
    dirty_paths = sorted(
        git_status_paths(root) & (covered_paths | set(new_files)))

    assignments = assign_new_files(root, docs, new_files)

    edited_paths = {r["path"] for d in stale_docs for r in d["reasons"]
                    if r["kind"] in ("edited", "deleted")}
    changed_files = len(edited_paths | set(new_files))

    baseline_sha = None
    ledger_path = os.path.join(root, LEDGER_RELPATH)
    if os.path.isfile(ledger_path):
        try:
            with open(ledger_path, "r", encoding="utf-8") as f:
                baseline_sha = json.load(f).get("baseline")
        except (OSError, ValueError):
            baseline_sha = None
    if not baseline_sha:
        for doc in docs:
            if isinstance(doc["fm"].get("baseline"), str):
                baseline_sha = doc["fm"]["baseline"]
                break

    resolvable = bool(baseline_sha) and git_commit_exists(root, baseline_sha)
    is_ancestor = resolvable and git_is_ancestor(root, baseline_sha, "HEAD")
    commits_behind = git_commits_behind(root, baseline_sha) if is_ancestor else None

    total_docs = len(docs)
    affected = len(affected_doc_ids)
    return {
        "ok": True,
        "stale_docs": stale_docs,
        "renamed_docs": renamed_docs,
        "orphaned_docs": orphaned_docs,
        "fingerprint_stale": fingerprint_stale,
        "ripple_docs": ripple_docs,
        "new_files": new_files,
        "new_file_assignments": assignments,
        "dirty_paths": dirty_paths,
        "unchanged_docs": unchanged_docs,
        "summary": {
            "total_docs": total_docs,
            "module_docs": sum(1 for d in docs if d["doc_id"].startswith("modules/")),
            "affected_docs": affected,
            "affected_pct": round(100.0 * affected / total_docs) if total_docs else 0,
            "changed_files": changed_files,
        },
        "baseline": {
            "sha": baseline_sha,
            "resolvable": resolvable,
            "is_ancestor": is_ancestor,
            "commits_behind": commits_behind,
        },
    }


def cmd_ledger_diff(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    result = compute_diff(root, generator=args.generator)
    emit(result)
    return 0 if result["ok"] else 1


def cmd_ledger_set_verified(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    abspath = os.path.join(root, MAP_DIR, args.doc_id)
    if not os.path.isfile(abspath):
        return emit_fail("unknown_doc", "No map doc at docs/atlas/{}".format(args.doc_id))
    doc = load_doc(root, args.doc_id)
    if doc["fm"] is None:
        return emit_fail("invalid_frontmatter",
                         "{} has no frontmatter block.".format(args.doc_id))
    doc["fm"]["verified"] = args.value == "true"
    write_doc(doc)
    docs, errors = load_validated_docs(root)
    if not errors:
        ledger = build_ledger(root, docs)
        ledger_path = os.path.join(root, LEDGER_RELPATH)
        with open(ledger_path, "w", encoding="utf-8") as f:
            json.dump(ledger, f, indent=2, sort_keys=True)
            f.write("\n")
    return emit_ok(doc=args.doc_id, verified=doc["fm"]["verified"])


# ─── doc (mechanical map-doc mutations for the update flow) ──────────────────
#
# These exist so the update orchestrator never freehand-edits or deletes map
# files: pure renames are path-string rewrites (no LLM), and orphaned or
# conflict-corrupted docs are removed through a path-guarded subcommand that
# echoes back what a fresh regeneration needs (module identity + sources).

def normalize_doc_id(doc_id):
    """A valid doc id ('modules/x.md' or 'overview/x.md') or None."""
    norm = os.path.normpath(doc_id)
    parts = norm.split(os.sep)
    if (len(parts) != 2 or parts[0] not in ("modules", "overview")
            or not parts[1].endswith(".md")):
        return None
    return "{}/{}".format(parts[0], parts[1])


def cmd_doc_apply_renames(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    diff = compute_diff(root)
    if not diff["ok"]:
        emit(diff)
        return 1

    targets = [(e["doc"], e["renames"]) for e in diff["renamed_docs"]]
    targets += [(e["doc"], e["renames"]) for e in diff["stale_docs"]
                if e.get("renames")]

    rewritten = []
    for doc_id, renames in targets:
        doc = load_doc(root, doc_id)
        # Longest old path first so nested/prefixed paths cannot mangle
        # each other mid-rewrite.
        pairs = sorted(((r["from"], r["to"]) for r in renames),
                       key=lambda p: -len(p[0]))
        for entry in doc["fm"].get("sources", []):
            for old, new in pairs:
                if entry.get("path") == old:
                    entry["path"] = new
        body = doc["body"]
        replacements = 0
        for old, new in pairs:
            replacements += body.count(old)
            body = body.replace(old, new)
        doc["body"] = body
        write_doc(doc)
        rewritten.append({
            "doc": doc_id,
            "renames": [{"from": old, "to": new} for old, new in pairs],
            "body_replacements": replacements,
        })
    return emit_ok(rewritten=rewritten)


def cmd_doc_remove(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    # Validate the whole batch before touching anything — all or nothing.
    targets = []
    for doc_id in args.doc_ids:
        norm = normalize_doc_id(doc_id)
        if norm is None:
            return emit_fail(
                "invalid_doc_id",
                "'{}' is not a removable map doc id (expected "
                "modules/<id>.md or overview/<id>.md).".format(doc_id),
            )
        abspath = os.path.join(root, MAP_DIR, norm)
        if not os.path.isfile(abspath):
            return emit_fail(
                "unknown_doc", "No map doc at docs/atlas/{}".format(norm))
        targets.append((norm, abspath))

    removed = []
    for norm, abspath in targets:
        doc = load_doc(root, norm)  # frontmatter may be corrupt — best effort
        fm = doc["fm"] if isinstance(doc["fm"], dict) else {}
        sources = [e.get("path") for e in (fm.get("sources") or [])
                   if isinstance(e, dict) and isinstance(e.get("path"), str)]
        os.remove(abspath)
        removed.append({
            "doc": norm,
            "module": fm.get("module"),
            "sources": sources,
        })
    return emit_ok(removed=removed)


# ─── diffpack (anchored-regeneration input for cartographers) ────────────────
#
# Cartographer agents have no Bash, and pasting diffs into agent prompts
# would route change content through the orchestrator's context. Instead the
# CLI writes one patch file per doc under .atlas/diffs/ — `git diff` between
# each source's recorded and current blob, plus deleted/new-source notes —
# and the agent reads it from disk.

DIFFS_RELDIR = os.path.join(".atlas", "diffs")


def blob_to_worktree_diff(root, recorded_blob, path):
    """Unified diff from a recorded blob to the file's working-tree bytes.

    The recorded blob may predate HEAD (mapped from a dirty tree) and the
    current bytes may be uncommitted, so neither side is guaranteed to be in
    the object database. `git cat-file` materializes the old side when it
    exists; `git diff --no-index` against the live file needs no objects at
    all and never writes any.
    """
    code, old_bytes = run_git(["cat-file", "blob", recorded_blob], cwd=root)
    if code != 0:
        return "(prior content unavailable — read the file fully)\n"
    tmp_dir = os.path.join(root, DIFFS_RELDIR)
    os.makedirs(tmp_dir, exist_ok=True)
    tmp_path = os.path.join(tmp_dir, ".prior-blob.tmp")
    try:
        with open(tmp_path, "wb") as f:
            f.write(old_bytes)
        code, out, _ = run_git_capture(
            ["diff", "--no-index", "--", tmp_path, path], cwd=root)
        if code not in (0, 1):  # --no-index exits 1 when files differ
            return "(blob diff unavailable — read the file fully)\n"
        return out.decode("utf-8", errors="replace")
    finally:
        try:
            os.remove(tmp_path)
        except OSError:
            pass


def cmd_diffpack(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    norm = normalize_doc_id(args.doc_id)
    if norm is None or not os.path.isfile(os.path.join(root, MAP_DIR, norm)):
        return emit_fail(
            "unknown_doc", "No map doc at docs/atlas/{}".format(args.doc_id))
    doc = load_doc(root, norm)
    if doc["fm"] is None or not isinstance(doc["fm"].get("sources"), list):
        return emit_fail(
            "invalid_frontmatter",
            "{} has no usable sources frontmatter.".format(norm))

    current = current_blob_map(root)
    sections = []
    changed = deleted = 0
    for entry in doc["fm"]["sources"]:
        if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
            continue
        path, recorded = entry["path"], entry.get("blob")
        cur = current.get(path)
        if cur is None:
            sections.append(
                "### {} (deleted) — drop every claim drawn from this file\n"
                .format(path))
            deleted += 1
        elif not recorded:
            sections.append(
                "### {} (no recorded blob) — read it fully\n".format(path))
            changed += 1
        elif cur != recorded:
            sections.append("### {} (edited)\n{}".format(
                path, blob_to_worktree_diff(root, recorded, path)))
            changed += 1
    for path in args.add or []:
        sections.append(
            "### {} (new source) — read it fully and add it to sources\n"
            .format(path))
    added = len(args.add or [])

    if not sections:
        return emit_ok(patch=None, sources_changed=0, sources_deleted=0,
                       sources_added=0)

    rel_patch = os.path.join(DIFFS_RELDIR, norm[:-3].replace("/", "-") + ".patch")
    abs_patch = os.path.join(root, rel_patch)
    os.makedirs(os.path.dirname(abs_patch), exist_ok=True)
    with open(abs_patch, "w", encoding="utf-8") as f:
        f.write("# diffpack for docs/atlas/{} — changes since the doc was "
                "written\n\n".format(norm))
        f.write("\n".join(sections))
    return emit_ok(patch=rel_patch, sources_changed=changed,
                   sources_deleted=deleted, sources_added=added)


# ─── lock ────────────────────────────────────────────────────────────────────

LOCK_TTL_DEFAULT = 600  # seconds without a heartbeat before takeover


def lock_paths(root):
    lock_dir = os.path.join(root, ".atlas", "lock")
    return lock_dir, os.path.join(lock_dir, "lock.json")


def read_lock(lock_file):
    try:
        with open(lock_file, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_lock(lock_file, holder, acquired_at=None):
    now = time.time()
    with open(lock_file, "w", encoding="utf-8") as f:
        json.dump({
            "holder": holder,
            "acquired_at": acquired_at if acquired_at is not None else now,
            "heartbeat_at": now,
        }, f, indent=2)
        f.write("\n")


def cmd_lock(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    lock_dir, lock_file = lock_paths(root)

    if args.lock_command == "acquire":
        os.makedirs(os.path.dirname(lock_dir), exist_ok=True)
        try:
            os.mkdir(lock_dir)  # atomic on POSIX — exactly one winner
            write_lock(lock_file, args.holder)
            return emit_ok(holder=args.holder, took_over=False)
        except FileExistsError:
            lock = read_lock(lock_file)
            if lock is not None and isinstance(lock.get("heartbeat_at"), (int, float)):
                age = time.time() - lock["heartbeat_at"]
            else:
                # lock.json missing or torn: the winner may not have written it
                # yet (milliseconds), or a session crashed mid-acquire. Age the
                # lock by its directory mtime so crashes still time out.
                try:
                    age = time.time() - os.stat(lock_dir).st_mtime
                except OSError:
                    age = 0.0
            if age > args.ttl:
                write_lock(lock_file, args.holder)
                return emit_ok(holder=args.holder, took_over=True,
                               previous_holder=(lock or {}).get("holder"))
            return emit_fail(
                "lock_held",
                "Another atlas session holds the lock "
                "(heartbeat {}s ago).".format(int(age)),
                holder=(lock or {}).get("holder"),
            )

    if args.lock_command == "heartbeat":
        lock = read_lock(lock_file)
        if lock is None:
            return emit_fail("not_held", "No atlas lock is currently held.")
        write_lock(lock_file, lock.get("holder", "unknown"),
                   acquired_at=lock.get("acquired_at"))
        return emit_ok(holder=lock.get("holder"))

    if args.lock_command == "release":
        shutil.rmtree(lock_dir, ignore_errors=True)
        return emit_ok(released=True)

    return emit_fail("usage", "Unknown lock command.")


# ─── status ──────────────────────────────────────────────────────────────────

DEFAULT_THRESHOLDS = {
    "recommend_pct": 25,   # T2: this % of docs affected
    "untrust_pct": 50,     # T3: this % of docs affected
    "recommend_files": 50, # T2: this many in-scope files changed
}

CONFLICT_MARKER_RE = re.compile(r"^(<{7}( |$)|>{7}( |$))", re.MULTILINE)


def status_thresholds(config):
    out = dict(DEFAULT_THRESHOLDS)
    user = config.get("thresholds")
    if isinstance(user, dict):
        for key in out:
            if isinstance(user.get(key), int) and user[key] > 0:
                out[key] = user[key]
    return out


def find_conflict_markers(root):
    hits = []
    map_root = os.path.join(root, MAP_DIR)
    for dirpath, _, filenames in os.walk(map_root):
        for name in sorted(filenames):
            if not name.endswith(".md"):
                continue
            abspath = os.path.join(dirpath, name)
            try:
                with open(abspath, "r", encoding="utf-8", errors="replace") as f:
                    if CONFLICT_MARKER_RE.search(f.read()):
                        hits.append(os.path.relpath(abspath, root))
            except OSError:
                continue
    return hits


def drift_cache_key(root):
    head = git_head(root) or "no-head"
    code, out = run_git(
        ["status", "--porcelain", "-z", "--untracked-files=all"], cwd=root)
    entries = out.decode("utf-8", errors="replace").split("\0") if code == 0 else []
    # Atlas's own runtime dir must not invalidate the cache it lives in.
    relevant = [e for e in entries if e and not e[3:].startswith(".atlas/")]
    digest = hashlib.sha256(
        (head + "\n" + "\n".join(sorted(relevant))).encode("utf-8", errors="replace")
    ).hexdigest()
    return digest


def doc_display_names(entries, cap=6):
    names = sorted(doc_module_id(e["doc"]) for e in entries)
    if len(names) > cap:
        return ", ".join(names[:cap]) + ", +{} more".format(len(names) - cap)
    return ", ".join(names)


def compute_status(root):
    config = load_config(root)
    thresholds = status_thresholds(config)

    markers = find_conflict_markers(root)
    if markers:
        return {
            "ok": True, "mapped": True, "tier": 3,
            "message": (
                "Atlas map untrustworthy (merge conflict markers in {}). "
                "Disregard the imported INDEX, treat the map as absent, and "
                "run /atlas update.".format(", ".join(markers))
            ),
            "affected_docs": None, "total_docs": None, "changed_files": None,
            "baseline": None,
        }

    # Map integrity (fast lint subset): a structurally-broken map is tier 3
    # no matter how little drift there is.
    integrity = None
    docs, fm_errors = load_validated_docs(root)
    index_path = os.path.join(root, INDEX_RELPATH)
    if fm_errors:
        integrity = "invalid frontmatter in {} doc(s)".format(len(fm_errors))
    elif not docs:
        integrity = "no map docs found"
    elif os.path.getsize(index_path) > INDEX_HARD_CHARS:
        integrity = "INDEX over its token budget"
    else:
        with open(index_path, "r", encoding="utf-8", errors="replace") as f:
            actual = f.read()
        if build_index_text(root, docs) != actual:
            integrity = "INDEX out of sync with doc frontmatter"
    # v2: a committed doc that diverges from its deterministic projection (a
    # stale render or a hand-edit) makes the map untrustworthy — tier 3.
    if not integrity and os.path.isfile(judgments_path(root)):
        idx, _ = load_or_build_index(root)
        if "symbols" in idx:
            judg = load_judgments(root)
            key_by = _key_index(compute_judgment_keys(idx))
            by_doc_id = {d["doc_id"]: d for d in docs}
            for mid in idx.get("modules", {}):
                doc = by_doc_id.get("modules/{}.md".format(mid))
                if doc is None:
                    continue
                text, _, _ = render_module_doc(root, idx, judg, key_by, mid)
                _, rbody = split_frontmatter(text)
                if (PENDING_PROSE in doc["body"]
                        or doc["body"].rstrip("\n") != rbody.rstrip("\n")):
                    integrity = "projected docs diverge from the structure index"
                    break
    if integrity:
        return {
            "ok": True, "mapped": True, "tier": 3,
            "message": (
                "Atlas map untrustworthy ({}). Disregard the imported INDEX, "
                "treat the map as absent, and run /atlas update."
                .format(integrity)
            ),
            "affected_docs": None, "total_docs": None, "changed_files": None,
            "baseline": None,
        }

    diff = compute_diff(root)
    if not diff["ok"]:
        return {
            "ok": True, "mapped": True, "tier": 3,
            "message": (
                "Atlas map untrustworthy ({}). Disregard the imported INDEX, "
                "treat the map as absent, and run /atlas update."
                .format(diff["error"])
            ),
            "affected_docs": None, "total_docs": None, "changed_files": None,
            "baseline": None,
        }

    summary = diff["summary"]
    affected = summary["affected_docs"]
    total = summary["total_docs"]
    pct = summary["affected_pct"]
    changed_files = summary["changed_files"]
    baseline = diff["baseline"]
    affected_entries = (diff["stale_docs"] + diff["orphaned_docs"] +
                        diff["renamed_docs"] + diff["fingerprint_stale"] +
                        diff["ripple_docs"])
    overview_affected = any(
        e["doc"].startswith("overview/") for e in affected_entries)

    if pct >= thresholds["untrust_pct"]:
        tier = 3
    elif (pct >= thresholds["recommend_pct"] or overview_affected
          or changed_files > thresholds["recommend_files"]
          or (affected > 0 and not baseline["is_ancestor"])):
        tier = 2
    elif affected > 0:
        tier = 1
    else:
        tier = 0

    behind = ""
    if baseline["is_ancestor"] and baseline["commits_behind"]:
        behind = ", {} commits behind".format(baseline["commits_behind"])

    if tier == 0:
        message = ""
    elif tier == 3:
        message = (
            "Atlas map untrustworthy ({} of {} map docs stale{}). Disregard "
            "the imported INDEX, treat the map as absent, and run /atlas "
            "update.".format(affected, total, behind)
        )
    else:
        names = doc_display_names(affected_entries)
        message = "Atlas: {} of {} map docs stale ({}{}).".format(
            affected, total, names, behind)
        if tier == 2:
            message += " Run /atlas update before relying on those docs."

    return {
        "ok": True, "mapped": True, "tier": tier, "message": message,
        "affected_docs": affected, "total_docs": total,
        "changed_files": changed_files, "baseline": baseline,
    }


def cmd_status(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    if not os.path.isfile(os.path.join(root, INDEX_RELPATH)):
        result = {"ok": True, "mapped": False, "tier": 0, "message": "",
                  "cached": False}
        if not args.for_hook:
            result.update(affected_docs=None, total_docs=None,
                          changed_files=None, baseline=None)
        emit(result)
        return 0

    cache_path = os.path.join(root, ".atlas", "drift-cache.json")
    key = drift_cache_key(root)
    cached_result = None
    try:
        with open(cache_path, "r", encoding="utf-8") as f:
            cache = json.load(f)
        if cache.get("key") == key:
            cached_result = cache.get("result")
    except (OSError, ValueError):
        pass

    if cached_result is not None:
        result = dict(cached_result)
        result["cached"] = True
    else:
        result = compute_status(root)
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump({"key": key, "result": result}, f, indent=2)
            f.write("\n")
        result = dict(result)
        result["cached"] = False

    if args.for_hook:
        result = {"ok": result["ok"], "mapped": result["mapped"],
                  "tier": result["tier"], "message": result["message"],
                  "cached": result["cached"]}
    emit(result)
    return 0


# ─── verify-cache (persist /atlas verify findings for /atlas repair) ─────────
#
# /atlas verify is read-only of the map; it persists its findings to a
# gitignored .atlas/verify.json so a later /atlas repair can reuse them instead
# of re-running the map-verifier sweep. Reuse is gated on drift_cache_key — the
# exact repo-state fingerprint /atlas status already trusts — so a cache is only
# reused while HEAD and the working tree are unchanged. The CLI (not the skill)
# owns this file: it recomputes lint/diff/fingerprint itself and only ingests
# the opaque agent verdicts from stdin, so a mistyped payload cannot poison it.

VERIFY_CACHE_VERSION = 1


def verify_cache_path(root):
    return os.path.join(root, ".atlas", "verify.json")


def cmd_verify_cache_write(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    # Verdicts are the only payload the CLI did not produce itself. Read them
    # from stdin; a TTY (no pipe) or empty input means "no docs verified".
    raw = "" if sys.stdin.isatty() else sys.stdin.read()
    if raw.strip():
        try:
            verdicts = json.loads(raw)
        except ValueError:
            return emit_fail(
                "bad_verdicts",
                "verify-cache write expects a JSON array of verdicts on stdin.")
        if not isinstance(verdicts, list):
            return emit_fail(
                "bad_verdicts", "verify-cache verdicts must be a JSON array.")
    else:
        verdicts = []

    findings = lint_map(root, fast=False)
    errors = [f for f in findings if f["severity"] == "ERROR"]
    warnings = [f for f in findings if f["severity"] == "WARN"]
    fingerprint = drift_cache_key(root)
    head = git_head(root)

    cache = {
        "version": VERIFY_CACHE_VERSION,
        "head": head,
        "fingerprint": fingerprint,
        "timestamp": int(time.time()),
        "lint": {
            "error_count": len(errors), "warning_count": len(warnings),
            "errors": errors, "warnings": warnings,
        },
        "diff": compute_diff(root),
        "verdicts": verdicts,
    }

    path = verify_cache_path(root)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(cache, f, indent=2, sort_keys=True)
        f.write("\n")

    return emit_ok(
        path=os.path.relpath(path, root), fingerprint=fingerprint, head=head,
        verdicts=len(verdicts),
        lint_errors=len(errors), lint_warnings=len(warnings),
    )


def cmd_verify_cache_read(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    try:
        with open(verify_cache_path(root), "r", encoding="utf-8") as f:
            cache = json.load(f)
    except (OSError, ValueError):
        return emit_ok(valid=False, stale_reason="absent", cache=None)

    if not isinstance(cache, dict) or cache.get("version") != VERIFY_CACHE_VERSION:
        return emit_ok(valid=False, stale_reason="version", cache=None)
    if cache.get("fingerprint") != drift_cache_key(root):
        return emit_ok(valid=False, stale_reason="fingerprint", cache=None)

    return emit_ok(valid=True, stale_reason=None, cache=cache,
                   timestamp=cache.get("timestamp"))


# ─── ground (grounding pack for mapper agents) ──────────────────────────────
#
# Deterministic signals that keep LLM mappers grounded: the module's files with
# working-tree blob hashes, import-ish lines, and definition candidates ranked
# by external fan-in (aider-derived heuristics, grep-portable).

DEF_LINE_RE = re.compile(
    r"^\s*(?:public\s+|private\s+|internal\s+|open\s+|final\s+|abstract\s+"
    r"|export\s+|static\s+|async\s+|sealed\s+|data\s+)*"
    r"(func|def|class|struct|enum|protocol|interface|fn|function|type"
    r"|extension|actor|trait|impl|module|defmodule|object)"
    r"\s+([A-Za-z_][A-Za-z0-9_]*)")

# The keyword must be followed by whitespace, a quote/bracket, or EOL — so a
# parameter label like Swift's `source:` or `from:` is NOT read as an import.
IMPORT_LINE_RE = re.compile(
    r"^\s*(import|from|require|use|using|include|#include|@import|source)"
    r"(?=\s|[\"'<(]|$)")

GROUND_MAX_IMPORT_LINES = 20   # per file
GROUND_MAX_SYMBOLS = 40
GROUND_MAX_FILE_BYTES = 200_000  # skip giants when computing fan-in


def read_text(abspath):
    try:
        with open(abspath, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def cmd_ground(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    part = do_partition(root)
    if not part["ok"]:
        emit(part)
        return 1
    module = next((m for m in part["modules"] if m["id"] == args.module_id), None)
    if module is None:
        return emit_fail(
            "unknown_module",
            "No module '{}' in the current partition. Known: {}".format(
                args.module_id, ", ".join(m["id"] for m in part["modules"])),
        )

    hashes = git_hash_paths(root, module["paths"])
    files = [{"path": p, "bytes": b, "blob": hashes.get(p)}
             for p, b in ((f, os.path.getsize(os.path.join(root, f)))
                          for f in module["paths"])]

    imports = {}
    candidates = {}  # name -> (kind, "path:line")
    for relpath in module["paths"]:
        text = read_text(os.path.join(root, relpath))
        if text is None:
            continue
        # Markdown is prose: sentences starting with "from"/"use"/"include"
        # match IMPORT_LINE_RE and phrases like "module docs" match
        # DEF_LINE_RE. Skip extraction; .md files still get listed (and
        # hashed) in `files` and still count toward fan-in.
        if relpath.lower().endswith(".md"):
            continue
        import_lines = []
        for lineno, line in enumerate(text.splitlines(), 1):
            if IMPORT_LINE_RE.match(line) and len(import_lines) < GROUND_MAX_IMPORT_LINES:
                import_lines.append(line.strip())
            m = DEF_LINE_RE.match(line)
            if m and m.group(2) not in candidates:
                candidates[m.group(2)] = (m.group(1), "{}:{}".format(relpath, lineno))
        if import_lines:
            imports[relpath] = import_lines

    # Fan-in: how many files OUTSIDE this module reference each candidate.
    scan = do_scan(root, enforce_ceiling=False)
    module_paths = set(module["paths"])
    outside_texts = []
    if scan.get("ok"):
        for f in scan["files"]:
            if f["path"] in module_paths or f["bytes"] > GROUND_MAX_FILE_BYTES:
                continue
            text = read_text(os.path.join(root, f["path"]))
            if text is not None:
                outside_texts.append(text)

    symbols = []
    for name in sorted(candidates):
        kind, defined_at = candidates[name]
        pattern = re.compile(WORDISH_BOUNDARY.format(re.escape(name)))
        fan_in = sum(1 for text in outside_texts if pattern.search(text))
        # aider-derived scoring: sqrt-dampened fan-in (0.1 keep-alive for
        # unreferenced definitions), 10x for descriptive names.
        score = (fan_in ** 0.5) if fan_in > 0 else 0.1
        if len(name) >= 8:
            score *= 10
        symbols.append({"name": name, "kind": kind, "defined_at": defined_at,
                        "fan_in": fan_in, "score": round(score, 2)})
    symbols.sort(key=lambda s: (-s["score"], s["name"]))
    symbols = symbols[:GROUND_MAX_SYMBOLS]

    return emit_ok(module={"id": module["id"], "label": module["label"],
                           "strategy": module["strategy"]},
                   files=files, imports=imports, symbols=symbols)


# ─── extract (Structure Index — the deterministic structure layer) ──────────
#
# The Structure Index is the deterministic half of atlas v2: a content-addressed
# inventory of every symbol (each with three orthogonal hashes), the import
# graph, and — once a parser backend is available — the call/type edge graph. It
# is a pure function of the source at a commit, cached under .atlas/structure/
# (gitignored, rebuildable). Wave 1 ships the regex backend (lifted from
# `ground`); tree-sitter arrives in Wave 2. See references/design-v2.md.

STRUCTURE_VERSION = 1
EXTRACT_MAX_IMPORT_LINES = 100        # per file
IDENT_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
VIS_PUBLIC_RE = re.compile(r"\b(public|open|export|pub)\b")
VIS_PRIVATE_RE = re.compile(r"\bprivate\b")
VIS_INTERNAL_RE = re.compile(r"\b(internal|protected|fileprivate)\b")


def content_hash(data):
    """Stable sha256 over text/bytes, prefixed to distinguish from git blob OIDs."""
    if isinstance(data, str):
        data = data.encode("utf-8", errors="replace")
    return "sha256:" + hashlib.sha256(data).hexdigest()


def structure_index_path(root):
    return os.path.join(root, ".atlas", "structure", "index.json")


def normalize_signature(line):
    return re.sub(r"\s+", " ", line.strip())


def detect_visibility(prefix, name):
    """Heuristic access level from a declaration's leading modifiers (regex
    backend). Defaults to public — a top-level definition is module surface
    unless explicitly restricted or underscore-prefixed by convention."""
    if VIS_PUBLIC_RE.search(prefix):
        return "public"
    if VIS_PRIVATE_RE.search(prefix):
        return "private"
    if VIS_INTERNAL_RE.search(prefix):
        return "internal"
    if name.startswith("_"):
        return "private"
    return "public"


def parse_import_target(line):
    """Best-effort dependency token following an import-ish keyword."""
    s = line.strip()
    m = IMPORT_LINE_RE.match(s)
    if not m:
        return None
    rest = s[m.end():].strip()
    # Token must START with a name char (letter/digit/_/@) — never punctuation,
    # so a stray `:`/`.` after a mis-detected keyword is not returned as a dep.
    tok = re.match(r'["\'<(]?\s*([A-Za-z0-9_@][A-Za-z0-9_./:@-]*)', rest)
    if not tok:
        return None
    return tok.group(1).rstrip(";,").strip() or None


def assign_spans(defs, total_lines):
    """A definition spans from its line to just before the next definition at
    the same or shallower indentation (or EOF) — deterministic containment so a
    body edit changes the span hash, while a sibling's edit does not."""
    for i, d in enumerate(defs):
        end = total_lines
        for j in range(i + 1, len(defs)):
            if defs[j]["indent"] <= d["indent"]:
                end = defs[j]["start_line"] - 1
                break
        d["end_line"] = max(end, d["start_line"])


def extract_regex(relpath, text):
    """Language-agnostic regex extraction (the same signals `ground` uses).
    Returns (symbols, import_lines, import_targets). Markdown is prose: a
    sentence beginning 'from'/'use' matches IMPORT_LINE_RE and 'module docs'
    matches DEF_LINE_RE, so .md files are skipped (still tokenized for fan-in)."""
    if relpath.lower().endswith(".md"):
        return [], [], []
    body = text.splitlines()
    kept = text.splitlines(keepends=True)
    total = len(kept)
    raw_defs = []
    import_lines = []
    targets = []
    for idx, line in enumerate(body):
        if IMPORT_LINE_RE.match(line):
            if len(import_lines) < EXTRACT_MAX_IMPORT_LINES:
                import_lines.append(line.strip())
            tgt = parse_import_target(line)
            if tgt:
                targets.append(tgt)
        m = DEF_LINE_RE.match(line)
        if m:
            raw_defs.append({
                "name": m.group(2), "kind": m.group(1),
                "signature": normalize_signature(line),
                "visibility": detect_visibility(line[:m.start(1)], m.group(2)),
                "start_line": idx + 1,
                "indent": len(line) - len(line.lstrip()),
            })
    assign_spans(raw_defs, total)
    symbols = []
    for d in raw_defs:
        span_text = "".join(kept[d["start_line"] - 1:d["end_line"]])
        symbols.append({
            "name": d["name"], "qualified_name": d["name"], "kind": d["kind"],
            "signature": d["signature"],
            "signature_hash": content_hash(d["signature"]),
            "visibility": d["visibility"], "file": relpath,
            "span": {"start_line": d["start_line"], "end_line": d["end_line"]},
            "span_hash": content_hash(span_text),
            "extraction": "regex",
        })
    return symbols, import_lines, sorted(set(targets))


# A call site: `callee(` optionally prefixed by `receiver.`. Keywords that take
# parentheses but are not calls are filtered against CALL_KEYWORDS below.
CALL_SITE_RE = re.compile(
    r"(?:([A-Za-z_]\w*)\s*\.\s*)?([A-Za-z_]\w*)\s*\(")

CALL_KEYWORDS = frozenset((
    "if", "for", "while", "switch", "catch", "return", "with", "elif",
    "func", "def", "class", "struct", "enum", "protocol", "interface",
    "fn", "function", "type", "extension", "actor", "trait", "impl",
    "and", "or", "not", "in", "is", "await", "yield", "throw", "throws",
    "print", "sizeof", "typeof", "super", "self", "init",
))


def enclosing_symbol(symbols_in_file, line):
    """The innermost symbol whose span contains `line` — a call's `from`. Among
    nested spans the one with the latest start_line wins (deepest container)."""
    best = None
    for s in symbols_in_file:
        if s["span"]["start_line"] <= line <= s["span"]["end_line"]:
            if best is None or s["span"]["start_line"] > best["span"]["start_line"]:
                best = s
    return best


def extract_call_sites_regex(relpath, text, symbols_in_file):
    """Name-based call sites for the regex backend: `{from, callee, line}` with
    no resolution target (resolve_edges resolves by name). Skips definition
    lines (a `def foo(` is not a call to foo) and parenthesised keywords."""
    if relpath.lower().endswith(".md"):
        return []
    sites = []
    for lineno, line in enumerate(text.splitlines(), 1):
        if DEF_LINE_RE.match(line):
            continue
        for m in CALL_SITE_RE.finditer(line):
            callee = m.group(2)
            if callee in CALL_KEYWORDS:
                continue
            frm = enclosing_symbol(symbols_in_file, lineno)
            if frm is None:
                continue
            sites.append({"from": frm["id"], "callee": callee, "line": lineno,
                          "file": relpath})
    return sites


def resolve_edges(symbols, call_sites):
    """Resolve call sites to structural `calls` edges with a confidence tier:
      resolved  — a tree-sitter-provided target, OR a unique corpus-wide name
      ambiguous — the name matches >1 indexed definition; all kept in candidates
      unresolved— 0 indexed definitions (external/builtin) → dropped, not noise
    A name-based unique match is `resolved` (it is unambiguous, not a guess);
    receiver types only matter to collapse an ambiguous set, which the
    tree-sitter helper does upstream by emitting `to_loc`. Output is sorted and
    deduped; parallel call sites merge their evidence."""
    name_to_ids = {}
    loc_to_id = {}
    for s in symbols:
        name_to_ids.setdefault(s["name"], []).append(s["id"])
        loc_to_id[(s["file"], s["span"]["start_line"])] = s["id"]

    merged = {}
    for cs in call_sites:
        frm = cs.get("from")
        if not frm:
            continue
        to = None
        confidence = None
        candidates = None
        loc = cs.get("to_loc")
        if loc and (loc.get("file"), loc.get("start_line")) in loc_to_id:
            to = loc_to_id[(loc["file"], loc["start_line"])]
            confidence = "resolved"
        else:
            cands = sorted(set(name_to_ids.get(cs.get("callee"), [])))
            if not cands:
                continue                      # unresolved — dropped
            if len(cands) == 1:
                to, confidence = cands[0], "resolved"
            else:
                confidence, candidates = "ambiguous", cands
        if to == frm:
            continue                          # ignore trivial self-recursion
        key = (frm, to or "", confidence, tuple(candidates or ()))
        ev = {"file": cs.get("file"), "line": cs.get("line")}
        if key in merged:
            if ev not in merged[key]["evidence"]:
                merged[key]["evidence"].append(ev)
        else:
            edge = {"from": frm, "to": to, "kind": "calls",
                    "confidence": confidence, "candidates": candidates,
                    "evidence": [ev]}
            merged[key] = edge
    edges = list(merged.values())
    for e in edges:
        e["evidence"].sort(key=lambda x: (x.get("file") or "", x.get("line") or 0))
    edges.sort(key=lambda e: (e["from"], e["to"] or "", e["confidence"],
                              tuple(e["candidates"] or ())))
    return edges


def incident_edge_digest(symbol_id, edges):
    """Content address of a symbol's INCOMING *resolved* edges — the 'who calls
    me' dependency a symbol's load-bearing judgment turns on. Resolved-only by
    design: ambiguous incoming edges (common names like `run`/`get` defined in
    many files) would thrash the digest on every unrelated same-named def, so
    they are excluded. An empty set hashes to a stable constant, so a symbol
    with no resolved callers (and every regex-only symbol with none) shares it
    — load_bearing then keys on signature_hash alone, no worse than v1 fan-in."""
    incoming = sorted(
        e["from"] for e in edges
        if e.get("to") == symbol_id and e.get("confidence") == "resolved")
    return content_hash("\n".join(incoming))


def compute_inputs_digest(root, file_list):
    """sha256 over (path, blob) for every mappable file as it exists now — the
    cache-validity fingerprint. Invalidates precisely when any mapped byte
    changes (working-tree edits included, via current_blob_map)."""
    blobs = current_blob_map(root)
    pairs = sorted("{} {}".format(p, blobs.get(p, "")) for p in file_list)
    return content_hash("\n".join(pairs))


def path_to_module(index):
    rev = {}
    for mid, paths in index.get("modules", {}).items():
        for p in paths:
            rev[p] = mid
    return rev


# ─── tree-sitter helper backend (precision call-site resolution) ─────────────
#
# atlas does not bundle tree-sitter. When a structure-extraction helper is
# available — a thin tree-sitter-backed binary emitting the JSON contract below
# — `extract` uses it for precise, scope-resolved call sites; otherwise every
# file falls back to the regex backend. The helper is probed once via
# $ATLAS_TS_HELPER (explicit) or a `tree-sitter` / `atlas-ts-helper` on PATH.
#
# Contract: the helper reads a NUL-free newline-delimited list of repo-relative
# paths on stdin and emits, on stdout:
#   {"version":1,"files":{"<path>":{
#       "symbols":[{"name","kind","start_line","end_line","signature","visibility"}],
#       "calls":[{"callee","line","to":{"file","start_line"}?}]}}}
# `to` is present only when the parser resolved the call's scope — that is what
# promotes an otherwise corpus-ambiguous name to a `resolved` edge.

TS_HELPER_VERSION = 1


def ts_helper_path():
    explicit = os.environ.get("ATLAS_TS_HELPER")
    if explicit:
        return explicit if (os.path.isfile(explicit)
                            and os.access(explicit, os.X_OK)) else None
    return shutil.which("atlas-ts-helper") or shutil.which("tree-sitter")


def run_ts_helper(root, paths, helper):
    """Invoke the helper for `paths`; return {relpath: {symbols, calls}} or None
    on any failure (the caller then falls back to regex — never a hard error)."""
    try:
        proc = subprocess.run(
            [helper, "extract", "--root", root], cwd=root,
            input=("\n".join(paths) + "\n").encode("utf-8", errors="replace"),
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    try:
        payload = json.loads(proc.stdout.decode("utf-8", errors="replace"))
    except ValueError:
        return None
    if not isinstance(payload, dict) or payload.get("version") != TS_HELPER_VERSION:
        return None
    files = payload.get("files")
    return files if isinstance(files, dict) else None


def symbols_from_helper(relpath, text, entry):
    """Convert one helper file entry's symbols into Structure Index symbol
    records. span_hash is computed from the actual file bytes (not the helper)
    so it stays a faithful content address regardless of backend."""
    kept = text.splitlines(keepends=True)
    out = []
    for sym in entry.get("symbols") or []:
        name = sym.get("name")
        if not name:
            continue
        start = int(sym.get("start_line") or 1)
        end = int(sym.get("end_line") or start)
        start = max(1, start)
        end = max(start, end)
        signature = normalize_signature(
            sym.get("signature") or "{} {}".format(sym.get("kind") or "", name))
        span_text = "".join(kept[start - 1:end])
        out.append({
            "name": name, "qualified_name": sym.get("qualified_name") or name,
            "kind": sym.get("kind") or "symbol", "signature": signature,
            "signature_hash": content_hash(signature),
            "visibility": sym.get("visibility") or "public", "file": relpath,
            "span": {"start_line": start, "end_line": end},
            "span_hash": content_hash(span_text),
            "extraction": "tree-sitter",
        })
    return out


def call_sites_from_helper(relpath, symbols_in_file, entry):
    sites = []
    for c in entry.get("calls") or []:
        callee = c.get("callee")
        if not callee:
            continue
        frm = enclosing_symbol(symbols_in_file, int(c.get("line") or 0))
        if frm is None:
            continue
        site = {"from": frm["id"], "callee": callee,
                "line": c.get("line"), "file": relpath}
        loc = c.get("to")
        if isinstance(loc, dict) and loc.get("file"):
            site["to_loc"] = {"file": loc["file"],
                              "start_line": int(loc.get("start_line") or 0)}
        sites.append(site)
    return sites


def lang_of(relpath):
    return relpath.rsplit(".", 1)[-1].lower() if "." in os.path.basename(relpath) else ""


def do_extract(root, backend="auto"):
    """Build the Structure Index fresh. Returns the index dict, or a do_scan
    error dict (no 'symbols' key) on failure. Backend selection:
      auto       — tree-sitter helper per file when available, else regex
      treesitter — same as auto, but stamps degraded=true if the helper is absent
      regex      — force the built-in regex backend"""
    scan = do_scan(root, enforce_ceiling=False)
    if not scan.get("ok"):
        return scan
    file_list = [f["path"] for f in scan["files"]]

    part = do_partition(root)
    modules_map = {}
    module_labels = {}
    if part.get("ok"):
        for m in part["modules"]:
            modules_map[m["id"]] = list(m["paths"])
            module_labels[m["id"]] = m["label"]

    helper = None
    helper_files = {}
    want_ts = backend in ("auto", "treesitter")
    if want_ts:
        helper = ts_helper_path()
        if helper:
            helper_files = run_ts_helper(root, file_list, helper) or {}
    degraded = backend == "treesitter" and not helper_files

    texts = {}
    file_tokens = {}
    all_symbols = []
    call_sites = []
    imports = {}
    external = set()
    backend_used = {}
    pending_calls = []   # (relpath, helper_entry-or-None) resolved after ids exist

    for relpath in file_list:
        text = read_text(os.path.join(root, relpath))
        if text is None:
            continue
        texts[relpath] = text
        file_tokens[relpath] = set(IDENT_RE.findall(text))
        # imports/external deps come from the regex scan in every backend —
        # cheap, language-agnostic, and not something the helper need carry.
        _, import_lines, targets = extract_regex(relpath, text)
        if import_lines:
            imports[relpath] = import_lines
        external.update(targets)

        entry = helper_files.get(relpath)
        if entry is not None:
            syms = symbols_from_helper(relpath, text, entry)
            backend_used[lang_of(relpath) or "*"] = "tree-sitter"
            pending_calls.append((relpath, entry))
        else:
            syms, _, _ = extract_regex(relpath, text)
            if not relpath.lower().endswith(".md"):
                backend_used.setdefault(lang_of(relpath) or "*", "regex")
            pending_calls.append((relpath, None))
        all_symbols.extend(syms)

    # Deterministic, line-move-stable ids: path::qualified-name, with an
    # occurrence suffix only on a genuine in-file name collision.
    all_symbols.sort(
        key=lambda s: (s["file"], s["span"]["start_line"], s["qualified_name"]))
    seen = {}
    for s in all_symbols:
        base = "{}::{}".format(s["file"], s["qualified_name"])
        n = seen.get(base, 0) + 1
        seen[base] = n
        s["id"] = base if n == 1 else "{}#{}".format(base, n)

    by_file = {}
    for s in all_symbols:
        by_file.setdefault(s["file"], []).append(s)
    for relpath, entry in pending_calls:
        in_file = by_file.get(relpath, [])
        if entry is not None:
            call_sites.extend(call_sites_from_helper(relpath, in_file, entry))
        else:
            call_sites.extend(
                extract_call_sites_regex(relpath, texts[relpath], in_file))

    edges = resolve_edges(all_symbols, call_sites)
    for s in all_symbols:
        s["fan_in"] = sum(1 for f, toks in file_tokens.items()
                          if f != s["file"] and s["name"] in toks)
        s["incident_edge_digest"] = incident_edge_digest(s["id"], edges)

    all_symbols.sort(key=lambda s: s["id"])
    if not backend_used:
        backend_used = {"*": "regex"}
    return {
        "version": STRUCTURE_VERSION,
        "commit": git_head(root),
        "dirty_digest": compute_inputs_digest(root, file_list),
        "backend": backend_used,
        "degraded": degraded,
        "symbols": all_symbols,
        "edges": edges,
        "imports": imports,
        "external_deps": sorted(external),
        "modules": modules_map,
        "module_labels": module_labels,
    }


def write_structure_index(root, index):
    path = structure_index_path(root)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(json.dumps(index, indent=2, sort_keys=True) + "\n")


def load_or_build_index(root, backend="auto", force=False):
    """Return (index, cached). Reuses .atlas/structure/index.json when its commit
    and inputs digest still match the working tree. An explicit (non-auto)
    backend always rebuilds, so backend selection is deterministic."""
    path = structure_index_path(root)
    if not force and backend == "auto" and os.path.isfile(path):
        try:
            with open(path, encoding="utf-8") as f:
                cached = json.load(f)
        except (OSError, ValueError):
            cached = None
        if cached and cached.get("version") == STRUCTURE_VERSION:
            scan = do_scan(root, enforce_ceiling=False)
            if scan.get("ok"):
                file_list = [f["path"] for f in scan["files"]]
                if (cached.get("commit") == git_head(root)
                        and cached.get("dirty_digest")
                        == compute_inputs_digest(root, file_list)):
                    return cached, True
    index = do_extract(root, backend)
    if "symbols" not in index:
        return index, False
    write_structure_index(root, index)
    return index, False


def cmd_extract(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    index, cached = load_or_build_index(
        root, backend=args.backend, force=args.force)
    if "symbols" not in index:
        emit(index)
        return 1
    fields = {
        "cached": cached,
        "backend": index["backend"],
        "degraded": index.get("degraded", False),
        "commit": index["commit"],
        "symbol_count": len(index["symbols"]),
        "edge_count": len(index["edges"]),
        "resolved_edge_count": sum(
            1 for e in index["edges"] if e["confidence"] == "resolved"),
        "ambiguous_edge_count": sum(
            1 for e in index["edges"] if e["confidence"] == "ambiguous"),
        "import_file_count": len(index["imports"]),
        "external_dep_count": len(index["external_deps"]),
        "module_count": len(index["modules"]),
        "path": os.path.relpath(structure_index_path(root), root),
    }
    if args.module_id:
        rev = path_to_module(index)
        fields["symbols"] = [s for s in index["symbols"]
                             if rev.get(s["file"]) == args.module_id]
    return emit_ok(**fields)


# ─── Judgment Cache (the LLM-produced, content-addressed prose layer) ────────
#
# Every judgment cell is keyed by WHAT IT DESCRIBES, not when it was written, so
# an unchanged thing reuses its cached prose verbatim across rebuilds and the LLM
# is invoked only for the delta. A key is `<kind>/<24-hex>` where the hash digests
# the kind, the cell's IDENTITY anchor (symbol id / module id), and exactly the
# structural input that should trigger re-judgment (decision 26):
#   symbol.contract       id + signature_hash + visibility      (NOT body → body edits are free)
#   symbol.load_bearing   id + signature_hash + incident_edge_digest (resolved callers)
#   module.{purpose,gotchas,summary,read_when}  module id + public_surface_digest
#   overview.{shape,dataflow,index_facts}       global surface + cross-module edge digest
# The identity anchor keeps two symbols with an identical signature from sharing
# one judgment; the trigger input makes the key miss exactly when the prose could
# go stale. See references/design-v2.md "The judgment-key derivation".

JUDGMENT_VERSION = 1
MODULE_JUDGMENT_KINDS = ("purpose", "type_notes", "gotchas", "summary", "read_when")
OVERVIEW_JUDGMENT_KINDS = ("shape", "dataflow", "index_facts")
# The falsifiable, act-to-your-peril prose kinds the map-verifier samples — the
# claims a downstream agent obeys to its peril (council decision: verify the
# high-consequence prose delta, not soft routing prose; structure is already
# lint-verified). edge.semantic is here too: a judged verb (owns/emits/reads/
# writes) is an act-to-your-peril relationship claim, so the verifier samples it
# (null-verb cells make no claim and are excluded by verify_targets).
VERIFY_KINDS = ("symbol.contract", "symbol.load_bearing", "module.gotchas",
                "edge.semantic")
# Verdicts meaning "not yet verified under this key" — the verify delta. A cached
# pass/fail is skipped (verification collapses to the delta exactly like judgment).
VERIFY_PENDING_VERDICTS = ("unverified", "migrated")


def judgments_path(root):
    return os.path.join(root, "docs", "atlas", "judgments.json")


def judgment_key(kind, *inputs):
    """`<kind>/<24-hex>` — kind-prefixed (greppable, cross-kind unique) digest of
    the kind plus its identity/trigger inputs. 24 hex = 96 bits, collision-safe."""
    canon = "\n".join([kind] + [str(i) for i in inputs])
    return "{}/{}".format(
        kind, hashlib.sha256(canon.encode("utf-8")).hexdigest()[:24])


def module_symbols(index):
    """{module_id: [symbol, …]} — symbols grouped by their file's module."""
    rev = path_to_module(index)
    out = {mid: [] for mid in index.get("modules", {})}
    for s in index["symbols"]:
        mid = rev.get(s["file"])
        if mid is not None:
            out.setdefault(mid, []).append(s)
    return out


def module_edge_kinds(index, module_id, member_ids):
    """Sorted set of structural edge kinds incident to a module (either end)."""
    kinds = set()
    for e in index["edges"]:
        if e["from"] in member_ids or (e.get("to") in member_ids):
            kinds.add(e["kind"])
    return sorted(kinds)


def public_surface_digest(index, module_id, members):
    """Order-independent digest of a module's PUBLIC CAPABILITY SET: the
    (name, kind, visibility) of its public symbols plus the kinds of edges
    touching it. Keyed on names — NOT signature hashes — so module-level
    judgments (purpose/summary/…) re-judge when the set of capabilities changes
    (a public symbol added/removed/renamed) but stay cached when an existing
    signature is merely tweaked (that re-judges only that symbol's contract).
    Excludes private symbols, bodies, and order by construction."""
    member_ids = {s["id"] for s in members}
    surface = sorted("{}|{}|{}".format(s["name"], s["kind"], s["visibility"])
                     for s in members if s["visibility"] == "public")
    kinds = module_edge_kinds(index, module_id, member_ids)
    return content_hash(json.dumps({"surface": surface, "edges": kinds},
                                   sort_keys=True))


def overview_digest(index, surfaces):
    """Global digest: every module's public_surface_digest plus the set of
    resolved cross-module edges. Stable under intra-module body edits."""
    rev = path_to_module(index)
    cross = sorted(set(
        "{}->{}:{}".format(rev.get(e["from"].split("::")[0]) or "",
                           rev.get((e.get("to") or "::").split("::")[0]) or "",
                           e["kind"])
        for e in index["edges"]
        if e["confidence"] == "resolved" and e.get("to")
        and rev.get(e["from"].split("::")[0])
        != rev.get(e["to"].split("::")[0])))
    return content_hash(json.dumps(
        {"surfaces": [surfaces[m] for m in sorted(surfaces)], "cross": cross},
        sort_keys=True))


def is_load_bearing_candidate(sym):
    """Internal (non-public) symbols that other files reach for are the
    load-bearing-internals candidates the LLM judges (bool + why). Public
    symbols get a contract cell instead; trivial unreferenced privates neither."""
    return sym["visibility"] != "public" and sym.get("fan_in", 0) >= 1


def resolved_cross_module_edges(index):
    """The resolved structural edges that cross a module boundary, returned as
    (edge, from_sym, from_module, to_module) tuples in deterministic order.

    These are the ONLY edges an `edge.semantic` cell annotates: the taxonomy
    anchors a semantic verb to a resolved structural edge (design-v2 determinism
    boundary), so the parser proposes the `A -> B` call and the LLM judges
    whether a richer verb (owns/emits/reads/writes) also holds. The parser never
    emits semantic verbs, so this — not "iterating semantic edges" — is how the
    planner and the projector agree on which cells exist. Shared by both so they
    can never drift."""
    rev = path_to_module(index)
    sym_by_id = {s["id"]: s for s in index["symbols"]}
    out = []
    for e in index["edges"]:
        if e["confidence"] != "resolved" or not e.get("to"):
            continue
        from_sym = sym_by_id.get(e["from"])
        to_sym = sym_by_id.get(e.get("to"))
        if from_sym is None or to_sym is None:
            continue
        fmod = rev.get(from_sym["file"])
        tmod = rev.get(to_sym["file"])
        if fmod is None or tmod is None or fmod == tmod:
            continue
        out.append((e, from_sym, fmod, tmod))
    out.sort(key=lambda t: (t[0]["from"], t[0]["to"] or ""))
    return out


def edge_semantic_key(from_sym, to_id):
    """Content address of an `edge.semantic` cell: keyed on the calling symbol's
    `span_hash` + the resolved target id, so it re-judges when the calling code
    changes or the target moves, and is stable across unrelated edits. The verb
    is the annotator's OUTPUT (value-addressed), never a key input."""
    return judgment_key("edge.semantic", from_sym["span_hash"], to_id)


def compute_judgment_keys(index):
    """The full set of judgment cells the current structure requires, each with
    its key and identity anchor. Deterministic — the planning side of the cache."""
    cells = []
    surfaces = {}
    mods = module_symbols(index)
    for mid in sorted(mods):
        members = mods[mid]
        surfaces[mid] = public_surface_digest(index, mid, members)
        for k in MODULE_JUDGMENT_KINDS:
            cells.append({
                "key": judgment_key("module." + k, mid, surfaces[mid]),
                "kind": "module." + k, "module": mid, "symbol": None})
        for s in sorted(members, key=lambda x: x["id"]):
            if s["visibility"] == "public":
                cells.append({
                    "key": judgment_key("symbol.contract", s["id"],
                                        s["signature_hash"], s["visibility"]),
                    "kind": "symbol.contract", "module": mid, "symbol": s["id"]})
            if is_load_bearing_candidate(s):
                cells.append({
                    "key": judgment_key("symbol.load_bearing", s["id"],
                                        s["signature_hash"],
                                        s["incident_edge_digest"]),
                    "kind": "symbol.load_bearing", "module": mid,
                    "symbol": s["id"]})
    if index["symbols"]:
        odigest = overview_digest(index, surfaces)
        for k in OVERVIEW_JUDGMENT_KINDS:
            cells.append({
                "key": judgment_key("overview." + k, odigest),
                "kind": "overview." + k, "module": "overview/ARCHITECTURE",
                "symbol": None})
    # One edge.semantic cell per resolved cross-module edge — anchored to the
    # calling (from) symbol's module so its annotator, reading that module's
    # source, judges whether a semantic verb also holds. `to` rides along so
    # judge-plan can name the target for the annotator.
    for e, from_sym, fmod, _tmod in resolved_cross_module_edges(index):
        cells.append({
            "key": edge_semantic_key(from_sym, e["to"]),
            "kind": "edge.semantic", "module": fmod,
            "symbol": from_sym["id"], "to": e["to"]})
    # Stable order; de-dup by key (identical anchors can't legitimately recur).
    seen = set()
    unique = []
    for c in sorted(cells, key=lambda c: (c["kind"], c["module"],
                                          c["symbol"] or "", c["key"])):
        if c["key"] not in seen:
            seen.add(c["key"])
            unique.append(c)
    return unique


def load_judgments(root):
    path = judgments_path(root)
    if os.path.isfile(path):
        try:
            with open(path, encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict) and isinstance(data.get("judgments"), dict):
                return data
        except (OSError, ValueError):
            pass
    return {"version": JUDGMENT_VERSION, "judgments": {}}


def write_judgments(root, data):
    path = judgments_path(root)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(json.dumps(data, indent=2, sort_keys=True) + "\n")


def plan_judgment_misses(index, judgments):
    """Split the required cells into present (cached) and missing (must be
    judged by the LLM). The cache miss set IS the delta the model must fill."""
    have = judgments.get("judgments", {})
    cells = compute_judgment_keys(index)
    missing = [c for c in cells if c["key"] not in have]
    present = [c["key"] for c in cells if c["key"] in have]
    return cells, missing, present


def cmd_judge_plan(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    index, _ = load_or_build_index(root, backend=args.backend)
    if "symbols" not in index:
        emit(index)
        return 1
    judgments = load_judgments(root)
    cells, missing, present = plan_judgment_misses(index, judgments)
    by_module = {}
    for c in cells:
        slot = by_module.setdefault(c["module"], {"expected": 0, "missing": 0})
        slot["expected"] += 1
        if c["key"] not in judgments.get("judgments", {}):
            slot["missing"] += 1
    return emit_ok(
        total_expected=len(cells),
        missing_count=len(missing),
        present_count=len(present),
        missing_keys=missing,
        by_module=by_module,
    )


def cmd_judgment_ingest(args):
    """Merge LLM-produced cells (a JSON array on stdin) into judgments.json. The
    CLI owns the file: it stamps created_at_commit and a default unverified
    verdict, then writes canonically. Same opaque-stdin discipline as
    verify-cache write."""
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    raw = sys.stdin.read()
    try:
        cells = json.loads(raw) if raw.strip() else []
    except ValueError as exc:
        return emit_fail("bad_payload", "Cells must be a JSON array: {}".format(exc))
    if not isinstance(cells, list):
        return emit_fail("bad_payload", "Expected a JSON array of cells.")

    data = load_judgments(root)
    store = data.setdefault("judgments", {})
    head = git_head(root)
    ingested = 0
    rejected = []
    for cell in cells:
        if not isinstance(cell, dict):
            rejected.append({"reason": "not_an_object", "cell": cell})
            continue
        key = cell.get("key")
        kind = cell.get("kind")
        value = cell.get("value")
        if not key or "/" not in str(key) or not kind or value is None:
            rejected.append({"reason": "missing_fields", "key": key})
            continue
        if not str(key).startswith(str(kind) + "/"):
            rejected.append({"reason": "key_kind_mismatch", "key": key})
            continue
        provenance = cell.get("provenance") or {}
        if not isinstance(provenance, dict):
            provenance = {}
        provenance.setdefault("created_at_commit", head)
        verify = cell.get("verify") or {"verdict": "unverified"}
        if not isinstance(verify, dict):
            verify = {"verdict": "unverified"}
        store[key] = {"kind": kind, "value": value,
                      "provenance": provenance, "verify": verify}
        ingested += 1
    write_judgments(root, data)
    return emit_ok(ingested=ingested, rejected=rejected,
                   total=len(store),
                   path=os.path.relpath(judgments_path(root), root))


def judgment_key_delta(index, judgments):
    """Classify the structure's required judgment cells against the cache:
    `missing` (required, not cached → the LLM delta) and `orphaned` (cached but
    no longer required → prunable). The miss set drives /atlas update."""
    cells = compute_judgment_keys(index)
    have = judgments.get("judgments", {})
    required = {c["key"] for c in cells}
    missing = [c for c in cells if c["key"] not in have]
    orphaned = sorted(set(have) - required)
    by_kind = {}
    for c in missing:
        by_kind[c["kind"]] = by_kind.get(c["kind"], 0) + 1
    return cells, missing, orphaned, by_kind


def cmd_judgment_diff(args):
    """The v2 staleness engine. Reports the judgment delta (cells the LLM must
    fill) and the docs whose freshly-rendered bytes differ from what's committed
    (pure re-projection). `clean` is the zero-LLM proof: no source-relevant
    change means missing == [] and stale_docs == []."""
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    index, _ = load_or_build_index(root, backend=args.backend)
    if "symbols" not in index:
        emit(index)
        return 1
    judgments = load_judgments(root)
    _, missing, orphaned, by_kind = judgment_key_delta(index, judgments)

    docs, _, _ = join_structure_and_judgments(root, index, judgments)
    stale_docs = []
    for relpath, text in sorted(docs.items()):
        abspath = os.path.join(root, relpath)
        prior = read_text(abspath) if os.path.isfile(abspath) else None
        if prior is None or canonical_doc_text(prior) != text:
            stale_docs.append(relpath)

    return emit_ok(
        clean=not missing and not stale_docs,
        missing_count=len(missing),
        missing_keys=missing,
        by_kind=by_kind,
        orphaned_count=len(orphaned),
        orphaned_keys=orphaned,
        stale_doc_count=len(stale_docs),
        stale_docs=stale_docs,
    )


def cmd_judgment_prune(args):
    """Drop cached judgment cells the current structure no longer requires —
    the apply-step for `judgment diff`'s `orphaned_keys`. Keys are content-
    addressed, so an orphan is unambiguously a cell whose anchoring symbol,
    module, or public surface vanished; dropping it keeps judgments.json from
    growing monotonically (and bloating PR diffs) as code churns. The cache is
    committed, so a prune is reversible via git; it writes nothing when there
    is nothing to drop (idempotent)."""
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    index, _ = load_or_build_index(root, backend=args.backend)
    if "symbols" not in index:
        emit(index)
        return 1
    judgments = load_judgments(root)
    _, _, orphaned, _ = judgment_key_delta(index, judgments)
    store = judgments.get("judgments", {})
    for key in orphaned:
        store.pop(key, None)
    if orphaned:
        write_judgments(root, judgments)
    return emit_ok(
        pruned_count=len(orphaned),
        pruned_keys=orphaned,
        total=len(store),
        path=os.path.relpath(judgments_path(root), root),
    )


def verify_targets(index, judgments):
    """The in-scope, not-yet-verified cells the map-verifier should sample: cells
    of a high-consequence falsifiable kind (VERIFY_KINDS) that the structure
    currently requires AND that are cached with a pending verdict (unverified or
    migrated). A cached pass/fail under an unchanged key is skipped — verification
    collapses to the delta exactly like judgment. Each target carries the claim
    (value) and the source the verifier checks it against."""
    store = judgments.get("judgments", {})
    sym_by_id = {s["id"]: s for s in index.get("symbols", [])}
    modules = index.get("modules", {})
    targets = []
    for cell in compute_judgment_keys(index):
        if cell["kind"] not in VERIFY_KINDS:
            continue
        entry = store.get(cell["key"])
        if entry is None:
            continue  # required but unjudged — a JUDGE miss, not a verify target
        verdict = (entry.get("verify") or {}).get("verdict", "unverified")
        if verdict not in VERIFY_PENDING_VERDICTS:
            continue  # already pass/fail under this key
        value = entry.get("value")
        if cell["kind"] == "edge.semantic" and not (
                isinstance(value, dict)
                and value.get("verb") in SEMANTIC_EDGE_VERBS):
            continue  # a null/absent verb is "no relationship" — nothing to refute
        target = {"key": cell["key"], "kind": cell["kind"],
                  "value": value, "module": cell["module"]}
        if cell["symbol"]:
            target["symbol"] = cell["symbol"]
            s = sym_by_id.get(cell["symbol"])
            if s:
                target["file"] = s["file"]
                target["line"] = s["span"]["start_line"]
            if cell.get("to"):
                target["to"] = cell["to"]  # the relationship's resolved target
        else:
            target["files"] = modules.get(cell["module"], [])
        targets.append(target)
    return targets


def cmd_judgment_verify_set(args):
    """Verify the high-consequence prose delta — the verify analogue of
    judge-plan -> judgment ingest. Two modes:
      --plan  : report the in-scope, not-yet-verified cells (kind in VERIFY_KINDS,
                verdict unverified/migrated) for the orchestrator to sample with
                map-verifier, each with the source to check it against.
      (stdin) : stamp an opaque JSON array of verdicts [{key, verdict, failures?}]
                onto store[key].verify by key. A pure verdict SINK — it never
                authors a cell's value; a `fail` is surfaced for the protocol to
                re-judge through JUDGE (the sole cell producer), not here."""
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    judgments = load_judgments(root)
    if args.plan:
        index, _ = load_or_build_index(root, backend=args.backend)
        if "symbols" not in index:
            emit(index)
            return 1
        targets = verify_targets(index, judgments)
        by_kind = {}
        for t in targets:
            by_kind[t["kind"]] = by_kind.get(t["kind"], 0) + 1
        return emit_ok(target_count=len(targets), targets=targets,
                       by_kind=by_kind, kinds=list(VERIFY_KINDS))

    # Ingest mode: opaque verdicts on stdin, stamped by key (à la verify-cache).
    raw = "" if sys.stdin.isatty() else sys.stdin.read()
    try:
        verdicts = json.loads(raw) if raw.strip() else []
    except ValueError as exc:
        return emit_fail(
            "bad_verdicts",
            "verify-set expects a JSON array of verdicts on stdin: {}".format(exc))
    if not isinstance(verdicts, list):
        return emit_fail("bad_verdicts", "verdicts must be a JSON array.")
    store = judgments.get("judgments", {})
    head = git_head(root)
    stamped = 0
    passed = []
    failed = []
    rejected = []
    for v in verdicts:
        if not isinstance(v, dict):
            rejected.append({"reason": "not_an_object", "verdict": v})
            continue
        key = v.get("key")
        verdict = v.get("verdict")
        if key not in store:
            rejected.append({"reason": "unknown_key", "key": key})
            continue
        if verdict not in ("pass", "fail"):
            rejected.append({"reason": "bad_verdict", "key": key})
            continue
        rec = {"verdict": verdict, "verifier": "map-verifier", "at_commit": head}
        failures = v.get("failures")
        if verdict == "fail" and failures:
            rec["failures"] = failures
        store[key]["verify"] = rec
        stamped += 1
        (passed if verdict == "pass" else failed).append(key)
    if stamped:
        write_judgments(root, judgments)
    return emit_ok(stamped=stamped, passed=len(passed), failed=len(failed),
                   fail_keys=failed, rejected=rejected,
                   path=os.path.relpath(judgments_path(root), root))


# ─── migrate-v1 (re-key existing v1 doc prose into the Judgment Cache) ───────
#
# A one-time upgrade so a v1-mapped project does not pay a full re-map. It reads
# the committed v1 docs, matches each prose cell to a current structure symbol/
# module by name+path, and writes it into the cache under the v2 key. Prose whose
# symbol no longer matches (drift since the v1 map) is reported, not guessed —
# those cells stay missing and are judged fresh by the next /atlas update.

def extract_section(body, anchor):
    """Prose under a `## <anchor>` heading, up to the next `## ` (trimmed)."""
    out = []
    in_sec = False
    for line in body.splitlines():
        if line.strip().startswith("## "):
            in_sec = line.strip() == "## " + anchor
            continue
        if in_sec:
            out.append(line)
    return "\n".join(out).strip()


def parse_table_rows(body, section):
    """(col1, col3, col4) cells from a `## <section>` markdown table — i.e.
    (symbol, location, contract/why) — skipping the header and separator."""
    rows = []
    in_section = False
    table_row = 0
    for line in body.splitlines():
        s = line.strip()
        if s.startswith("## "):
            in_section = s == "## " + section
            table_row = 0
            continue
        if not in_section or not s.startswith("|"):
            continue
        table_row += 1
        if table_row <= 2:
            continue
        cells = [c.strip().strip("`") for c in s.strip("|").split("|")]
        if len(cells) >= 4 and cells[0]:
            rows.append((cells[0], cells[2], cells[3]))
    return rows


def parse_index_facts(body):
    m = re.search(r"<!-- atlas:index-facts -->(.*?)<!-- /atlas:index-facts -->",
                  body, re.S)
    if not m:
        return []
    return [ln.strip()[2:].strip() for ln in m.group(1).splitlines()
            if ln.strip().startswith("- ")]


def cmd_migrate_v1(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    docs, _ = load_validated_docs(root)
    if not docs:
        return emit_fail("no_v1_map", "No committed map docs to migrate.")
    index, _ = load_or_build_index(root)
    if "symbols" not in index:
        emit(index)
        return 1

    key_by = _key_index(compute_judgment_keys(index))
    rev = path_to_module(index)
    sym_by_namefile = {(s["name"], s["file"]): s for s in index["symbols"]}
    head = git_head(root)
    migrated = {}
    unmapped = []

    def place(kind, module, symbol, value):
        key = key_by.get((kind, module, symbol))
        if key is None or value is None or value == "":
            return False
        migrated[key] = {
            "kind": kind, "value": value,
            "provenance": {"generator": "migrated/v1", "created_at_commit": head},
            "verify": {"verdict": "migrated"}}
        return True

    def match_symbol(symbol, location):
        relpath = location.rsplit(":", 1)[0] if re.search(r":\d+$", location) \
            else location
        bare = symbol.rsplit(".", 1)[-1].split("(", 1)[0].strip()
        s = sym_by_namefile.get((bare, relpath))
        if s:
            return s
        for (name, f), cand in sym_by_namefile.items():  # name match, any file
            if name == bare and (not relpath or f == relpath):
                return cand
        return None

    for doc in docs:
        body, fm = doc["body"], doc["fm"]
        if doc["doc_id"].startswith("modules/"):
            mid = doc_module_id(doc["doc_id"])
            place("module.summary", mid, None, fm.get("summary"))
            place("module.read_when", mid, None, fm.get("read_when"))
            place("module.purpose", mid, None, extract_section(body, "Purpose"))
            place("module.type_notes", mid, None,
                  extract_section(body, "Type notes"))
            place("module.gotchas", mid, None, extract_section(body, "Gotchas"))
            for symbol, loc, contract in parse_table_rows(body, "Public API"):
                s = match_symbol(symbol, loc)
                if not (s and place("symbol.contract", rev.get(s["file"]),
                                    s["id"], contract)):
                    unmapped.append({"doc": doc["doc_id"], "symbol": symbol,
                                     "kind": "symbol.contract"})
            for symbol, loc, why in parse_table_rows(body,
                                                     "Load-bearing internals"):
                s = match_symbol(symbol, loc)
                if not (s and place("symbol.load_bearing", rev.get(s["file"]),
                                    s["id"], why)):
                    unmapped.append({"doc": doc["doc_id"], "symbol": symbol,
                                     "kind": "symbol.load_bearing"})
        else:  # overview
            place("overview.shape", "overview/ARCHITECTURE", None,
                  extract_section(body, "System shape"))
            place("overview.dataflow", "overview/ARCHITECTURE", None,
                  extract_section(body, "Data flow"))
            facts = parse_index_facts(body)
            if facts:
                place("overview.index_facts", "overview/ARCHITECTURE", None, facts)

    data = load_judgments(root)
    store = data.setdefault("judgments", {})
    for key, cell in migrated.items():
        store.setdefault(key, cell)  # never clobber a real judgment
    write_judgments(root, data)

    _, still_missing, _ = plan_judgment_misses(index, data)
    return emit_ok(
        migrated=len(migrated),
        unmapped_count=len(unmapped),
        unmapped=unmapped[:50],
        still_missing=len(still_missing),
        path=os.path.relpath(judgments_path(root), root),
    )


# ─── project (deterministic render — the JOIN) ───────────────────────────────
#
# project assembles the committed docs by JOINing the Structure Index (rows,
# edges, deps — what exists) with the Judgment Cache (prose cells — why it
# matters). It writes no judgment of its own: a missing cell renders a visible
# placeholder (which lint L15 flags and judge-plan counts), so a doc is always
# structurally valid and re-projecting after ingest fills the blanks. Output is
# deterministic — same index + same cache → byte-identical docs.

GENERATOR_V2 = "cartographer/4"
PENDING_PROSE = "_(pending judgment)_"
PROJECT_MAX_EDGES = 60
OVERVIEW_SUMMARY = "System architecture and cross-module relationships"


def _key_index(cells):
    """{(kind, module, symbol): key} from compute_judgment_keys — the single
    source of truth for the single-valued (module/symbol/overview) cells, shared
    by planning and projection. edge.semantic is excluded: it is multi-valued per
    (kind, module, symbol) — one cell per outgoing cross-module edge — so the
    projector keys it directly via edge_semantic_key, not through this map."""
    return {(c["kind"], c["module"], c["symbol"]): c["key"]
            for c in cells if c["kind"] != "edge.semantic"}


def symbol_location(sym):
    return "{}:{}".format(sym["file"], sym["span"]["start_line"])


def module_external_deps(root, index, paths):
    """Sorted import targets for a module's files that are NOT internal repo
    paths (a target whose first segment is a repo directory is internal)."""
    deps = set()
    for p in paths:
        for line in index["imports"].get(p, []):
            tgt = parse_import_target(line)
            if not tgt:
                continue
            first = tgt.replace(".", "/").split("/", 1)[0]
            if first and os.path.isdir(os.path.join(root, first)):
                continue
            deps.add(tgt)
    return sorted(deps)


def render_relationships(index, judgments, module_id):
    """Resolved cross-module structural edges rendered as v1 edge lines. When an
    `edge.semantic` cell has judged a richer verb (owns/emits/reads/writes) for
    an edge, that verb REPLACES the bare structural one (`calls`/…) — the v1
    relationship richness; an unjudged or explicitly null-verb edge keeps its
    structural verb, so projection is stable before the cell is judged and after
    one says "purely structural". Returns
    (lines, referenced_modules, consumed_keys, missing_keys): the semantic keys
    join the doc's judgment_keys and the JUDGE delta exactly like cell prose."""
    store = judgments.get("judgments", {})
    name_by_id = {s["id"]: s["name"] for s in index["symbols"]}
    lines = set()
    refs = set()
    consumed, missing = [], []
    for e, from_sym, _fmod, to_mod in resolved_cross_module_edges(index):
        if _fmod != module_id:
            continue  # only this module's outgoing edges (cross-module only)
        fn = name_by_id.get(e["from"])
        tn = name_by_id.get(e["to"])
        if not fn or not tn:
            continue
        key = edge_semantic_key(from_sym, e["to"])
        consumed.append(key)
        verb = e["kind"]
        entry = store.get(key)
        if entry is None:
            missing.append(key)
        else:
            value = entry.get("value")
            if isinstance(value, dict) and value.get("verb") in SEMANTIC_EDGE_VERBS:
                verb = value["verb"]
        lines.add("- `{}.{} -> {}.{} ({})`".format(
            module_id, fn, to_mod, tn, verb))
        refs.add(to_mod)
    return sorted(lines)[:PROJECT_MAX_EDGES], sorted(refs), consumed, missing


def render_module_doc(root, index, judgments, key_by, module_id):
    """Render one module doc. Returns (text, consumed_keys, missing_keys)."""
    store = judgments.get("judgments", {})
    consumed, missing = [], []

    def cell(kind, symbol=None):
        key = key_by.get((kind, module_id, symbol))
        if key is None:
            return None
        consumed.append(key)
        entry = store.get(key)
        if entry is None:
            missing.append(key)
            return None
        return entry.get("value")

    mods = module_symbols(index)
    members = sorted(mods.get(module_id, []), key=lambda s: (s["name"], s["id"]))
    label = index.get("module_labels", {}).get(module_id, module_id)

    summary = cell("module.summary") or "Pending summary for {}".format(label)
    read_when = cell("module.read_when") or "Pending routing for {}".format(label)
    purpose = cell("module.purpose") or PENDING_PROSE
    type_notes = cell("module.type_notes") or PENDING_PROSE
    gotchas = cell("module.gotchas")

    rel_lines, refs, rel_consumed, rel_missing = render_relationships(
        index, judgments, module_id)
    consumed += rel_consumed
    missing += rel_missing
    paths = sorted(index["modules"].get(module_id, []))

    fm = {
        "module": label,
        "summary": summary,
        "read_when": read_when,
        "sources": [{"path": p} for p in paths],
    }
    if refs:
        fm["references_modules"] = refs
    fm["generator"] = GENERATOR_V2

    out = [serialize_frontmatter(fm).rstrip("\n"), ""]
    out += ["# Module: {}".format(label), ""]
    out += ["## Purpose", "", purpose, ""]

    out += ["## Public API", ""]
    out += ["| Symbol | Kind | Location | Contract |", "| --- | --- | --- | --- |"]
    for s in members:
        if s["visibility"] != "public":
            continue
        contract = cell("symbol.contract", s["id"]) or PENDING_PROSE
        out.append("| `{}` | {} | `{}` | {} |".format(
            s["name"], s["kind"], symbol_location(s), contract))
    out.append("")

    out += ["## Load-bearing internals", ""]
    out += ["| Symbol | Kind | Location | Why it matters |",
            "| --- | --- | --- | --- |"]
    for s in members:
        if not is_load_bearing_candidate(s):
            continue
        why = cell("symbol.load_bearing", s["id"])
        if isinstance(why, dict):
            if why.get("load_bearing") is False:
                continue
            why = why.get("why") or PENDING_PROSE
        why = why or PENDING_PROSE
        out.append("| `{}` | {} | `{}` | {} |".format(
            s["name"], s["kind"], symbol_location(s), why))
    out.append("")

    out += ["## Relationships", ""]
    out += rel_lines
    if rel_lines:
        out.append("")
    out += ["## Type notes", "", type_notes, ""]

    out += ["## External deps", ""]
    for dep in module_external_deps(root, index, paths):
        out.append("- {} — imported".format(dep))
    out.append("")

    if gotchas and gotchas != PENDING_PROSE:
        out += ["## Gotchas", "", gotchas, ""]

    text = "\n".join(out).rstrip("\n") + "\n"
    return text, consumed, missing


def render_overview_doc(root, index, judgments, key_by):
    """Render overview/ARCHITECTURE.md from module-granularity structure +
    overview judgment cells. Returns (text, consumed_keys, missing_keys)."""
    store = judgments.get("judgments", {})
    consumed, missing = [], []
    oid = "overview/ARCHITECTURE"

    def cell(kind):
        key = key_by.get((kind, oid, None))
        if key is None:
            return None
        consumed.append(key)
        entry = store.get(key)
        if entry is None:
            missing.append(key)
            return None
        return entry.get("value")

    rev = path_to_module(index)
    module_ids = sorted(index.get("modules", {}))
    scopes = sorted({p.split("/", 1)[0] for paths in index["modules"].values()
                     for p in paths if "/" in p})

    # Module-granularity resolved cross edges.
    medges = set()
    for e in index["edges"]:
        if e["confidence"] != "resolved" or not e.get("to"):
            continue
        fm_ = rev.get(e["from"].split("::")[0])
        tm = rev.get(e["to"].split("::")[0])
        if fm_ and tm and fm_ != tm:
            medges.add("- `{} -> {} ({})`".format(fm_, tm, e["kind"]))

    shape = cell("overview.shape") or PENDING_PROSE
    dataflow = cell("overview.dataflow") or PENDING_PROSE
    facts = cell("overview.index_facts")

    fm = {
        "module": oid,
        "summary": OVERVIEW_SUMMARY,
        "sources": [{"path": "docs/atlas/modules/{}.md".format(m)}
                    for m in module_ids],
    }
    if scopes:
        fm["scopes"] = [{"tree": s} for s in scopes]
    fm["generator"] = GENERATOR_V2

    out = [serialize_frontmatter(fm).rstrip("\n"), ""]
    out += ["# Architecture", ""]
    out += ["## System shape", "", shape, ""]
    out += ["## Module relationships", ""]
    out += sorted(medges)
    if medges:
        out.append("")
    out += ["## Data flow", "", dataflow, ""]

    out += ["<!-- atlas:index-facts -->"]
    if isinstance(facts, list):
        bullets = [str(b) for b in facts]
    elif isinstance(facts, str):
        bullets = [l.lstrip("- ").strip() for l in facts.splitlines() if l.strip()]
    else:
        bullets = ["(pending judgment)"]
    for b in bullets:
        out.append("- {}".format(b))
    out += ["<!-- /atlas:index-facts -->"]

    text = "\n".join(out).rstrip("\n") + "\n"
    return text, consumed, missing


def join_structure_and_judgments(root, index, judgments):
    """Render every committed doc. Returns (docs, consumed, missing) where docs
    maps repo-relative path → text."""
    key_by = _key_index(compute_judgment_keys(index))
    docs = {}
    consumed, missing = [], []
    for module_id in sorted(index.get("modules", {})):
        text, c, m = render_module_doc(root, index, judgments, key_by, module_id)
        docs["docs/atlas/modules/{}.md".format(module_id)] = text
        consumed += c
        missing += m
    if index["symbols"]:
        text, c, m = render_overview_doc(root, index, judgments, key_by)
        docs["docs/atlas/overview/ARCHITECTURE.md"] = text
        consumed += c
        missing += m
    return docs, consumed, missing


def judgment_keys_by_doc(root, index, judgments):
    """{doc_relpath: [judgment keys it consumes]} — the per-doc dependency the
    v2 ledger records and `judgment diff` uses to map a key delta to the docs
    that must re-project. Derived from the same render path as project (DRY)."""
    key_by = _key_index(compute_judgment_keys(index))
    out = {}
    for module_id in sorted(index.get("modules", {})):
        _, consumed, _ = render_module_doc(
            root, index, judgments, key_by, module_id)
        out["docs/atlas/modules/{}.md".format(module_id)] = sorted(set(consumed))
    if index["symbols"]:
        _, consumed, _ = render_overview_doc(root, index, judgments, key_by)
        out["docs/atlas/overview/ARCHITECTURE.md"] = sorted(set(consumed))
    return out


def structure_ledger_block(index):
    """The v2 ledger's structure fingerprint: a content digest of the whole
    index plus per-path symbol hashes, so a future diff can localize change
    without re-reading every file."""
    per_path = {}
    for s in index["symbols"]:
        per_path.setdefault(s["file"], []).append({
            "id": s["id"], "signature_hash": s["signature_hash"],
            "span_hash": s["span_hash"],
            "incident_edge_digest": s["incident_edge_digest"]})
    digest_src = {
        "symbols": [[s["id"], s["signature_hash"], s["span_hash"],
                     s["incident_edge_digest"]] for s in index["symbols"]],
        "edges": [[e["from"], e.get("to"), e["kind"], e["confidence"]]
                  for e in index["edges"]],
    }
    return {
        "index_commit": index["commit"],
        "index_digest": content_hash(json.dumps(digest_src, sort_keys=True)),
        "symbols": per_path,
    }


def cmd_project(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    index, _ = load_or_build_index(root, backend=args.backend)
    if "symbols" not in index:
        emit(index)
        return 1
    judgments = load_judgments(root)
    docs, consumed, missing = join_structure_and_judgments(root, index, judgments)

    written = []
    changed = 0
    for relpath, text in sorted(docs.items()):
        abspath = os.path.join(root, relpath)
        prior = read_text(abspath) if os.path.isfile(abspath) else None
        # Compare modulo finalize-managed keys: a doc whose projection is
        # unchanged keeps its committed bytes (and its ledger blobs) intact.
        if prior is None or canonical_doc_text(prior) != text:
            os.makedirs(os.path.dirname(abspath), exist_ok=True)
            with open(abspath, "w", encoding="utf-8") as f:
                f.write(text)
            changed += 1
        written.append(relpath)
    return emit_ok(written=written, doc_count=len(written), changed=changed,
                   consumed_keys=len(consumed),
                   missing_keys=sorted(set(missing)),
                   placeholder_count=len(set(missing)))


# ─── commit (guarded, pathspec-scoped) ───────────────────────────────────────

def run_git_capture(args, cwd):
    proc = subprocess.run(["git"] + args, cwd=cwd, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE)
    return proc.returncode, proc.stdout, proc.stderr


def git_with_index_retry(args, cwd, attempts=3):
    """Retry on index.lock contention from the user's own git activity."""
    for attempt in range(attempts):
        code, out, err = run_git_capture(args, cwd)
        if code == 0 or b"index.lock" not in err:
            return code, out, err
        time.sleep(0.5 * (attempt + 1))
    return code, out, err


def cmd_commit(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    code, _ = run_git(["rev-parse", "-q", "--verify", "MERGE_HEAD"], cwd=root)
    if code == 0:
        return emit_fail(
            "mid_merge",
            "A merge is in progress — git refuses partial commits mid-merge. "
            "Complete or abort the merge, then run /atlas update.",
        )

    paths = ["docs/atlas/"] + [p for p in (args.also or [])
                               if os.path.exists(os.path.join(root, p))]
    code, out = run_git(["status", "--porcelain", "-z", "--"] + paths, cwd=root)
    if code == 0 and not out.strip():
        return emit_ok(committed=False, message="Nothing to commit in the map paths.")

    code, _, err = git_with_index_retry(["add", "--"] + paths, cwd=root)
    if code != 0:
        return emit_fail("git_add_failed", err.decode("utf-8", errors="replace").strip())
    code, _, err = git_with_index_retry(
        ["commit", "-m", args.message, "--"] + paths, cwd=root)
    if code != 0:
        return emit_fail("git_commit_failed", err.decode("utf-8", errors="replace").strip())

    sha = git_head(root)
    return emit_ok(committed=True, sha=sha)


# ─── branch (isolate map work on an atlas/* branch) ──────────────────────────
#
# Mapping runs on a dedicated `atlas/<op>-<short-sha>` branch so checkpoint
# commits never touch the user's working branch and a crash/re-run cannot
# clobber an already-good committed map. Idempotent: a flow already on an
# atlas/* branch (resume/re-entry) gets a no-op. Refuses mid-merge for the same
# reason `commit` does — git can't isolate a partial state mid-merge.

ATLAS_BRANCH_PREFIX = "atlas/"


def git_current_branch(root):
    """Short branch name for HEAD, or None when detached or unborn."""
    code, out = run_git(["symbolic-ref", "-q", "--short", "HEAD"], cwd=root)
    if code != 0:
        return None
    return out.decode("utf-8", errors="replace").strip()


def git_branch_exists(root, name):
    code, _ = run_git(
        ["show-ref", "--verify", "--quiet", "refs/heads/{}".format(name)],
        cwd=root)
    return code == 0


def cmd_branch_ensure(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    code, _ = run_git(["rev-parse", "-q", "--verify", "MERGE_HEAD"], cwd=root)
    if code == 0:
        return emit_fail(
            "mid_merge",
            "A merge is in progress — finish or abort it before mapping so "
            "atlas can isolate the run on its own branch.",
        )

    head_sha = git_head(root)
    if head_sha is None:
        return emit_fail(
            "no_commits",
            "The repository has no commits yet — create an initial commit "
            "before mapping.",
        )

    current = git_current_branch(root)

    # Already on an atlas branch → idempotent no-op so a resumed or re-entered
    # flow does not stack atlas/map-… on atlas/map-….
    if current is not None and current.startswith(ATLAS_BRANCH_PREFIX):
        return emit_ok(branch=current, created=False, base_branch=None,
                       base_sha=head_sha, detached=False)

    # Deterministic name tied to the base commit; a numeric suffix keeps a
    # sequential re-run (same base sha, prior branch still around) distinct
    # instead of resuming a possibly half-finished branch.
    detached = current is None
    base = "{}{}-{}".format(ATLAS_BRANCH_PREFIX, args.op, head_sha[:7])
    name = base
    suffix = 2
    while git_branch_exists(root, name):
        name = "{}-{}".format(base, suffix)
        suffix += 1

    # `checkout -b` roots the new branch at the current commit (works from a
    # detached HEAD too) and carries any dirty working-tree state along — the
    # about-to-be-written map docs travel onto the isolated branch.
    code, _, err = run_git_capture(["checkout", "-b", name], cwd=root)
    if code != 0:
        return emit_fail(
            "branch_failed", err.decode("utf-8", errors="replace").strip())

    return emit_ok(branch=name, created=True, base_branch=current,
                   base_sha=head_sha, detached=detached)


# ─── init / remove (CLAUDE.md managed block + gitignore wiring) ──────────────

CLAUDE_MD_START = "<!-- atlas:start -->"
CLAUDE_MD_END = "<!-- atlas:end -->"

CLAUDE_MD_BLOCK = """<!-- atlas:start -->
## Codebase Map (atlas)

@docs/atlas/INDEX.md

- The imported INDEX above is this project's codebase map. Use its routing
  table: read the listed module doc before working in that area.
- The map covers code structure only; build/test/workflow guidance lives in
  the rest of this file.
- After committing changes to mapped source files, suggest running
  `/atlas update`.
<!-- atlas:end -->"""

GITIGNORE_LINE = ".atlas/"
GITIGNORE_COMMENT = "# Atlas runtime state (ephemeral, never committed)"


def claude_md_block_re():
    return re.compile(
        re.escape(CLAUDE_MD_START) + r".*?" + re.escape(CLAUDE_MD_END),
        re.DOTALL)


def cmd_init(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    claude_path = os.path.join(root, "CLAUDE.md")
    if os.path.isfile(claude_path):
        with open(claude_path, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
        if CLAUDE_MD_START in text:
            text = claude_md_block_re().sub(CLAUDE_MD_BLOCK, text, count=1)
            action = "replaced"
        else:
            text = text.rstrip("\n") + "\n\n" + CLAUDE_MD_BLOCK + "\n"
            action = "appended"
    else:
        text = CLAUDE_MD_BLOCK + "\n"
        action = "created"
    with open(claude_path, "w", encoding="utf-8") as f:
        f.write(text)

    gitignore_path = os.path.join(root, ".gitignore")
    gitignore_action = "present"
    lines = []
    if os.path.isfile(gitignore_path):
        with open(gitignore_path, "r", encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    if GITIGNORE_LINE not in lines:
        if lines and lines[-1].strip():
            lines.append("")
        lines.extend([GITIGNORE_COMMENT, GITIGNORE_LINE])
        with open(gitignore_path, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        gitignore_action = "added"

    return emit_ok(claude_md=action, gitignore=gitignore_action)


def cmd_remove(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    claude_path = os.path.join(root, "CLAUDE.md")
    if not os.path.isfile(claude_path):
        return emit_ok(claude_md="absent")
    with open(claude_path, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    if CLAUDE_MD_START not in text:
        return emit_ok(claude_md="absent")
    text = claude_md_block_re().sub("", text, count=1)
    text = re.sub(r"\n{3,}", "\n\n", text).rstrip("\n") + "\n"
    with open(claude_path, "w", encoding="utf-8") as f:
        f.write(text)
    return emit_ok(claude_md="removed",
                   note="The .atlas/ gitignore entry and docs/atlas/ map files "
                        "are left in place; delete them manually if desired.")


# ─── INDEX rebuild ───────────────────────────────────────────────────────────
#
# INDEX.md is DERIVED — assembled mechanically from doc frontmatter plus the
# index-facts block in the architecture overview. Two branches that both ran
# /atlas update will conflict on INDEX; the resolution is always "rebuild",
# never hand-merge. Determinism here is what makes that safe.

INDEX_HARD_CHARS = 7000   # ≈2k tokens at ~3.5 chars/token (markdown-dense)
INDEX_WARN_CHARS = 6000

INDEX_FACTS_START = "<!-- atlas:index-facts -->"
INDEX_FACTS_END = "<!-- /atlas:index-facts -->"


def table_cell(text):
    return str(text).replace("|", "/").replace("\n", " ").strip()


def extract_index_facts(root):
    """Verbatim bullet lines from the overview's index-facts block."""
    arch = os.path.join(root, MAP_DIR, "overview", "ARCHITECTURE.md")
    if not os.path.isfile(arch):
        return []
    with open(arch, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    start = text.find(INDEX_FACTS_START)
    end = text.find(INDEX_FACTS_END)
    if start == -1 or end == -1 or end <= start:
        return []
    block = text[start + len(INDEX_FACTS_START):end]
    return [line.rstrip() for line in block.splitlines()
            if line.strip().startswith("- ")]


def ledger_baseline(root):
    try:
        with open(os.path.join(root, LEDGER_RELPATH), "r", encoding="utf-8") as f:
            return json.load(f).get("baseline")
    except (OSError, ValueError):
        return None


def build_index_text(root, docs):
    """Deterministic INDEX assembly. Returns the full file text."""
    config = load_config(root)
    project = config.get("project_name") or os.path.basename(root.rstrip("/"))
    baseline = ledger_baseline(root) or git_head(root)
    short = baseline[:7] if isinstance(baseline, str) else "unmapped"

    module_docs = sorted(
        (d for d in docs if d["doc_id"].startswith("modules/")),
        key=lambda d: d["doc_id"])
    overview_docs = sorted(
        (d for d in docs if d["doc_id"].startswith("overview/")),
        key=lambda d: d["doc_id"])
    facts = extract_index_facts(root)

    lines = []
    lines.append("# {} — Atlas Codebase Map".format(table_cell(project)))
    lines.append("")
    lines.append(
        "Generated by atlas at baseline {}. Derived file — do not edit by "
        "hand; regenerate with /atlas update.".format(short))
    lines.append(
        "Module docs live at docs/atlas/modules/<id>.md — before working "
        "in an area, read its module doc.")
    lines.append("")
    lines.append("## Modules")
    lines.append("")
    lines.append("| Module | When working on |")
    lines.append("| --- | --- |")
    for doc in module_docs:
        lines.append("| {} | {} |".format(
            doc_module_id(doc["doc_id"]),
            table_cell(doc["fm"].get("read_when", ""))))
    for doc in overview_docs:
        lines.append("| {} | Architecture and cross-module relationships "
                     "— read docs/atlas/{} |".format(
                         doc["doc_id"][:-3], doc["doc_id"]))
    if facts:
        lines.append("")
        lines.append("## Key facts")
        lines.append("")
        lines.extend(facts)
    lines.append("")
    lines.append("## Reminders")
    lines.append("")
    lines.extend(facts[:2])
    lines.append(
        "- Read the routed module doc before editing unfamiliar modules; "
        "workflow and commands live in CLAUDE.md, not here.")
    return "\n".join(lines) + "\n"


def cmd_index_rebuild(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    docs, errors = load_validated_docs(root)
    if errors:
        return emit_fail(
            "invalid_frontmatter",
            "Some map docs have invalid frontmatter; fix or regenerate them.",
            docs={doc_id: msgs for doc_id, msgs in errors},
        )
    if not docs:
        return emit_fail("no_docs", "No map docs found under docs/atlas/ — "
                         "run a full map first.")
    text = build_index_text(root, docs)
    if len(text) > INDEX_HARD_CHARS:
        return emit_fail(
            "index_over_budget",
            "Rebuilt INDEX would be {} chars (hard ceiling {}). Trim module "
            "summaries, read_when entries, or index facts.".format(
                len(text), INDEX_HARD_CHARS),
            chars=len(text), hard=INDEX_HARD_CHARS,
        )
    index_path = os.path.join(root, INDEX_RELPATH)
    os.makedirs(os.path.dirname(index_path), exist_ok=True)
    with open(index_path, "w", encoding="utf-8") as f:
        f.write(text)
    return emit_ok(
        chars=len(text), modules=sum(1 for d in docs
                                     if d["doc_id"].startswith("modules/")),
        warn_chars=INDEX_WARN_CHARS, hard_chars=INDEX_HARD_CHARS,
        over_warn=len(text) > INDEX_WARN_CHARS,
    )


# ─── lint ────────────────────────────────────────────────────────────────────
#
# Mechanical integrity checks. ERROR = the map lies structurally (untrustworthy
# until fixed); WARN = probably stale or sloppy. `--fast` runs the cheap subset
# used by status/hooks: markers, drift, INDEX budget, INDEX reconciliation.

MODULE_DOC_ANCHORS = [
    "## Purpose", "## Public API", "## Load-bearing internals",
    "## Relationships", "## Type notes", "## External deps",
]

BACKTICK_RE = re.compile(r"`([^`\n]+)`")
PATHISH_RE = re.compile(r"[\w./-]+/[\w./-]+\.\w{1,8}(?::\d+)?")
LINK_RE = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)")
WORDISH_BOUNDARY = r"(?<![A-Za-z0-9_]){}(?![A-Za-z0-9_])"


def gitignored_top_dirs(root):
    """Top-level dir names with gitignored content — runtime artifact
    namespaces (.forge/, .rca/, …) whose paths legitimately don't exist."""
    tops = {".atlas"}  # atlas's own runtime dir, gitignored at init time
    path = os.path.join(root, ".gitignore")
    if not os.path.isfile(path):
        return tops
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith(("#", "!")):
                continue
            seg = line.lstrip("/").split("/", 1)[0].rstrip("/")
            if seg and not any(ch in seg for ch in "*?["):
                tops.add(seg)
    return tops


def github_slug(heading):
    s = heading.strip().lower()
    s = re.sub(r"[^\w\- ]", "", s)
    return s.replace(" ", "-")


def parse_symbol_tables(body):
    """(symbol, location) rows from Public API / Load-bearing tables."""
    rows = []
    in_section = False
    table_row = 0
    for line in body.splitlines():
        stripped = line.strip()
        if stripped.startswith("## "):
            in_section = stripped in ("## Public API", "## Load-bearing internals")
            table_row = 0
            continue
        if not in_section or not stripped.startswith("|"):
            continue
        table_row += 1
        if table_row <= 2:  # header + separator
            continue
        cells = [c.strip().strip("`") for c in stripped.strip("|").split("|")]
        if len(cells) >= 3 and cells[0]:
            rows.append((cells[0], cells[2]))
    return rows


# Structural verbs a parser can propose (decision 24) vs semantic verbs that
# always require judgment (decision: determinism boundary). An `edge.semantic`
# cell's value carries one of the SEMANTIC verbs; ALLOWED_EDGE_VERBS is their
# union — the grammar lint L13 validates rendered relationship lines against.
STRUCTURAL_EDGE_VERBS = {"calls", "implements", "conforms-to", "extends"}
SEMANTIC_EDGE_VERBS = {"owns", "emits", "reads", "writes"}
ALLOWED_EDGE_VERBS = STRUCTURAL_EDGE_VERBS | SEMANTIC_EDGE_VERBS

# `<lhs> -> <rhs> (<verb>)` captured inside a backtick span; a trailing
# ` — `path:line`` citation after the closing backtick is outside the match
# and ignored. The verb group accepts any non-`)`/backtick run so an
# out-of-grammar verb (e.g. `builds`, `depends-on`) is still captured for L13.
RELATIONSHIP_EDGE_RE = re.compile(
    r"`([^`]+?)\s*->\s*([^`]+?)\s*\(([^)`]+)\)`")


def parse_relationship_edges(body):
    """(lhs, rhs, verb) tuples from the `## Relationships` section."""
    edges = []
    in_section = False
    for line in body.splitlines():
        stripped = line.strip()
        if stripped.startswith("## "):
            in_section = stripped == "## Relationships"
            continue
        if not in_section or not stripped.startswith("-"):
            continue
        m = RELATIONSHIP_EDGE_RE.search(stripped)
        if m:
            edges.append((m.group(1), m.group(2), m.group(3).strip()))
    return edges


def lint_map(root, fast=False):
    findings = []

    def add(check, severity, file, message):
        findings.append({"check": check, "severity": severity,
                         "file": file, "message": message})

    # L2 — conflict markers (any map file)
    for relfile in find_conflict_markers(root):
        add("L2", "ERROR", relfile, "merge conflict markers present — "
            "doc is invalid; regenerate it (see README conflict recipe)")

    gitignored_tops = gitignored_top_dirs(root)

    # Frontmatter validity gates everything doc-driven.
    docs, fm_errors = load_validated_docs(root)
    for doc_id, msgs in fm_errors:
        add("L1", "ERROR", "docs/atlas/" + doc_id,
            "invalid frontmatter: " + "; ".join(msgs))

    index_path = os.path.join(root, INDEX_RELPATH)

    # L9 — INDEX budget
    if os.path.isfile(index_path):
        size = os.path.getsize(index_path)
        if size > INDEX_HARD_CHARS:
            add("L9", "ERROR", "docs/atlas/INDEX.md",
                "INDEX is {} chars, over the {} hard ceiling "
                "(~2k tokens)".format(size, INDEX_HARD_CHARS))
        elif size > INDEX_WARN_CHARS:
            add("L9", "WARN", "docs/atlas/INDEX.md",
                "INDEX is {} chars, past the {} warning threshold".format(
                    size, INDEX_WARN_CHARS))
    else:
        add("L9", "ERROR", "docs/atlas/INDEX.md",
            "INDEX.md missing — run `index rebuild`")

    # L10 — INDEX reconciliation (byte-compare against a fresh rebuild)
    if not fm_errors and docs and os.path.isfile(index_path):
        expected = build_index_text(root, docs)
        with open(index_path, "r", encoding="utf-8", errors="replace") as f:
            actual = f.read()
        if expected != actual:
            add("L10", "ERROR", "docs/atlas/INDEX.md",
                "INDEX does not match a rebuild from doc frontmatter — "
                "run `index rebuild` (never hand-merge)")

    # L4 — ledger drift
    diff = None
    if not fm_errors and docs:
        diff = compute_diff(root)
        if diff["ok"] and diff["summary"]["affected_docs"]:
            entries = (diff["stale_docs"] + diff["orphaned_docs"] +
                       diff["renamed_docs"] + diff["fingerprint_stale"] +
                       diff["ripple_docs"])
            add("L4", "WARN", "docs/atlas/atlas-ledger.json",
                "{} of {} docs out of date ({}) — run /atlas update".format(
                    diff["summary"]["affected_docs"],
                    diff["summary"]["total_docs"],
                    doc_display_names(entries)))

    if fast:
        return findings

    file_text_cache = {}

    def read_repo_file(relpath):
        if relpath not in file_text_cache:
            try:
                with open(os.path.join(root, relpath), "r",
                          encoding="utf-8", errors="replace") as f:
                    file_text_cache[relpath] = f.read()
            except OSError:
                file_text_cache[relpath] = None
        return file_text_cache[relpath]

    valid_module_ids = {doc_module_id(d["doc_id"]) for d in docs
                        if d["doc_id"].startswith("modules/")}

    # v2 mode (a Judgment Cache exists): the Structure Index is ground truth for
    # symbol existence (L7 join) and the committed docs are a deterministic
    # projection (L15 no placeholders, L16 no divergence).
    v2_index = None
    v2_judgments = None
    v2_renders = {}
    if os.path.isfile(judgments_path(root)):
        idx, _ = load_or_build_index(root)
        if "symbols" in idx:
            v2_index = idx
            v2_judgments = load_judgments(root)
            key_by = _key_index(compute_judgment_keys(v2_index))
            for mid in v2_index.get("modules", {}):
                text, _, _ = render_module_doc(
                    root, v2_index, v2_judgments, key_by, mid)
                _, rbody = split_frontmatter(text)
                v2_renders["modules/{}.md".format(mid)] = rbody
            if v2_index["symbols"]:
                text, _, _ = render_overview_doc(
                    root, v2_index, v2_judgments, key_by)
                _, rbody = split_frontmatter(text)
                v2_renders["overview/ARCHITECTURE.md"] = rbody
    v2_symbols_by_file = {}
    if v2_index is not None:
        for s in v2_index["symbols"]:
            v2_symbols_by_file.setdefault(s["file"], set()).add(s["name"])

    for doc in docs:
        doc_file = "docs/atlas/" + doc["doc_id"]
        body = doc["body"]

        # L15 — a committed projected doc must carry no unfilled judgment
        # placeholders (the map shipped with a pending cell). v2 mode only.
        if v2_index is not None and PENDING_PROSE in body:
            add("L15", "ERROR", doc_file,
                "doc has unfilled judgment placeholders — run /atlas update")

        # L16 — a committed doc must equal its deterministic projection (body).
        # Finalize manages frontmatter (blobs/baseline), so compare bodies.
        if v2_index is not None and doc["doc_id"] in v2_renders:
            if body.rstrip("\n") != v2_renders[doc["doc_id"]].rstrip("\n"):
                add("L16", "ERROR", doc_file,
                    "doc diverges from its projection — run `project` "
                    "(never hand-edit a derived doc)")

        # L1 — skeleton conformance (module docs)
        if doc["doc_id"].startswith("modules/"):
            body_lines = [l.strip() for l in body.splitlines()]
            if not any(l.startswith("# Module: ") for l in body_lines):
                add("L1", "ERROR", doc_file, "missing `# Module: <path>` title")
            positions = []
            for anchor in MODULE_DOC_ANCHORS:
                try:
                    positions.append(body_lines.index(anchor))
                except ValueError:
                    add("L1", "ERROR", doc_file,
                        "missing required section `{}`".format(anchor))
                    positions = None
                    break
            if positions and positions != sorted(positions):
                add("L1", "ERROR", doc_file,
                    "required sections out of canonical order")

        # L3 — ledger source paths exist
        for entry in doc["fm"].get("sources", []):
            if not os.path.isfile(os.path.join(root, entry["path"])):
                add("L3", "ERROR", doc_file,
                    "ledger source `{}` does not exist".format(entry["path"]))

        # L6 — backticked path-ish mentions resolve. Skipped as not being
        # repo-root citations: paths under gitignored top-level dirs
        # (runtime artifacts), `./`/`../`/absolute prefixes (cwd-relative
        # command idiom and machine paths), and line-numberless paths whose
        # first segment is not a repo directory (server-side artifacts like
        # `index/builds.json`). A `:line` suffix always claims a repo code
        # location, so module-relative shorthand stays flagged.
        for match in BACKTICK_RE.finditer(body):
            token = match.group(1)
            if not PATHISH_RE.fullmatch(token):
                continue
            if token.startswith(("./", "../", "/")):
                continue
            has_line = re.search(r":\d+$", token)
            relpath = token.rsplit(":", 1)[0] if has_line else token
            first_seg = relpath.split("/", 1)[0]
            if first_seg in gitignored_tops:
                continue
            if not has_line and not os.path.isdir(os.path.join(root, first_seg)):
                continue
            if not os.path.exists(os.path.join(root, relpath)):
                add("L6", "WARN", doc_file,
                    "backticked path `{}` not found in repo".format(token))

        # L7 — symbol existence. In v2 mode this is a JOIN against the Structure
        # Index (the symbol must be indexed at the cited file — stronger than a
        # grep, which a string match anywhere in the file would satisfy);
        # otherwise it falls back to grepping the claimed location.
        if doc["doc_id"].startswith("modules/") and v2_index is not None:
            for symbol, location in parse_symbol_tables(body):
                relpath = location.rsplit(":", 1)[0] \
                    if re.search(r":\d+$", location) else location
                bare = symbol.rsplit(".", 1)[-1].split("(", 1)[0].strip()
                names = v2_symbols_by_file.get(relpath, set())
                if names and bare not in names and symbol not in names:
                    add("L7", "WARN", doc_file,
                        "symbol `{}` is not an indexed definition in `{}`".format(
                            symbol, relpath))
        elif doc["doc_id"].startswith("modules/"):
            for symbol, location in parse_symbol_tables(body):
                relpath = location.rsplit(":", 1)[0] \
                    if re.search(r":\d+$", location) else location
                if relpath and symbol == os.path.basename(relpath):
                    continue
                content = read_repo_file(relpath) if relpath else None
                if content is None:
                    continue  # dead path already flagged by L6
                if not re.search(WORDISH_BOUNDARY.format(re.escape(symbol)),
                                 content):
                    # The format blesses fully-qualified `Type.member` and
                    # arg-labelled `func(a:b:)` symbol names; fall back to the
                    # bare trailing identifier before declaring it missing.
                    bare = symbol.rsplit(".", 1)[-1].split("(", 1)[0].strip()
                    if not (bare and bare != symbol and re.search(
                            WORDISH_BOUNDARY.format(re.escape(bare)), content)):
                        add("L7", "WARN", doc_file,
                            "symbol `{}` not found in `{}`".format(
                                symbol, relpath))

        # L8 — intra-map links resolve
        for match in LINK_RE.finditer(body):
            target = match.group(1)
            if target.startswith(("http://", "https://", "mailto:", "#")):
                continue
            file_part, _, anchor = target.partition("#")
            doc_dir = os.path.dirname(os.path.join(root, MAP_DIR, doc["doc_id"]))
            target_abs = os.path.normpath(os.path.join(doc_dir, file_part))
            if not os.path.isfile(target_abs):
                add("L8", "ERROR", doc_file,
                    "link target `{}` does not exist".format(target))
            elif anchor:
                with open(target_abs, "r", encoding="utf-8",
                          errors="replace") as f:
                    slugs = [github_slug(l.lstrip("#"))
                             for l in f.read().splitlines()
                             if l.startswith("#")]
                if anchor not in slugs:
                    add("L8", "WARN", doc_file,
                        "anchor `#{}` not found in `{}`".format(anchor, file_part))

        # L12 — references_modules entries resolve to real module docs. A
        # dangling id silently breaks ripple invalidation (referenced_by is
        # keyed off these), so it is an ERROR the orchestrator regenerates.
        if doc["doc_id"].startswith("modules/"):
            for ref in doc["fm"].get("references_modules") or []:
                if str(ref) not in valid_module_ids:
                    add("L12", "ERROR", doc_file,
                        "references_modules entry `{}` is not an existing "
                        "module doc id".format(ref))

        # L13 — relationship edge verbs are in the allowed grammar set.
        if doc["doc_id"].startswith("modules/"):
            for _lhs, _rhs, verb in parse_relationship_edges(body):
                if verb not in ALLOWED_EDGE_VERBS:
                    add("L13", "ERROR", doc_file,
                        "relationship edge verb `{}` is not allowed (use one "
                        "of {})".format(
                            verb, ", ".join(sorted(ALLOWED_EDGE_VERBS))))

        # L14 — INDEX-budget hygiene: over-length read_when / summary feed the
        # budget-capped INDEX (see L9). WARN, not ERROR — a long line bloats
        # the INDEX but never makes the map lie.
        read_when = doc["fm"].get("read_when")
        if (doc["doc_id"].startswith("modules/")
                and isinstance(read_when, str) and len(read_when) > 90):
            add("L14", "WARN", doc_file,
                "read_when is {} chars, over the 90-char limit".format(
                    len(read_when)))
        summary = doc["fm"].get("summary")
        if isinstance(summary, str) and len(summary) > 120:
            add("L14", "WARN", doc_file,
                "summary is {} chars, over the 120-char limit".format(
                    len(summary)))

    # L5 — coverage: mappable files no module doc draws from
    scan = do_scan(root, enforce_ceiling=False)
    if scan.get("ok"):
        covered = set()
        for doc in docs:
            if doc["doc_id"].startswith("modules/"):
                covered.update(e["path"] for e in doc["fm"].get("sources", []))
        uncovered = [f["path"] for f in scan["files"] if f["path"] not in covered]
        if uncovered:
            sample = ", ".join(uncovered[:10])
            if len(uncovered) > 10:
                sample += ", +{} more".format(len(uncovered) - 10)
            add("L5", "WARN", "docs/atlas/",
                "{} mappable files not covered by any module doc: {}".format(
                    len(uncovered), sample))

    # L11 — ledger/baseline sanity
    ledger_path = os.path.join(root, LEDGER_RELPATH)
    if not os.path.isfile(ledger_path):
        add("L11", "WARN", "docs/atlas/atlas-ledger.json",
            "derived ledger missing — run `ledger finalize`")
    else:
        baseline = ledger_baseline(root)
        if baseline and not git_commit_exists(root, baseline):
            add("L11", "WARN", "docs/atlas/atlas-ledger.json",
                "baseline commit {} not in object database (history "
                "rewritten?) — informational; invalidation uses blob "
                "hashes".format(baseline[:7]))

    return findings


def cmd_lint(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    findings = lint_map(root, fast=args.fast)
    errors = [f for f in findings if f["severity"] == "ERROR"]
    warnings = [f for f in findings if f["severity"] == "WARN"]
    result = {
        "ok": not errors, "fast": args.fast,
        "error_count": len(errors), "warning_count": len(warnings),
        "errors": errors, "warnings": warnings,
    }
    if errors:
        result["error"] = "lint_errors"
        result["message"] = "{} lint error(s) — the map is untrustworthy " \
            "until these are fixed.".format(len(errors))
    emit(result)
    return 0 if not errors else 1


# ─── Glob matching ───────────────────────────────────────────────────────────

def glob_to_regex(pattern):
    """Translate a glob with **, *, ? into an anchored regex on a relpath."""
    i, n = 0, len(pattern)
    out = []
    while i < n:
        c = pattern[i]
        if c == "*":
            if pattern[i:i + 3] == "**/":
                out.append("(?:.*/)?")
                i += 3
            elif pattern[i:i + 2] == "**":
                out.append(".*")
                i += 2
            else:
                out.append("[^/]*")
                i += 1
        elif c == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(c))
            i += 1
    return re.compile("^" + "".join(out) + "$")


class GlobSet:
    """A list of glob patterns; bare patterns (no slash) also match basenames."""

    def __init__(self, patterns):
        self.entries = [
            (glob_to_regex(p), "/" not in p) for p in patterns if p
        ]

    def matches(self, path):
        base = os.path.basename(path)
        for regex, bare in self.entries:
            if regex.match(path):
                return True
            if bare and regex.match(base):
                return True
        return False


# ─── scan ────────────────────────────────────────────────────────────────────

def has_nul_prefix(abspath):
    try:
        with open(abspath, "rb") as f:
            return b"\0" in f.read(SNIFF_BYTES)
    except OSError:
        return True  # unreadable files are not mappable


def do_scan(project_dir, enforce_ceiling=True):
    """Returns a result dict; result["ok"] indicates success."""
    root = git_toplevel(project_dir)
    if root is None:
        return {
            "ok": False, "error": "not_a_git_repo",
            "message": "atlas requires a git repository; "
                       "run from inside a git work tree.",
        }

    config = load_config(root)
    includes = GlobSet(config.get("include") or ["**"])
    excludes = GlobSet(DEFAULT_EXCLUDES + list(config.get("exclude") or []))
    ceiling = config.get("max_files")
    if not isinstance(ceiling, int) or ceiling <= 0:
        ceiling = DEFAULT_MAX_FILES

    files = []
    excluded_count = 0
    total_bytes = 0
    for relpath in git_listed_files(root):
        abspath = os.path.join(root, relpath)
        if not os.path.isfile(abspath):
            continue  # deleted from worktree, submodule gitlink, broken link
        if not includes.matches(relpath) or excludes.matches(relpath):
            excluded_count += 1
            continue
        ext = relpath.rsplit(".", 1)[-1].lower() if "." in os.path.basename(relpath) else ""
        if ext in BINARY_EXTENSIONS:
            excluded_count += 1
            continue
        if has_nul_prefix(abspath):
            excluded_count += 1
            continue
        size = os.path.getsize(abspath)
        files.append({"path": relpath, "bytes": size})
        total_bytes += size

    if enforce_ceiling and len(files) > ceiling:
        return {
            "ok": False, "error": "ceiling_exceeded",
            "message": (
                "Found {} mappable files, above the ceiling of {}. Narrow "
                "include/exclude globs in {} or raise max_files if you really "
                "mean it — full maps this large degrade mapper quality."
                .format(len(files), ceiling, CONFIG_RELPATH)
            ),
            "total_files": len(files), "ceiling": ceiling,
        }

    return {
        "ok": True, "root": root, "files": files,
        "total_files": len(files), "total_bytes": total_bytes,
        "ceiling": ceiling, "excluded_count": excluded_count,
    }


def cmd_scan(args):
    result = do_scan(args.project_dir)
    emit(result)
    return 0 if result["ok"] else 1


# ─── partition ───────────────────────────────────────────────────────────────

def sanitize_id(seed):
    s = seed.replace("/", "-")
    s = re.sub(r"[^A-Za-z0-9._-]+", "-", s)
    s = re.sub(r"-{2,}", "-", s).strip("-.")
    return s or "root"


def deepest_common_dir(paths):
    dirs = [p.rsplit("/", 1)[0] if "/" in p else "" for p in paths]
    if any(d == "" for d in dirs):
        return ""
    split = [d.split("/") for d in dirs]
    prefix = []
    for segments in zip(*split):
        if all(seg == segments[0] for seg in segments):
            prefix.append(segments[0])
        else:
            break
    return "/".join(prefix)


class _DirNode:
    __slots__ = ("dirs", "files")

    def __init__(self):
        self.dirs = {}
        self.files = []  # list of (relpath, bytes)


def build_tree(entries):
    root = _DirNode()
    for entry in entries:
        parts = entry["path"].split("/")
        node = root
        for segment in parts[:-1]:
            node = node.dirs.setdefault(segment, _DirNode())
        node.files.append((entry["path"], entry["bytes"]))
    return root


def collect_files(node):
    out = list(node.files)
    for child in node.dirs.values():
        out.extend(collect_files(child))
    out.sort()
    return out


def make_partition(label, id_seed, strategy, files):
    return {
        "id_seed": id_seed, "label": label, "strategy": strategy,
        "file_entries": files,
    }


def split_bucket(bucket, path, caps):
    """Split an over-cap bucket: stem clusters first, then greedy chunks."""
    base = path or "root"
    out = []
    groups = {}
    leftover = []
    for f in bucket:
        name = os.path.basename(f[0])
        m = re.match(r"^([^-_]+)[-_].", name)
        if m:
            groups.setdefault(m.group(1).lower(), []).append(f)
        else:
            leftover.append(f)
    for stem in sorted(groups):
        g = sorted(groups[stem])
        g_bytes = sum(b for _, b in g)
        if caps["min_files"] <= len(g) <= caps["max_files"] and g_bytes <= caps["max_bytes"]:
            label = "{}/{}*".format(path, stem) if path else "{}*".format(stem)
            out.append(make_partition(label, "{}-{}".format(base, stem), "stem", g))
        else:
            # Under-min or over-cap stem groups fall through to chunking.
            leftover.extend(g)
    leftover.sort()
    chunks = []
    cur, cur_bytes = [], 0
    for f in leftover:
        if cur and (len(cur) >= caps["max_files"] or cur_bytes + f[1] > caps["max_bytes"]):
            chunks.append(cur)
            cur, cur_bytes = [], 0
        cur.append(f)
        cur_bytes += f[1]
    if cur:
        chunks.append(cur)
    for idx, chunk in enumerate(chunks, 1):
        out.append(make_partition(
            "{} (chunk {})".format(base, idx),
            "{}-chunk-{}".format(base, idx), "chunk", chunk,
        ))
    return out


def decide(node, path, caps):
    files_all = collect_files(node)
    if not files_all:
        return []
    agg_bytes = sum(b for _, b in files_all)
    if len(files_all) <= caps["max_files"] and agg_bytes <= caps["max_bytes"]:
        label = deepest_common_dir([p for p, _ in files_all]) or "root"
        return [make_partition(label, label, "dir", files_all)]

    parts = []
    small = []
    for name in sorted(node.dirs):
        child_path = "{}/{}".format(path, name) if path else name
        for p in decide(node.dirs[name], child_path, caps):
            if p["strategy"] == "dir" and len(p["file_entries"]) < caps["min_files"]:
                small.append(p)
            else:
                parts.append(p)

    bucket = sorted(node.files + [f for p in small for f in p["file_entries"]])
    if bucket:
        base = path or "root"
        bucket_bytes = sum(b for _, b in bucket)
        if len(bucket) <= caps["max_files"] and bucket_bytes <= caps["max_bytes"]:
            parts.append(make_partition(
                "{} (misc)".format(base), "{}-misc".format(base),
                "coalesced", bucket,
            ))
        else:
            parts.extend(split_bucket(bucket, path, caps))
    return parts


def apply_overrides(entries, config):
    """Claim files for config `modules:` overrides; first match wins."""
    overrides = config.get("modules")
    claimed_parts = []
    if not isinstance(overrides, list):
        return claimed_parts, entries

    remaining = entries
    for override in overrides:
        if not isinstance(override, dict):
            continue
        name = override.get("name")
        globs = override.get("globs")
        if not name or not isinstance(globs, list):
            continue
        globset = GlobSet([g for g in globs if isinstance(g, str)])
        claimed = [e for e in remaining if globset.matches(e["path"])]
        remaining = [e for e in remaining if not globset.matches(e["path"])]
        if claimed:
            files = sorted((e["path"], e["bytes"]) for e in claimed)
            claimed_parts.append(make_partition(str(name), str(name), "override", files))
    return claimed_parts, remaining


def do_partition(project_dir):
    scan = do_scan(project_dir)
    if not scan["ok"]:
        return scan

    config = load_config(scan["root"])
    caps = partition_caps(config)

    override_parts, remaining = apply_overrides(scan["files"], config)
    tree = build_tree(remaining)
    parts = override_parts + decide(tree, "", caps)

    assigned_ids = set()
    modules = []
    for p in parts:
        base_id = sanitize_id(p["id_seed"])
        candidate = base_id
        suffix = 2
        while candidate in assigned_ids:
            candidate = "{}-{}".format(base_id, suffix)
            suffix += 1
        assigned_ids.add(candidate)
        modules.append({
            "id": candidate,
            "label": p["label"],
            "strategy": p["strategy"],
            "files": len(p["file_entries"]),
            "bytes": sum(b for _, b in p["file_entries"]),
            "paths": [path for path, _ in p["file_entries"]],
        })

    modules.sort(key=lambda m: m["id"])
    return {
        "ok": True, "root": scan["root"], "modules": modules,
        "module_count": len(modules), "unassigned": [],
    }


def cmd_partition(args):
    result = do_partition(args.project_dir)
    emit(result)
    return 0 if result["ok"] else 1


# ─── main ────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="atlas-cli",
        description="Deterministic operations for the atlas plugin.",
    )
    parser.add_argument(
        "--project-dir", default=".",
        help="Project directory (default: current directory)",
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("scan", help="Enumerate mappable files")
    sub.add_parser("partition", help="Partition mappable files into modules")

    ledger = sub.add_parser("ledger", help="Blob-SHA dependency ledger")
    ledger_sub = ledger.add_subparsers(dest="ledger_command")
    finalize = ledger_sub.add_parser(
        "finalize", help="Validate frontmatter and rebuild atlas-ledger.json")
    finalize.add_argument(
        "--refresh-hashes", action="store_true",
        help="Recompute blob/tree hashes from the working tree and rewrite docs")
    finalize.add_argument(
        "--generator", default=None,
        help="Stamp this generator fingerprint into refreshed docs")
    finalize.add_argument(
        "--except", dest="except_docs", action="append", default=[],
        metavar="DOC_ID",
        help="Doc id to leave untouched when refreshing hashes (repeatable); "
             "its recorded blobs stay as-is so it remains flagged stale. "
             "Used by /atlas repair to keep drift docs flagged after a body fix")
    diff = ledger_sub.add_parser(
        "diff", help="Classify map docs against the repo as it exists now")
    diff.add_argument(
        "--generator", default=None,
        help="Flag docs whose generator fingerprint differs from this")
    set_verified = ledger_sub.add_parser(
        "set-verified", help="Stamp a doc's map-verifier verdict")
    set_verified.add_argument("doc_id", help="Doc id, e.g. modules/src-auth.md")
    set_verified.add_argument("value", choices=["true", "false"])

    doc = sub.add_parser("doc", help="Mechanical map-doc mutations")
    doc_sub = doc.add_subparsers(dest="doc_command")
    doc_sub.add_parser(
        "apply-renames",
        help="Rewrite pure-renamed source paths inside map docs (no LLM)")
    doc_remove = doc_sub.add_parser(
        "remove", help="Delete map docs (orphaned or conflict-corrupted)")
    doc_remove.add_argument("doc_ids", nargs="+",
                            help="Doc ids, e.g. modules/src-auth.md")

    diffpack = sub.add_parser(
        "diffpack", help="Write a doc's anchored-regeneration patch file")
    diffpack.add_argument("doc_id", help="Doc id, e.g. modules/src-auth.md")
    diffpack.add_argument("--add", action="append", default=[],
                          help="New source path to note in the pack (repeatable)")

    lock = sub.add_parser("lock", help="Heartbeat lock for map operations")
    lock_sub = lock.add_subparsers(dest="lock_command")
    acquire = lock_sub.add_parser("acquire", help="Acquire the lock")
    acquire.add_argument("--holder", default="atlas")
    acquire.add_argument("--ttl", type=int, default=LOCK_TTL_DEFAULT,
                         help="Seconds without heartbeat before takeover")
    lock_sub.add_parser("heartbeat", help="Refresh the lock heartbeat")
    lock_sub.add_parser("release", help="Release the lock")

    status = sub.add_parser("status", help="Staleness tier for the current map")
    status.add_argument("--for-hook", action="store_true",
                        help="Trimmed output for the SessionStart hook")

    index = sub.add_parser("index", help="Derived INDEX.md operations")
    index_sub = index.add_subparsers(dest="index_command")
    index_sub.add_parser("rebuild",
                         help="Rebuild INDEX.md from doc frontmatter")

    lint = sub.add_parser("lint", help="Mechanical map integrity checks")
    lint.add_argument("--fast", action="store_true",
                      help="Cheap subset only (markers, drift, INDEX checks)")

    ground = sub.add_parser("ground", help="Grounding pack for a mapper agent")
    ground.add_argument("module_id", help="Module id from `partition`")

    extract = sub.add_parser(
        "extract", help="Build/refresh the deterministic Structure Index")
    extract.add_argument("--module", dest="module_id", default=None,
                         help="Restrict reported symbols to one module id")
    extract.add_argument("--backend", choices=["auto", "treesitter", "regex"],
                         default="auto", help="Extraction backend (default: auto)")
    extract.add_argument("--force", action="store_true",
                         help="Rebuild even when the cached index is still valid")

    judge_plan = sub.add_parser(
        "judge-plan",
        help="List the judgment cells the structure needs (missing vs cached)")
    judge_plan.add_argument(
        "--backend", choices=["auto", "treesitter", "regex"], default="auto")

    judgment = sub.add_parser("judgment", help="Judgment Cache operations")
    judgment_sub = judgment.add_subparsers(dest="judgment_command")
    judgment_sub.add_parser(
        "ingest", help="Merge LLM-produced cells (JSON array on stdin)")
    jdiff = judgment_sub.add_parser(
        "diff", help="Classify the judgment delta (missing/orphaned/stale docs)")
    jdiff.add_argument("--backend", choices=["auto", "treesitter", "regex"],
                       default="auto")
    jprune = judgment_sub.add_parser(
        "prune",
        help="Drop cached cells the structure no longer needs (diff's orphaned_keys)")
    jprune.add_argument("--backend", choices=["auto", "treesitter", "regex"],
                        default="auto")
    jverify = judgment_sub.add_parser(
        "verify-set",
        help="Verify the high-consequence prose delta (--plan lists targets; stdin verdicts stamp)")
    jverify.add_argument(
        "--plan", action="store_true",
        help="List in-scope unverified cells for map-verifier (else ingest verdicts on stdin)")
    jverify.add_argument("--backend", choices=["auto", "treesitter", "regex"],
                         default="auto")

    project = sub.add_parser(
        "project", help="Render committed docs by joining structure + judgments")
    project.add_argument(
        "--backend", choices=["auto", "treesitter", "regex"], default="auto")

    sub.add_parser(
        "migrate-v1",
        help="Re-key existing v1 doc prose into the Judgment Cache (one-time)")

    commit = sub.add_parser("commit", help="Guarded pathspec-scoped map commit")
    commit.add_argument("--message", required=True)
    commit.add_argument("--also", action="append", default=[],
                        help="Additional path to include (repeatable)")

    branch = sub.add_parser("branch", help="Isolate map work on an atlas/* branch")
    branch_sub = branch.add_subparsers(dest="branch_command")
    branch_ensure = branch_sub.add_parser(
        "ensure", help="Create/switch to the atlas working branch")
    branch_ensure.add_argument(
        "--op", choices=["map", "update", "repair"], default="map",
        help="Operation naming the branch (atlas/<op>-<sha>)")

    verify_cache = sub.add_parser(
        "verify-cache", help="Persist/read the /atlas verify findings cache")
    vc_sub = verify_cache.add_subparsers(dest="verify_cache_command")
    vc_sub.add_parser(
        "write",
        help="Write .atlas/verify.json from stdin verdicts plus recomputed "
             "lint/diff/fingerprint")
    vc_sub.add_parser(
        "read",
        help="Read .atlas/verify.json and report whether it is still valid")

    sub.add_parser("init", help="Inject the CLAUDE.md block + gitignore entry")
    sub.add_parser("remove", help="Remove the CLAUDE.md block")

    args = parser.parse_args()
    if args.command == "scan":
        return cmd_scan(args)
    if args.command == "partition":
        return cmd_partition(args)
    if args.command == "ledger":
        if args.ledger_command == "finalize":
            return cmd_ledger_finalize(args)
        if args.ledger_command == "diff":
            return cmd_ledger_diff(args)
        if args.ledger_command == "set-verified":
            return cmd_ledger_set_verified(args)
        emit_fail("usage", "Unknown ledger command. "
                  "Available: finalize, diff, set-verified.")
        return 2
    if args.command == "doc":
        if args.doc_command == "apply-renames":
            return cmd_doc_apply_renames(args)
        if args.doc_command == "remove":
            return cmd_doc_remove(args)
        emit_fail("usage", "Unknown doc command. "
                  "Available: apply-renames, remove.")
        return 2
    if args.command == "diffpack":
        return cmd_diffpack(args)
    if args.command == "lock":
        if args.lock_command in ("acquire", "heartbeat", "release"):
            return cmd_lock(args)
        emit_fail("usage", "Unknown lock command. "
                  "Available: acquire, heartbeat, release.")
        return 2
    if args.command == "status":
        return cmd_status(args)
    if args.command == "index":
        if args.index_command == "rebuild":
            return cmd_index_rebuild(args)
        emit_fail("usage", "Unknown index command. Available: rebuild.")
        return 2
    if args.command == "lint":
        return cmd_lint(args)
    if args.command == "ground":
        return cmd_ground(args)
    if args.command == "extract":
        return cmd_extract(args)
    if args.command == "judge-plan":
        return cmd_judge_plan(args)
    if args.command == "judgment":
        if args.judgment_command == "ingest":
            return cmd_judgment_ingest(args)
        if args.judgment_command == "diff":
            return cmd_judgment_diff(args)
        if args.judgment_command == "prune":
            return cmd_judgment_prune(args)
        if args.judgment_command == "verify-set":
            return cmd_judgment_verify_set(args)
        emit_fail("usage",
                  "Unknown judgment command. Available: ingest, diff, prune, verify-set.")
        return 2
    if args.command == "project":
        return cmd_project(args)
    if args.command == "migrate-v1":
        return cmd_migrate_v1(args)
    if args.command == "commit":
        return cmd_commit(args)
    if args.command == "branch":
        if args.branch_command == "ensure":
            return cmd_branch_ensure(args)
        emit_fail("usage", "Unknown branch command. Available: ensure.")
        return 2
    if args.command == "verify-cache":
        if args.verify_cache_command == "write":
            return cmd_verify_cache_write(args)
        if args.verify_cache_command == "read":
            return cmd_verify_cache_read(args)
        emit_fail("usage", "Unknown verify-cache command. "
                  "Available: write, read.")
        return 2
    if args.command == "init":
        return cmd_init(args)
    if args.command == "remove":
        return cmd_remove(args)

    emit_fail("usage", "Unknown or missing subcommand. Available: scan, "
              "partition, ledger, lock, status, index, lint, ground, extract, "
              "judge-plan, judgment, project, commit, branch, verify-cache, "
              "init, remove.")
    return 2


if __name__ == "__main__":
    sys.exit(main())
