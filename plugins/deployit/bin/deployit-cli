#!/usr/bin/env python3
"""deployit CLI — orchestrates archive/export/serve/push.

Subcommands:
  bootstrap          one-time per-machine setup
  deploy             archive and publish a build
  list               show recent builds across the tailnet
  url                print this machine's listing URL
  status             backend health + recent local deploys
  gc                 prune local artifacts; archive in index
  rm                 delete a local build/product (files + index); web-UI delete
"""

import argparse
import datetime as _dt
import json
import re as _re
import shutil as _shutil
import string
import sys
import urllib.request
from pathlib import Path
from urllib.parse import urlparse, quote

import os
import shutil
import subprocess
import time
from textwrap import dedent

__version__ = "0.1.0"

# Same shape the backend enforces on build ids; `rm` re-validates independently.
_BUILD_ID_RE = _re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")


def ok(payload):
    payload["ok"] = True
    print(json.dumps(payload, indent=2))


def fail(message, **extra):
    payload = {"ok": False, "display": message, **extra}
    print(json.dumps(payload, indent=2))
    sys.exit(1)


def not_implemented(name):
    fail(f"{name}: not implemented yet")


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        fail(f"argument error: {message}")


def _state_dir() -> Path:
    """Per-machine state directory. Overridable for tests via DEPLOYIT_STATE_DIR."""
    override = os.environ.get("DEPLOYIT_STATE_DIR")
    if override:
        return Path(override)
    return Path.home() / "Library" / "Application Support" / "deployit"


def _tailscale_bin() -> str:
    return os.environ.get("DEPLOYIT_TAILSCALE_BIN", "tailscale")


def _derive_base_url() -> str:
    """Build the listing base URL from `tailscale status --json`."""
    try:
        res = subprocess.run(
            [_tailscale_bin(), "status", "--json"],
            capture_output=True, text=True, check=True, timeout=5,
        )
    except FileNotFoundError:
        fail(f"tailscale binary not found at {_tailscale_bin()!r} — install Tailscale or set DEPLOYIT_TAILSCALE_BIN")
    except subprocess.CalledProcessError as exc:
        fail(f"tailscale status failed: {exc.stderr.strip() or exc}")
    except subprocess.TimeoutExpired:
        fail("tailscale status timed out after 5s — is the daemon running?")
    try:
        data = json.loads(res.stdout)
        dns = data["Self"]["DNSName"].rstrip(".")
    except (json.JSONDecodeError, KeyError) as exc:
        fail(f"could not parse tailscale status output: {exc}")
    return f"https://{dns}/deployit"


def _write_config(state: Path, plugin_root: Path, base_url: str) -> Path:
    """Write config.toml on first run; preserve user edits on re-run."""
    cfg = state / "config.toml"
    if cfg.exists():
        return cfg
    template = (plugin_root / "assets" / "config.example.toml").read_text()
    template = template.replace(
        'base_url = "https://<host>.<tailnet>.ts.net/deployit"',
        f'base_url = "{base_url}"',
    )
    cfg.write_text(template)
    return cfg


def _ensure_dirs(state: Path):
    for sub in ("serve", "index", "logs", "bin"):
        (state / sub).mkdir(parents=True, exist_ok=True)


def _atomic_symlink(target: Path, link: Path):
    """Atomically point `link` at `target` via tmpfile + os.replace, so a
    concurrent reader never sees a missing or half-formed symlink."""
    link.parent.mkdir(parents=True, exist_ok=True)
    tmp = link.with_name(link.name + ".tmp")
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    tmp.symlink_to(target)
    os.replace(tmp, link)


def _sync_plugin_root(state: Path, plugin_root: Path):
    """Point the daemon's stable indirection symlinks at `plugin_root`:
      <state>/_plugin_root              → <plugin_root>
      <state>/bin/deployit-backend      → <plugin_root>/bin/deployit-backend

    The launchd plist references these stable paths, so plugin upgrades only
    need to move the symlinks — never regenerate the plist."""
    plugin_root = plugin_root.resolve()
    backend = plugin_root / "bin" / "deployit-backend"
    if not backend.is_file():
        fail(f"plugin_root has no bin/deployit-backend: {plugin_root}")
    _atomic_symlink(plugin_root, state / "_plugin_root")
    _atomic_symlink(backend, state / "bin" / "deployit-backend")


def _clone_index(state: Path):
    """Clone the shared index repo. Skipped in tests via DEPLOYIT_SKIP_INDEX_CLONE."""
    if os.environ.get("DEPLOYIT_SKIP_INDEX_CLONE"):
        (state / "index" / "builds.json").write_text(
            json.dumps({"version": 1, "builds": []}))
        return
    index_dir = state / "index"
    if (index_dir / ".git").is_dir():
        return
    # Re-clone fresh; the placeholder builds.json from _ensure_dirs is overwritten.
    shutil.rmtree(index_dir)
    subprocess.run(
        ["git", "clone", "https://github.com/mikeydotio/deployit-index.git", str(index_dir)],
        check=True, timeout=30,
    )


def _configure_tailscale_serve(port: int):
    """Front the local backend with HTTPS via Tailscale Serve. Idempotent."""
    if os.environ.get("DEPLOYIT_SKIP_TAILSCALE_SERVE"):
        return
    subprocess.run(
        [_tailscale_bin(), "serve", "--bg", str(port)],
        check=False, timeout=10,
    )


def _launchd_plist(state: Path, port: int) -> str:
    """Generate a launchd plist that references STABLE symlinks under <state>.

    The plist is immutable across plugin upgrades — only `_sync_plugin_root`'s
    symlinks move. This prevents the daemon from getting pinned to a stale
    content-addressed plugin cache directory."""
    return dedent(f"""\
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
          <key>Label</key><string>com.mikeydotio.deployit.backend</string>
          <key>ProgramArguments</key>
          <array>
            <string>/usr/bin/env</string>
            <string>python3</string>
            <string>{state}/bin/deployit-backend</string>
            <string>--port</string><string>{port}</string>
            <string>--root</string><string>{state}</string>
            <string>--plugin-root</string><string>{state}/_plugin_root</string>
          </array>
          <key>RunAtLoad</key><true/>
          <key>KeepAlive</key><true/>
          <key>StandardOutPath</key><string>{state}/logs/backend.log</string>
          <key>StandardErrorPath</key><string>{state}/logs/backend.err.log</string>
        </dict>
        </plist>
        """)


def _install_launchd(state: Path, port: int) -> dict:
    """Write and load the launchd agent. Skipped in tests via DEPLOYIT_SKIP_LAUNCHD."""
    if os.environ.get("DEPLOYIT_SKIP_LAUNCHD"):
        return {"loaded": False, "skipped": True}
    plist_dir = Path.home() / "Library" / "LaunchAgents"
    plist_dir.mkdir(parents=True, exist_ok=True)
    plist_path = plist_dir / "com.mikeydotio.deployit.backend.plist"
    plist_path.write_text(_launchd_plist(state, port))
    launchctl = os.environ.get("DEPLOYIT_LAUNCHCTL_BIN", "launchctl")
    subprocess.run([launchctl, "bootout", f"gui/{os.getuid()}/com.mikeydotio.deployit.backend"],
                   check=False)
    res = subprocess.run([launchctl, "bootstrap", f"gui/{os.getuid()}", str(plist_path)],
                         capture_output=True, text=True, check=False)
    return {
        "loaded": res.returncode == 0,
        "skipped": False,
        "launchctl_stderr": res.stderr.strip() if res.returncode != 0 else None,
    }


_PLATFORM_SUFFIX = {"ios": "iOS", "macos": "macOS", "visionos": "visionOS"}


def _find_workspace(cwd: Path):
    for p in cwd.glob("*.xcworkspace"):
        return p
    return None


def _find_xcodeproj(cwd: Path):
    for p in cwd.glob("*.xcodeproj"):
        return p
    return None


def _find_apps_project_yml(cwd: Path, platform: str):
    """Return the first project.yml under Apps/ whose name suggests the platform.
    Falls back to any Apps/*/project.yml."""
    suffix = _PLATFORM_SUFFIX[platform]
    candidates = sorted(cwd.glob(f"Apps/*-{suffix}/project.yml")) \
              or sorted(cwd.glob("Apps/*/project.yml"))
    return candidates[0] if candidates else None


def _read_yaml_scalar(text: str, key: str):
    """Return the first occurrence of `key: value` in `text`, accepting either a
    double-quoted value (`KEY: "v"`) or a bare scalar (`KEY: v`). Returns None
    if the key is not present."""
    m = _re.search(rf'\b{_re.escape(key)}\s*:\s*(?:"([^"\n]+)"|(\S+))', text)
    if not m:
        return None
    return m.group(1) if m.group(1) is not None else m.group(2)


def _read_marketing_version(project_yml: Path) -> str:
    v = _read_yaml_scalar(project_yml.read_text(), "MARKETING_VERSION")
    if v is None:
        fail(f"Could not parse MARKETING_VERSION from {project_yml}")
    return v


def _read_bundle_id(project_yml: Path) -> str:
    v = _read_yaml_scalar(project_yml.read_text(), "PRODUCT_BUNDLE_IDENTIFIER")
    if v is None:
        fail(f"Could not parse PRODUCT_BUNDLE_IDENTIFIER from {project_yml}")
    return v


def _short_sha(cwd: Path) -> str:
    try:
        res = subprocess.run(
            ["git", "-C", str(cwd), "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True, check=True, timeout=5,
        )
    except FileNotFoundError:
        fail("git binary not found on PATH")
    except subprocess.CalledProcessError as exc:
        fail(f"git rev-parse failed (not a git repo or no commits?): {exc.stderr.strip() or exc}")
    except subprocess.TimeoutExpired:
        fail("git rev-parse timed out")
    return res.stdout.strip()


def _derive_metadata(cwd: Path, platform: str) -> dict:
    """Detect the Xcode project + spec layout. Supports two shapes:

    Apps-layout (Lillist):   ./Foo.xcworkspace + ./Apps/Foo-<Platform>/project.yml
                             default scheme = "<Project>-<Platform>"

    Single-app layout:       ./Foo.xcodeproj   + ./project.yml
                             default scheme = "<project>" (the .xcodeproj stem)

    Apps-layout takes precedence when both signals are present, so existing
    consumers keep working unchanged.
    """
    workspace      = _find_workspace(cwd)
    apps_yml       = _find_apps_project_yml(cwd, platform)
    xcodeproj      = _find_xcodeproj(cwd)
    root_yml       = cwd / "project.yml"
    suffix         = _PLATFORM_SUFFIX[platform]

    if workspace is not None and apps_yml is not None:
        project_name   = workspace.stem
        container_flag = "-workspace"
        container_path = str(workspace)
        project_yml    = apps_yml
        default_scheme = f"{project_name}-{suffix}"
    elif xcodeproj is not None and root_yml.is_file():
        project_name   = xcodeproj.stem
        container_flag = "-project"
        container_path = str(xcodeproj)
        project_yml    = root_yml
        default_scheme = project_name
    else:
        fail(
            "no recognised Xcode project layout in cwd. "
            "deployit looks for one of:\n"
            "  • <Name>.xcworkspace + Apps/<Name>-{Platform}/project.yml (monorepo)\n"
            "  • <Name>.xcodeproj  + ./project.yml                       (single-app)\n"
            f"cwd: {cwd}"
        )

    return {
        "project": project_name,
        "platform": platform,
        "bundle_id": _read_bundle_id(project_yml),
        "marketing_version": _read_marketing_version(project_yml),
        "commit": _short_sha(cwd),
        "project_yml": str(project_yml),
        "xcode_container_flag": container_flag,
        "xcode_container_path": container_path,
        "default_scheme": default_scheme,
    }


def _parse_semver_config(cwd: Path):
    """Parse <cwd>/.semver/config.yaml into a flat dict, or None if absent.

    The file is flat `key: value` YAML (no nesting); mirror semver's own
    line-split + quote-strip parser rather than take a dependency on the
    semver plugin or a YAML library."""
    cfg = cwd / ".semver" / "config.yaml"
    if not cfg.is_file():
        return None
    out = {}
    for line in cfg.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, _, val = line.partition(":")
        out[key.strip()] = val.strip().strip('"').strip("'")
    return out


def _semver_active_version(cwd: Path):
    """Return the semver VERSION string iff semver is *active* for the project
    rooted at `cwd` — `.semver/config.yaml` exists with `tracking: true` and a
    readable VERSION file. Otherwise None.

    deployit reads semver's on-disk artifacts directly (no code dependency on
    the semver plugin). cwd is the project root, matching `_derive_metadata`
    and `semver-cli`'s own cwd-relative behaviour."""
    config = _parse_semver_config(cwd)
    if not config or config.get("tracking") != "true":
        return None
    version_file = cwd / "VERSION"
    if not version_file.is_file():
        return None
    return version_file.read_text().strip() or None


def _semver_prefix(cwd: Path) -> str:
    """Return the configured semver `version_prefix` (e.g. 'v'), default ''."""
    config = _parse_semver_config(cwd)
    return config.get("version_prefix", "") if config else ""


def _next_versions(version: str, prefix: str):
    """Compute {major, minor, patch} successors of a semver string, prefix-aware,
    or None if unparseable. e.g. 'v2.16.1' →
    {'major':'v3.0.0','minor':'v2.17.0','patch':'v2.16.2'}. Universal SemVer
    arithmetic used only to label the bump question — the bump itself is done
    by semver-cli."""
    bare = version[len(prefix):] if prefix and version.startswith(prefix) else version
    m = _re.match(r"^(\d+)\.(\d+)\.(\d+)$", bare)
    if not m:
        return None
    major, minor, patch = int(m.group(1)), int(m.group(2)), int(m.group(3))
    return {
        "major": f"{prefix}{major + 1}.0.0",
        "minor": f"{prefix}{major}.{minor + 1}.0",
        "patch": f"{prefix}{major}.{minor}.{patch + 1}",
    }


def _find_semver_cli(plugin_root: Path):
    """Locate the semver plugin's CLI so a deploy can drive a version bump.
    Order: $DEPLOYIT_SEMVER_CLI → sibling plugin in the same marketplace →
    a glob under ~/.claude. Returns a Path or None."""
    env = os.environ.get("DEPLOYIT_SEMVER_CLI")
    if env:
        p = Path(env)
        return p if p.is_file() else None
    sibling = plugin_root.parent / "semver" / "bin" / "semver-cli"
    if sibling.is_file():
        return sibling
    base = Path.home() / ".claude"
    if base.is_dir():
        for cand in base.glob("**/semver/bin/semver-cli"):
            if cand.is_file():
                return cand
    return None


def _current_branch(cwd: Path):
    """Current git branch name, or None if it cannot be determined."""
    try:
        res = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--abbrev-ref", "HEAD"],
                             capture_output=True, text=True, timeout=5)
        return res.stdout.strip() if res.returncode == 0 else None
    except Exception:
        return None


def _is_dirty(cwd: Path) -> bool:
    """True if the working tree has uncommitted changes."""
    try:
        res = subprocess.run(["git", "-C", str(cwd), "status", "--porcelain"],
                             capture_output=True, text=True, timeout=5)
        return bool(res.stdout.strip())
    except Exception:
        return False


def _pull_index(state: Path):
    """Best-effort refresh of the shared index before a read. Never fatal;
    skippable via DEPLOYIT_SKIP_INDEX_PULL (e.g. remote-less test indexes)."""
    if os.environ.get("DEPLOYIT_SKIP_INDEX_PULL"):
        return
    try:
        subprocess.run(["git", "-C", str(state / "index"), "pull", "--rebase", "--quiet"],
                       check=False, timeout=15)
    except Exception:
        pass


def _latest_build_for(builds, bundle_id: str, platform: str):
    """Newest build entry matching (bundle_id, platform), or None. builds.json is
    newest-first, so the first match is the newest."""
    for b in builds:
        if b.get("bundle_id") == bundle_id and b.get("platform") == platform:
            return b
    return None


def _read_config(state: Path) -> dict:
    """Parse the bits we need out of config.toml. Use tomllib when available
    (Python 3.11+), fall back to regex on older Pythons. macOS 26 ships 3.13."""
    try:
        import tomllib
        return tomllib.loads((state / "config.toml").read_text())
    except ModuleNotFoundError:
        text = (state / "config.toml").read_text()
        port_m = _re.search(r'port\s*=\s*(\d+)', text)
        base_m = _re.search(r'base_url\s*=\s*"([^"]+)"', text)
        if port_m is None or base_m is None:
            fail("config.toml missing required server.port or server.base_url")
        notarize = bool(_re.search(r'notarize\s*=\s*true', text))
        notary_profile_m = _re.search(r'notary_profile\s*=\s*"([^"]+)"', text)
        # [macos.sparkle] — `enabled = true` must sit inside that section (match
        # up to the next table header); the path keys are unique so a global
        # search is unambiguous.
        sp_enabled = bool(_re.search(r'\[macos\.sparkle\][^\[]*?enabled\s*=\s*true', text))

        def _sp(key):
            m = _re.search(rf'{key}\s*=\s*"([^"]*)"', text)
            return m.group(1) if m else ""

        return {
            "server": {"port": int(port_m.group(1)), "base_url": base_m.group(1)},
            "macos":  {"notarize": notarize,
                       "notary_profile": notary_profile_m.group(1) if notary_profile_m else "",
                       "sparkle": {
                           "enabled": sp_enabled,
                           "sign_update_path": _sp("sign_update_path"),
                           "private_key_path": _sp("private_key_path"),
                           "public_ed_key": _sp("public_ed_key"),
                       }},
        }


def _build_id(project: str, platform: str, commit: str) -> str:
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    return f"{project.lower()}-{platform}-{stamp}-{commit}"


def _destination_for(platform: str) -> str:
    return {
        "ios":      "generic/platform=iOS",
        "visionos": "generic/platform=visionOS",
        "macos":    "generic/platform=macOS",
    }[platform]


def _xcodebuild_archive(meta: dict, archive_path: Path, scheme):
    cmd = [
        "xcodebuild",
        meta["xcode_container_flag"], meta["xcode_container_path"],
        "-scheme", scheme or meta["default_scheme"],
        "-configuration", "Debug",
        "-destination", _destination_for(meta["platform"]),
        "-archivePath", str(archive_path),
        "-allowProvisioningUpdates",
        "archive",
    ]
    res = subprocess.run(cmd)
    if res.returncode != 0:
        fail("xcodebuild archive failed — see Xcode output above; "
             "common causes in references/troubleshooting.md")


def _read_archive_build_number(archive_path: Path, project: str) -> str:
    app = archive_path / "Products" / "Applications" / f"{project}.app"
    # iOS/visionOS place Info.plist at the app-bundle root; macOS nests it under
    # Contents/. Check both so every platform's archive resolves.
    candidates = [app / "Info.plist", app / "Contents" / "Info.plist"]
    plist = next((p for p in candidates if p.is_file()), None)
    if plist is None:
        fail(f"built Info.plist not found at {candidates[0]} or {candidates[1]}")
    res = subprocess.run(
        ["/usr/libexec/PlistBuddy", "-c", "Print :CFBundleVersion", str(plist)],
        capture_output=True, text=True, check=True,
    )
    return res.stdout.strip()


def _xcodebuild_export(archive_path: Path, export_dir: Path, plugin_root: Path, platform: str):
    # Prefer an explicit override or a project-local
    # .deployit/ExportOptions.<platform>.plist before the bundled default,
    # so projects that need custom export options (e.g. manual signing for
    # headless/CI deploys) can supply their own without editing the plugin.
    _env_eo = os.environ.get("DEPLOYIT_EXPORT_OPTIONS_PATH")
    _local_eo = Path.cwd() / ".deployit" / f"ExportOptions.{platform}.plist"
    if _env_eo and Path(_env_eo).is_file():
        options = Path(_env_eo)
    elif _local_eo.is_file():
        options = _local_eo
    else:
        options = plugin_root / "assets" / f"ExportOptions.{platform}.plist"
    if not options.is_file():
        fail(f"missing export options plist: {options}")
    cmd = [
        "xcodebuild", "-exportArchive",
        "-archivePath", str(archive_path),
        "-exportOptionsPlist", str(options),
        "-exportPath", str(export_dir),
        "-allowProvisioningUpdates",
    ]
    res = subprocess.run(cmd)
    if res.returncode != 0:
        fail("xcodebuild -exportArchive failed — see Xcode output above")


def _stage_ios_or_visionos(state: Path, plugin_root: Path,
                           build_id: str, ipa_src: Path, meta_full: dict):
    """Move the IPA into serve/<build_id>/, render manifest.plist and _meta.json.
    Returns (artifact_name, ipa_url, manifest_url)."""
    dst = state / "serve" / build_id
    if dst.exists():
        _shutil.rmtree(dst)
    dst.mkdir(parents=True)

    artifact_name = ipa_src.name
    _shutil.move(str(ipa_src), dst / artifact_name)

    ipa_url      = f"{meta_full['origin_base_url']}/{build_id}/{artifact_name}"
    manifest_url = f"{meta_full['origin_base_url']}/{build_id}/manifest.plist"

    manifest_tmpl = string.Template(
        (plugin_root / "assets" / "manifest.template.plist").read_text())
    (dst / "manifest.plist").write_text(manifest_tmpl.substitute(
        IPA_URL=ipa_url,
        BUNDLE_ID=meta_full["bundle_id"],
        BUNDLE_VERSION=meta_full["marketing_version"],
        TITLE=meta_full["project"],
    ))

    (dst / "_meta.json").write_text(json.dumps({
        **{k: meta_full[k] for k in (
            "id", "platform", "project", "bundle_id",
            "marketing_version", "semver_version", "build_number", "commit",
            "timestamp", "origin_host", "origin_base_url",
        )},
        "install": {
            "kind": "itms-services",
            "manifest_url": manifest_url,
            "ipa_url": ipa_url,
        },
        "primary_artifact": artifact_name,
    }, indent=2))

    return artifact_name, ipa_url, manifest_url


def _find_sparkle_sign_update(plugin_root: Path, sparkle_cfg: dict):
    """Locate Sparkle's `sign_update`. Resolution mirrors _xcodebuild_export's
    ExportOptions ladder: env override -> config path -> PATH -> common SPM /
    Homebrew locations. Returns a Path, or None when nothing is found."""
    env = os.environ.get("DEPLOYIT_SPARKLE_SIGN_UPDATE")
    if env and Path(env).is_file():
        return Path(env)
    cfg_path = sparkle_cfg.get("sign_update_path") or ""
    if cfg_path and Path(cfg_path).is_file():
        return Path(cfg_path)
    on_path = _shutil.which("sign_update")
    if on_path:
        return Path(on_path)
    import glob as _glob
    home = str(Path.home())
    patterns = [
        "/opt/homebrew/Caskroom/sparkle/*/bin/sign_update",
        "/usr/local/Caskroom/sparkle/*/bin/sign_update",
        home + "/Library/Developer/Xcode/DerivedData/*/SourcePackages/"
        "artifacts/*/Sparkle/bin/sign_update",
    ]
    for pattern in patterns:
        for hit in sorted(_glob.glob(pattern)):
            if Path(hit).is_file():
                return Path(hit)
    return None


def _sparkle_sign(plugin_root: Path, zip_path: Path, sparkle_cfg: dict):
    """Return the base64 EdDSA signature for zip_path, or None when signing
    can't proceed. Best-effort: a missing tool / key / parse failure only warns,
    so the deploy still ships the .dmg. DEPLOYIT_SKIP_SPARKLE_SIGN stubs a
    deterministic signature for tests (no real Sparkle toolchain needed)."""
    if os.environ.get("DEPLOYIT_SKIP_SPARKLE_SIGN"):
        return "TEST-ED-SIGNATURE-DO-NOT-SHIP=="
    tool = _find_sparkle_sign_update(plugin_root, sparkle_cfg)
    if tool is None:
        sys.stderr.write(
            "deployit: [macos.sparkle] enabled but `sign_update` not found; "
            "skipping Sparkle for this build (see references/sparkle.md)\n")
        return None
    cmd = [str(tool), str(zip_path)]
    key_path = sparkle_cfg.get("private_key_path") or ""
    if key_path:
        cmd += ["--ed-key-file", key_path]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        sys.stderr.write(
            "deployit: sign_update failed; skipping Sparkle for this build: "
            f"{res.stderr.strip() or res.stdout.strip()}\n")
        return None
    # sign_update prints e.g.: sparkle:edSignature="BASE64==" length="12345"
    m = _re.search(r'edSignature="([^"]+)"', res.stdout)
    if not m:
        sys.stderr.write(
            f"deployit: could not parse sign_update output ({res.stdout.strip()!r}); "
            "skipping Sparkle\n")
        return None
    return m.group(1)


def _stage_sparkle_zip(plugin_root: Path, dst: Path, build_id: str,
                       app_path: Path, meta_full: dict, sparkle_cfg: dict):
    """Zip the exported .app and EdDSA-sign it for Sparkle. Returns the sparkle
    metadata dict, or None if signing was skipped (no tool/key) — in which case
    the unsigned zip is discarded, since Sparkle requires a signature. Must run
    while the .app still exists (before _stage_macos removes it)."""
    zip_name = f"{meta_full['project']}.zip"
    zip_path = dst / zip_name
    # ditto preserves the bundle symlinks and resource forks a plain `zip` would
    # corrupt; --keepParent keeps the .app directory itself inside the archive.
    res = subprocess.run(
        ["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent",
         str(app_path), str(zip_path)],
        capture_output=True, text=True)
    if res.returncode != 0:
        fail(f"ditto zip for Sparkle failed: {res.stderr.strip() or res.stdout.strip()}")
    signature = _sparkle_sign(plugin_root, zip_path, sparkle_cfg)
    if signature is None:
        zip_path.unlink(missing_ok=True)
        return None
    return {
        "zip_artifact": zip_name,
        "zip_url": f"{meta_full['origin_base_url']}/{build_id}/{zip_name}",
        "zip_length": zip_path.stat().st_size,
        "ed_signature": signature,
        "short_version": meta_full["marketing_version"],
        "version": meta_full["build_number"],
        # Travels in the index so any backend can surface it on the product page
        # for copy-paste into the app's Info.plist SUPublicEDKey.
        "public_ed_key": sparkle_cfg.get("public_ed_key", ""),
    }


def _stage_macos(state: Path, plugin_root: Path, build_id: str,
                 app_src: Path, meta_full: dict, notarize: bool,
                 notary_profile: str, sparkle_cfg: dict = None):
    """Wrap the exported .app in a .dmg, optionally notarize + staple, and (when
    [macos.sparkle] is enabled) also produce an EdDSA-signed .zip for Sparkle
    auto-update. Writes _meta.json. Returns (dmg_name, dmg_url)."""
    sparkle_cfg = sparkle_cfg or {}
    dst = state / "serve" / build_id
    if dst.exists():
        _shutil.rmtree(dst)
    dst.mkdir(parents=True)

    dmg_name = f"{meta_full['project']}.dmg"
    dmg_path = dst / dmg_name

    staging_app = dst / app_src.name
    _shutil.move(str(app_src), staging_app)

    res = subprocess.run([
        "hdiutil", "create",
        "-srcfolder", str(staging_app),
        "-volname", meta_full["project"],
        "-format", "UDZO",
        "-ov",
        str(dmg_path),
    ], capture_output=True, text=True)
    if res.returncode != 0:
        fail(f"hdiutil create failed: {res.stderr.strip() or res.stdout.strip()}")

    # Sparkle (opt-in): zip + EdDSA-sign the .app before it's removed below.
    sparkle_meta = None
    if sparkle_cfg.get("enabled"):
        sparkle_meta = _stage_sparkle_zip(plugin_root, dst, build_id, staging_app,
                                          meta_full, sparkle_cfg)

    _shutil.rmtree(staging_app)

    if notarize:
        if not notary_profile:
            fail("macos.notarize=true but macos.notary_profile is empty in config.toml")
        notary = subprocess.run([
            "xcrun", "notarytool", "submit", str(dmg_path),
            "--keychain-profile", notary_profile,
            "--wait",
        ], capture_output=True, text=True)
        if notary.returncode != 0:
            fail(f"notarytool submit failed: {notary.stderr.strip() or notary.stdout.strip()}")
        staple = subprocess.run(["xcrun", "stapler", "staple", str(dmg_path)],
                                capture_output=True, text=True)
        if staple.returncode != 0:
            fail(f"stapler staple failed: {staple.stderr.strip() or staple.stdout.strip()}")

    dmg_url = f"{meta_full['origin_base_url']}/{build_id}/{dmg_name}"
    meta = {
        **{k: meta_full[k] for k in (
            "id", "platform", "project", "bundle_id",
            "marketing_version", "semver_version", "build_number", "commit",
            "timestamp", "origin_host", "origin_base_url",
        )},
        "install": {"kind": "direct-download", "dmg_url": dmg_url},
        "primary_artifact": dmg_name,
    }
    if sparkle_meta:
        meta["sparkle"] = sparkle_meta
    (dst / "_meta.json").write_text(json.dumps(meta, indent=2))
    return dmg_name, dmg_url


PRUNE_KEEP_PER_PRODUCT = 10


def _prune_old_builds(state: Path, data: dict, new_entry: dict) -> int:
    """Hard-delete this machine's older builds of the same (bundle_id, platform).

    Mutates `data["builds"]` in place. Removes the entry from the index AND
    deletes serve/<id>/ from disk. Returns the number of pruned entries.

    Only touches builds matching the new entry's `origin_base_url` — other
    machines manage their own pruning.
    """
    origin = new_entry["origin_base_url"]
    bundle = new_entry["bundle_id"]
    platform = new_entry["platform"]
    same_product = [b for b in data["builds"]
                    if b.get("origin_base_url") == origin
                    and b.get("bundle_id") == bundle
                    and b.get("platform") == platform]
    same_product.sort(key=lambda b: b["timestamp"], reverse=True)
    to_drop = same_product[PRUNE_KEEP_PER_PRODUCT:]
    if not to_drop:
        return 0
    drop_ids = {b["id"] for b in to_drop}
    data["builds"] = [b for b in data["builds"] if b["id"] not in drop_ids]
    for b in to_drop:
        _shutil.rmtree(state / "serve" / b["id"], ignore_errors=True)
    return len(to_drop)


def _append_to_index(state: Path, entry: dict, attempts: int = 3):
    """Pull, prepend entry to builds.json (newest first), prune this product's
    older builds beyond PRUNE_KEEP_PER_PRODUCT on this origin, commit, push.
    Retry up to `attempts` times on push conflict; on final failure, raise via fail()."""
    index_dir = state / "index"
    builds_path = index_dir / "builds.json"

    last_stderr = ""
    for attempt in range(1, attempts + 1):
        subprocess.run(["git", "-C", str(index_dir), "pull", "--rebase", "--quiet"],
                       check=True, timeout=30)
        data = json.loads(builds_path.read_text())
        data["builds"].insert(0, entry)
        pruned = _prune_old_builds(state, data, entry)
        builds_path.write_text(json.dumps(data, indent=2) + "\n")

        suffix = f" [pruned {pruned}]" if pruned else ""
        msg = (f"feat(deploy): {entry['project']} {entry['platform']} "
               f"{entry['marketing_version']} (build {entry['build_number']}) "
               f"from {entry['origin_host']}{suffix}")
        subprocess.run(["git", "-C", str(index_dir), "add", "builds.json"], check=True)
        subprocess.run(["git", "-C", str(index_dir), "commit", "-m", msg], check=True)
        try:
            push = subprocess.run(
                ["git", "-c", "url.https://github.com/.insteadOf=git@github.com:",
                 "-C", str(index_dir), "push", "origin", "main"],
                capture_output=True, text=True, timeout=60,
            )
        except subprocess.TimeoutExpired:
            last_stderr = "git push timed out after 60s"
            subprocess.run(["git", "-C", str(index_dir), "reset", "--hard", "origin/main"],
                           check=True)
            continue
        if push.returncode == 0:
            return
        last_stderr = push.stderr.strip()
        subprocess.run(["git", "-C", str(index_dir), "reset", "--hard", "origin/main"],
                       check=True)

    fail("push to deployit-index failed after retries; local artifacts retained",
         stderr=last_stderr)


def _commit_and_push_index(state: Path, mutate, *, attempts: int = 3):
    """Apply a mutation to index/builds.json and push it, robustly.

    `mutate(data)` edits the parsed index in place and returns a commit message,
    or None to abort with no change. Loops up to `attempts` times: pull --rebase,
    re-read, mutate, write, commit, push; on a push conflict it resets --hard to
    origin/main and retries, so a concurrent deploy never clobbers us. Honors
    DEPLOYIT_SKIP_GC_PUSH (write + return locally, touch no git remote) for tests
    and offline runs. Returns the commit message, or None if the mutation
    aborted; raises via fail() if every push attempt fails.

    Shared by cmd_gc and cmd_rm. The high-frequency deploy path keeps its own
    prune-in-loop variant (`_append_to_index`)."""
    index_dir = state / "index"
    builds_path = index_dir / "builds.json"

    if os.environ.get("DEPLOYIT_SKIP_GC_PUSH"):
        data = json.loads(builds_path.read_text())
        msg = mutate(data)
        if msg is None:
            return None
        builds_path.write_text(json.dumps(data, indent=2) + "\n")
        return msg

    def _git(*args, timeout=30):
        # capture_output keeps git chatter (commit summaries, "HEAD is now at…")
        # off our stdout, which must stay a single JSON object for callers such
        # as the backend that parse it programmatically.
        return subprocess.run(["git", "-C", str(index_dir), *args],
                              check=True, capture_output=True, text=True, timeout=timeout)

    last_stderr = ""
    for _ in range(attempts):
        _git("pull", "--rebase", "--quiet")
        data = json.loads(builds_path.read_text())
        msg = mutate(data)
        if msg is None:
            return None
        builds_path.write_text(json.dumps(data, indent=2) + "\n")
        _git("add", "builds.json")
        _git("commit", "-m", msg)
        try:
            push = subprocess.run(
                ["git", "-c", "url.https://github.com/.insteadOf=git@github.com:",
                 "-C", str(index_dir), "push", "origin", "main"],
                capture_output=True, text=True, timeout=60,
            )
        except subprocess.TimeoutExpired:
            last_stderr = "git push timed out after 60s"
            _git("reset", "--hard", "origin/main")
            continue
        if push.returncode == 0:
            return msg
        last_stderr = push.stderr.strip()
        _git("reset", "--hard", "origin/main")

    fail("push to deployit-index failed after retries", stderr=last_stderr)


def _refresh_local_backend(port: int):
    try:
        req = urllib.request.Request(
            f"http://127.0.0.1:{port}/deployit/_internal/refresh", method="POST")
        urllib.request.urlopen(req, timeout=3).read()
    except Exception as exc:
        sys.stderr.write(f"warning: local backend refresh failed: {exc}\n")


def cmd_bootstrap(args):
    args.plugin_root = args.plugin_root.resolve()
    state = _state_dir()
    state.mkdir(parents=True, exist_ok=True)
    _ensure_dirs(state)
    _sync_plugin_root(state, args.plugin_root)
    base_url = _derive_base_url()
    cfg_path = _write_config(state, args.plugin_root, base_url)
    _clone_index(state)
    _configure_tailscale_serve(8729)
    launchd_status = _install_launchd(state, 8729)
    display = f"deployit bootstrapped. Bookmark on iPhone: {base_url}/"
    if not launchd_status["skipped"] and not launchd_status["loaded"]:
        display += f"\nWARNING: launchctl bootstrap failed: {launchd_status['launchctl_stderr']}"
    ok({
        "display": display,
        "state_dir": str(state),
        "config_path": str(cfg_path),
        "base_url": base_url,
        "launchd": launchd_status,
    })


def cmd_deploy(args):
    if not args.platform:
        fail("--platform required (one of ios | macos | visionos)")
    cwd = Path.cwd()
    meta = _derive_metadata(cwd, args.platform)
    if getattr(args, "dump_metadata", False):
        ok({"display": "metadata", **meta})
        return

    # Semver awareness: when the project tracks its version with the semver
    # plugin, capture that version so the web UI reports it (else build number).
    semver_version = _semver_active_version(cwd)

    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")
    origin_host = urlparse(base_url).netloc

    build_id = _build_id(meta["project"], meta["platform"], meta["commit"])
    timestamp = _dt.datetime.now().astimezone().isoformat(timespec="seconds")

    builds_dir = state / "builds"
    builds_dir.mkdir(exist_ok=True)
    archive_path = builds_dir / f"{build_id}.xcarchive"
    export_dir = builds_dir / f"{build_id}.export"
    if archive_path.exists(): _shutil.rmtree(archive_path)
    if export_dir.exists():   _shutil.rmtree(export_dir)
    export_dir.mkdir(parents=True)

    _xcodebuild_archive(meta, archive_path, args.scheme)
    build_number = _read_archive_build_number(archive_path, meta["project"])
    _xcodebuild_export(archive_path, export_dir, args.plugin_root, args.platform)

    meta_full = {
        **meta,
        "id": build_id,
        "build_number": build_number,
        "semver_version": semver_version,
        "timestamp": timestamp,
        "origin_host": origin_host,
        "origin_base_url": base_url,
    }

    if args.platform in ("ios", "visionos"):
        ipa = next(export_dir.glob("*.ipa"), None)
        if ipa is None:
            fail("export produced no .ipa")
        _stage_ios_or_visionos(state, args.plugin_root, build_id, ipa, meta_full)
    elif args.platform == "macos":
        app = next(export_dir.glob("*.app"), None)
        if app is None:
            fail("export produced no .app")
        notarize = cfg["macos"]["notarize"]
        notary_profile = cfg["macos"].get("notary_profile", "")
        sparkle_cfg = cfg.get("macos", {}).get("sparkle", {})
        _stage_macos(state, args.plugin_root, build_id, app, meta_full,
                     notarize, notary_profile, sparkle_cfg)
    else:
        fail(f"unsupported platform: {args.platform}")

    _shutil.rmtree(archive_path, ignore_errors=True)
    _shutil.rmtree(export_dir, ignore_errors=True)

    entry = json.loads((state / "serve" / build_id / "_meta.json").read_text())
    primary = entry.pop("primary_artifact")
    artifact_path = state / "serve" / build_id / primary
    entry["size_bytes"] = artifact_path.stat().st_size
    entry["archived"] = False
    entry["notes"] = None

    _append_to_index(state, entry)
    _refresh_local_backend(cfg["server"]["port"])

    install_url = f"{base_url}/{build_id}/"
    listing_url = f"{base_url}/"
    display = (
        f"deployed: {entry['project']} {entry['platform']} "
        f"{entry['marketing_version']} (build {entry['build_number']})\n"
        f"install:  {install_url}\n"
        f"listing:  {listing_url}"
    )
    result = {
        "build_id": build_id,
        "install_url": install_url,
        "listing_url": listing_url,
    }
    # Sparkle: when this build was EdDSA-signed, surface the appcast feed and the
    # public key so the developer can wire SUFeedURL / SUPublicEDKey into the app.
    if entry.get("sparkle"):
        sp_cfg = cfg.get("macos", {}).get("sparkle", {})
        appcast_url = f"{base_url}/p/{quote(entry['bundle_id'], safe='')}/macos/appcast.xml"
        public_ed_key = sp_cfg.get("public_ed_key", "")
        result["appcast_url"] = appcast_url
        result["public_ed_key"] = public_ed_key
        display += (
            f"\nappcast:  {appcast_url}"
            f"\nSUPublicEDKey: "
            f"{public_ed_key or '(set macos.sparkle.public_ed_key in config.toml)'}"
        )
    result["display"] = display
    ok(result)


def cmd_preflight(args):
    """Read-only pre-deploy check: is a semver version bump needed before this
    deploy? Drives the SKILL's bump prompt. Never builds or mutates anything.

    When semver is inactive the deploy proceeds normally (the web UI reports the
    build number). When active, compares the current VERSION against the newest
    already-published build of this (bundle_id, platform): if unchanged, a bump
    is required so no two published builds share a version."""
    if not args.platform:
        fail("--platform required (one of ios | macos | visionos)")
    cwd = Path.cwd()
    meta = _derive_metadata(cwd, args.platform)
    semver_version = _semver_active_version(cwd)

    if semver_version is None:
        ok({
            "display": "semver inactive — deploy will report the build number",
            "semver_active": False,
            "bump_needed": False,
            "project": meta["project"],
            "bundle_id": meta["bundle_id"],
            "platform": meta["platform"],
        })
        return

    prefix = _semver_prefix(cwd)
    state = _state_dir()
    _pull_index(state)
    try:
        builds = json.loads((state / "index" / "builds.json").read_text()).get("builds", [])
    except (FileNotFoundError, json.JSONDecodeError):
        builds = []
    latest = _latest_build_for(builds, meta["bundle_id"], meta["platform"])
    latest_version = latest.get("semver_version") if latest else None
    version_changed = (latest is None or latest_version is None
                       or latest_version != semver_version)
    bump_needed = not version_changed

    if bump_needed:
        display = (f"semver {semver_version} is already the latest published build of "
                   f"{meta['project']} {meta['platform']} — a version bump is required")
    else:
        display = (f"semver {semver_version} — OK to deploy "
                   f"(latest published: {latest_version or 'none'})")

    ok({
        "display": display,
        "semver_active": True,
        "bump_needed": bump_needed,
        "version_changed": version_changed,
        "current_version": semver_version,
        "latest_version": latest_version,
        "candidates": _next_versions(semver_version, prefix),
        "project": meta["project"],
        "bundle_id": meta["bundle_id"],
        "platform": meta["platform"],
        "dirty_tree": _is_dirty(cwd),
        "current_branch": _current_branch(cwd),
        "target_branch": (_parse_semver_config(cwd) or {}).get("target_branch", "main"),
    })


def cmd_bump(args):
    """Drive a semver version bump as part of a deploy: non-interactive, folding
    any uncommitted changes into the chore(release) commit ("auto-include").

    Delegates the bump to the semver plugin's CLI (discovered at runtime) so all
    of semver's behaviour — changelog, tagging, shell hooks — is reused. Bypasses
    semver's interactive `gather` step: the deploy already chose the component and
    pre-authorised include semantics, so there are no extra prompts. `--force`
    permits a version-only bump when there are no new commits; a pre-existing tag
    is non-fatal."""
    if not args.component:
        fail("--component required (one of major | minor | patch)")
    cwd = Path.cwd()
    if _semver_active_version(cwd) is None:
        fail("semver is not active for this project — nothing to bump")
    cli = _find_semver_cli(args.plugin_root)
    if cli is None:
        fail(f"semver CLI not found — run `/semver bump {args.component}` "
             "manually, then re-run the deploy")
    semver_root = cli.parent.parent
    res = subprocess.run(
        ["python3", str(cli), "bump", "execute", args.component,
         "--source", "force", "--force", "--dirty-action", "include",
         "--plugin-root", str(semver_root)],
        capture_output=True, text=True,
    )
    try:
        payload = json.loads(res.stdout)
    except json.JSONDecodeError:
        fail("semver bump produced no JSON",
             stderr=res.stderr.strip() or res.stdout.strip())
    if not payload.get("ok"):
        fail(payload.get("display") or payload.get("message") or "semver bump failed",
             semver=payload)
    old_v, new_v = payload.get("old_version", "?"), payload.get("new_version", "?")
    ok({
        "display": f"semver bump: {old_v} → {new_v} ({args.component})",
        "old_version": old_v,
        "new_version": new_v,
    })


def cmd_url(args):
    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")
    ok({"display": f"{base_url}/", "url": f"{base_url}/"})


def cmd_status(args):
    state = _state_dir()
    cfg = _read_config(state)
    port = cfg["server"]["port"]
    base_url = cfg["server"]["base_url"].rstrip("/")
    try:
        with urllib.request.urlopen(
                f"http://127.0.0.1:{port}/deployit/_healthz", timeout=2) as r:
            health = json.loads(r.read())
            backend_ok = bool(health.get("ok"))
    except Exception:
        backend_ok = False

    builds_path = state / "index" / "builds.json"
    try:
        data = json.loads(builds_path.read_text())
        local_builds = [b for b in data["builds"]
                        if b["origin_base_url"] == base_url]
    except FileNotFoundError:
        local_builds = []

    lines = [
        f"backend:  {'up' if backend_ok else 'DOWN'} (port {port})",
        f"base_url: {base_url}/",
        f"recent local deploys:",
    ]
    for b in local_builds[:5]:
        lines.append(f"  - {b['id']}  {b['project']} {b['platform']} "
                     f"{b['marketing_version']} ({b['timestamp']})")
    if not local_builds:
        lines.append("  (none)")
    ok({"display": "\n".join(lines), "backend_ok": backend_ok})


def cmd_list(args):
    state = _state_dir()
    builds_path = state / "index" / "builds.json"
    if not builds_path.exists():
        fail("no local index — run /deployit bootstrap")
    data = json.loads(builds_path.read_text())
    rows = data["builds"]
    if args.platform:
        rows = [b for b in rows if b["platform"] == args.platform]
    if args.project:
        rows = [b for b in rows if b["project"].lower() == args.project.lower()]
    lines = []
    for b in rows[:30]:
        flag = " [archived]" if b.get("archived") else ""
        lines.append(f"{b['id']}{flag}\n"
                     f"  {b['project']} {b['platform']} {b['marketing_version']} "
                     f"(build {b['build_number']}) · {b['timestamp']} · {b['origin_host']}")
    ok({"display": "\n".join(lines) if lines else "(no builds)",
        "count": len(rows)})


def cmd_gc(args):
    if args.keep is None and getattr(args, "older_than", None) is None:
        fail("gc requires --keep N or --older-than DAYS")
    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")

    archived_ids = []

    def mutate(data):
        local = [b for b in data["builds"]
                 if b["origin_base_url"] == base_url and not b.get("archived")]
        local.sort(key=lambda b: b["timestamp"], reverse=True)
        if args.keep is not None:
            to_archive = local[args.keep:]
        else:
            cutoff = _dt.datetime.now(_dt.timezone.utc) - _dt.timedelta(days=args.older_than)
            to_archive = [b for b in local
                          if _dt.datetime.fromisoformat(b["timestamp"]).astimezone(_dt.timezone.utc) < cutoff]
        if not to_archive:
            return None
        for b in to_archive:
            b["archived"] = True
        archived_ids[:] = [b["id"] for b in to_archive]
        return f"chore(deploy): archive {len(to_archive)} build(s) from {base_url}"

    msg = _commit_and_push_index(state, mutate)

    removed = 0
    for bid in archived_ids:
        d = state / "serve" / bid
        if d.exists():
            _shutil.rmtree(d)
            removed += 1
    if msg and not os.environ.get("DEPLOYIT_SKIP_GC_PUSH"):
        _refresh_local_backend(cfg["server"]["port"])

    ok({"display": f"archived {len(archived_ids)} build(s); removed {removed} local dir(s)",
        "archived": len(archived_ids), "removed_local": removed})


def cmd_rm(args):
    """Delete a single local build (--build ID) or a whole local product
    (--product BUNDLE_ID --platform P): remove the matching entries from the
    shared index and rmtree their serve/ dirs. Scoped to builds this machine
    owns (origin_base_url == base_url) — foreign builds are managed on their
    origin Mac. This is the writer behind the web UI's swipe-to-delete."""
    has_build = bool(args.build)
    has_product = bool(args.product)
    if has_build == has_product:
        fail("rm requires exactly one of --build ID or --product BUNDLE_ID --platform P")
    if has_product and not args.platform:
        fail("rm --product requires --platform")
    if has_build and not _BUILD_ID_RE.match(args.build):
        fail("invalid build id")

    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")
    host = urlparse(base_url).netloc

    if has_build:
        scope = f"build {args.build}"
        match = lambda b: b.get("id") == args.build
    else:
        scope = f"product {args.product} {args.platform}"
        match = lambda b: (b.get("bundle_id") == args.product
                           and b.get("platform") == args.platform)

    removed_ids = []

    def mutate(data):
        targets = [b for b in data["builds"] if match(b)]
        local_ids = {b["id"] for b in targets if b.get("origin_base_url") == base_url}
        if not local_ids:
            hint = " (foreign builds are managed on their origin Mac)" if targets else ""
            fail(f"no local {scope} to delete{hint}")
        data["builds"] = [b for b in data["builds"] if b["id"] not in local_ids]
        removed_ids[:] = sorted(local_ids)
        return f"chore(deploy): rm {scope} via web from {host}"

    msg = _commit_and_push_index(state, mutate)

    removed = 0
    for bid in removed_ids:
        d = state / "serve" / bid
        if d.exists():
            _shutil.rmtree(d, ignore_errors=True)
            removed += 1
    if msg and not os.environ.get("DEPLOYIT_SKIP_GC_PUSH"):
        _refresh_local_backend(cfg["server"]["port"])

    ok({"display": f"removed {len(removed_ids)} build(s); {removed} local dir(s)",
        "removed": len(removed_ids), "removed_local": removed})


def _plist_is_legacy(state: Path) -> bool:
    """True iff the installed plist references something OTHER than the stable
    <state>/bin/deployit-backend path (i.e., still pins to a cache-hash dir)."""
    plist_path = Path.home() / "Library" / "LaunchAgents" / "com.mikeydotio.deployit.backend.plist"
    if not plist_path.is_file():
        return True
    try:
        body = plist_path.read_text()
    except OSError:
        return True
    return f"{state}/bin/deployit-backend" not in body


def _kickstart_daemon():
    """Restart the launchd-managed backend. Skipped via DEPLOYIT_SKIP_KICKSTART."""
    if os.environ.get("DEPLOYIT_SKIP_KICKSTART"):
        return
    launchctl = os.environ.get("DEPLOYIT_LAUNCHCTL_BIN", "launchctl")
    subprocess.run(
        [launchctl, "kickstart", "-k", f"gui/{os.getuid()}/com.mikeydotio.deployit.backend"],
        check=True, timeout=10,
    )


def _wait_for_health(port: int, timeout_s: float = 5.0) -> bool:
    """Poll /deployit/_healthz until it returns ok or timeout."""
    if os.environ.get("DEPLOYIT_SKIP_VERIFY"):
        return True
    deadline = time.monotonic() + timeout_s
    last_err = ""
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(
                    f"http://127.0.0.1:{port}/deployit/_healthz", timeout=1) as r:
                if json.loads(r.read()).get("ok"):
                    return True
        except Exception as exc:
            last_err = repr(exc)
        time.sleep(0.1)
    sys.stderr.write(f"deployit: health probe failed: {last_err}\n")
    return False


def cmd_redeploy(args):
    """Re-sync the daemon's plugin-root symlinks, repair a legacy plist if
    needed, restart launchd, wait for health, and run verify-live.sh.

    Defaults the target to args.plugin_root (the runtime cache dir). Pass
    --source PATH to point at an arbitrary plugin checkout (e.g., a dev
    repo) for fast iteration without waiting for a new release."""
    state = _state_dir()
    if not state.exists():
        fail("deployit not bootstrapped — run /deployit bootstrap first")
    _ensure_dirs(state)

    target = (args.source if args.source else args.plugin_root).resolve()
    if not (target / "bin" / "deployit-backend").is_file():
        fail(f"target has no bin/deployit-backend: {target}")

    cfg = _read_config(state)
    port = cfg["server"]["port"]

    _sync_plugin_root(state, target)

    # Repair legacy hash-pinned plists from older bootstrap runs.
    plist_rewritten = False
    if _plist_is_legacy(state):
        _install_launchd(state, port)
        plist_rewritten = True

    _kickstart_daemon()

    if not _wait_for_health(port):
        fail(f"daemon did not become healthy on port {port} after kickstart",
             port=port)

    # Live verification: run verify-live.sh against the running daemon.
    if not os.environ.get("DEPLOYIT_SKIP_VERIFY"):
        verify = target / "tests" / "verify-live.sh"
        if not verify.is_file():
            fail(f"verify-live.sh not found at {verify}")
        env = {**os.environ, "DEPLOYIT_STATE_DIR": str(state)}
        res = subprocess.run(
            ["bash", str(verify), "--port", str(port)],
            capture_output=True, text=True, env=env, timeout=15,
        )
        if res.returncode != 0:
            fail("live verification failed",
                 verify_stdout=res.stdout, verify_stderr=res.stderr)

    parts = [f"redeployed daemon: target={target}"]
    if plist_rewritten:
        parts.append("plist rewritten to stable paths")
    parts.append("health + live checks passed")
    ok({
        "display": "\n  ".join(parts),
        "target": str(target),
        "port": port,
        "plist_rewritten": plist_rewritten,
    })


def build_parser():
    parser = JsonArgumentParser(prog="deployit")
    parser.add_argument("--plugin-root", required=True, type=Path)
    parser.add_argument("--version", action="store_true")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("bootstrap").set_defaults(func=cmd_bootstrap)

    p_deploy = sub.add_parser("deploy")
    p_deploy.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_deploy.add_argument("--scheme")
    p_deploy.add_argument("--__dump-metadata", action="store_true",
                          help=argparse.SUPPRESS, dest="dump_metadata")
    p_deploy.set_defaults(func=cmd_deploy)

    p_list = sub.add_parser("list")
    p_list.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_list.add_argument("--project")
    p_list.set_defaults(func=cmd_list)

    sub.add_parser("url").set_defaults(func=cmd_url)
    sub.add_parser("status").set_defaults(func=cmd_status)

    p_gc = sub.add_parser("gc")
    p_gc.add_argument("--keep", type=int)
    p_gc.add_argument("--older-than", type=int, help="days")
    p_gc.set_defaults(func=cmd_gc)

    p_rm = sub.add_parser("rm")
    p_rm.add_argument("--build")
    p_rm.add_argument("--product")
    p_rm.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_rm.set_defaults(func=cmd_rm)

    p_redeploy = sub.add_parser("redeploy")
    p_redeploy.add_argument("--source", type=Path, default=None,
        help="point the daemon at this plugin dir instead of the cached release")
    p_redeploy.set_defaults(func=cmd_redeploy)

    p_preflight = sub.add_parser("preflight")
    p_preflight.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_preflight.add_argument("--scheme")  # accepted for symmetry with deploy; unused
    p_preflight.set_defaults(func=cmd_preflight)

    p_bump = sub.add_parser("bump")
    p_bump.add_argument("--component", choices=["major", "minor", "patch"])
    p_bump.set_defaults(func=cmd_bump)

    return parser


def main(argv):
    args = build_parser().parse_args(argv)
    if args.version:
        ok({"version": __version__})
        return
    if not args.cmd:
        fail("no subcommand given")
    args.func(args)


if __name__ == "__main__":
    main(sys.argv[1:])
