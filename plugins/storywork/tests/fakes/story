#!/usr/bin/env bash
# Fake `story` (storyhook CLI) for storywork tests. Emits canned output driven
# by env knobs so the whole story-dependent flow runs offline and
# deterministically. The JSON SHAPE below is copied from the REAL `story`
# binary's output (verified empirically against a built `story` v0.16.0, not
# guessed from docs) -- double-nested `story.story`, `result` discriminator
# (ok|conflict|error), and the conflict envelope's `expected`/`actual` fields.
# This is NOT the same shape as plugins/rca/tests/fakes/story (a flat
# {id,title,status,body} stand-in for a different, older contract) --
# storywork's story.sh parses the real nested shape, so its fake must match it.
#
# Shared:
#   FAKE_STORY_LOG=path              append each invocation's args here
#
# story show <id> [--json]:
#   FAKE_STORY_SHOW_FAIL=1           `story show` reports {result:"error"} (not found)
#   FAKE_STORY_STATE=todo            .story.story.state (default: todo)
#   FAKE_STORY_SUPERSTATE=OPEN       .story.story.superstate (default: OPEN)
#   FAKE_STORY_TITLE=...             .story.story.title (default: "Fake story <id>")
#
# story move <id> <state> [--if-state <expected>] [--json]:
#   FAKE_STORY_MOVE_CONFLICT=1       the move reports {result:"conflict"} regardless
#                                    of the --if-state value passed (models a
#                                    concurrent claim winning the race between
#                                    story.sh's own show and move calls)
#   FAKE_STORY_MOVE_FAIL=1           the move reports {result:"error"}
#   FAKE_STORY_ROLLBACK_FAIL=1       a move whose TARGET state is anything
#                                    other than "in-progress" reports
#                                    {result:"error"} -- by construction,
#                                    story.sh's cmd_dispatch only ever moves
#                                    to a state other than in-progress via
#                                    claim_rollback_note's post-claim
#                                    rollback, so this isolates JUST that
#                                    call (the original claim move, which
#                                    always targets in-progress, is
#                                    unaffected) -- models a rollback attempt
#                                    itself failing (e.g. the story moved on
#                                    again in the interim)
#
# story state list [--json]:
#   the project's state VOCABULARY, which story.sh consults only on the
#   already-failed claim path to CONFIRM (never infer from upstream's error
#   text) that `in-progress` is genuinely absent. The real CLI returns the
#   vocabulary as an UNSTRUCTURED prose blob under `.message` -- one state per
#   line, slug first -- so the default below is copied from real `story`
#   2.0.0 output, trailing " -- N open" annotation included, rather than
#   idealised into something easier to parse than the real thing.
#   FAKE_STORY_STATES=<blob>         override the `.message` blob verbatim
#                                    (pass $'a\nb' for multiple lines). Set it
#                                    to a vocabulary WITHOUT an `in-progress`
#                                    line to model the AGE-12 condition.
#   FAKE_STORY_STATE_LIST_FAIL=1     `story state list` reports {result:"error"}
#   FAKE_STORY_STATE_LIST_EMPTY=1    `story state list` succeeds but emits an
#                                    EMPTY `.message` -- models an upstream
#                                    output-shape change that defeats the
#                                    parse. Distinct from _FAIL: the call
#                                    works, the answer is unusable.
#
# story comment / story block: logged only (FAKE_STORY_LOG), always succeed.
args="$*"
[ -n "${FAKE_STORY_LOG:-}" ] && printf '%s\n' "$args" >> "$FAKE_STORY_LOG"

case "${1:-}" in
  show)
    id="${2:-}"
    if [ -n "${FAKE_STORY_SHOW_FAIL:-}" ]; then
      jq -n --arg id "$id" '{result:"error", error:("story `" + $id + "` not found"), exit_code:3}'
      exit 3
    fi
    jq -n \
      --arg id "$id" \
      --arg title "${FAKE_STORY_TITLE:-Fake story $id}" \
      --arg state "${FAKE_STORY_STATE:-todo}" \
      --arg super "${FAKE_STORY_SUPERSTATE:-OPEN}" '
      {result:"ok", story:{story:{id:$id, title:$title, state:$state, superstate:$super}}}'
    exit 0 ;;
  move)
    id="${2:-}" state="${3:-}"
    shift 3 2>/dev/null || true
    if_state=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --if-state) if_state="${2:-}"; shift 2 ;;
        *)          shift ;;
      esac
    done
    # A target state absent from the project's vocabulary cannot be moved to.
    # Modelled here rather than behind its own knob because the two facts are
    # NOT independent in reality: if `in-progress` is missing, `story move
    # <id> in-progress` always fails, with exactly this error text (verified
    # against real story 2.0.0). A test that could set them independently
    # could assert a world that cannot exist.
    if [ -n "${FAKE_STORY_STATES:-}" ]; then
      case "$FAKE_STORY_STATES" in
        *"$state"*) : ;;
        *) jq -n --arg s "$state" \
             '{result:"error", error:("state `" + $s + "` is not defined"), exit_code:2}'
           exit 2 ;;
      esac
    fi
    if [ -n "${FAKE_STORY_MOVE_FAIL:-}" ]; then
      jq -n --arg id "$id" '{result:"error", error:("story `" + $id + "` could not be moved"), exit_code:1}'
      exit 1
    fi
    if [ -n "${FAKE_STORY_ROLLBACK_FAIL:-}" ] && [ "$state" != "in-progress" ]; then
      jq -n --arg id "$id" --arg s "$state" \
        '{result:"error", error:("story `" + $id + "` could not be rolled back to `" + $s + "`"), exit_code:1}'
      exit 1
    fi
    if [ -n "${FAKE_STORY_MOVE_CONFLICT:-}" ]; then
      jq -n --arg exp "$if_state" --arg act "${FAKE_STORY_STATE:-todo}" '
        {result:"conflict",
         error:("state conflict: expected `" + $exp + "`, was `" + $act + "`"),
         exit_code:9, expected:$exp, actual:$act}'
      exit 9
    fi
    jq -n \
      --arg id "$id" \
      --arg title "${FAKE_STORY_TITLE:-Fake story $id}" \
      --arg state "$state" \
      --arg super "${FAKE_STORY_MOVE_SUPERSTATE:-OPEN}" '
      {result:"ok", story:{story:{id:$id, title:$title, state:$state, superstate:$super}}}'
    exit 0 ;;
  state)
    if [ "${2:-}" = "list" ]; then
      if [ -n "${FAKE_STORY_STATE_LIST_FAIL:-}" ]; then
        jq -n '{result:"error", error:"could not read the project state list", exit_code:1}'
        exit 1
      fi
      if [ -n "${FAKE_STORY_STATE_LIST_EMPTY:-}" ]; then
        jq -n '{result:"ok", message:""}'
        exit 0
      fi
      default_states=$'todo (OPEN)\nin-progress (OPEN, active) — 1 open\nblocked (OPEN)\ndone (CLOSED)'
      jq -n --arg m "${FAKE_STORY_STATES:-$default_states}" '{result:"ok", message:$m}'
      exit 0
    fi
    echo "fake-story: unhandled: $args" >&2; exit 0 ;;
  comment|block)
    if [ -n "${FAKE_STORY_COMMENT_FAIL:-}" ] && [ "$1" = "comment" ]; then
      echo "could not comment" >&2; exit 1
    fi
    if [ -n "${FAKE_STORY_BLOCK_FAIL:-}" ] && [ "$1" = "block" ]; then
      echo "could not block" >&2; exit 1
    fi
    exit 0 ;;
  *)
    echo "fake-story: unhandled: $args" >&2; exit 0 ;;
esac
