#!/usr/bin/env python3
"""atlas-cli: Deterministic operations for the atlas codebase-mapping plugin.

All output is JSON to stdout. Errors are JSON with ok=false.
Exit codes: 0=success, 1=operation failed, 2=usage error.

Subcommands (phase 1):
  scan       Enumerate mappable files (git ls-files ∩ config globs) with sizes.
  partition  Deterministically partition mappable files into modules.

Design record: plugins/atlas/references/design.md
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time


# ─── Constants ───────────────────────────────────────────────────────────────

DEFAULT_MAX_FILES = 1500          # scan ceiling — full maps beyond this are refused

DEFAULT_PARTITION = {
    "min_files": 3,               # partitions smaller than this coalesce into (misc)
    "max_files": 15,              # per-mapper attention cap
    "max_bytes": 120_000,         # ~30k tokens of source per mapper
}

# Always excluded, in addition to user config excludes. Atlas's own artifacts
# first, then generated/locked/minified files that carry no mappable signal.
DEFAULT_EXCLUDES = [
    "docs/atlas/**",
    ".atlas/**",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/Cargo.lock",
    "**/Gemfile.lock",
    "**/poetry.lock",
    "**/uv.lock",
    "**/composer.lock",
    "**/go.sum",
    "**/Package.resolved",
    "**/*.lock",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.map",
    "**/.DS_Store",
]

# Extension-based binary exclusion; the NUL sniff below catches the rest.
BINARY_EXTENSIONS = {
    "png", "jpg", "jpeg", "gif", "webp", "ico", "icns", "bmp", "tiff", "tif",
    "pdf", "zip", "tar", "gz", "tgz", "bz2", "xz", "7z", "rar",
    "jar", "war", "ear", "bin", "exe", "dll", "dylib", "so", "a", "o", "obj",
    "class", "pyc", "pyo", "wasm",
    "woff", "woff2", "ttf", "otf", "eot",
    "mp3", "mp4", "m4a", "m4v", "mov", "avi", "mkv", "wav", "flac", "ogg",
    "heic", "heif", "sketch", "fig", "psd", "ai", "eps",
    "db", "sqlite", "sqlite3", "realm", "car", "nib", "ipa", "apk",
    "dmg", "pkg", "iso",
}

SNIFF_BYTES = 8192                # leading bytes checked for NUL (binary sniff)

CONFIG_RELPATH = os.path.join("docs", "atlas", "config.yaml")


# ─── Output helpers ──────────────────────────────────────────────────────────

def emit(data):
    print(json.dumps(data, indent=2))


def emit_ok(**fields):
    out = {"ok": True}
    out.update(fields)
    emit(out)
    return 0


def emit_fail(error, message, **fields):
    out = {"ok": False, "error": error, "message": message}
    out.update(fields)
    emit(out)
    return 1


# ─── Git helpers ─────────────────────────────────────────────────────────────

def run_git(args, cwd):
    """Run a git command; returns (exit_code, stdout_bytes)."""
    proc = subprocess.run(
        ["git"] + args, cwd=cwd,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    return proc.returncode, proc.stdout


def git_toplevel(project_dir):
    """Absolute repo root for project_dir, or None when not in a git repo."""
    code, out = run_git(["rev-parse", "--show-toplevel"], cwd=project_dir)
    if code != 0:
        return None
    return out.decode("utf-8", errors="replace").strip()


def git_listed_files(root):
    """Tracked + untracked-but-not-ignored files, relative to root, deduped."""
    code, out = run_git(
        ["ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        cwd=root,
    )
    if code != 0:
        return []
    paths = out.decode("utf-8", errors="replace").split("\0")
    return sorted({p for p in paths if p})


# ─── Config (restricted YAML subset) ─────────────────────────────────────────
#
# Supported on purpose: top-level scalars, one level of nested map, lists of
# scalars, and lists of {key: value} maps (for `modules:`). Comments and blank
# lines are skipped. Anything fancier is unsupported — see design.md.

def parse_scalar(s):
    s = s.strip()
    if s.startswith("[") and s.endswith("]"):
        inner = s[1:-1].strip()
        return [parse_scalar(x) for x in inner.split(",")] if inner else []
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    if s.lower() in ("true", "false"):
        return s.lower() == "true"
    if s.lower() in ("null", "~"):
        return None
    if re.fullmatch(r"-?\d+", s):
        return int(s)
    return s


def parse_yaml_subset(text):
    lines = []
    for raw in text.splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        lines.append((indent, stripped))

    pos = [0]

    def parse_value_block(parent_indent):
        """Parse the block nested under a `key:` line, or None if absent."""
        if pos[0] >= len(lines) or lines[pos[0]][0] <= parent_indent:
            return None
        child_indent = lines[pos[0]][0]
        if lines[pos[0]][1].startswith("- ") or lines[pos[0]][1] == "-":
            return parse_list(child_indent)
        return parse_map(child_indent)

    def parse_map(indent):
        out = {}
        while pos[0] < len(lines):
            i, content = lines[pos[0]]
            if i != indent or content.startswith("- "):
                break
            key, _, rest = content.partition(":")
            key, rest = key.strip(), rest.strip()
            pos[0] += 1
            out[key] = parse_scalar(rest) if rest else parse_value_block(i)
        return out

    def parse_list(indent):
        out = []
        while pos[0] < len(lines):
            i, content = lines[pos[0]]
            if i != indent or not (content.startswith("- ") or content == "-"):
                break
            item = content[1:].strip()
            pos[0] += 1
            if ":" not in item:
                out.append(parse_scalar(item))
                continue
            # Map item: "- key: value" (or "- key:" opening a nested block),
            # with continuation keys indented past the dash.
            key, _, rest = item.partition(":")
            entry = {}
            entry[key.strip()] = parse_scalar(rest.strip()) if rest.strip() \
                else parse_value_block(i)
            while pos[0] < len(lines):
                ci, ccontent = lines[pos[0]]
                if ci <= i or ccontent.startswith("- "):
                    break
                k2, _, r2 = ccontent.partition(":")
                pos[0] += 1
                entry[k2.strip()] = parse_scalar(r2.strip()) if r2.strip() \
                    else parse_value_block(ci)
            out.append(entry)
        return out

    if not lines:
        return {}
    return parse_map(lines[0][0])


def load_config(root):
    path = os.path.join(root, CONFIG_RELPATH)
    if not os.path.isfile(path):
        return {}
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        parsed = parse_yaml_subset(f.read())
    return parsed if isinstance(parsed, dict) else {}


def partition_caps(config):
    caps = dict(DEFAULT_PARTITION)
    user = config.get("partition")
    if isinstance(user, dict):
        for key in caps:
            if isinstance(user.get(key), int) and user[key] > 0:
                caps[key] = user[key]
    return caps


# ─── Frontmatter (module/overview doc ledger entries) ───────────────────────
#
# Doc frontmatter is the ledger's source of truth; atlas-ledger.json is a
# derived reverse index. Serialization is canonical (fixed key order, stable
# quoting) so regenerated docs only churn where content actually changed.

FRONTMATTER_KEY_ORDER = [
    "module", "summary", "read_when", "sources", "scopes",
    "references_modules", "generator", "baseline", "verified",
]

BARE_SCALAR_RE = re.compile(r"[A-Za-z0-9._/-]+")


def split_frontmatter(text):
    """Returns (frontmatter_text, body_text) or (None, text) when absent."""
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        return None, text
    for idx in range(1, len(lines)):
        if lines[idx].strip() == "---":
            return "".join(lines[1:idx]), "".join(lines[idx + 1:])
    return None, text


def yaml_scalar(value):
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    s = str(value)
    if BARE_SCALAR_RE.fullmatch(s):
        return s
    return json.dumps(s)


def serialize_frontmatter(fm):
    keys = [k for k in FRONTMATTER_KEY_ORDER if k in fm]
    keys += sorted(k for k in fm if k not in FRONTMATTER_KEY_ORDER)
    out = ["---"]
    for key in keys:
        value = fm[key]
        if key in ("sources", "scopes") and isinstance(value, list):
            out.append("{}:".format(key))
            for entry in value:
                if not isinstance(entry, dict):
                    continue
                first = True
                for ek in ("path", "blob", "tree", "sha"):
                    if ek not in entry:
                        continue
                    prefix = "  - " if first else "    "
                    out.append("{}{}: {}".format(prefix, ek, yaml_scalar(entry[ek])))
                    first = False
        elif isinstance(value, list):
            out.append("{}: [{}]".format(
                key, ", ".join(yaml_scalar(v) for v in value)))
        else:
            out.append("{}: {}".format(key, yaml_scalar(value)))
    out.append("---")
    return "\n".join(out) + "\n"


# ─── Git plumbing for the ledger ─────────────────────────────────────────────

def git_head(root):
    code, out = run_git(["rev-parse", "HEAD"], cwd=root)
    if code != 0:
        return None
    return out.decode("utf-8", errors="replace").strip()


def git_ls_tree_blobs(root):
    """{path: blob_oid} for HEAD; empty when there is no HEAD yet."""
    code, out = run_git(["ls-tree", "-r", "-z", "HEAD"], cwd=root)
    if code != 0:
        return {}
    blobs = {}
    for entry in out.decode("utf-8", errors="replace").split("\0"):
        if not entry:
            continue
        meta, _, path = entry.partition("\t")
        fields = meta.split()
        if len(fields) == 3 and fields[1] == "blob":
            blobs[path] = fields[2]
    return blobs


def git_status_paths(root):
    """All paths git status reports as differing from HEAD (incl. untracked)."""
    code, out = run_git(
        ["status", "--porcelain", "-z", "--untracked-files=all"], cwd=root)
    if code != 0:
        return set()
    entries = out.decode("utf-8", errors="replace").split("\0")
    paths = set()
    i = 0
    while i < len(entries):
        entry = entries[i]
        i += 1
        if not entry or len(entry) < 4:
            continue
        xy, path = entry[:2], entry[3:]
        paths.add(path)
        if xy[0] in ("R", "C") and i < len(entries):
            paths.add(entries[i])  # original path travels as the next record
            i += 1
    return paths


def git_hash_paths(root, paths):
    """{path: blob_oid} for working-tree bytes — the hash-what-you-read rule."""
    paths = [p for p in paths if os.path.isfile(os.path.join(root, p))]
    if not paths:
        return {}
    proc = subprocess.run(
        ["git", "hash-object", "--stdin-paths"], cwd=root,
        input=("\n".join(paths) + "\n").encode("utf-8", errors="replace"),
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    if proc.returncode == 0:
        hashes = proc.stdout.decode().split()
        if len(hashes) == len(paths):
            return dict(zip(paths, hashes))
    out = {}
    for p in paths:  # batch failed (e.g. one unreadable file) — fall back
        code, single = run_git(["hash-object", "--", p], cwd=root)
        if code == 0:
            out[p] = single.decode().strip()
    return out


def current_blob_map(root):
    """{path: blob} for the repo as it exists NOW: HEAD blobs overridden by
    working-tree hashes for every path git status reports as changed."""
    blobs = git_ls_tree_blobs(root)
    dirty = git_status_paths(root)
    rehashed = git_hash_paths(root, sorted(dirty))
    for path in dirty:
        if path in rehashed:
            blobs[path] = rehashed[path]
        else:
            blobs.pop(path, None)  # deleted from the worktree
    return blobs


def git_tree_oid(root, treepath):
    code, out = run_git(["rev-parse", "HEAD:{}".format(treepath)], cwd=root)
    if code != 0:
        return None
    return out.decode().strip()


def git_commit_exists(root, sha):
    code, _ = run_git(["cat-file", "-e", "{}^{{commit}}".format(sha)], cwd=root)
    return code == 0


def git_is_ancestor(root, ancestor, descendant):
    code, _ = run_git(
        ["merge-base", "--is-ancestor", ancestor, descendant], cwd=root)
    return code == 0


def git_commits_behind(root, baseline):
    code, out = run_git(
        ["rev-list", "--count", "{}..HEAD".format(baseline)], cwd=root)
    if code != 0:
        return None
    try:
        return int(out.decode().strip())
    except ValueError:
        return None


# ─── Map doc discovery and validation ────────────────────────────────────────

MAP_DIR = os.path.join("docs", "atlas")
LEDGER_RELPATH = os.path.join(MAP_DIR, "atlas-ledger.json")
INDEX_RELPATH = os.path.join(MAP_DIR, "INDEX.md")


def doc_module_id(doc_id):
    """modules/src-auth.md → src-auth (the id used in references_modules)."""
    return os.path.basename(doc_id)[:-3]


def discover_docs(root):
    """Map docs as doc_ids relative to docs/atlas/ (modules/* then overview/*)."""
    doc_ids = []
    for sub in ("modules", "overview"):
        absdir = os.path.join(root, MAP_DIR, sub)
        if not os.path.isdir(absdir):
            continue
        for name in sorted(os.listdir(absdir)):
            if name.endswith(".md"):
                doc_ids.append("{}/{}".format(sub, name))
    return doc_ids


def load_doc(root, doc_id):
    abspath = os.path.join(root, MAP_DIR, doc_id)
    with open(abspath, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    fm_text, body = split_frontmatter(text)
    fm = parse_yaml_subset(fm_text) if fm_text is not None else None
    return {"doc_id": doc_id, "abspath": abspath, "fm": fm, "body": body}


def validate_doc(doc):
    errors = []
    fm = doc["fm"]
    if fm is None:
        return ["missing frontmatter block"]
    for key in ("module", "summary", "generator"):
        if not isinstance(fm.get(key), str) or not fm.get(key).strip():
            errors.append("missing or empty `{}`".format(key))
    if doc["doc_id"].startswith("modules/") and not isinstance(fm.get("read_when"), str):
        errors.append("missing `read_when` (required for module docs)")
    sources = fm.get("sources")
    if not isinstance(sources, list) or not sources:
        errors.append("`sources` must be a non-empty list")
    else:
        for entry in sources:
            if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
                errors.append("every `sources` entry needs a `path`")
                break
    scopes = fm.get("scopes")
    if scopes is not None and not isinstance(scopes, list):
        errors.append("`scopes` must be a list when present")
    refs = fm.get("references_modules")
    if refs is not None and not isinstance(refs, list):
        errors.append("`references_modules` must be a list when present")
    return errors


def load_validated_docs(root):
    """Returns (docs, errors). errors is a list of (doc_id, [messages])."""
    docs = []
    errors = []
    for doc_id in discover_docs(root):
        doc = load_doc(root, doc_id)
        doc_errors = validate_doc(doc)
        if doc_errors:
            errors.append((doc_id, doc_errors))
        else:
            docs.append(doc)
    return docs, errors


# ─── ledger ──────────────────────────────────────────────────────────────────

def write_doc(doc):
    text = serialize_frontmatter(doc["fm"]) + doc["body"]
    with open(doc["abspath"], "w", encoding="utf-8") as f:
        f.write(text)


def build_ledger(root, docs):
    head = git_head(root)
    ledger = {
        "version": 1,
        "baseline": head,
        "docs": {},
        "paths": {},
        "referenced_by": {},
    }
    for doc in docs:
        fm = doc["fm"]
        sources = {e["path"]: e.get("blob") for e in fm.get("sources", [])}
        ledger["docs"][doc["doc_id"]] = {
            "module": fm.get("module"),
            "summary": fm.get("summary"),
            "sources": sources,
            "references_modules": fm.get("references_modules") or [],
            "generator": fm.get("generator"),
            "verified": fm.get("verified"),
        }
        if doc["doc_id"].startswith("modules/"):
            for path in sources:
                ledger["paths"][path] = doc["doc_id"]
        for ref in fm.get("references_modules") or []:
            ledger["referenced_by"].setdefault(str(ref), []).append(doc["doc_id"])
    for ref in ledger["referenced_by"]:
        ledger["referenced_by"][ref].sort()
    return ledger


def check_duplicate_ownership(docs):
    """Each non-map source path is owned by exactly one module doc."""
    owners = {}
    duplicates = []
    for doc in docs:
        if not doc["doc_id"].startswith("modules/"):
            continue
        for entry in doc["fm"].get("sources", []):
            path = entry["path"]
            if path.startswith("docs/atlas/"):
                continue
            if path in owners and owners[path] != doc["doc_id"]:
                duplicates.append((path, owners[path], doc["doc_id"]))
            owners[path] = doc["doc_id"]
    return duplicates


def cmd_ledger_finalize(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    docs, errors = load_validated_docs(root)
    if errors:
        return emit_fail(
            "invalid_frontmatter",
            "Some map docs have invalid frontmatter; fix or regenerate them.",
            docs={doc_id: msgs for doc_id, msgs in errors},
        )

    duplicates = check_duplicate_ownership(docs)
    if duplicates:
        return emit_fail(
            "duplicate_source",
            "Each source file must be owned by exactly one module doc.",
            duplicates=[
                {"path": p, "docs": [a, b]} for p, a, b in duplicates
            ],
        )

    baseline = git_head(root)
    sources_count = 0
    if args.refresh_hashes:
        # Module docs first, then overview docs — overview sources are module
        # doc files, which must carry their final bytes before being hashed.
        ordered = ([d for d in docs if d["doc_id"].startswith("modules/")] +
                   [d for d in docs if not d["doc_id"].startswith("modules/")])
        for doc in ordered:
            fm = doc["fm"]
            missing = [e["path"] for e in fm["sources"]
                       if not os.path.isfile(os.path.join(root, e["path"]))]
            if missing:
                return emit_fail(
                    "missing_source",
                    "{}: source files not found: {}".format(
                        doc["doc_id"], ", ".join(missing)),
                )
            hashes = git_hash_paths(root, [e["path"] for e in fm["sources"]])
            for entry in fm["sources"]:
                entry["blob"] = hashes.get(entry["path"])
                sources_count += 1
            for scope in fm.get("scopes") or []:
                if isinstance(scope, dict) and isinstance(scope.get("tree"), str):
                    scope["sha"] = git_tree_oid(root, scope["tree"])
            if args.generator:
                fm["generator"] = args.generator
            fm["baseline"] = baseline
            write_doc(doc)
    else:
        for doc in docs:
            for entry in doc["fm"]["sources"]:
                if not entry.get("blob"):
                    return emit_fail(
                        "missing_blobs",
                        "{}: sources lack blob hashes — run "
                        "`ledger finalize --refresh-hashes`.".format(doc["doc_id"]),
                    )
                sources_count += 1

    ledger = build_ledger(root, docs)
    ledger_path = os.path.join(root, LEDGER_RELPATH)
    os.makedirs(os.path.dirname(ledger_path), exist_ok=True)
    with open(ledger_path, "w", encoding="utf-8") as f:
        json.dump(ledger, f, indent=2, sort_keys=True)
        f.write("\n")

    return emit_ok(
        docs_count=len(docs), sources_count=sources_count, baseline=baseline,
    )


def compute_diff(root, generator=None):
    """Classify every map doc against the repo as it exists now."""
    docs, errors = load_validated_docs(root)
    if errors:
        return {
            "ok": False, "error": "invalid_frontmatter",
            "message": "Some map docs have invalid frontmatter; fix or "
                       "regenerate them before diffing.",
            "docs": {doc_id: msgs for doc_id, msgs in errors},
        }

    current = current_blob_map(root)
    blob_to_paths = {}
    for path, blob in current.items():
        blob_to_paths.setdefault(blob, []).append(path)
    for blob in blob_to_paths:
        blob_to_paths[blob].sort()

    stale_docs = []
    renamed_docs = []
    orphaned_docs = []
    fingerprint_stale = []
    unchanged_docs = []
    covered_paths = set()

    for doc in docs:
        fm = doc["fm"]
        doc_id = doc["doc_id"]
        if doc_id.startswith("modules/"):
            covered_paths.update(e["path"] for e in fm["sources"])

        edited, deleted, renames = [], [], []
        for entry in fm["sources"]:
            path, recorded = entry["path"], entry.get("blob")
            cur = current.get(path)
            if cur is None:
                candidates = [p for p in blob_to_paths.get(recorded, []) if p != path]
                if recorded and candidates:
                    renames.append({"from": path, "to": candidates[0]})
                else:
                    deleted.append(path)
            elif recorded is None or cur != recorded:
                edited.append(path)

        scope_changed = []
        for scope in fm.get("scopes") or []:
            if not isinstance(scope, dict):
                continue
            tree, recorded_sha = scope.get("tree"), scope.get("sha")
            if not tree or not recorded_sha:
                continue
            if git_tree_oid(root, tree) != recorded_sha:
                scope_changed.append(tree)

        if fm["sources"] and len(deleted) == len(fm["sources"]):
            orphaned_docs.append({"doc": doc_id, "deleted": deleted})
        elif edited or deleted or scope_changed:
            reasons = ([{"path": p, "kind": "edited"} for p in edited] +
                       [{"path": p, "kind": "deleted"} for p in deleted] +
                       [{"path": t, "kind": "scope_changed"} for t in scope_changed])
            stale_docs.append({"doc": doc_id, "reasons": reasons, "renames": renames})
        elif renames:
            renamed_docs.append({"doc": doc_id, "renames": renames})
        elif generator and fm.get("generator") != generator:
            fingerprint_stale.append({"doc": doc_id, "generator": fm.get("generator")})
        else:
            unchanged_docs.append(doc_id)

    affected_ids = {doc_module_id(d["doc"]) for d in stale_docs + orphaned_docs
                    if d["doc"].startswith("modules/")}
    affected_doc_ids = {d["doc"] for d in
                        stale_docs + orphaned_docs + renamed_docs + fingerprint_stale}
    ripple_docs = []
    for doc in docs:
        if doc["doc_id"] in affected_doc_ids:
            continue
        refs = set(str(r) for r in doc["fm"].get("references_modules") or [])
        via = sorted(refs & affected_ids)
        if via:
            ripple_docs.append({"doc": doc["doc_id"], "via": via})
            affected_doc_ids.add(doc["doc_id"])

    scan = do_scan(root, enforce_ceiling=False)
    new_files = [f["path"] for f in scan.get("files", [])
                 if f["path"] not in covered_paths] if scan.get("ok") else []

    edited_paths = {r["path"] for d in stale_docs for r in d["reasons"]
                    if r["kind"] in ("edited", "deleted")}
    changed_files = len(edited_paths | set(new_files))

    baseline_sha = None
    ledger_path = os.path.join(root, LEDGER_RELPATH)
    if os.path.isfile(ledger_path):
        try:
            with open(ledger_path, "r", encoding="utf-8") as f:
                baseline_sha = json.load(f).get("baseline")
        except (OSError, ValueError):
            baseline_sha = None
    if not baseline_sha:
        for doc in docs:
            if isinstance(doc["fm"].get("baseline"), str):
                baseline_sha = doc["fm"]["baseline"]
                break

    resolvable = bool(baseline_sha) and git_commit_exists(root, baseline_sha)
    is_ancestor = resolvable and git_is_ancestor(root, baseline_sha, "HEAD")
    commits_behind = git_commits_behind(root, baseline_sha) if is_ancestor else None

    total_docs = len(docs)
    affected = len(affected_doc_ids)
    return {
        "ok": True,
        "stale_docs": stale_docs,
        "renamed_docs": renamed_docs,
        "orphaned_docs": orphaned_docs,
        "fingerprint_stale": fingerprint_stale,
        "ripple_docs": ripple_docs,
        "new_files": new_files,
        "unchanged_docs": unchanged_docs,
        "summary": {
            "total_docs": total_docs,
            "module_docs": sum(1 for d in docs if d["doc_id"].startswith("modules/")),
            "affected_docs": affected,
            "affected_pct": round(100.0 * affected / total_docs) if total_docs else 0,
            "changed_files": changed_files,
        },
        "baseline": {
            "sha": baseline_sha,
            "resolvable": resolvable,
            "is_ancestor": is_ancestor,
            "commits_behind": commits_behind,
        },
    }


def cmd_ledger_diff(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    result = compute_diff(root, generator=args.generator)
    emit(result)
    return 0 if result["ok"] else 1


def cmd_ledger_set_verified(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    abspath = os.path.join(root, MAP_DIR, args.doc_id)
    if not os.path.isfile(abspath):
        return emit_fail("unknown_doc", "No map doc at docs/atlas/{}".format(args.doc_id))
    doc = load_doc(root, args.doc_id)
    if doc["fm"] is None:
        return emit_fail("invalid_frontmatter",
                         "{} has no frontmatter block.".format(args.doc_id))
    doc["fm"]["verified"] = args.value == "true"
    write_doc(doc)
    docs, errors = load_validated_docs(root)
    if not errors:
        ledger = build_ledger(root, docs)
        ledger_path = os.path.join(root, LEDGER_RELPATH)
        with open(ledger_path, "w", encoding="utf-8") as f:
            json.dump(ledger, f, indent=2, sort_keys=True)
            f.write("\n")
    return emit_ok(doc=args.doc_id, verified=doc["fm"]["verified"])


# ─── lock ────────────────────────────────────────────────────────────────────

LOCK_TTL_DEFAULT = 600  # seconds without a heartbeat before takeover


def lock_paths(root):
    lock_dir = os.path.join(root, ".atlas", "lock")
    return lock_dir, os.path.join(lock_dir, "lock.json")


def read_lock(lock_file):
    try:
        with open(lock_file, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_lock(lock_file, holder, acquired_at=None):
    now = time.time()
    with open(lock_file, "w", encoding="utf-8") as f:
        json.dump({
            "holder": holder,
            "acquired_at": acquired_at if acquired_at is not None else now,
            "heartbeat_at": now,
        }, f, indent=2)
        f.write("\n")


def cmd_lock(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    lock_dir, lock_file = lock_paths(root)

    if args.lock_command == "acquire":
        os.makedirs(os.path.dirname(lock_dir), exist_ok=True)
        try:
            os.mkdir(lock_dir)  # atomic on POSIX — exactly one winner
            write_lock(lock_file, args.holder)
            return emit_ok(holder=args.holder, took_over=False)
        except FileExistsError:
            lock = read_lock(lock_file)
            if lock is not None and isinstance(lock.get("heartbeat_at"), (int, float)):
                age = time.time() - lock["heartbeat_at"]
            else:
                # lock.json missing or torn: the winner may not have written it
                # yet (milliseconds), or a session crashed mid-acquire. Age the
                # lock by its directory mtime so crashes still time out.
                try:
                    age = time.time() - os.stat(lock_dir).st_mtime
                except OSError:
                    age = 0.0
            if age > args.ttl:
                write_lock(lock_file, args.holder)
                return emit_ok(holder=args.holder, took_over=True,
                               previous_holder=(lock or {}).get("holder"))
            return emit_fail(
                "lock_held",
                "Another atlas session holds the lock "
                "(heartbeat {}s ago).".format(int(age)),
                holder=(lock or {}).get("holder"),
            )

    if args.lock_command == "heartbeat":
        lock = read_lock(lock_file)
        if lock is None:
            return emit_fail("not_held", "No atlas lock is currently held.")
        write_lock(lock_file, lock.get("holder", "unknown"),
                   acquired_at=lock.get("acquired_at"))
        return emit_ok(holder=lock.get("holder"))

    if args.lock_command == "release":
        shutil.rmtree(lock_dir, ignore_errors=True)
        return emit_ok(released=True)

    return emit_fail("usage", "Unknown lock command.")


# ─── status ──────────────────────────────────────────────────────────────────

DEFAULT_THRESHOLDS = {
    "recommend_pct": 25,   # T2: this % of docs affected
    "untrust_pct": 50,     # T3: this % of docs affected
    "recommend_files": 50, # T2: this many in-scope files changed
}

CONFLICT_MARKER_RE = re.compile(r"^(<{7}( |$)|>{7}( |$))", re.MULTILINE)


def status_thresholds(config):
    out = dict(DEFAULT_THRESHOLDS)
    user = config.get("thresholds")
    if isinstance(user, dict):
        for key in out:
            if isinstance(user.get(key), int) and user[key] > 0:
                out[key] = user[key]
    return out


def find_conflict_markers(root):
    hits = []
    map_root = os.path.join(root, MAP_DIR)
    for dirpath, _, filenames in os.walk(map_root):
        for name in sorted(filenames):
            if not name.endswith(".md"):
                continue
            abspath = os.path.join(dirpath, name)
            try:
                with open(abspath, "r", encoding="utf-8", errors="replace") as f:
                    if CONFLICT_MARKER_RE.search(f.read()):
                        hits.append(os.path.relpath(abspath, root))
            except OSError:
                continue
    return hits


def drift_cache_key(root):
    head = git_head(root) or "no-head"
    code, out = run_git(
        ["status", "--porcelain", "-z", "--untracked-files=all"], cwd=root)
    entries = out.decode("utf-8", errors="replace").split("\0") if code == 0 else []
    # Atlas's own runtime dir must not invalidate the cache it lives in.
    relevant = [e for e in entries if e and not e[3:].startswith(".atlas/")]
    digest = hashlib.sha256(
        (head + "\n" + "\n".join(sorted(relevant))).encode("utf-8", errors="replace")
    ).hexdigest()
    return digest


def doc_display_names(entries, cap=6):
    names = sorted(doc_module_id(e["doc"]) for e in entries)
    if len(names) > cap:
        return ", ".join(names[:cap]) + ", +{} more".format(len(names) - cap)
    return ", ".join(names)


def compute_status(root):
    config = load_config(root)
    thresholds = status_thresholds(config)

    markers = find_conflict_markers(root)
    if markers:
        return {
            "ok": True, "mapped": True, "tier": 3,
            "message": (
                "Atlas map untrustworthy (merge conflict markers in {}). "
                "Disregard the imported INDEX, treat the map as absent, and "
                "run /atlas update.".format(", ".join(markers))
            ),
            "affected_docs": None, "total_docs": None, "changed_files": None,
            "baseline": None,
        }

    # Map integrity (fast lint subset): a structurally-broken map is tier 3
    # no matter how little drift there is.
    integrity = None
    docs, fm_errors = load_validated_docs(root)
    index_path = os.path.join(root, INDEX_RELPATH)
    if fm_errors:
        integrity = "invalid frontmatter in {} doc(s)".format(len(fm_errors))
    elif not docs:
        integrity = "no map docs found"
    elif os.path.getsize(index_path) > INDEX_HARD_CHARS:
        integrity = "INDEX over its token budget"
    else:
        with open(index_path, "r", encoding="utf-8", errors="replace") as f:
            actual = f.read()
        if build_index_text(root, docs) != actual:
            integrity = "INDEX out of sync with doc frontmatter"
    if integrity:
        return {
            "ok": True, "mapped": True, "tier": 3,
            "message": (
                "Atlas map untrustworthy ({}). Disregard the imported INDEX, "
                "treat the map as absent, and run /atlas update."
                .format(integrity)
            ),
            "affected_docs": None, "total_docs": None, "changed_files": None,
            "baseline": None,
        }

    diff = compute_diff(root)
    if not diff["ok"]:
        return {
            "ok": True, "mapped": True, "tier": 3,
            "message": (
                "Atlas map untrustworthy ({}). Disregard the imported INDEX, "
                "treat the map as absent, and run /atlas update."
                .format(diff["error"])
            ),
            "affected_docs": None, "total_docs": None, "changed_files": None,
            "baseline": None,
        }

    summary = diff["summary"]
    affected = summary["affected_docs"]
    total = summary["total_docs"]
    pct = summary["affected_pct"]
    changed_files = summary["changed_files"]
    baseline = diff["baseline"]
    affected_entries = (diff["stale_docs"] + diff["orphaned_docs"] +
                        diff["renamed_docs"] + diff["fingerprint_stale"] +
                        diff["ripple_docs"])
    overview_affected = any(
        e["doc"].startswith("overview/") for e in affected_entries)

    if pct >= thresholds["untrust_pct"]:
        tier = 3
    elif (pct >= thresholds["recommend_pct"] or overview_affected
          or changed_files > thresholds["recommend_files"]
          or (affected > 0 and not baseline["is_ancestor"])):
        tier = 2
    elif affected > 0:
        tier = 1
    else:
        tier = 0

    behind = ""
    if baseline["is_ancestor"] and baseline["commits_behind"]:
        behind = ", {} commits behind".format(baseline["commits_behind"])

    if tier == 0:
        message = ""
    elif tier == 3:
        message = (
            "Atlas map untrustworthy ({} of {} map docs stale{}). Disregard "
            "the imported INDEX, treat the map as absent, and run /atlas "
            "update.".format(affected, total, behind)
        )
    else:
        names = doc_display_names(affected_entries)
        message = "Atlas: {} of {} map docs stale ({}{}).".format(
            affected, total, names, behind)
        if tier == 2:
            message += " Run /atlas update before relying on those docs."

    return {
        "ok": True, "mapped": True, "tier": tier, "message": message,
        "affected_docs": affected, "total_docs": total,
        "changed_files": changed_files, "baseline": baseline,
    }


def cmd_status(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    if not os.path.isfile(os.path.join(root, INDEX_RELPATH)):
        result = {"ok": True, "mapped": False, "tier": 0, "message": "",
                  "cached": False}
        if not args.for_hook:
            result.update(affected_docs=None, total_docs=None,
                          changed_files=None, baseline=None)
        emit(result)
        return 0

    cache_path = os.path.join(root, ".atlas", "drift-cache.json")
    key = drift_cache_key(root)
    cached_result = None
    try:
        with open(cache_path, "r", encoding="utf-8") as f:
            cache = json.load(f)
        if cache.get("key") == key:
            cached_result = cache.get("result")
    except (OSError, ValueError):
        pass

    if cached_result is not None:
        result = dict(cached_result)
        result["cached"] = True
    else:
        result = compute_status(root)
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump({"key": key, "result": result}, f, indent=2)
            f.write("\n")
        result = dict(result)
        result["cached"] = False

    if args.for_hook:
        result = {"ok": result["ok"], "mapped": result["mapped"],
                  "tier": result["tier"], "message": result["message"],
                  "cached": result["cached"]}
    emit(result)
    return 0


# ─── ground (grounding pack for mapper agents) ──────────────────────────────
#
# Deterministic signals that keep LLM mappers grounded: the module's files with
# working-tree blob hashes, import-ish lines, and definition candidates ranked
# by external fan-in (aider-derived heuristics, grep-portable).

DEF_LINE_RE = re.compile(
    r"^\s*(?:public\s+|private\s+|internal\s+|open\s+|final\s+|abstract\s+"
    r"|export\s+|static\s+|async\s+|sealed\s+|data\s+)*"
    r"(func|def|class|struct|enum|protocol|interface|fn|function|type"
    r"|extension|actor|trait|impl|module|defmodule|object)"
    r"\s+([A-Za-z_][A-Za-z0-9_]*)")

IMPORT_LINE_RE = re.compile(
    r"^\s*(import|from|require|use|using|include|#include|@import|source)\b")

GROUND_MAX_IMPORT_LINES = 20   # per file
GROUND_MAX_SYMBOLS = 40
GROUND_MAX_FILE_BYTES = 200_000  # skip giants when computing fan-in


def read_text(abspath):
    try:
        with open(abspath, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def cmd_ground(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    part = do_partition(root)
    if not part["ok"]:
        emit(part)
        return 1
    module = next((m for m in part["modules"] if m["id"] == args.module_id), None)
    if module is None:
        return emit_fail(
            "unknown_module",
            "No module '{}' in the current partition. Known: {}".format(
                args.module_id, ", ".join(m["id"] for m in part["modules"])),
        )

    hashes = git_hash_paths(root, module["paths"])
    files = [{"path": p, "bytes": b, "blob": hashes.get(p)}
             for p, b in ((f, os.path.getsize(os.path.join(root, f)))
                          for f in module["paths"])]

    imports = {}
    candidates = {}  # name -> (kind, "path:line")
    for relpath in module["paths"]:
        text = read_text(os.path.join(root, relpath))
        if text is None:
            continue
        import_lines = []
        for lineno, line in enumerate(text.splitlines(), 1):
            if IMPORT_LINE_RE.match(line) and len(import_lines) < GROUND_MAX_IMPORT_LINES:
                import_lines.append(line.strip())
            m = DEF_LINE_RE.match(line)
            if m and m.group(2) not in candidates:
                candidates[m.group(2)] = (m.group(1), "{}:{}".format(relpath, lineno))
        if import_lines:
            imports[relpath] = import_lines

    # Fan-in: how many files OUTSIDE this module reference each candidate.
    scan = do_scan(root, enforce_ceiling=False)
    module_paths = set(module["paths"])
    outside_texts = []
    if scan.get("ok"):
        for f in scan["files"]:
            if f["path"] in module_paths or f["bytes"] > GROUND_MAX_FILE_BYTES:
                continue
            text = read_text(os.path.join(root, f["path"]))
            if text is not None:
                outside_texts.append(text)

    symbols = []
    for name in sorted(candidates):
        kind, defined_at = candidates[name]
        pattern = re.compile(WORDISH_BOUNDARY.format(re.escape(name)))
        fan_in = sum(1 for text in outside_texts if pattern.search(text))
        # aider-derived scoring: sqrt-dampened fan-in (0.1 keep-alive for
        # unreferenced definitions), 10x for descriptive names.
        score = (fan_in ** 0.5) if fan_in > 0 else 0.1
        if len(name) >= 8:
            score *= 10
        symbols.append({"name": name, "kind": kind, "defined_at": defined_at,
                        "fan_in": fan_in, "score": round(score, 2)})
    symbols.sort(key=lambda s: (-s["score"], s["name"]))
    symbols = symbols[:GROUND_MAX_SYMBOLS]

    return emit_ok(module={"id": module["id"], "label": module["label"],
                           "strategy": module["strategy"]},
                   files=files, imports=imports, symbols=symbols)


# ─── commit (guarded, pathspec-scoped) ───────────────────────────────────────

def run_git_capture(args, cwd):
    proc = subprocess.run(["git"] + args, cwd=cwd, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE)
    return proc.returncode, proc.stdout, proc.stderr


def git_with_index_retry(args, cwd, attempts=3):
    """Retry on index.lock contention from the user's own git activity."""
    for attempt in range(attempts):
        code, out, err = run_git_capture(args, cwd)
        if code == 0 or b"index.lock" not in err:
            return code, out, err
        time.sleep(0.5 * (attempt + 1))
    return code, out, err


def cmd_commit(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    code, _ = run_git(["rev-parse", "-q", "--verify", "MERGE_HEAD"], cwd=root)
    if code == 0:
        return emit_fail(
            "mid_merge",
            "A merge is in progress — git refuses partial commits mid-merge. "
            "Complete or abort the merge, then run /atlas update.",
        )

    paths = ["docs/atlas/"] + [p for p in (args.also or [])
                               if os.path.exists(os.path.join(root, p))]
    code, out = run_git(["status", "--porcelain", "-z", "--"] + paths, cwd=root)
    if code == 0 and not out.strip():
        return emit_ok(committed=False, message="Nothing to commit in the map paths.")

    code, _, err = git_with_index_retry(["add", "--"] + paths, cwd=root)
    if code != 0:
        return emit_fail("git_add_failed", err.decode("utf-8", errors="replace").strip())
    code, _, err = git_with_index_retry(
        ["commit", "-m", args.message, "--"] + paths, cwd=root)
    if code != 0:
        return emit_fail("git_commit_failed", err.decode("utf-8", errors="replace").strip())

    sha = git_head(root)
    return emit_ok(committed=True, sha=sha)


# ─── init / remove (CLAUDE.md managed block + gitignore wiring) ──────────────

CLAUDE_MD_START = "<!-- atlas:start -->"
CLAUDE_MD_END = "<!-- atlas:end -->"

CLAUDE_MD_BLOCK = """<!-- atlas:start -->
## Codebase Map (atlas)

@docs/atlas/INDEX.md

- The imported INDEX above is this project's codebase map. Use its routing
  table: read the listed module doc before working in that area.
- The map covers code structure only; build/test/workflow guidance lives in
  the rest of this file.
- After committing changes to mapped source files, suggest running
  `/atlas update`.
<!-- atlas:end -->"""

GITIGNORE_LINE = ".atlas/"
GITIGNORE_COMMENT = "# Atlas runtime state (ephemeral, never committed)"


def claude_md_block_re():
    return re.compile(
        re.escape(CLAUDE_MD_START) + r".*?" + re.escape(CLAUDE_MD_END),
        re.DOTALL)


def cmd_init(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    claude_path = os.path.join(root, "CLAUDE.md")
    if os.path.isfile(claude_path):
        with open(claude_path, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
        if CLAUDE_MD_START in text:
            text = claude_md_block_re().sub(CLAUDE_MD_BLOCK, text, count=1)
            action = "replaced"
        else:
            text = text.rstrip("\n") + "\n\n" + CLAUDE_MD_BLOCK + "\n"
            action = "appended"
    else:
        text = CLAUDE_MD_BLOCK + "\n"
        action = "created"
    with open(claude_path, "w", encoding="utf-8") as f:
        f.write(text)

    gitignore_path = os.path.join(root, ".gitignore")
    gitignore_action = "present"
    lines = []
    if os.path.isfile(gitignore_path):
        with open(gitignore_path, "r", encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    if GITIGNORE_LINE not in lines:
        if lines and lines[-1].strip():
            lines.append("")
        lines.extend([GITIGNORE_COMMENT, GITIGNORE_LINE])
        with open(gitignore_path, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        gitignore_action = "added"

    return emit_ok(claude_md=action, gitignore=gitignore_action)


def cmd_remove(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")

    claude_path = os.path.join(root, "CLAUDE.md")
    if not os.path.isfile(claude_path):
        return emit_ok(claude_md="absent")
    with open(claude_path, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    if CLAUDE_MD_START not in text:
        return emit_ok(claude_md="absent")
    text = claude_md_block_re().sub("", text, count=1)
    text = re.sub(r"\n{3,}", "\n\n", text).rstrip("\n") + "\n"
    with open(claude_path, "w", encoding="utf-8") as f:
        f.write(text)
    return emit_ok(claude_md="removed",
                   note="The .atlas/ gitignore entry and docs/atlas/ map files "
                        "are left in place; delete them manually if desired.")


# ─── INDEX rebuild ───────────────────────────────────────────────────────────
#
# INDEX.md is DERIVED — assembled mechanically from doc frontmatter plus the
# index-facts block in the architecture overview. Two branches that both ran
# /atlas update will conflict on INDEX; the resolution is always "rebuild",
# never hand-merge. Determinism here is what makes that safe.

INDEX_HARD_CHARS = 7000   # ≈2k tokens at ~3.5 chars/token (markdown-dense)
INDEX_WARN_CHARS = 6000

INDEX_FACTS_START = "<!-- atlas:index-facts -->"
INDEX_FACTS_END = "<!-- /atlas:index-facts -->"


def table_cell(text):
    return str(text).replace("|", "/").replace("\n", " ").strip()


def extract_index_facts(root):
    """Verbatim bullet lines from the overview's index-facts block."""
    arch = os.path.join(root, MAP_DIR, "overview", "ARCHITECTURE.md")
    if not os.path.isfile(arch):
        return []
    with open(arch, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    start = text.find(INDEX_FACTS_START)
    end = text.find(INDEX_FACTS_END)
    if start == -1 or end == -1 or end <= start:
        return []
    block = text[start + len(INDEX_FACTS_START):end]
    return [line.rstrip() for line in block.splitlines()
            if line.strip().startswith("- ")]


def ledger_baseline(root):
    try:
        with open(os.path.join(root, LEDGER_RELPATH), "r", encoding="utf-8") as f:
            return json.load(f).get("baseline")
    except (OSError, ValueError):
        return None


def build_index_text(root, docs):
    """Deterministic INDEX assembly. Returns the full file text."""
    config = load_config(root)
    project = config.get("project_name") or os.path.basename(root.rstrip("/"))
    baseline = ledger_baseline(root) or git_head(root)
    short = baseline[:7] if isinstance(baseline, str) else "unmapped"

    module_docs = sorted(
        (d for d in docs if d["doc_id"].startswith("modules/")),
        key=lambda d: d["doc_id"])
    overview_docs = sorted(
        (d for d in docs if d["doc_id"].startswith("overview/")),
        key=lambda d: d["doc_id"])
    facts = extract_index_facts(root)

    lines = []
    lines.append("# {} — Atlas Codebase Map".format(table_cell(project)))
    lines.append("")
    lines.append(
        "Generated by atlas at baseline {}. Derived file — do not edit by "
        "hand; regenerate with /atlas update.".format(short))
    lines.append(
        "Routing: before working in an area, read its module doc below.")
    lines.append("")
    lines.append("## Routing")
    lines.append("")
    lines.append("| When working on | Read |")
    lines.append("| --- | --- |")
    for doc in module_docs:
        lines.append("| {} | docs/atlas/{} |".format(
            table_cell(doc["fm"].get("read_when", "")), doc["doc_id"]))
    for doc in overview_docs:
        lines.append("| Architecture and cross-module relationships "
                     "| docs/atlas/{} |".format(doc["doc_id"]))
    lines.append("")
    lines.append("## Modules")
    lines.append("")
    lines.append("| Module | Path | Summary |")
    lines.append("| --- | --- | --- |")
    for doc in module_docs:
        lines.append("| {} | {} | {} |".format(
            doc_module_id(doc["doc_id"]),
            table_cell(doc["fm"].get("module", "")),
            table_cell(doc["fm"].get("summary", ""))))
    if facts:
        lines.append("")
        lines.append("## Key facts")
        lines.append("")
        lines.extend(facts)
    lines.append("")
    lines.append("## Reminders")
    lines.append("")
    lines.extend(facts[:2])
    lines.append(
        "- Read the routed module doc before editing unfamiliar modules; "
        "workflow and commands live in CLAUDE.md, not here.")
    return "\n".join(lines) + "\n"


def cmd_index_rebuild(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    docs, errors = load_validated_docs(root)
    if errors:
        return emit_fail(
            "invalid_frontmatter",
            "Some map docs have invalid frontmatter; fix or regenerate them.",
            docs={doc_id: msgs for doc_id, msgs in errors},
        )
    if not docs:
        return emit_fail("no_docs", "No map docs found under docs/atlas/ — "
                         "run a full map first.")
    text = build_index_text(root, docs)
    if len(text) > INDEX_HARD_CHARS:
        return emit_fail(
            "index_over_budget",
            "Rebuilt INDEX would be {} chars (hard ceiling {}). Trim module "
            "summaries, read_when entries, or index facts.".format(
                len(text), INDEX_HARD_CHARS),
            chars=len(text), hard=INDEX_HARD_CHARS,
        )
    index_path = os.path.join(root, INDEX_RELPATH)
    os.makedirs(os.path.dirname(index_path), exist_ok=True)
    with open(index_path, "w", encoding="utf-8") as f:
        f.write(text)
    return emit_ok(
        chars=len(text), modules=sum(1 for d in docs
                                     if d["doc_id"].startswith("modules/")),
        warn_chars=INDEX_WARN_CHARS, hard_chars=INDEX_HARD_CHARS,
        over_warn=len(text) > INDEX_WARN_CHARS,
    )


# ─── lint ────────────────────────────────────────────────────────────────────
#
# Mechanical integrity checks. ERROR = the map lies structurally (untrustworthy
# until fixed); WARN = probably stale or sloppy. `--fast` runs the cheap subset
# used by status/hooks: markers, drift, INDEX budget, INDEX reconciliation.

MODULE_DOC_ANCHORS = [
    "## Purpose", "## Public API", "## Load-bearing internals",
    "## Relationships", "## Type notes", "## External deps",
]

BACKTICK_RE = re.compile(r"`([^`\n]+)`")
PATHISH_RE = re.compile(r"[\w./-]+/[\w./-]+\.\w{1,8}(?::\d+)?")
LINK_RE = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)")
WORDISH_BOUNDARY = r"(?<![A-Za-z0-9_]){}(?![A-Za-z0-9_])"


def github_slug(heading):
    s = heading.strip().lower()
    s = re.sub(r"[^\w\- ]", "", s)
    return s.replace(" ", "-")


def parse_symbol_tables(body):
    """(symbol, location) rows from Public API / Load-bearing tables."""
    rows = []
    in_section = False
    table_row = 0
    for line in body.splitlines():
        stripped = line.strip()
        if stripped.startswith("## "):
            in_section = stripped in ("## Public API", "## Load-bearing internals")
            table_row = 0
            continue
        if not in_section or not stripped.startswith("|"):
            continue
        table_row += 1
        if table_row <= 2:  # header + separator
            continue
        cells = [c.strip().strip("`") for c in stripped.strip("|").split("|")]
        if len(cells) >= 3 and cells[0]:
            rows.append((cells[0], cells[2]))
    return rows


def lint_map(root, fast=False):
    findings = []

    def add(check, severity, file, message):
        findings.append({"check": check, "severity": severity,
                         "file": file, "message": message})

    # L2 — conflict markers (any map file)
    for relfile in find_conflict_markers(root):
        add("L2", "ERROR", relfile, "merge conflict markers present — "
            "doc is invalid; regenerate it (see README conflict recipe)")

    # Frontmatter validity gates everything doc-driven.
    docs, fm_errors = load_validated_docs(root)
    for doc_id, msgs in fm_errors:
        add("L1", "ERROR", "docs/atlas/" + doc_id,
            "invalid frontmatter: " + "; ".join(msgs))

    index_path = os.path.join(root, INDEX_RELPATH)

    # L9 — INDEX budget
    if os.path.isfile(index_path):
        size = os.path.getsize(index_path)
        if size > INDEX_HARD_CHARS:
            add("L9", "ERROR", "docs/atlas/INDEX.md",
                "INDEX is {} chars, over the {} hard ceiling "
                "(~2k tokens)".format(size, INDEX_HARD_CHARS))
        elif size > INDEX_WARN_CHARS:
            add("L9", "WARN", "docs/atlas/INDEX.md",
                "INDEX is {} chars, past the {} warning threshold".format(
                    size, INDEX_WARN_CHARS))
    else:
        add("L9", "ERROR", "docs/atlas/INDEX.md",
            "INDEX.md missing — run `index rebuild`")

    # L10 — INDEX reconciliation (byte-compare against a fresh rebuild)
    if not fm_errors and docs and os.path.isfile(index_path):
        expected = build_index_text(root, docs)
        with open(index_path, "r", encoding="utf-8", errors="replace") as f:
            actual = f.read()
        if expected != actual:
            add("L10", "ERROR", "docs/atlas/INDEX.md",
                "INDEX does not match a rebuild from doc frontmatter — "
                "run `index rebuild` (never hand-merge)")

    # L4 — ledger drift
    diff = None
    if not fm_errors and docs:
        diff = compute_diff(root)
        if diff["ok"] and diff["summary"]["affected_docs"]:
            entries = (diff["stale_docs"] + diff["orphaned_docs"] +
                       diff["renamed_docs"] + diff["fingerprint_stale"] +
                       diff["ripple_docs"])
            add("L4", "WARN", "docs/atlas/atlas-ledger.json",
                "{} of {} docs out of date ({}) — run /atlas update".format(
                    diff["summary"]["affected_docs"],
                    diff["summary"]["total_docs"],
                    doc_display_names(entries)))

    if fast:
        return findings

    file_text_cache = {}

    def read_repo_file(relpath):
        if relpath not in file_text_cache:
            try:
                with open(os.path.join(root, relpath), "r",
                          encoding="utf-8", errors="replace") as f:
                    file_text_cache[relpath] = f.read()
            except OSError:
                file_text_cache[relpath] = None
        return file_text_cache[relpath]

    for doc in docs:
        doc_file = "docs/atlas/" + doc["doc_id"]
        body = doc["body"]

        # L1 — skeleton conformance (module docs)
        if doc["doc_id"].startswith("modules/"):
            body_lines = [l.strip() for l in body.splitlines()]
            if not any(l.startswith("# Module: ") for l in body_lines):
                add("L1", "ERROR", doc_file, "missing `# Module: <path>` title")
            positions = []
            for anchor in MODULE_DOC_ANCHORS:
                try:
                    positions.append(body_lines.index(anchor))
                except ValueError:
                    add("L1", "ERROR", doc_file,
                        "missing required section `{}`".format(anchor))
                    positions = None
                    break
            if positions and positions != sorted(positions):
                add("L1", "ERROR", doc_file,
                    "required sections out of canonical order")

        # L3 — ledger source paths exist
        for entry in doc["fm"].get("sources", []):
            if not os.path.isfile(os.path.join(root, entry["path"])):
                add("L3", "ERROR", doc_file,
                    "ledger source `{}` does not exist".format(entry["path"]))

        # L6 — backticked path-ish mentions resolve
        for match in BACKTICK_RE.finditer(body):
            token = match.group(1)
            if not PATHISH_RE.fullmatch(token):
                continue
            relpath = token.rsplit(":", 1)[0] if re.search(r":\d+$", token) else token
            if not os.path.exists(os.path.join(root, relpath)):
                add("L6", "WARN", doc_file,
                    "backticked path `{}` not found in repo".format(token))

        # L7 — symbol existence (grep the claimed location)
        if doc["doc_id"].startswith("modules/"):
            for symbol, location in parse_symbol_tables(body):
                relpath = location.rsplit(":", 1)[0] \
                    if re.search(r":\d+$", location) else location
                content = read_repo_file(relpath) if relpath else None
                if content is None:
                    continue  # dead path already flagged by L6
                if not re.search(WORDISH_BOUNDARY.format(re.escape(symbol)),
                                 content):
                    add("L7", "WARN", doc_file,
                        "symbol `{}` not found in `{}`".format(symbol, relpath))

        # L8 — intra-map links resolve
        for match in LINK_RE.finditer(body):
            target = match.group(1)
            if target.startswith(("http://", "https://", "mailto:", "#")):
                continue
            file_part, _, anchor = target.partition("#")
            doc_dir = os.path.dirname(os.path.join(root, MAP_DIR, doc["doc_id"]))
            target_abs = os.path.normpath(os.path.join(doc_dir, file_part))
            if not os.path.isfile(target_abs):
                add("L8", "ERROR", doc_file,
                    "link target `{}` does not exist".format(target))
            elif anchor:
                with open(target_abs, "r", encoding="utf-8",
                          errors="replace") as f:
                    slugs = [github_slug(l.lstrip("#"))
                             for l in f.read().splitlines()
                             if l.startswith("#")]
                if anchor not in slugs:
                    add("L8", "WARN", doc_file,
                        "anchor `#{}` not found in `{}`".format(anchor, file_part))

    # L5 — coverage: mappable files no module doc draws from
    scan = do_scan(root, enforce_ceiling=False)
    if scan.get("ok"):
        covered = set()
        for doc in docs:
            if doc["doc_id"].startswith("modules/"):
                covered.update(e["path"] for e in doc["fm"].get("sources", []))
        uncovered = [f["path"] for f in scan["files"] if f["path"] not in covered]
        if uncovered:
            sample = ", ".join(uncovered[:10])
            if len(uncovered) > 10:
                sample += ", +{} more".format(len(uncovered) - 10)
            add("L5", "WARN", "docs/atlas/",
                "{} mappable files not covered by any module doc: {}".format(
                    len(uncovered), sample))

    # L11 — ledger/baseline sanity
    ledger_path = os.path.join(root, LEDGER_RELPATH)
    if not os.path.isfile(ledger_path):
        add("L11", "WARN", "docs/atlas/atlas-ledger.json",
            "derived ledger missing — run `ledger finalize`")
    else:
        baseline = ledger_baseline(root)
        if baseline and not git_commit_exists(root, baseline):
            add("L11", "WARN", "docs/atlas/atlas-ledger.json",
                "baseline commit {} not in object database (history "
                "rewritten?) — informational; invalidation uses blob "
                "hashes".format(baseline[:7]))

    return findings


def cmd_lint(args):
    root = git_toplevel(args.project_dir)
    if root is None:
        return emit_fail("not_a_git_repo", "atlas requires a git repository.")
    findings = lint_map(root, fast=args.fast)
    errors = [f for f in findings if f["severity"] == "ERROR"]
    warnings = [f for f in findings if f["severity"] == "WARN"]
    result = {
        "ok": not errors, "fast": args.fast,
        "error_count": len(errors), "warning_count": len(warnings),
        "errors": errors, "warnings": warnings,
    }
    if errors:
        result["error"] = "lint_errors"
        result["message"] = "{} lint error(s) — the map is untrustworthy " \
            "until these are fixed.".format(len(errors))
    emit(result)
    return 0 if not errors else 1


# ─── Glob matching ───────────────────────────────────────────────────────────

def glob_to_regex(pattern):
    """Translate a glob with **, *, ? into an anchored regex on a relpath."""
    i, n = 0, len(pattern)
    out = []
    while i < n:
        c = pattern[i]
        if c == "*":
            if pattern[i:i + 3] == "**/":
                out.append("(?:.*/)?")
                i += 3
            elif pattern[i:i + 2] == "**":
                out.append(".*")
                i += 2
            else:
                out.append("[^/]*")
                i += 1
        elif c == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(c))
            i += 1
    return re.compile("^" + "".join(out) + "$")


class GlobSet:
    """A list of glob patterns; bare patterns (no slash) also match basenames."""

    def __init__(self, patterns):
        self.entries = [
            (glob_to_regex(p), "/" not in p) for p in patterns if p
        ]

    def matches(self, path):
        base = os.path.basename(path)
        for regex, bare in self.entries:
            if regex.match(path):
                return True
            if bare and regex.match(base):
                return True
        return False


# ─── scan ────────────────────────────────────────────────────────────────────

def has_nul_prefix(abspath):
    try:
        with open(abspath, "rb") as f:
            return b"\0" in f.read(SNIFF_BYTES)
    except OSError:
        return True  # unreadable files are not mappable


def do_scan(project_dir, enforce_ceiling=True):
    """Returns a result dict; result["ok"] indicates success."""
    root = git_toplevel(project_dir)
    if root is None:
        return {
            "ok": False, "error": "not_a_git_repo",
            "message": "atlas requires a git repository; "
                       "run from inside a git work tree.",
        }

    config = load_config(root)
    includes = GlobSet(config.get("include") or ["**"])
    excludes = GlobSet(DEFAULT_EXCLUDES + list(config.get("exclude") or []))
    ceiling = config.get("max_files")
    if not isinstance(ceiling, int) or ceiling <= 0:
        ceiling = DEFAULT_MAX_FILES

    files = []
    excluded_count = 0
    total_bytes = 0
    for relpath in git_listed_files(root):
        abspath = os.path.join(root, relpath)
        if not os.path.isfile(abspath):
            continue  # deleted from worktree, submodule gitlink, broken link
        if not includes.matches(relpath) or excludes.matches(relpath):
            excluded_count += 1
            continue
        ext = relpath.rsplit(".", 1)[-1].lower() if "." in os.path.basename(relpath) else ""
        if ext in BINARY_EXTENSIONS:
            excluded_count += 1
            continue
        if has_nul_prefix(abspath):
            excluded_count += 1
            continue
        size = os.path.getsize(abspath)
        files.append({"path": relpath, "bytes": size})
        total_bytes += size

    if enforce_ceiling and len(files) > ceiling:
        return {
            "ok": False, "error": "ceiling_exceeded",
            "message": (
                "Found {} mappable files, above the ceiling of {}. Narrow "
                "include/exclude globs in {} or raise max_files if you really "
                "mean it — full maps this large degrade mapper quality."
                .format(len(files), ceiling, CONFIG_RELPATH)
            ),
            "total_files": len(files), "ceiling": ceiling,
        }

    return {
        "ok": True, "root": root, "files": files,
        "total_files": len(files), "total_bytes": total_bytes,
        "ceiling": ceiling, "excluded_count": excluded_count,
    }


def cmd_scan(args):
    result = do_scan(args.project_dir)
    emit(result)
    return 0 if result["ok"] else 1


# ─── partition ───────────────────────────────────────────────────────────────

def sanitize_id(seed):
    s = seed.replace("/", "-")
    s = re.sub(r"[^A-Za-z0-9._-]+", "-", s)
    s = re.sub(r"-{2,}", "-", s).strip("-.")
    return s or "root"


def deepest_common_dir(paths):
    dirs = [p.rsplit("/", 1)[0] if "/" in p else "" for p in paths]
    if any(d == "" for d in dirs):
        return ""
    split = [d.split("/") for d in dirs]
    prefix = []
    for segments in zip(*split):
        if all(seg == segments[0] for seg in segments):
            prefix.append(segments[0])
        else:
            break
    return "/".join(prefix)


class _DirNode:
    __slots__ = ("dirs", "files")

    def __init__(self):
        self.dirs = {}
        self.files = []  # list of (relpath, bytes)


def build_tree(entries):
    root = _DirNode()
    for entry in entries:
        parts = entry["path"].split("/")
        node = root
        for segment in parts[:-1]:
            node = node.dirs.setdefault(segment, _DirNode())
        node.files.append((entry["path"], entry["bytes"]))
    return root


def collect_files(node):
    out = list(node.files)
    for child in node.dirs.values():
        out.extend(collect_files(child))
    out.sort()
    return out


def make_partition(label, id_seed, strategy, files):
    return {
        "id_seed": id_seed, "label": label, "strategy": strategy,
        "file_entries": files,
    }


def split_bucket(bucket, path, caps):
    """Split an over-cap bucket: stem clusters first, then greedy chunks."""
    base = path or "root"
    out = []
    groups = {}
    leftover = []
    for f in bucket:
        name = os.path.basename(f[0])
        m = re.match(r"^([^-_]+)[-_].", name)
        if m:
            groups.setdefault(m.group(1).lower(), []).append(f)
        else:
            leftover.append(f)
    for stem in sorted(groups):
        g = sorted(groups[stem])
        g_bytes = sum(b for _, b in g)
        if caps["min_files"] <= len(g) <= caps["max_files"] and g_bytes <= caps["max_bytes"]:
            label = "{}/{}*".format(path, stem) if path else "{}*".format(stem)
            out.append(make_partition(label, "{}-{}".format(base, stem), "stem", g))
        else:
            # Under-min or over-cap stem groups fall through to chunking.
            leftover.extend(g)
    leftover.sort()
    chunks = []
    cur, cur_bytes = [], 0
    for f in leftover:
        if cur and (len(cur) >= caps["max_files"] or cur_bytes + f[1] > caps["max_bytes"]):
            chunks.append(cur)
            cur, cur_bytes = [], 0
        cur.append(f)
        cur_bytes += f[1]
    if cur:
        chunks.append(cur)
    for idx, chunk in enumerate(chunks, 1):
        out.append(make_partition(
            "{} (chunk {})".format(base, idx),
            "{}-chunk-{}".format(base, idx), "chunk", chunk,
        ))
    return out


def decide(node, path, caps):
    files_all = collect_files(node)
    if not files_all:
        return []
    agg_bytes = sum(b for _, b in files_all)
    if len(files_all) <= caps["max_files"] and agg_bytes <= caps["max_bytes"]:
        label = deepest_common_dir([p for p, _ in files_all]) or "root"
        return [make_partition(label, label, "dir", files_all)]

    parts = []
    small = []
    for name in sorted(node.dirs):
        child_path = "{}/{}".format(path, name) if path else name
        for p in decide(node.dirs[name], child_path, caps):
            if p["strategy"] == "dir" and len(p["file_entries"]) < caps["min_files"]:
                small.append(p)
            else:
                parts.append(p)

    bucket = sorted(node.files + [f for p in small for f in p["file_entries"]])
    if bucket:
        base = path or "root"
        bucket_bytes = sum(b for _, b in bucket)
        if len(bucket) <= caps["max_files"] and bucket_bytes <= caps["max_bytes"]:
            parts.append(make_partition(
                "{} (misc)".format(base), "{}-misc".format(base),
                "coalesced", bucket,
            ))
        else:
            parts.extend(split_bucket(bucket, path, caps))
    return parts


def apply_overrides(entries, config):
    """Claim files for config `modules:` overrides; first match wins."""
    overrides = config.get("modules")
    claimed_parts = []
    if not isinstance(overrides, list):
        return claimed_parts, entries

    remaining = entries
    for override in overrides:
        if not isinstance(override, dict):
            continue
        name = override.get("name")
        globs = override.get("globs")
        if not name or not isinstance(globs, list):
            continue
        globset = GlobSet([g for g in globs if isinstance(g, str)])
        claimed = [e for e in remaining if globset.matches(e["path"])]
        remaining = [e for e in remaining if not globset.matches(e["path"])]
        if claimed:
            files = sorted((e["path"], e["bytes"]) for e in claimed)
            claimed_parts.append(make_partition(str(name), str(name), "override", files))
    return claimed_parts, remaining


def do_partition(project_dir):
    scan = do_scan(project_dir)
    if not scan["ok"]:
        return scan

    config = load_config(scan["root"])
    caps = partition_caps(config)

    override_parts, remaining = apply_overrides(scan["files"], config)
    tree = build_tree(remaining)
    parts = override_parts + decide(tree, "", caps)

    assigned_ids = set()
    modules = []
    for p in parts:
        base_id = sanitize_id(p["id_seed"])
        candidate = base_id
        suffix = 2
        while candidate in assigned_ids:
            candidate = "{}-{}".format(base_id, suffix)
            suffix += 1
        assigned_ids.add(candidate)
        modules.append({
            "id": candidate,
            "label": p["label"],
            "strategy": p["strategy"],
            "files": len(p["file_entries"]),
            "bytes": sum(b for _, b in p["file_entries"]),
            "paths": [path for path, _ in p["file_entries"]],
        })

    modules.sort(key=lambda m: m["id"])
    return {
        "ok": True, "root": scan["root"], "modules": modules,
        "module_count": len(modules), "unassigned": [],
    }


def cmd_partition(args):
    result = do_partition(args.project_dir)
    emit(result)
    return 0 if result["ok"] else 1


# ─── main ────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="atlas-cli",
        description="Deterministic operations for the atlas plugin.",
    )
    parser.add_argument(
        "--project-dir", default=".",
        help="Project directory (default: current directory)",
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("scan", help="Enumerate mappable files")
    sub.add_parser("partition", help="Partition mappable files into modules")

    ledger = sub.add_parser("ledger", help="Blob-SHA dependency ledger")
    ledger_sub = ledger.add_subparsers(dest="ledger_command")
    finalize = ledger_sub.add_parser(
        "finalize", help="Validate frontmatter and rebuild atlas-ledger.json")
    finalize.add_argument(
        "--refresh-hashes", action="store_true",
        help="Recompute blob/tree hashes from the working tree and rewrite docs")
    finalize.add_argument(
        "--generator", default=None,
        help="Stamp this generator fingerprint into refreshed docs")
    diff = ledger_sub.add_parser(
        "diff", help="Classify map docs against the repo as it exists now")
    diff.add_argument(
        "--generator", default=None,
        help="Flag docs whose generator fingerprint differs from this")
    set_verified = ledger_sub.add_parser(
        "set-verified", help="Stamp a doc's map-verifier verdict")
    set_verified.add_argument("doc_id", help="Doc id, e.g. modules/src-auth.md")
    set_verified.add_argument("value", choices=["true", "false"])

    lock = sub.add_parser("lock", help="Heartbeat lock for map operations")
    lock_sub = lock.add_subparsers(dest="lock_command")
    acquire = lock_sub.add_parser("acquire", help="Acquire the lock")
    acquire.add_argument("--holder", default="atlas")
    acquire.add_argument("--ttl", type=int, default=LOCK_TTL_DEFAULT,
                         help="Seconds without heartbeat before takeover")
    lock_sub.add_parser("heartbeat", help="Refresh the lock heartbeat")
    lock_sub.add_parser("release", help="Release the lock")

    status = sub.add_parser("status", help="Staleness tier for the current map")
    status.add_argument("--for-hook", action="store_true",
                        help="Trimmed output for the SessionStart hook")

    index = sub.add_parser("index", help="Derived INDEX.md operations")
    index_sub = index.add_subparsers(dest="index_command")
    index_sub.add_parser("rebuild",
                         help="Rebuild INDEX.md from doc frontmatter")

    lint = sub.add_parser("lint", help="Mechanical map integrity checks")
    lint.add_argument("--fast", action="store_true",
                      help="Cheap subset only (markers, drift, INDEX checks)")

    ground = sub.add_parser("ground", help="Grounding pack for a mapper agent")
    ground.add_argument("module_id", help="Module id from `partition`")

    commit = sub.add_parser("commit", help="Guarded pathspec-scoped map commit")
    commit.add_argument("--message", required=True)
    commit.add_argument("--also", action="append", default=[],
                        help="Additional path to include (repeatable)")

    sub.add_parser("init", help="Inject the CLAUDE.md block + gitignore entry")
    sub.add_parser("remove", help="Remove the CLAUDE.md block")

    args = parser.parse_args()
    if args.command == "scan":
        return cmd_scan(args)
    if args.command == "partition":
        return cmd_partition(args)
    if args.command == "ledger":
        if args.ledger_command == "finalize":
            return cmd_ledger_finalize(args)
        if args.ledger_command == "diff":
            return cmd_ledger_diff(args)
        if args.ledger_command == "set-verified":
            return cmd_ledger_set_verified(args)
        emit_fail("usage", "Unknown ledger command. "
                  "Available: finalize, diff, set-verified.")
        return 2
    if args.command == "lock":
        if args.lock_command in ("acquire", "heartbeat", "release"):
            return cmd_lock(args)
        emit_fail("usage", "Unknown lock command. "
                  "Available: acquire, heartbeat, release.")
        return 2
    if args.command == "status":
        return cmd_status(args)
    if args.command == "index":
        if args.index_command == "rebuild":
            return cmd_index_rebuild(args)
        emit_fail("usage", "Unknown index command. Available: rebuild.")
        return 2
    if args.command == "lint":
        return cmd_lint(args)
    if args.command == "ground":
        return cmd_ground(args)
    if args.command == "commit":
        return cmd_commit(args)
    if args.command == "init":
        return cmd_init(args)
    if args.command == "remove":
        return cmd_remove(args)

    emit_fail("usage", "Unknown or missing subcommand. Available: scan, "
              "partition, ledger, lock, status, index, lint, ground, "
              "commit, init, remove.")
    return 2


if __name__ == "__main__":
    sys.exit(main())
