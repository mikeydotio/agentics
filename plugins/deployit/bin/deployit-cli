#!/usr/bin/env python3
"""deployit CLI — orchestrates archive/export/serve/push.

Subcommands:
  bootstrap          one-time per-machine setup
  deploy             archive and publish a build
  list               show recent builds across the tailnet
  url                print this machine's listing URL
  status             backend health + recent local deploys
  gc                 prune local artifacts; archive in index
  rm                 delete a local build/product (files + index); web-UI delete
"""

import argparse
import datetime as _dt
import json
import re as _re
import shutil as _shutil
import string
import sys
import urllib.request
from pathlib import Path
from urllib.parse import urlparse, quote

import os
import shutil
import subprocess
import time
from textwrap import dedent

__version__ = "0.1.0"

# Same shape the backend enforces on build ids; `rm` re-validates independently.
_BUILD_ID_RE = _re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")

# The shared index repo. `_clone_index` clones its HTTPS URL; the PR-publish
# fallback needs the owner/repo slug for `gh`. Keep these two in sync.
INDEX_REPO_SLUG = "mikeydotio/deployit-index"
INDEX_REPO_URL = f"https://github.com/{INDEX_REPO_SLUG}.git"


def ok(payload):
    payload["ok"] = True
    print(json.dumps(payload, indent=2))


def fail(message, **extra):
    payload = {"ok": False, "display": message, **extra}
    print(json.dumps(payload, indent=2))
    sys.exit(1)


def not_implemented(name):
    fail(f"{name}: not implemented yet")


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        fail(f"argument error: {message}")


def _state_dir() -> Path:
    """Per-machine state directory. Overridable for tests via DEPLOYIT_STATE_DIR."""
    override = os.environ.get("DEPLOYIT_STATE_DIR")
    if override:
        return Path(override)
    return Path.home() / "Library" / "Application Support" / "deployit"


def _tailscale_bin() -> str:
    return os.environ.get("DEPLOYIT_TAILSCALE_BIN", "tailscale")


def _applications_dir() -> Path:
    """Where to scan for Xcode installs when resolving [toolchain] min_sdk.
    Overridable for tests via DEPLOYIT_APPLICATIONS_DIR."""
    override = os.environ.get("DEPLOYIT_APPLICATIONS_DIR")
    return Path(override) if override else Path("/Applications")


def _gh_bin() -> str:
    """Absolute path to the `gh` CLI.

    Returns an absolute path so the PR-publish fallback works from the launchd
    daemon (swipe-to-delete → `deployit-cli rm`), whose PATH is the minimal
    `/usr/bin:/bin:/usr/sbin:/sbin` and lacks Homebrew's `gh`. The
    `DEPLOYIT_GH_BIN` override (used by tests' fake gh) always wins; otherwise we
    resolve via PATH, then probe the common Homebrew (Apple-silicon / Intel)
    locations, falling back to the bare name so a clear "gh not found" surfaces
    downstream rather than here."""
    override = os.environ.get("DEPLOYIT_GH_BIN")
    if override:
        return override
    found = shutil.which("gh")
    if found:
        return found
    for cand in ("/opt/homebrew/bin/gh", "/usr/local/bin/gh"):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return "gh"


def _parse_owner_repo(remote_url: str):
    """owner/repo from a GitHub remote (git@github.com:owner/repo.git or
    https://github.com/owner/repo(.git)). None if unparseable."""
    m = _re.search(r'[:/]([^/:]+)/([^/]+?)(?:\.git)?/?$', remote_url.strip())
    return f"{m.group(1)}/{m.group(2)}" if m else None


def _derive_base_url() -> str:
    """Build the listing base URL from `tailscale status --json`."""
    try:
        res = subprocess.run(
            [_tailscale_bin(), "status", "--json"],
            capture_output=True, text=True, check=True, timeout=5,
        )
    except FileNotFoundError:
        fail(f"tailscale binary not found at {_tailscale_bin()!r} — install Tailscale or set DEPLOYIT_TAILSCALE_BIN")
    except subprocess.CalledProcessError as exc:
        fail(f"tailscale status failed: {exc.stderr.strip() or exc}")
    except subprocess.TimeoutExpired:
        fail("tailscale status timed out after 5s — is the daemon running?")
    try:
        data = json.loads(res.stdout)
        dns = data["Self"]["DNSName"].rstrip(".")
    except (json.JSONDecodeError, KeyError) as exc:
        fail(f"could not parse tailscale status output: {exc}")
    return f"https://{dns}/deployit"


def _write_config(state: Path, plugin_root: Path, base_url: str) -> Path:
    """Write config.toml on first run; preserve user edits on re-run."""
    cfg = state / "config.toml"
    if cfg.exists():
        return cfg
    template = (plugin_root / "assets" / "config.example.toml").read_text()
    template = template.replace(
        'base_url = "https://<host>.<tailnet>.ts.net/deployit"',
        f'base_url = "{base_url}"',
    )
    cfg.write_text(template)
    return cfg


def _ensure_dirs(state: Path):
    for sub in ("serve", "index", "logs", "bin"):
        (state / sub).mkdir(parents=True, exist_ok=True)


def _atomic_symlink(target: Path, link: Path):
    """Atomically point `link` at `target` via tmpfile + os.replace, so a
    concurrent reader never sees a missing or half-formed symlink."""
    link.parent.mkdir(parents=True, exist_ok=True)
    tmp = link.with_name(link.name + ".tmp")
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    tmp.symlink_to(target)
    os.replace(tmp, link)


def _sync_plugin_root(state: Path, plugin_root: Path):
    """Point the daemon's stable indirection symlinks at `plugin_root`:
      <state>/_plugin_root              → <plugin_root>
      <state>/bin/deployit-backend      → <plugin_root>/bin/deployit-backend

    The launchd plist references these stable paths, so plugin upgrades only
    need to move the symlinks — never regenerate the plist."""
    plugin_root = plugin_root.resolve()
    backend = plugin_root / "bin" / "deployit-backend"
    if not backend.is_file():
        fail(f"plugin_root has no bin/deployit-backend: {plugin_root}")
    _atomic_symlink(plugin_root, state / "_plugin_root")
    _atomic_symlink(backend, state / "bin" / "deployit-backend")


def _clone_index(state: Path):
    """Clone the shared index repo. Skipped in tests via DEPLOYIT_SKIP_INDEX_CLONE."""
    if os.environ.get("DEPLOYIT_SKIP_INDEX_CLONE"):
        (state / "index" / "builds.json").write_text(
            json.dumps({"version": 1, "builds": []}))
        return
    index_dir = state / "index"
    if (index_dir / ".git").is_dir():
        return
    # Re-clone fresh; the placeholder builds.json from _ensure_dirs is overwritten.
    shutil.rmtree(index_dir)
    subprocess.run(
        ["git", "clone", INDEX_REPO_URL, str(index_dir)],
        check=True, timeout=30,
    )


def _configure_tailscale_serve(port: int):
    """Front the local backend with HTTPS via Tailscale Serve. Idempotent."""
    if os.environ.get("DEPLOYIT_SKIP_TAILSCALE_SERVE"):
        return
    subprocess.run(
        [_tailscale_bin(), "serve", "--bg", str(port)],
        check=False, timeout=10,
    )


def _launchd_plist(state: Path, port: int) -> str:
    """Generate a launchd plist that references STABLE symlinks under <state>.

    The plist is immutable across plugin upgrades — only `_sync_plugin_root`'s
    symlinks move. This prevents the daemon from getting pinned to a stale
    content-addressed plugin cache directory."""
    return dedent(f"""\
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
          <key>Label</key><string>com.mikeydotio.deployit.backend</string>
          <key>ProgramArguments</key>
          <array>
            <string>/usr/bin/env</string>
            <string>python3</string>
            <string>{state}/bin/deployit-backend</string>
            <string>--port</string><string>{port}</string>
            <string>--root</string><string>{state}</string>
            <string>--plugin-root</string><string>{state}/_plugin_root</string>
          </array>
          <key>RunAtLoad</key><true/>
          <key>KeepAlive</key><true/>
          <key>StandardOutPath</key><string>{state}/logs/backend.log</string>
          <key>StandardErrorPath</key><string>{state}/logs/backend.err.log</string>
        </dict>
        </plist>
        """)


def _install_launchd(state: Path, port: int) -> dict:
    """Write and load the launchd agent. Skipped in tests via DEPLOYIT_SKIP_LAUNCHD."""
    if os.environ.get("DEPLOYIT_SKIP_LAUNCHD"):
        return {"loaded": False, "skipped": True}
    plist_dir = Path.home() / "Library" / "LaunchAgents"
    plist_dir.mkdir(parents=True, exist_ok=True)
    plist_path = plist_dir / "com.mikeydotio.deployit.backend.plist"
    plist_path.write_text(_launchd_plist(state, port))
    launchctl = os.environ.get("DEPLOYIT_LAUNCHCTL_BIN", "launchctl")
    subprocess.run([launchctl, "bootout", f"gui/{os.getuid()}/com.mikeydotio.deployit.backend"],
                   check=False)
    res = subprocess.run([launchctl, "bootstrap", f"gui/{os.getuid()}", str(plist_path)],
                         capture_output=True, text=True, check=False)
    return {
        "loaded": res.returncode == 0,
        "skipped": False,
        "launchctl_stderr": res.stderr.strip() if res.returncode != 0 else None,
    }


_PLATFORM_SUFFIX = {"ios": "iOS", "macos": "macOS", "visionos": "visionOS"}


def _find_workspace(cwd: Path):
    for p in cwd.glob("*.xcworkspace"):
        return p
    return None


def _find_xcodeproj(cwd: Path):
    for p in cwd.glob("*.xcodeproj"):
        return p
    return None


def _find_apps_project_yml(cwd: Path, platform: str):
    """Return the first project.yml under Apps/ whose name suggests the platform.
    Falls back to any Apps/*/project.yml."""
    suffix = _PLATFORM_SUFFIX[platform]
    candidates = sorted(cwd.glob(f"Apps/*-{suffix}/project.yml")) \
              or sorted(cwd.glob("Apps/*/project.yml"))
    return candidates[0] if candidates else None


def _read_yaml_scalar(text: str, key: str):
    """Return the first occurrence of `key: value` in `text`, accepting either a
    double-quoted value (`KEY: "v"`) or a bare scalar (`KEY: v`). Returns None
    if the key is not present."""
    m = _re.search(rf'\b{_re.escape(key)}\s*:\s*(?:"([^"\n]+)"|(\S+))', text)
    if not m:
        return None
    return m.group(1) if m.group(1) is not None else m.group(2)


def _read_marketing_version(project_yml: Path) -> str:
    v = _read_yaml_scalar(project_yml.read_text(), "MARKETING_VERSION")
    if v is None:
        fail(f"Could not parse MARKETING_VERSION from {project_yml}")
    return v


def _read_bundle_id(project_yml: Path) -> str:
    v = _read_yaml_scalar(project_yml.read_text(), "PRODUCT_BUNDLE_IDENTIFIER")
    if v is None:
        fail(f"Could not parse PRODUCT_BUNDLE_IDENTIFIER from {project_yml}")
    return v


def _short_sha(cwd: Path) -> str:
    try:
        res = subprocess.run(
            ["git", "-C", str(cwd), "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True, check=True, timeout=5,
        )
    except FileNotFoundError:
        fail("git binary not found on PATH")
    except subprocess.CalledProcessError as exc:
        fail(f"git rev-parse failed (not a git repo or no commits?): {exc.stderr.strip() or exc}")
    except subprocess.TimeoutExpired:
        fail("git rev-parse timed out")
    return res.stdout.strip()


def _derive_metadata(cwd: Path, platform: str) -> dict:
    """Detect the Xcode project + spec layout. Supports two shapes:

    Apps-layout (Lillist):   ./Foo.xcworkspace + ./Apps/Foo-<Platform>/project.yml
                             default scheme = "<Project>-<Platform>"

    Single-app layout:       ./Foo.xcodeproj   + ./project.yml
                             default scheme = "<project>" (the .xcodeproj stem)

    Apps-layout takes precedence when both signals are present, so existing
    consumers keep working unchanged.
    """
    workspace      = _find_workspace(cwd)
    apps_yml       = _find_apps_project_yml(cwd, platform)
    xcodeproj      = _find_xcodeproj(cwd)
    root_yml       = cwd / "project.yml"
    suffix         = _PLATFORM_SUFFIX[platform]

    if workspace is not None and apps_yml is not None:
        project_name   = workspace.stem
        container_flag = "-workspace"
        container_path = str(workspace)
        project_yml    = apps_yml
        default_scheme = f"{project_name}-{suffix}"
    elif xcodeproj is not None and root_yml.is_file():
        project_name   = xcodeproj.stem
        container_flag = "-project"
        container_path = str(xcodeproj)
        project_yml    = root_yml
        default_scheme = project_name
    else:
        fail(
            "no recognised Xcode project layout in cwd. "
            "deployit looks for one of:\n"
            "  • <Name>.xcworkspace + Apps/<Name>-{Platform}/project.yml (monorepo)\n"
            "  • <Name>.xcodeproj  + ./project.yml                       (single-app)\n"
            f"cwd: {cwd}"
        )

    return {
        "project": project_name,
        "platform": platform,
        "bundle_id": _read_bundle_id(project_yml),
        "marketing_version": _read_marketing_version(project_yml),
        "commit": _short_sha(cwd),
        "project_yml": str(project_yml),
        "xcode_container_flag": container_flag,
        "xcode_container_path": container_path,
        "default_scheme": default_scheme,
    }


def _parse_semver_config(cwd: Path):
    """Parse <cwd>/.semver/config.yaml into a flat dict, or None if absent.

    The file is flat `key: value` YAML (no nesting); mirror semver's own
    line-split + quote-strip parser rather than take a dependency on the
    semver plugin or a YAML library."""
    cfg = cwd / ".semver" / "config.yaml"
    if not cfg.is_file():
        return None
    out = {}
    for line in cfg.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, _, val = line.partition(":")
        out[key.strip()] = val.strip().strip('"').strip("'")
    return out


def _semver_active_version(cwd: Path):
    """Return the semver VERSION string iff semver is *active* for the project
    rooted at `cwd` — `.semver/config.yaml` exists with `tracking: true` and a
    readable VERSION file. Otherwise None.

    deployit reads semver's on-disk artifacts directly (no code dependency on
    the semver plugin). cwd is the project root, matching `_derive_metadata`
    and `semver-cli`'s own cwd-relative behaviour."""
    config = _parse_semver_config(cwd)
    if not config or config.get("tracking") != "true":
        return None
    version_file = cwd / "VERSION"
    if not version_file.is_file():
        return None
    return version_file.read_text().strip() or None


def _semver_prefix(cwd: Path) -> str:
    """Return the configured semver `version_prefix` (e.g. 'v'), default ''."""
    config = _parse_semver_config(cwd)
    return config.get("version_prefix", "") if config else ""


def _next_versions(version: str, prefix: str):
    """Compute {major, minor, patch} successors of a semver string, prefix-aware,
    or None if unparseable. e.g. 'v2.16.1' →
    {'major':'v3.0.0','minor':'v2.17.0','patch':'v2.16.2'}. Universal SemVer
    arithmetic used only to label the bump question — the bump itself is done
    by semver-cli."""
    bare = version[len(prefix):] if prefix and version.startswith(prefix) else version
    m = _re.match(r"^(\d+)\.(\d+)\.(\d+)$", bare)
    if not m:
        return None
    major, minor, patch = int(m.group(1)), int(m.group(2)), int(m.group(3))
    return {
        "major": f"{prefix}{major + 1}.0.0",
        "minor": f"{prefix}{major}.{minor + 1}.0",
        "patch": f"{prefix}{major}.{minor}.{patch + 1}",
    }


def _find_semver_cli(plugin_root: Path):
    """Locate the semver plugin's CLI so a deploy can drive a version bump.
    Order: $DEPLOYIT_SEMVER_CLI → sibling plugin in the same marketplace →
    a glob under ~/.claude. Returns a Path or None."""
    env = os.environ.get("DEPLOYIT_SEMVER_CLI")
    if env:
        p = Path(env)
        return p if p.is_file() else None
    sibling = plugin_root.parent / "semver" / "bin" / "semver-cli"
    if sibling.is_file():
        return sibling
    base = Path.home() / ".claude"
    if base.is_dir():
        for cand in base.glob("**/semver/bin/semver-cli"):
            if cand.is_file():
                return cand
    return None


def _current_branch(cwd: Path):
    """Current git branch name, or None if it cannot be determined."""
    try:
        res = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--abbrev-ref", "HEAD"],
                             capture_output=True, text=True, timeout=5)
        return res.stdout.strip() if res.returncode == 0 else None
    except Exception:
        return None


def _is_dirty(cwd: Path) -> bool:
    """True if the working tree has uncommitted changes."""
    try:
        res = subprocess.run(["git", "-C", str(cwd), "status", "--porcelain"],
                             capture_output=True, text=True, timeout=5)
        return bool(res.stdout.strip())
    except Exception:
        return False


def _is_linked_worktree(cwd: Path) -> bool:
    """True iff cwd is inside a *linked* git worktree (not the main working tree).

    In a linked worktree `--git-dir` resolves to `<repo>/.git/worktrees/<name>`
    while `--git-common-dir` resolves to the shared `<repo>/.git`; in the main
    tree both are the same `.git`. Returns False when cwd is not inside a repo.
    """
    def _rev_parse(flag: str):
        try:
            res = subprocess.run(["git", "-C", str(cwd), "rev-parse", flag],
                                 capture_output=True, text=True, timeout=5)
            return res.stdout.strip() if res.returncode == 0 else None
        except Exception:
            return None
    gd = _rev_parse("--git-dir")
    cdir = _rev_parse("--git-common-dir")
    if gd is None or cdir is None:
        return False
    base = str(cwd)
    return os.path.realpath(os.path.join(base, gd)) != os.path.realpath(os.path.join(base, cdir))


def _refuse_if_worktree(cwd: Path):
    """Refuse a deploy/bump inside a linked git worktree (override with
    DEPLOYIT_ALLOW_WORKTREE=1). Deploys and version bumps run from the main
    working tree on the main branch, never a per-issue worktree."""
    if os.environ.get("DEPLOYIT_ALLOW_WORKTREE"):
        return
    if _is_linked_worktree(cwd):
        fail("Refusing to deploy or bump from a git worktree. Deploys and version "
             "bumps run from the main working tree on the main branch, not from a "
             "per-issue worktree. Set DEPLOYIT_ALLOW_WORKTREE=1 to override.",
             error="in_worktree")


def _pull_index(state: Path):
    """Best-effort refresh of the shared index before a read. Never fatal;
    skippable via DEPLOYIT_SKIP_INDEX_PULL (e.g. remote-less test indexes)."""
    if os.environ.get("DEPLOYIT_SKIP_INDEX_PULL"):
        return
    try:
        subprocess.run(["git", "-C", str(state / "index"), "pull", "--rebase", "--quiet"],
                       check=False, timeout=15)
    except Exception:
        pass


def _latest_build_for(builds, bundle_id: str, platform: str):
    """Newest build entry matching (bundle_id, platform), or None. builds.json is
    newest-first, so the first match is the newest."""
    for b in builds:
        if b.get("bundle_id") == bundle_id and b.get("platform") == platform:
            return b
    return None


def _read_config(state: Path) -> dict:
    """Parse the bits we need out of config.toml. Use tomllib when available
    (Python 3.11+), fall back to regex on older Pythons. macOS 26 ships 3.13."""
    try:
        import tomllib
        return tomllib.loads((state / "config.toml").read_text())
    except ModuleNotFoundError:
        text = (state / "config.toml").read_text()
        port_m = _re.search(r'port\s*=\s*(\d+)', text)
        base_m = _re.search(r'base_url\s*=\s*"([^"]+)"', text)
        if port_m is None or base_m is None:
            fail("config.toml missing required server.port or server.base_url")
        notarize = bool(_re.search(r'notarize\s*=\s*true', text))
        notary_profile_m = _re.search(r'notary_profile\s*=\s*"([^"]+)"', text)
        notary_keychain_m = _re.search(r'notary_keychain\s*=\s*"([^"]+)"', text)
        # [macos.sparkle] — `enabled = true` must sit inside that section (match
        # up to the next table header); the path keys are unique so a global
        # search is unambiguous.
        sp_enabled = bool(_re.search(r'\[macos\.sparkle\][^\[]*?enabled\s*=\s*true', text))

        def _sp(key):
            m = _re.search(rf'{key}\s*=\s*"([^"]*)"', text)
            return m.group(1) if m else ""

        # [github] — release defaults on (false only when explicitly set within
        # the section); the flag keys are scoped to the table like sparkle's.
        gh_release = not bool(_re.search(r'\[github\][^\[]*?\brelease\s*=\s*false', text))
        gh_prerelease = bool(_re.search(r'\[github\][^\[]*?\bprerelease\s*=\s*true', text))
        gh_attach = bool(_re.search(r'\[github\][^\[]*?\battach_dmg\s*=\s*true', text))
        gh_clobber = bool(_re.search(r'\[github\][^\[]*?\bclobber\s*=\s*true', text))

        # [index] — publish mode + auto-merge default. auto_merge is on unless the
        # section explicitly sets it false (scoped to the table like the others).
        idx_repo_m = _re.search(r'\[index\][^\[]*?\brepo\s*=\s*"([^"]+)"', text)
        idx_publish_m = _re.search(r'\[index\][^\[]*?\bpublish\s*=\s*"([^"]+)"', text)
        idx_auto_merge = not bool(_re.search(r'\[index\][^\[]*?\bauto_merge\s*=\s*false', text))

        return {
            "server": {"port": int(port_m.group(1)), "base_url": base_m.group(1)},
            "index":  {"repo": idx_repo_m.group(1) if idx_repo_m else INDEX_REPO_URL,
                       "publish": idx_publish_m.group(1) if idx_publish_m else "auto",
                       "auto_merge": idx_auto_merge},
            "macos":  {"notarize": notarize,
                       "notary_profile": notary_profile_m.group(1) if notary_profile_m else "",
                       "notary_keychain": notary_keychain_m.group(1) if notary_keychain_m else "",
                       "sparkle": {
                           "enabled": sp_enabled,
                           "sign_update_path": _sp("sign_update_path"),
                           "private_key_path": _sp("private_key_path"),
                           "public_ed_key": _sp("public_ed_key"),
                       }},
            "github": {"release": gh_release, "prerelease": gh_prerelease,
                       "attach_dmg": gh_attach, "clobber": gh_clobber},
        }


def _read_project_config(cwd: Path) -> dict:
    """Optional per-project overrides from <cwd>/.deployit/config.toml — the
    project's own repo-committed config, separate from the per-machine
    ~/Library/Application Support/deployit/config.toml that `_read_config`
    reads. Lets different repos on the same machine pin different settings
    (e.g. a project whose build needs a specific Xcode toolchain — see
    [toolchain] / `_resolve_toolchain_developer_dir` below). Returns {} when
    the file is absent, so a repo with no .deployit/config.toml behaves
    exactly as it did before this feature existed. Reads [toolchain] and
    [build]; the file can grow more tables without a loader redesign,
    mirroring `_read_config`'s per-table shape."""
    path = cwd / ".deployit" / "config.toml"
    if not path.is_file():
        return {}
    try:
        import tomllib
        return tomllib.loads(path.read_text())
    except ModuleNotFoundError:
        return _parse_project_config_text(path.read_text())


def _parse_project_config_text(text: str) -> dict:
    """The pre-3.11 fallback parse of a project config.toml, as a pure function.

    Split out so it can be tested *directly and unconditionally* — on a 3.11+
    interpreter `_read_project_config` never reaches this branch, so a test that
    only exercised the public entry point would pass vacuously there while this
    is the sole live path everywhere else (macOS ships python 3.9).

    Accumulates each table independently. The previous shape returned
    `{"toolchain": toolchain} if toolchain else {}`, which silently discarded
    every other table — so a config.toml setting only `[build]` parsed to `{}`
    and the acknowledgement vanished without a word.

    Note `allow_debug` is matched as a bare TOML boolean, not a quoted string:
    the quoted-capture idiom used for the `[toolchain]` keys would never match
    `allow_debug = true`."""
    out = {}

    toolchain = {}
    dd_m = _re.search(r'\[toolchain\][^\[]*?developer_dir\s*=\s*"([^"]*)"', text)
    if dd_m:
        toolchain["developer_dir"] = dd_m.group(1)
    sdk_m = _re.search(r'\[toolchain\][^\[]*?min_sdk\s*=\s*"([^"]*)"', text)
    if sdk_m:
        toolchain["min_sdk"] = sdk_m.group(1)
    if toolchain:
        out["toolchain"] = toolchain

    if _re.search(r'\[build\][^\[]*?\ballow_debug\s*=\s*true', text):
        out["build"] = {"allow_debug": True}

    return out


def _resolve_toolchain_developer_dir(project_cfg: dict):
    """Resolve the DEVELOPER_DIR to archive/export with, from the project's
    [toolchain] table in .deployit/config.toml. Returns None when the
    project sets no [toolchain] table (or an empty one) — callers then build
    with whatever toolchain xcode-select/the ambient environment already
    provides, unchanged from before this feature existed.

    Precedence: an explicit `developer_dir` always wins — a per-machine
    escape hatch for a nonstandard install location. Otherwise `min_sdk`
    selects the newest /Applications/Xcode*.app whose own version is >=
    min_sdk. That's a portable selector deliberately preferred over a
    committed absolute path: Xcode install locations and names churn (e.g.
    a beta moving from ~/Downloads to /Applications, or being renamed once
    it ships stable), so pinning a path in a repo-committed file would go
    stale. It approximates the platform SDK version by Xcode's own version
    — Apple's Xcode and platform-SDK major versions track together on the
    yearly release cadence — rather than shelling out to `xcodebuild
    -showsdks` per candidate.

    fails loudly when min_sdk is set but nothing on disk satisfies it,
    rather than silently falling back to the ambient toolchain: a build
    that silently used the wrong SDK could succeed while silently omitting
    whatever the pinned SDK enables (the motivating case: Lillist's
    Private-Cloud-Compute search tier needs the iOS/macOS 27 SDK — see
    mikeydotio/lillist#70 — and a 26.x build compiles fine without it)."""
    toolchain = project_cfg.get("toolchain") or {}
    if not toolchain:
        return None

    explicit = toolchain.get("developer_dir")
    if explicit:
        if not Path(explicit).is_dir():
            fail(f"[toolchain] developer_dir={explicit!r} (from .deployit/config.toml) does not exist")
        return explicit

    min_sdk = toolchain.get("min_sdk")
    if not min_sdk:
        return None
    try:
        min_major = int(str(min_sdk).split(".")[0])
    except ValueError:
        fail(f"[toolchain] min_sdk={min_sdk!r} (from .deployit/config.toml) is not a valid version")

    apps_dir = _applications_dir()
    best_path, best_major = None, -1
    for candidate in sorted(apps_dir.glob("Xcode*.app")):
        version = _read_plist_string(candidate / "Contents" / "version.plist", "CFBundleShortVersionString")
        if not version:
            continue
        try:
            major = int(version.split(".")[0])
        except ValueError:
            continue
        if major >= min_major and major > best_major:
            best_path, best_major = candidate, major

    if best_path is None:
        fail(
            f"[toolchain] min_sdk={min_sdk!r} (from .deployit/config.toml) but no "
            f"{apps_dir}/Xcode*.app install has a version >= {min_major}. Install "
            f"the required Xcode, or set an explicit [toolchain] developer_dir."
        )
    return str(best_path / "Contents" / "Developer")


def _build_id(project: str, platform: str, commit: str) -> str:
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    return f"{project.lower()}-{platform}-{stamp}-{commit}"


def _destination_for(platform: str) -> str:
    return {
        "ios":      "generic/platform=iOS",
        "visionos": "generic/platform=visionOS",
        "macos":    "generic/platform=macOS",
    }[platform]


def _archive_argv(meta: dict, archive_path: Path, scheme) -> list:
    """The full `xcodebuild … archive` command line, as a pure function.

    Split out from `_xcodebuild_archive` so the argv can be asserted without
    running Xcode — deployit's test suite is hermetic and there is no
    `DEPLOYIT_XCODEBUILD_BIN` fake-binary seam.

    Deliberately passes **no** `-configuration` (AGE-28). An explicit
    `-configuration` on the command line overrides the scheme's ArchiveAction,
    and this function hardcoded `Debug` from the first iOS commit — so every OTA
    build deployit ever produced shipped unoptimized with `#if DEBUG` code
    compiled in. The scheme is the sole authority over what gets built; deployit
    only *measures* the result (`_archive_gate`) and refuses to ship an
    unacknowledged unoptimized one."""
    return [
        "xcodebuild",
        meta["xcode_container_flag"], meta["xcode_container_path"],
        "-scheme", scheme or meta["default_scheme"],
        "-destination", _destination_for(meta["platform"]),
        "-archivePath", str(archive_path),
        "-allowProvisioningUpdates",
        "archive",
    ]


def _settings_argv(meta: dict, scheme) -> list:
    """`xcodebuild -showBuildSettings` for the archive action, as a pure function.

    Deliberately mirrors `_archive_argv`'s container flag/path, `-scheme` and
    `-destination` exactly: if the query and the archive disagreed on any of
    those, the gate would measure a *different* build than the one it ships —
    a check that verifies the wrong thing while reporting green. A test pins
    that agreement."""
    return [
        "xcodebuild",
        meta["xcode_container_flag"], meta["xcode_container_path"],
        "-scheme", scheme or meta["default_scheme"],
        "-destination", _destination_for(meta["platform"]),
        "-showBuildSettings", "-json",
        "archive",
    ]


def _archive_build_settings(meta: dict, scheme, env=None):
    """Resolved archive build settings, straight from xcodebuild, or None.

    Asking xcodebuild is asking the only component whose answer is
    definitionally correct — it is the same binary, container, scheme,
    destination and (via `env`) DEVELOPER_DIR that the archive itself will use.
    Parsing the `.xcscheme` instead would be a second implementation of Xcode's
    own scheme resolution, free to disagree with reality.

    `env` must be the same toolchain-augmented environment the archive gets, or
    the settings could be resolved by a *different* Xcode than the one that
    builds. Returns None when xcodebuild cannot answer; the caller refuses."""
    res = subprocess.run(_settings_argv(meta, scheme), env=env,
                         capture_output=True, text=True)
    if res.returncode != 0:
        return None
    try:
        entries = json.loads(res.stdout)
    except (json.JSONDecodeError, ValueError):
        return None
    if not entries:
        return None
    return entries[0].get("buildSettings") or None


# Reasons `_archive_gate` can refuse. Distinct strings so a later refactor
# cannot collapse the branches unnoticed — a test asserts they stay distinct.
_GATE_UNACKNOWLEDGED = "unoptimized_unacknowledged"
_GATE_PUBLISH        = "unoptimized_publish"
_GATE_UNRESOLVED     = "unresolved"


def _archive_refusal_message(gate: dict, meta: dict, scheme) -> str:
    """The operator-facing text for a refused archive. Every refusal names what
    was measured and every way out, so nobody has to read the source to act."""
    name = gate["configuration"] or "?"
    if gate["reason"] == _GATE_UNRESOLVED:
        return (
            "could not determine what this archive would build — xcodebuild "
            "could not resolve the archive build settings.\n"
            f"  command: {' '.join(_settings_argv(meta, scheme))}\n"
            "This usually means the archive itself was about to fail. Fix the "
            "scheme/toolchain, then retry.\n"
            "[build] allow_debug does NOT silence this: it acknowledges a known "
            "unoptimized build, not an unknown one."
        )
    shared = (
        f"the {meta['platform']} archive would build configuration {name!r}, "
        f"which is UNOPTIMIZED (optimization level {gate['optimization_level']}).\n"
        "That ships a slow binary with any #if DEBUG code compiled in.\n"
    )
    if gate["reason"] == _GATE_PUBLISH:
        return shared + (
            "[build] allow_debug = true acknowledges an unoptimized build for "
            "installing on your own devices — it does NOT authorise publishing "
            "one. This deploy would publish a Developer-ID-signed GitHub "
            "release, which cannot be recalled.\n"
            "Ways out: deploy with --no-release, set [github] release = false, "
            "or fix the scheme's archive configuration."
        )
    return shared + (
        "Ways out:\n"
        "  • fix the scheme's ArchiveAction to build an optimized "
        "configuration (deployit no longer overrides it), or\n"
        "  • if this project deploys unoptimized builds deliberately, "
        "acknowledge it in .deployit/config.toml:\n"
        "        [build]\n"
        "        allow_debug = true\n"
        "See references/build-configuration.md."
    )


def _archive_gate(settings, project_cfg: dict, platform: str,
                  do_release: bool) -> dict:
    """Rule on whether an archive may proceed. Pure — no I/O, fully testable.

    Substance-based, never name-based: a configuration *named* Release that
    builds `-Onone` is still unoptimized, and a project may name its
    configurations anything. Ordered ladder, because a target with no Swift
    reports only the GCC key:

        SWIFT_OPTIMIZATION_LEVEL → GCC_OPTIMIZATION_LEVEL → unresolved

    Absence of `SWIFT_ACTIVE_COMPILATION_CONDITIONS` / `GCC_OPTIMIZATION_LEVEL`
    is the **healthy** signal (measured: a real Release archive omits both), so
    it must never itself trigger a refusal.

    `platform` and `do_release` are parameters rather than globals so the
    refusal boundary is directly testable. Note `do_release` is a *ceiling on
    the escape hatch*, not the trigger: it is macOS-only by construction, so
    triggering on it would leave every iOS deploy — the case that motivated
    this — unprotected."""
    settings = settings or {}
    allow_debug = bool((project_cfg.get("build") or {}).get("allow_debug"))

    swift = settings.get("SWIFT_OPTIMIZATION_LEVEL")
    gcc = settings.get("GCC_OPTIMIZATION_LEVEL")
    if swift is not None:
        optimization_level, unoptimized = swift, (swift == "-Onone")
    elif gcc is not None:
        optimization_level, unoptimized = gcc, (gcc == "0")
    else:
        optimization_level, unoptimized = None, None

    verdict = {
        "configuration": settings.get("CONFIGURATION"),
        "configuration_source": "xcodebuild -showBuildSettings",
        "optimization_level": optimization_level,
        "unoptimized": unoptimized,
        "allow_debug": allow_debug,
        "verdict": "proceed",
        "reason": None,
        "warnings": [],
    }

    if optimization_level is None:
        return {**verdict, "verdict": "refuse", "reason": _GATE_UNRESOLVED}
    if not unoptimized:
        return verdict

    name = verdict["configuration"] or "?"
    if not allow_debug:
        return {**verdict, "verdict": "refuse", "reason": _GATE_UNACKNOWLEDGED}
    # Acknowledged — but the acknowledgement covers sideloading to your own
    # devices, never an unrecallable Developer-ID-signed GitHub release.
    if do_release:
        return {**verdict, "verdict": "refuse", "reason": _GATE_PUBLISH}
    return {**verdict, "warnings": [
        f"configuration {name!r} builds unoptimized "
        f"({optimization_level}) — allowed by [build] allow_debug = true in "
        f".deployit/config.toml. This {platform} build ships without "
        f"optimization and with any #if DEBUG code compiled in."
    ]}


def _xcodebuild_archive(meta: dict, archive_path: Path, scheme, env=None):
    cmd = _archive_argv(meta, archive_path, scheme)
    # env=None (the default) means "inherit this process's environment",
    # identical to the pre-[toolchain] behavior. cmd_deploy passes an
    # explicit DEVELOPER_DIR-augmented env only when the project's
    # .deployit/config.toml [toolchain] table resolves one.
    res = subprocess.run(cmd, env=env)
    if res.returncode != 0:
        fail("xcodebuild archive failed — see Xcode output above; "
             "common causes in references/troubleshooting.md")


def _read_archive_build_number(archive_path: Path, project: str) -> str:
    app = archive_path / "Products" / "Applications" / f"{project}.app"
    # iOS/visionOS place Info.plist at the app-bundle root; macOS nests it under
    # Contents/. Check both so every platform's archive resolves.
    candidates = [app / "Info.plist", app / "Contents" / "Info.plist"]
    plist = next((p for p in candidates if p.is_file()), None)
    if plist is None:
        fail(f"built Info.plist not found at {candidates[0]} or {candidates[1]}")
    res = subprocess.run(
        ["/usr/libexec/PlistBuddy", "-c", "Print :CFBundleVersion", str(plist)],
        capture_output=True, text=True, check=True,
    )
    return res.stdout.strip()


def _read_plist_string(plist: Path, key: str):
    """A single string value from a plist via PlistBuddy, or None when the
    plist is missing or the key isn't set (PlistBuddy exits non-zero for a
    missing key — that's an expected outcome here, not an error)."""
    if not plist.is_file():
        return None
    res = subprocess.run(
        ["/usr/libexec/PlistBuddy", "-c", f"Print :{key}", str(plist)],
        capture_output=True, text=True,
    )
    return res.stdout.strip() if res.returncode == 0 else None


def _detect_sparkle_in_app(app_path: Path) -> dict:
    """Inspect a built macOS .app for Sparkle wiring, independent of whether
    [macos.sparkle] is enabled in config.toml: is Sparkle.framework embedded,
    and does the app's own Info.plist declare SUFeedURL / SUPublicEDKey.
    Purely advisory (issue #111) — used to warn on a config-vs-app mismatch.
    Never gates appcast production, which requires the configured signing
    key/tool regardless of what the app itself carries."""
    plist = app_path / "Contents" / "Info.plist"
    return {
        "framework": (app_path / "Contents" / "Frameworks" / "Sparkle.framework").exists(),
        "feed_url": _read_plist_string(plist, "SUFeedURL"),
        "public_ed_key": _read_plist_string(plist, "SUPublicEDKey"),
    }


def _sparkle_mismatch_warnings(sparkle_detect: dict, enabled: bool) -> list:
    """Compare what `_detect_sparkle_in_app` found against `[macos.sparkle]
    enabled` and return human-readable warnings for every mismatch (issue
    #111's config-vs-app-vs-appcast triangle). Empty list when they agree.
    Pure function — no I/O — so cmd_deploy's warning surfacing is directly
    testable without a full deploy."""
    warnings = []
    if enabled and not sparkle_detect["framework"]:
        warnings.append(
            "macos.sparkle.enabled=true but the built app has no "
            "Sparkle.framework — the appcast will be signed, but the app "
            "has no way to check it.")
    if not enabled and sparkle_detect["framework"]:
        feed = sparkle_detect.get("feed_url") or "(no SUFeedURL set)"
        warnings.append(
            f"the built app is Sparkle-wired (SUFeedURL: {feed}) but "
            "macos.sparkle.enabled is false — no appcast is being "
            "produced; auto-update will silently not work.")
    if enabled and sparkle_detect["framework"] and not sparkle_detect.get("feed_url"):
        warnings.append(
            "Sparkle.framework is embedded but the app's Info.plist has "
            "no SUFeedURL — auto-update can't locate the appcast.")
    return warnings


def _xcodebuild_export(archive_path: Path, export_dir: Path, plugin_root: Path, platform: str, env=None):
    # Prefer an explicit override or a project-local
    # .deployit/ExportOptions.<platform>.plist before the bundled default,
    # so projects that need custom export options (e.g. manual signing for
    # headless/CI deploys) can supply their own without editing the plugin.
    _env_eo = os.environ.get("DEPLOYIT_EXPORT_OPTIONS_PATH")
    _local_eo = Path.cwd() / ".deployit" / f"ExportOptions.{platform}.plist"
    if _env_eo and Path(_env_eo).is_file():
        options = Path(_env_eo)
    elif _local_eo.is_file():
        options = _local_eo
    else:
        options = plugin_root / "assets" / f"ExportOptions.{platform}.plist"
    if not options.is_file():
        fail(f"missing export options plist: {options}")
    cmd = [
        "xcodebuild", "-exportArchive",
        "-archivePath", str(archive_path),
        "-exportOptionsPlist", str(options),
        "-exportPath", str(export_dir),
        "-allowProvisioningUpdates",
    ]
    # See _xcodebuild_archive: env=None inherits this process's environment
    # unchanged; cmd_deploy passes a DEVELOPER_DIR-augmented env when
    # [toolchain] resolved one, so archive and export always agree on which
    # toolchain built the artifact being exported.
    res = subprocess.run(cmd, env=env)
    if res.returncode != 0:
        fail("xcodebuild -exportArchive failed — see Xcode output above")


def _stage_ios_or_visionos(state: Path, plugin_root: Path,
                           build_id: str, ipa_src: Path, meta_full: dict):
    """Move the IPA into serve/<build_id>/, render manifest.plist and _meta.json.
    Returns (artifact_name, ipa_url, manifest_url)."""
    dst = state / "serve" / build_id
    if dst.exists():
        _shutil.rmtree(dst)
    dst.mkdir(parents=True)

    artifact_name = ipa_src.name
    _shutil.move(str(ipa_src), dst / artifact_name)

    ipa_url      = f"{meta_full['origin_base_url']}/{build_id}/{artifact_name}"
    manifest_url = f"{meta_full['origin_base_url']}/{build_id}/manifest.plist"

    manifest_tmpl = string.Template(
        (plugin_root / "assets" / "manifest.template.plist").read_text())
    (dst / "manifest.plist").write_text(manifest_tmpl.substitute(
        IPA_URL=ipa_url,
        BUNDLE_ID=meta_full["bundle_id"],
        BUNDLE_VERSION=meta_full["marketing_version"],
        TITLE=meta_full["project"],
    ))

    (dst / "_meta.json").write_text(json.dumps({
        **{k: meta_full[k] for k in (
            "id", "platform", "project", "bundle_id",
            "marketing_version", "semver_version", "build_number", "commit",
            "timestamp", "origin_host", "origin_base_url",
        )},
        # AGE-28: what this build was actually built with. There is no post-hoc
        # oracle — a real .xcarchive/Info.plist records no configuration — so
        # this is the only durable record, and a warning alone would die with
        # the terminal scrollback. Both staging paths use an explicit allowlist,
        # so a field threaded only through meta_full is silently dropped rather
        # than carried. Read with .get(): these are advisory build-provenance
        # fields that cmd_deploy always supplies, but staging is also called
        # directly (by tests, and by any future caller that does not gate), and
        # missing provenance must not crash a stage. The required keys above
        # stay strict, so a genuinely missing one still fails loudly.
        **{k: meta_full.get(k) for k in (
            "configuration", "configuration_source", "optimization_level",
        )},
        "install": {
            "kind": "itms-services",
            "manifest_url": manifest_url,
            "ipa_url": ipa_url,
        },
        "primary_artifact": artifact_name,
    }, indent=2))

    return artifact_name, ipa_url, manifest_url


# Sparkle `sign_update` discovery roots (issue #117). Module-level so tests
# can monkeypatch them instead of touching real Caskroom/DerivedData paths.
# Homebrew has deprecated the `sparkle` cask ("does not pass the macOS
# Gatekeeper check! It will be disabled on 2026-09-01") and quarantines its
# downloads; the SwiftPM artifact bundle a Sparkle-using project already has
# is byte-identical, carries no quarantine xattr, and is version-matched to
# what the app actually links — so it is tried first.
SPARKLE_SPM_DERIVED_DATA_GLOBS = [
    "{home}/Library/Developer/Xcode/DerivedData/{project}-*/SourcePackages/"
    "artifacts/*/Sparkle/bin/sign_update",
    "{home}/Library/Developer/Xcode/DerivedData/*/SourcePackages/"
    "artifacts/*/Sparkle/bin/sign_update",
]
SPARKLE_CASK_ROOTS = [
    Path("/opt/homebrew/Caskroom/sparkle"),
    Path("/usr/local/Caskroom/sparkle"),
]


def _sparkle_version_sort_key(path: Path):
    """Sort key that picks the NEWEST of several `sign_update` glob hits by
    parsed version, not lexicographically. The old code did
    `sorted(glob(...))[0]` — with 2.9.3 and 2.9.4 both installed that returns
    2.9.3 (string '3' < '4'), and across majors 1.9.0 beats 2.0.0 (issue
    #117, AC 5). Every dotted-number run in the path is a candidate; the
    largest wins. Paths with no parseable version sort behind ones that have
    one, with the path string as a deterministic tiebreaker."""
    versions = [tuple(int(part) for part in match.split("."))
                for match in _re.findall(r"\d+(?:\.\d+)+", str(path))]
    return (max(versions) if versions else (), str(path))


def _sparkle_glob_newest(pattern: str):
    """Newest file matching `pattern` by _sparkle_version_sort_key, or None."""
    import glob as _glob
    hits = [Path(hit) for hit in _glob.glob(pattern) if Path(hit).is_file()]
    return max(hits, key=_sparkle_version_sort_key) if hits else None


def _is_quarantined(path: Path) -> bool:
    """True if `path` carries com.apple.quarantine — the exact condition that
    got a Homebrew-cask `sign_update` killed by Gatekeeper with a non-zero
    exit and EMPTY stderr in issue #117's postmortem. Diagnostic only:
    CPython's os.getxattr doesn't reach macOS's xattr namespace, so this
    shells to /usr/bin/xattr; missing on non-macOS, so that case (and any
    other failure to invoke it) reads as "not quarantined" rather than
    raising — quarantine is a warning, never the primary failure signal."""
    try:
        res = subprocess.run(["xattr", "-p", "com.apple.quarantine", str(path)],
                             capture_output=True, text=True)
    except (FileNotFoundError, OSError):
        return False
    return res.returncode == 0


def _resolve_sparkle_sign_update(sparkle_cfg: dict, project: str = "") -> dict:
    """Locate Sparkle's `sign_update`. Resolution is intent-first: an
    operator who pinned a path (env override or config) meant it, so a pin
    that doesn't exist on disk is a hard error naming the pin — never a
    silent fall-through to discovery. That fall-through is exactly how issue
    #117 shipped an unsigned release: a version-stamped Caskroom path
    disappeared under `brew upgrade`, and the missing-file check silently
    substituted a different, quarantined binary with no diagnostic naming
    what actually ran. Only an EMPTY key falls through to discovery, which
    prefers the SwiftPM artifact bundle over the deprecated Homebrew cask
    (see the module-level SPARKLE_* comment).

    Returns {"path": Path|None, "source": str, "warnings": [str]} — callers
    need to name how the tool was resolved, not just whether it was, so a
    failure message can always say what actually ran (issue #117, AC 3)."""
    result = None  # (Path, source-description)

    env = os.environ.get("DEPLOYIT_SPARKLE_SIGN_UPDATE")
    if env:
        p = Path(env)
        if not p.is_file():
            fail(f"DEPLOYIT_SPARKLE_SIGN_UPDATE={env!r} does not exist")
        result = (p, "env DEPLOYIT_SPARKLE_SIGN_UPDATE")

    if result is None:
        cfg_path = sparkle_cfg.get("sign_update_path") or ""
        if cfg_path:
            p = Path(cfg_path)
            if not p.is_file():
                fail("macos.sparkle.sign_update_path="
                     f"{cfg_path!r} (from config.toml) does not exist")
            result = (p, "config macos.sparkle.sign_update_path")

    if result is None:
        on_path = _shutil.which("sign_update")
        if on_path:
            result = (Path(on_path), "PATH")

    warnings = []

    if result is None:
        home = str(Path.home())
        for pattern in SPARKLE_SPM_DERIVED_DATA_GLOBS:
            hit = _sparkle_glob_newest(pattern.format(home=home, project=project or "*"))
            if hit:
                result = (hit, "SwiftPM artifact bundle")
                break

    if result is None:
        for root in SPARKLE_CASK_ROOTS:
            hit = _sparkle_glob_newest(str(root / "*" / "bin" / "sign_update"))
            if hit:
                warnings.append(
                    f"{hit} was resolved from the deprecated Homebrew `sparkle` "
                    "cask (`brew info --cask sparkle`: disabled 2026-09-01) — "
                    "prefer the SwiftPM artifact bundle; see references/sparkle.md")
                result = (hit, f"Homebrew cask ({root})")
                break

    if result is None:
        return {"path": None, "source": "not found", "warnings": warnings}

    path, source = result
    if _is_quarantined(path):
        warnings.append(
            f"{path} carries the com.apple.quarantine attribute — Gatekeeper "
            "kills it on first run with a non-zero exit and NO stderr (the "
            f"exact failure issue #117 hardened against). Fix: xattr -d "
            f"com.apple.quarantine {path}")
    return {"path": path, "source": source, "warnings": warnings}


def _gatekeeper_diagnosis(tool: Path) -> str:
    """A non-zero sign_update exit with EMPTY stdout AND stderr is Gatekeeper
    killing the process before it can write anything — the signature of
    issue #117's incident (a quarantined, adhoc-signed Homebrew-cask
    binary). Name it as fact when the quarantine xattr confirms it, as the
    leading hypothesis otherwise, so the failure is never just a bare colon
    with nothing after it (AC 3)."""
    if _is_quarantined(tool):
        return ("(empty stdout/stderr) — Gatekeeper killed it: this binary "
                f"carries com.apple.quarantine. Fix: xattr -d "
                f"com.apple.quarantine {tool}")
    return ("(empty stdout/stderr) — likely Gatekeeper killing an "
            f"unsigned/adhoc-signed binary before it could run. Check: "
            f"xattr -p com.apple.quarantine {tool}")


def _sparkle_sign_failure(message: str, *, release: bool):
    """Route a signing failure. When `release` is set, a GitHub release is
    about to be published from this build: an unsigned Developer-ID release
    is what real users auto-update from, so shipping one while reporting
    success is the exact defect issue #117 is about — fail the whole deploy
    loudly (fail() -> exit 1) rather than let it ship. Otherwise (tailnet-
    only channel) keep the pre-#117 best-effort posture: warn on stderr and
    let the .dmg still ship without an appcast entry."""
    if release:
        fail("deployit: [macos.sparkle] enabled and this deploy publishes a "
             "GitHub release, but signing failed — refusing to ship an "
             f"unsigned release: {message}")
    sys.stderr.write(
        f"deployit: sign_update failed; skipping Sparkle for this build: {message}\n")
    return None


def _sparkle_sign(zip_path: Path, sparkle_cfg: dict, project: str, *, release: bool):
    """Return the base64 EdDSA signature for zip_path, or None when signing
    can't proceed and this deploy is allowed to degrade (release=False —
    the tailnet channel only; see _sparkle_sign_failure). Every failure path
    reports the resolved binary and how it was resolved, never a bare
    message (issue #117, AC 3). DEPLOYIT_SKIP_SPARKLE_SIGN stubs a
    deterministic signature for tests (no real Sparkle toolchain needed)."""
    if os.environ.get("DEPLOYIT_SKIP_SPARKLE_SIGN"):
        return "TEST-ED-SIGNATURE-DO-NOT-SHIP=="

    resolved = _resolve_sparkle_sign_update(sparkle_cfg, project)
    for w in resolved["warnings"]:
        sys.stderr.write(f"deployit: WARNING — {w}\n")

    tool = resolved["path"]
    source = resolved["source"]
    if tool is None:
        return _sparkle_sign_failure(
            "no `sign_update` found (checked env, config, PATH, SwiftPM "
            "artifacts, and the Homebrew cask — see references/sparkle.md)",
            release=release)

    cmd = [str(tool), str(zip_path)]
    key_path = sparkle_cfg.get("private_key_path") or ""
    if key_path:
        cmd += ["--ed-key-file", key_path]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        detail = res.stderr.strip() or res.stdout.strip() or _gatekeeper_diagnosis(tool)
        return _sparkle_sign_failure(
            f"sign_update ({tool}, via {source}) failed: {detail}", release=release)
    # sign_update prints e.g.: sparkle:edSignature="BASE64==" length="12345"
    m = _re.search(r'edSignature="([^"]+)"', res.stdout)
    if not m:
        return _sparkle_sign_failure(
            f"could not parse sign_update ({tool}, via {source}) output "
            f"({res.stdout.strip()!r})", release=release)
    return m.group(1)


def _ditto_zip_app(app_path: Path, zip_path: Path):
    """Archive a .app with ditto, preserving the bundle symlinks and resource
    forks a plain `zip` would corrupt; --keepParent keeps the .app directory
    itself inside the archive. Shared by the Sparkle enclosure and the GitHub
    release asset (both want the same canonical signed-app zip)."""
    res = subprocess.run(
        ["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent",
         str(app_path), str(zip_path)],
        capture_output=True, text=True)
    if res.returncode != 0:
        fail(f"ditto zip failed: {res.stderr.strip() or res.stdout.strip()}")


def _notarize_staple_app(app_path: Path, notary_profile: str, notary_keychain: str = ""):
    """Notarize and staple a .app so a GitHub-release download opens past
    Gatekeeper without the right-click dance. notarytool takes a zip, so we
    submit a throwaway zip of the bundle, then staple the ticket onto the .app
    itself (the release zip is taken from the stapled bundle afterwards).

    When `notary_keychain` is set (macos.notary_keychain in config.toml),
    notarytool is pointed at that file-based keychain via `--keychain` so
    headless SSH/mosh deploys work even with the GUI screen locked. By default
    `notarytool store-credentials` writes to the *data-protection* keychain,
    which locks when the screen locks — so over SSH the profile reads back as
    "No Keychain password item found." Storing the profile in the login keychain
    (`no-timeout`, always unlocked) and pointing notarytool at it sidesteps that.
    See references/macos.md."""
    if not notary_profile:
        fail("notarize requested but macos.notary_profile is empty in config.toml")
    tmp_zip = app_path.with_suffix(".notarize.zip")
    _ditto_zip_app(app_path, tmp_zip)
    try:
        cmd = [
            "xcrun", "notarytool", "submit", str(tmp_zip),
            "--keychain-profile", notary_profile, "--wait",
        ]
        if notary_keychain:
            cmd += ["--keychain", str(Path(notary_keychain).expanduser())]
        notary = subprocess.run(cmd, capture_output=True, text=True)
        if notary.returncode != 0:
            fail(f"notarytool submit (app) failed: {notary.stderr.strip() or notary.stdout.strip()}")
    finally:
        tmp_zip.unlink(missing_ok=True)
    staple = subprocess.run(["xcrun", "stapler", "staple", str(app_path)],
                            capture_output=True, text=True)
    if staple.returncode != 0:
        fail(f"stapler staple (app) failed: {staple.stderr.strip() or staple.stdout.strip()}")


def _stage_sparkle_zip(plugin_root: Path, dst: Path, build_id: str,
                       app_path: Path, meta_full: dict, sparkle_cfg: dict,
                       *, release: bool):
    """Zip the exported .app and EdDSA-sign it for Sparkle. Returns the sparkle
    metadata dict, or None if signing was skipped — allowed only when
    `release` is False (tailnet channel); when `release` is True a signing
    failure is fatal (_sparkle_sign_failure raises via fail(), issue #117) so
    a None return here never happens on that path. When None, the unsigned
    zip is discarded, since Sparkle requires a signature. Must run while the
    .app still exists (before _stage_macos removes it)."""
    zip_name = f"{meta_full['project']}.zip"
    zip_path = dst / zip_name
    _ditto_zip_app(app_path, zip_path)
    signature = _sparkle_sign(zip_path, sparkle_cfg, meta_full["project"], release=release)
    if signature is None:
        zip_path.unlink(missing_ok=True)
        return None
    return {
        "zip_artifact": zip_name,
        "zip_url": f"{meta_full['origin_base_url']}/{build_id}/{zip_name}",
        "zip_length": zip_path.stat().st_size,
        "ed_signature": signature,
        "short_version": meta_full["marketing_version"],
        "version": meta_full["build_number"],
        # Travels in the index so any backend can surface it on the product page
        # for copy-paste into the app's Info.plist SUPublicEDKey.
        "public_ed_key": sparkle_cfg.get("public_ed_key", ""),
    }


def _stage_macos(state: Path, plugin_root: Path, build_id: str,
                 app_src: Path, meta_full: dict, notarize: bool,
                 notary_profile: str, sparkle_cfg: dict = None,
                 release: bool = False, notary_keychain: str = ""):
    """Wrap the exported .app in a .dmg, optionally notarize + staple, and (when
    [macos.sparkle] is enabled) also produce an EdDSA-signed .zip for Sparkle
    auto-update. When `release` is set, also stage a `<Project>.zip` of the
    signed bundle as the GitHub-release asset (notarizing+stapling the .app
    first when notarization is configured). Always inspects the built app for
    Sparkle wiring (issue #111), independent of `enabled`, so cmd_deploy can
    warn on a config-vs-app mismatch. Writes _meta.json. Returns
    (dmg_name, dmg_url)."""
    sparkle_cfg = sparkle_cfg or {}
    dst = state / "serve" / build_id
    if dst.exists():
        _shutil.rmtree(dst)
    dst.mkdir(parents=True)

    dmg_name = f"{meta_full['project']}.dmg"
    dmg_path = dst / dmg_name

    staging_app = dst / app_src.name
    _shutil.move(str(app_src), staging_app)

    # For a GitHub release the .app itself must carry a notarization ticket (a
    # zip download extracts the bundle directly, so Gatekeeper checks the
    # bundle's own ticket — not the .dmg's). Staple before any zipping/dmg so
    # every downstream artifact inherits it.
    if release and notarize:
        _notarize_staple_app(staging_app, notary_profile, notary_keychain)

    res = subprocess.run([
        "hdiutil", "create",
        "-srcfolder", str(staging_app),
        "-volname", meta_full["project"],
        "-format", "UDZO",
        "-ov",
        str(dmg_path),
    ], capture_output=True, text=True)
    if res.returncode != 0:
        fail(f"hdiutil create failed: {res.stderr.strip() or res.stdout.strip()}")

    # Sparkle detection (issue #111): inspect the built app itself, independent
    # of [macos.sparkle] enabled, so cmd_deploy can warn on a config-vs-app
    # mismatch instead of silently no-op'ing either direction.
    sparkle_detect = _detect_sparkle_in_app(staging_app)

    # Sparkle (opt-in): zip + EdDSA-sign the .app before it's removed below.
    # When `release` is set, a failed sign is fatal (_sparkle_sign_failure ->
    # fail() -> exit 1, issue #117) — this call does not return None on that
    # path, so sparkle_meta is only ever falsy here when release is False.
    sparkle_meta = None
    if sparkle_cfg.get("enabled"):
        try:
            sparkle_meta = _stage_sparkle_zip(plugin_root, dst, build_id, staging_app,
                                              meta_full, sparkle_cfg, release=release)
        except SystemExit:
            # Any fatal signing failure here — a release-gated sign failure,
            # or an explicitly configured sign_update_path/env override that
            # doesn't exist (both are hard fail() calls, issue #117) — aborts
            # the whole deploy. The .dmg hdiutil already wrote above must not
            # linger as an orphaned, meta-less artifact under serve/: no
            # _meta.json is ever written on this path, so cmd_deploy's
            # index/release publish steps never ran; removing dst makes that
            # true on disk too.
            _shutil.rmtree(dst, ignore_errors=True)
            raise

    # GitHub release asset: the canonical signed-app zip. Reuse Sparkle's zip
    # when it produced one (byte-identical archive of the same bundle);
    # otherwise create it now, while the .app still exists.
    release_zip_name = None
    if release:
        release_zip_name = f"{meta_full['project']}.zip"
        if not (dst / release_zip_name).is_file():
            _ditto_zip_app(staging_app, dst / release_zip_name)

    _shutil.rmtree(staging_app)

    if notarize:
        if not notary_profile:
            fail("macos.notarize=true but macos.notary_profile is empty in config.toml")
        notary_cmd = [
            "xcrun", "notarytool", "submit", str(dmg_path),
            "--keychain-profile", notary_profile,
            "--wait",
        ]
        if notary_keychain:
            notary_cmd += ["--keychain", str(Path(notary_keychain).expanduser())]
        notary = subprocess.run(notary_cmd, capture_output=True, text=True)
        if notary.returncode != 0:
            fail(f"notarytool submit failed: {notary.stderr.strip() or notary.stdout.strip()}")
        staple = subprocess.run(["xcrun", "stapler", "staple", str(dmg_path)],
                                capture_output=True, text=True)
        if staple.returncode != 0:
            fail(f"stapler staple failed: {staple.stderr.strip() or staple.stdout.strip()}")

    dmg_url = f"{meta_full['origin_base_url']}/{build_id}/{dmg_name}"
    meta = {
        **{k: meta_full[k] for k in (
            "id", "platform", "project", "bundle_id",
            "marketing_version", "semver_version", "build_number", "commit",
            "timestamp", "origin_host", "origin_base_url",
        )},
        # AGE-28: what this build was actually built with. There is no post-hoc
        # oracle — a real .xcarchive/Info.plist records no configuration — so
        # this is the only durable record, and a warning alone would die with
        # the terminal scrollback. Both staging paths use an explicit allowlist,
        # so a field threaded only through meta_full is silently dropped rather
        # than carried. Read with .get(): these are advisory build-provenance
        # fields that cmd_deploy always supplies, but staging is also called
        # directly (by tests, and by any future caller that does not gate), and
        # missing provenance must not crash a stage. The required keys above
        # stay strict, so a genuinely missing one still fails loudly.
        **{k: meta_full.get(k) for k in (
            "configuration", "configuration_source", "optimization_level",
        )},
        "install": {"kind": "direct-download", "dmg_url": dmg_url},
        "primary_artifact": dmg_name,
    }
    if sparkle_meta:
        meta["sparkle"] = sparkle_meta
    if release_zip_name:
        meta["release_zip"] = release_zip_name
    meta["sparkle_detect"] = sparkle_detect
    # Defense in depth (issue #117): the only intended path to "enabled but
    # no sparkle" is release=False, which _sparkle_sign_failure treats as a
    # warn-and-degrade. Recording the invariant here lets
    # _publish_github_release refuse to publish if a future change ever
    # breaks that guarantee, rather than silently shipping an unsigned
    # release again. Popped before this meta reaches the shared tailnet
    # index (cmd_deploy), like release_zip/sparkle_detect below.
    if sparkle_cfg.get("enabled"):
        meta["sparkle_required"] = True
    (dst / "_meta.json").write_text(json.dumps(meta, indent=2))
    return dmg_name, dmg_url


PRUNE_KEEP_PER_PRODUCT = 10


def _prune_old_builds(state: Path, data: dict, new_entry: dict) -> int:
    """Hard-delete this machine's older builds of the same (bundle_id, platform).

    Mutates `data["builds"]` in place. Removes the entry from the index AND
    deletes serve/<id>/ from disk. Returns the number of pruned entries.

    Only touches builds matching the new entry's `origin_base_url` — other
    machines manage their own pruning.
    """
    origin = new_entry["origin_base_url"]
    bundle = new_entry["bundle_id"]
    platform = new_entry["platform"]
    same_product = [b for b in data["builds"]
                    if b.get("origin_base_url") == origin
                    and b.get("bundle_id") == bundle
                    and b.get("platform") == platform]
    same_product.sort(key=lambda b: b["timestamp"], reverse=True)
    to_drop = same_product[PRUNE_KEEP_PER_PRODUCT:]
    if not to_drop:
        return 0
    drop_ids = {b["id"] for b in to_drop}
    data["builds"] = [b for b in data["builds"] if b["id"] not in drop_ids]
    for b in to_drop:
        _shutil.rmtree(state / "serve" / b["id"], ignore_errors=True)
    return len(to_drop)


def _default_index_cfg() -> dict:
    """Index-publishing defaults used when no config.toml is in scope (e.g. the
    direct-function tests) or a pre-existing config.toml predates these keys."""
    return {"repo": INDEX_REPO_URL, "publish": "auto", "auto_merge": True}


def _index_cfg(cfg: dict) -> dict:
    """Normalise the `[index]` publish settings out of a parsed config, filling
    every key with a default so callers never KeyError on an older config.toml."""
    idx = (cfg or {}).get("index", {}) or {}
    return {
        "repo": idx.get("repo") or INDEX_REPO_URL,
        "publish": idx.get("publish") or "auto",
        "auto_merge": idx.get("auto_merge", True),
    }


def _classify_push_failure(stderr: str) -> str:
    """Classify a failed `git push origin main` from its stderr so the publisher
    can route it: 'ruleset'/'protected' → publish via PR (retrying the direct
    push is pointless); 'non_fast_forward' → a concurrent writer won, re-pull and
    retry; 'auth' → credentials are broken, a PR push would fail identically so
    preserve and bail; 'other' → unknown, treat as transiently retryable.

    Matches case-insensitively over the whole stderr. Order matters: a ruleset
    rejection also prints a generic "failed to push some refs" line, so the
    ruleset/protected checks must precede the non-fast-forward check."""
    s = (stderr or "").lower()
    ruleset_signals = ("gh013", "repository rule violations",
                       "changes must be made through a pull request",
                       "push declined due to repository rule violations")
    protected_signals = ("gh006", "protected branch hook declined",
                         "cannot push to this protected branch",
                         "at least 1 approving review",
                         "required status check")
    auth_signals = ("authentication failed", "could not read username",
                    "permission denied", "invalid username or password",
                    "support for password authentication was removed",
                    "403 forbidden", "fatal: could not read")
    nff_signals = ("non-fast-forward", "fetch first",
                   "updates were rejected", "tip of your current branch is behind")
    if any(sig in s for sig in ruleset_signals):
        return "ruleset"
    if any(sig in s for sig in protected_signals):
        return "protected"
    if any(sig in s for sig in auth_signals):
        return "auth"
    if any(sig in s for sig in nff_signals):
        return "non_fast_forward"
    return "other"


def _git_index_auth_args() -> list:
    """Git -c overrides that make an index push/fetch self-sufficient off the
    login shell: rewrite any SSH remote to HTTPS, then pin the credential helper
    to an ABSOLUTE `gh` path so the launchd daemon (minimal PATH, no bare `gh`)
    can still authenticate. The empty-then-set idiom replaces any inherited
    helper rather than appending to it."""
    gh = _gh_bin()
    return [
        "-c", "url.https://github.com/.insteadOf=git@github.com:",
        "-c", "credential.https://github.com.helper=",
        "-c", f"credential.https://github.com.helper=!{gh} auth git-credential",
    ]


def _git_push_index(index_dir: Path, refspec: str, *, lease: bool = False):
    """Push `refspec` to origin with the self-sufficient auth args. Returns
    (returncode, stderr); a timeout is surfaced as a retryable non-zero."""
    cmd = ["git", *_git_index_auth_args(), "-C", str(index_dir), "push"]
    if lease:
        cmd.append("--force-with-lease")
    cmd += ["origin", refspec]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        return p.returncode, (p.stderr or "").strip()
    except subprocess.TimeoutExpired:
        return 124, "git push timed out after 60s"


def _reset_index_to_origin_main(index_dir: Path):
    """Return the index checkout to a clean `origin/main` base: best-effort fetch
    (network optional — `reset` falls back to the cached remote-tracking ref),
    ensure we're on `main`, then hard-reset. This is the invariant that keeps a
    generated-but-unpushed commit from ever lingering on local `main`; the commit
    survives on whatever `deploy/<slug>` branch the publisher created."""
    subprocess.run(["git", *_git_index_auth_args(), "-C", str(index_dir),
                    "fetch", "origin", "main", "--quiet"],
                   capture_output=True, text=True, timeout=60)
    subprocess.run(["git", "-C", str(index_dir), "checkout", "--quiet", "main"],
                   capture_output=True, text=True, timeout=30)
    subprocess.run(["git", "-C", str(index_dir), "reset", "--hard", "--quiet", "origin/main"],
                   check=True, capture_output=True, text=True, timeout=30)


def _preserve_and_fail(index_dir: Path, branch: str, stderr: str):
    """Terminal path when the commit can't be published AND can't be pushed to a
    branch (auth/network): stash it on a LOCAL recovery branch, reset `main`
    clean, and fail with the branch name so nothing is silently lost."""
    local_branch = f"{branch}-local"
    subprocess.run(["git", "-C", str(index_dir), "branch", "-f", local_branch, "HEAD"],
                   capture_output=True, text=True)
    _reset_index_to_origin_main(index_dir)
    fail("index publish blocked (could not push to the index); the generated "
         f"commit was retained on local branch {local_branch} — recover it once "
         "the cause is fixed", stderr=stderr, branch=local_branch)


def _pr_publish_fallback(index_dir: Path, subject: str, branch: str, idx: dict) -> dict:
    """Publish the just-committed change via a PR: push it to `branch`, open a PR
    against main, and (when `auto_merge`) merge it. Returns a status dict. The
    commit is safe on the remote branch before any PR step, so a later failure
    only ever downgrades to 'pending' (open PR the user merges), never loss."""
    gh = _gh_bin()
    owner_repo = _parse_owner_repo(idx["repo"]) or INDEX_REPO_SLUG

    rc, stderr = _git_push_index(index_dir, f"HEAD:refs/heads/{branch}", lease=True)
    if rc != 0:
        _preserve_and_fail(index_dir, branch, stderr)  # does not return

    body = ("Automated deployit index publish — a branch-protection ruleset "
            f"blocks the direct push to main.\n\n{subject}")
    pr = subprocess.run([gh, "pr", "create", "--repo", owner_repo, "--base", "main",
                         "--head", branch, "--title", subject, "--body", body],
                        cwd=str(index_dir), capture_output=True, text=True, timeout=60)
    combined = ((pr.stdout or "") + " " + (pr.stderr or "")).lower()
    if pr.returncode == 0:
        lines = [ln for ln in (pr.stdout or "").strip().splitlines() if ln.strip()]
        pr_url = lines[-1].strip() if lines else ""
    elif "already exists" in combined:
        view = subprocess.run([gh, "pr", "view", branch, "--repo", owner_repo,
                               "--json", "url", "-q", ".url"],
                              cwd=str(index_dir), capture_output=True, text=True, timeout=30)
        pr_url = (view.stdout or "").strip() if view.returncode == 0 else ""
    else:
        # Branch is pushed (commit is safe); we just couldn't open the PR.
        _reset_index_to_origin_main(index_dir)
        fail("index publish: pushed the branch but `gh pr create` failed — open "
             "the PR manually to publish this build",
             stderr=(pr.stderr or "").strip(), branch=branch,
             pr_create_url=f"https://github.com/{owner_repo}/compare/main...{branch}?expand=1")

    if idx["auto_merge"] and pr_url:
        merge = subprocess.run([gh, "pr", "merge", branch, "--repo", owner_repo,
                                "--merge", "--delete-branch"],
                               cwd=str(index_dir), capture_output=True, text=True, timeout=90)
        if merge.returncode == 0:
            _reset_index_to_origin_main(index_dir)  # local main now includes the merge
            return {"status": "published", "pr_url": pr_url, "branch": None}
        # Auto-merge failed — most likely a concurrent deploy already merged and
        # this PR now conflicts on the top of builds.json. Leave it open rather
        # than force a resolution; the URL is surfaced for a manual merge.

    _reset_index_to_origin_main(index_dir)  # drop the commit from local main; safe on `branch`
    return {"status": "pending", "pr_url": pr_url, "branch": branch}


def _publish_index_commit(index_dir: Path, subject: str, slug: str, idx: dict,
                          *, allow_retry: bool) -> dict:
    """Publish the HEAD commit of the index checkout (already `git commit`ed by
    the caller). Tries a direct push to main first (unless publish='pr'); on a
    ruleset/protected rejection it publishes via a PR; on a concurrent-writer
    rejection it asks the caller to re-pull and retry; on an auth failure it
    preserves the commit and fails. Never resets-and-drops the commit.

    Returns one of:
      {"status": "published", "pr_url": str|None, "branch": None}
      {"status": "pending",   "pr_url": str,      "branch": str}   # open PR
      {"status": "retry",     "stderr": str}                        # caller re-runs
    or fails terminally via _preserve_and_fail/fail()."""
    mode = idx["publish"]
    branch = f"deploy/{slug}"

    if mode != "pr":
        rc, stderr = _git_push_index(index_dir, "main")
        if rc == 0:
            return {"status": "published", "pr_url": None, "branch": None}
        verdict = _classify_push_failure(stderr)
        if verdict in ("non_fast_forward", "other") and allow_retry:
            # A concurrent writer won (or a transient) — the caller's loop resets
            # to a fresh origin/main, re-mutates, and calls us again.
            return {"status": "retry", "stderr": stderr}
        if verdict == "auth" or mode == "push":
            # publish='push' means direct-push-only: no PR fallback. Either way,
            # preserve the commit on a branch and bail.
            _preserve_and_fail(index_dir, branch, stderr)  # does not return

    return _pr_publish_fallback(index_dir, subject, branch, idx)


def _append_to_index(state: Path, entry: dict, *, idx: dict = None, attempts: int = 3) -> dict:
    """Prepend `entry` to builds.json (newest first), prune this product's older
    builds beyond PRUNE_KEEP_PER_PRODUCT on this origin, commit, and publish.

    Each attempt starts from a clean origin/main base, so a concurrent-writer
    conflict simply re-runs the prune afresh. Publishing tries a direct push and,
    when a branch-protection ruleset rejects it, falls back to a PR (auto-merged
    by default). The generated commit is never discarded. Returns a publish
    result: {"published": bool, "pr_url": str|None, "branch": str|None}."""
    index_dir = state / "index"
    builds_path = index_dir / "builds.json"
    idx = idx or _default_index_cfg()
    slug = entry.get("id") or f"deploy-{_dt.datetime.now().strftime('%Y%m%d-%H%M%S')}"

    for attempt in range(1, attempts + 1):
        _reset_index_to_origin_main(index_dir)
        data = json.loads(builds_path.read_text())
        data["builds"].insert(0, entry)
        pruned = _prune_old_builds(state, data, entry)
        builds_path.write_text(json.dumps(data, indent=2) + "\n")

        suffix = f" [pruned {pruned}]" if pruned else ""
        msg = (f"feat(deploy): {entry['project']} {entry['platform']} "
               f"{entry['marketing_version']} (build {entry['build_number']}) "
               f"from {entry['origin_host']}{suffix}")
        subprocess.run(["git", "-C", str(index_dir), "add", "builds.json"], check=True)
        subprocess.run(["git", "-C", str(index_dir), "commit", "-m", msg],
                       check=True, capture_output=True, text=True)
        result = _publish_index_commit(index_dir, msg, slug, idx,
                                       allow_retry=(attempt < attempts))
        if result["status"] == "retry":
            continue
        return {"published": result["status"] == "published",
                "pr_url": result.get("pr_url"), "branch": result.get("branch")}

    fail("push to deployit-index failed after retries; local artifacts retained")


def _commit_and_push_index(state: Path, mutate, *, attempts: int = 3,
                           idx: dict = None, slug: str = None):
    """Apply a mutation to index/builds.json and publish it, robustly.

    `mutate(data)` edits the parsed index in place and returns a commit message,
    or None to abort with no change. Loops up to `attempts` times: reset to a
    clean origin/main, re-read, mutate, write, commit, then publish via
    `_publish_index_commit` (direct push, PR fallback under a ruleset, auto-merge
    by default). A concurrent-writer conflict re-runs the mutation on a fresh
    base; the generated commit is never discarded. Honors DEPLOYIT_SKIP_GC_PUSH
    (write + return locally, touch no git remote) for tests and offline runs.

    Returns None if the mutation aborted, else a dict {"status": str, "pr_url":
    str|None, "branch": str|None, "msg": str}; fails terminally if the commit can
    neither be published nor preserved. `status` carries `_publish_index_commit`'s
    vocabulary plus one member of its own:

      "published"   the change is on origin/main
      "pending"     the change sits on an open PR; main is unchanged
      "local_only"  DEPLOYIT_SKIP_GC_PUSH — builds.json was rewritten on this
                    machine and no remote was contacted

    ⚠ Every value-returning DEPLOYIT_SKIP_* hatch in this file carries a marker
    naming itself (`_install_launchd`, `_publish_github_release`, `_run_post_test`).
    This one returned the real path's success value instead, so a caller could not
    tell a published removal from an unpublished one while files were deleted
    either way (AGE-48). Do not reintroduce a boolean here: `local_only` is a
    fourth outcome, not a shade of `published`.

    Shared by cmd_gc and cmd_rm. The high-frequency deploy path keeps its own
    prune-in-loop variant (`_append_to_index`)."""
    index_dir = state / "index"
    builds_path = index_dir / "builds.json"

    if os.environ.get("DEPLOYIT_SKIP_GC_PUSH"):
        data = json.loads(builds_path.read_text())
        msg = mutate(data)
        if msg is None:
            return None
        builds_path.write_text(json.dumps(data, indent=2) + "\n")
        return {"status": "local_only", "pr_url": None, "branch": None, "msg": msg}

    idx = idx or _default_index_cfg()
    if slug is None:
        slug = f"index-{_dt.datetime.now().strftime('%Y%m%d-%H%M%S')}"

    for attempt in range(1, attempts + 1):
        _reset_index_to_origin_main(index_dir)
        data = json.loads(builds_path.read_text())
        msg = mutate(data)
        if msg is None:
            return None
        builds_path.write_text(json.dumps(data, indent=2) + "\n")
        subprocess.run(["git", "-C", str(index_dir), "add", "builds.json"],
                       check=True, capture_output=True, text=True)
        subprocess.run(["git", "-C", str(index_dir), "commit", "-m", msg],
                       check=True, capture_output=True, text=True)
        result = _publish_index_commit(index_dir, msg, slug, idx,
                                       allow_retry=(attempt < attempts))
        if result["status"] == "retry":
            continue
        return {"status": result["status"],
                "pr_url": result.get("pr_url"), "branch": result.get("branch"),
                "msg": msg}

    fail("push to deployit-index failed after retries")


def _index_change_is_effective(result) -> bool:
    """True iff an index mutation is final — i.e. the serve/ dirs it orphaned may
    now be deleted.

    The invariant, which is why this is one named predicate rather than a
    condition spelled out at each call site: never delete a build's files while
    the index its consumers actually read still lists it. `published` landed on
    origin/main. `local_only` is the documented offline hatch, where this
    machine's own builds.json IS the index its consumers read. `pending` is NOT
    final — the change sits on an open PR and the world still reads unchanged
    main, so the files must survive until it merges.

    Total over `_commit_and_push_index`'s whole return type (`dict | None`), so
    callers need no outer `result and ...` guard. An aborted mutation (None) and
    any unrecognised status fail CLOSED: a status added later authorises no
    deletion until it is classified here, which is the safe direction — keeping
    files that could have gone is recoverable, deleting files that should have
    stayed is not."""
    if not isinstance(result, dict):
        return False
    return result.get("status") in ("published", "local_only")


def _refresh_local_backend(port: int):
    try:
        req = urllib.request.Request(
            f"http://127.0.0.1:{port}/deployit/_internal/refresh", method="POST")
        urllib.request.urlopen(req, timeout=3).read()
    except Exception as exc:
        sys.stderr.write(f"warning: local backend refresh failed: {exc}\n")


def _release_notes_path(args, meta_full: dict, builds_dir: Path) -> Path:
    """Notes file for the GitHub release: the agent-authored --release-notes-file
    when present, else a minimal auto-note so a hand-run `deploy` still publishes
    something legible."""
    given = getattr(args, "release_notes_file", None)
    if given:
        p = Path(given)
        if p.is_file():
            return p
        sys.stderr.write(f"deployit: --release-notes-file {p} not found; using a minimal note\n")
    note = builds_dir / f"{meta_full['id']}.release-notes.md"
    ver = meta_full.get("semver_version") or meta_full["marketing_version"]
    note.write_text(f"{meta_full['project']} {ver} (build {meta_full['build_number']}, "
                    f"commit {meta_full['commit']}).\n")
    return note


def _publish_github_release(plugin_root: Path, cwd: Path, state: Path, build_id: str,
                            notes_file: Path, *, clobber: bool, prerelease: bool,
                            attach_dmg: bool) -> dict:
    """Invoke bin/deployit-release to publish the staged release zip, returning its
    JSON result (or an {ok: False, ...} dict). Never raises: a release failure
    must not roll back the already-deployed tailnet build. Honors
    DEPLOYIT_SKIP_RELEASE_PUBLISH (no-op ok) for tests/offline runs.

    When this build was EdDSA-signed for Sparkle (meta["sparkle"] present — the
    release zip and the Sparkle zip are byte-identical, see _stage_macos),
    also asks deployit-release to publish a GitHub-release appcast.xml (issue
    #111), passing the already-computed signature so the release process
    never needs the private key. Withheld when `prerelease` is set:
    .../releases/latest/download/... only ever resolves to the newest
    non-prerelease release, so a prerelease's appcast would never be fetched."""
    serve = state / "serve" / build_id
    try:
        meta = json.loads((serve / "_meta.json").read_text())
    except (FileNotFoundError, json.JSONDecodeError) as exc:
        return {"ok": False, "display": f"release: could not read build meta: {exc}"}
    # Defense in depth (issue #117): should be unreachable — _sparkle_sign
    # fails the whole deploy before a build with sparkle_required=True and no
    # signature can ever be staged (see _stage_macos) — but refuse here too
    # rather than trust that invariant blindly at the one place a release
    # actually gets published.
    if meta.get("sparkle_required") and not meta.get("sparkle"):
        return {"ok": False, "display":
                "release: [macos.sparkle] enabled but this build has no EdDSA "
                "signature — refusing to publish an unsigned release"}
    zip_name = meta.get("release_zip")
    if not zip_name:
        return {"ok": False, "display": "release: no release zip was staged"}
    zip_path = serve / zip_name

    if os.environ.get("DEPLOYIT_SKIP_RELEASE_PUBLISH"):
        return {"ok": True, "skipped": True,
                "display": f"release publish skipped (env) for {zip_path.name}"}

    # Full SHA pins the release to the exact build commit even if the tag is
    # created later/elsewhere.
    sha_res = subprocess.run(["git", "-C", str(cwd), "rev-parse", "HEAD"],
                             capture_output=True, text=True)
    target = sha_res.stdout.strip() if sha_res.returncode == 0 else meta.get("commit", "")
    ver = meta.get("semver_version") or meta.get("marketing_version", "")
    title = f"{meta.get('project', '')} {ver}".strip()

    script = plugin_root / "bin" / "deployit-release"
    cmd = ["python3", str(script), "--zip", str(zip_path), "--project-dir", str(cwd),
           "--notes-file", str(notes_file)]
    if target:
        cmd += ["--target", target]
    if title:
        cmd += ["--title", title]
    if clobber:
        cmd.append("--clobber")
    if prerelease:
        cmd.append("--prerelease")
    if attach_dmg:
        dmg = meta.get("primary_artifact")
        if dmg and (serve / dmg).is_file():
            cmd += ["--attach", str(serve / dmg)]

    appcast_skipped_prerelease = False
    sparkle_meta = meta.get("sparkle")
    if sparkle_meta:
        if prerelease:
            appcast_skipped_prerelease = True
        else:
            cmd += ["--appcast-signature", sparkle_meta["ed_signature"]]

    res = subprocess.run(cmd, capture_output=True, text=True)
    try:
        result = json.loads(res.stdout)
    except json.JSONDecodeError:
        return {"ok": False, "stderr": res.stderr.strip() or res.stdout.strip(),
                "display": f"release: deployit-release produced no JSON (exit {res.returncode})"}
    if appcast_skipped_prerelease and result.get("ok"):
        result["appcast_skipped"] = (
            "prerelease mode: releases/latest/download/appcast.xml would never "
            "resolve to a prerelease, so no GitHub-release appcast was published")
    return result


# --- Out-of-band post-deploy tests (issue #90) -----------------------------
# A long UI suite cannot run inside a synchronous PreToolUse hook (Claude Code
# kills those at ~60s). So a project opts in with a convention script
# <project>/.deployit/post-deploy-test.sh (mirroring the .deployit/ExportOptions
# convention); after a build is fully published we spawn bin/deployit-posttest
# DETACHED to run it, streaming to a per-build log and recording a status file
# the web build page renders. Status + log live OUTSIDE serve/<id>/ so a mid-run
# write can't resurrect a build that gc/rm deleted, nor tear _meta.json.

POST_TEST_SCRIPT_REL = ".deployit/post-deploy-test.sh"


def _post_test_status_path(state: Path, build_id: str) -> Path:
    return state / "posttest" / f"{build_id}.json"


def _post_test_log_path(state: Path, build_id: str) -> Path:
    return state / "logs" / f"posttest-{build_id}.log"


def _write_post_test_status(status_file: Path, record: dict) -> None:
    """Atomic status write (temp + os.replace), shared discipline with
    bin/deployit-posttest so the backend never reads a half-written file."""
    status_file.parent.mkdir(parents=True, exist_ok=True)
    tmp = status_file.with_name(f"{status_file.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(record, indent=2))
    os.replace(tmp, status_file)


def _prune_post_test_artifacts(state: Path, build_id: str) -> None:
    """Delete a build's post-test status + log when the build itself is pruned
    (gc/rm), so they don't orphan under <state>/posttest and <state>/logs."""
    _post_test_status_path(state, build_id).unlink(missing_ok=True)
    _post_test_log_path(state, build_id).unlink(missing_ok=True)


def _spawn_post_deploy_test(state: Path, plugin_root: Path, project_dir: Path,
                            build_id: str, install_url: str) -> dict:
    """Kick off the project's post-deploy test suite OUT OF BAND, returning a
    small dict for the deploy display. Never raises — a post-test concern must
    never affect the already-published build.

    Absent script -> record `not_configured` and say so (a test gate must never
    be a silent no-op). Present -> spawn bin/deployit-posttest DETACHED:
    start_new_session so it outlives this CLI process AND the ~60s hook / tool
    timeout, and ALL stdio to DEVNULL so the deploy's own Bash tool returns
    immediately rather than blocking on the child's inherited stdout pipe (the
    exact trap #90 escapes). Honors DEPLOYIT_SKIP_POSTTEST (tests/offline)."""
    status_file = _post_test_status_path(state, build_id)
    log_file = _post_test_log_path(state, build_id)
    script = project_dir / POST_TEST_SCRIPT_REL
    # The build is ALREADY published by the time we run — no post-test
    # bookkeeping failure (a full disk, an unwritable state dir) may propagate
    # out and fail an otherwise-successful deploy.
    try:
        if not script.is_file():
            _write_post_test_status(status_file, {
                "build_id": build_id, "status": "not_configured",
                "started_at": None, "finished_at": None,
            })
            return {"status": "not_configured", "script": str(script)}

        if os.environ.get("DEPLOYIT_SKIP_POSTTEST"):
            return {"status": "skipped", "script": str(script),
                    "log_path": str(log_file), "status_file": str(status_file)}

        started_at = _dt.datetime.now().astimezone().isoformat(timespec="seconds")
        helper = plugin_root / "bin" / "deployit-posttest"
        cmd = ["python3", str(helper),
               "--script", str(script),
               "--project-dir", str(project_dir),
               "--build-id", build_id,
               "--status-file", str(status_file),
               "--log-file", str(log_file),
               "--state-dir", str(state),
               "--install-url", install_url]
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        # Initial `running` marker so the build page reflects the run
        # immediately; the detached helper rewrites this file with the final
        # outcome minutes on.
        _write_post_test_status(status_file, {
            "build_id": build_id, "status": "running", "pid": proc.pid,
            "started_at": started_at, "finished_at": None,
            "exit_code": None, "log_path": str(log_file),
        })
        return {"status": "running", "pid": proc.pid,
                "log_path": str(log_file), "status_file": str(status_file)}
    except Exception as exc:  # never fail the deploy over a post-test concern
        return {"status": "error", "detail": str(exc),
                "log_path": str(log_file), "status_file": str(status_file)}


def cmd_bootstrap(args):
    args.plugin_root = args.plugin_root.resolve()
    state = _state_dir()
    state.mkdir(parents=True, exist_ok=True)
    _ensure_dirs(state)
    _sync_plugin_root(state, args.plugin_root)
    base_url = _derive_base_url()
    cfg_path = _write_config(state, args.plugin_root, base_url)
    _clone_index(state)
    _configure_tailscale_serve(8729)
    launchd_status = _install_launchd(state, 8729)
    display = f"deployit bootstrapped. Bookmark on iPhone: {base_url}/"
    if not launchd_status["skipped"] and not launchd_status["loaded"]:
        display += f"\nWARNING: launchctl bootstrap failed: {launchd_status['launchctl_stderr']}"
    ok({
        "display": display,
        "state_dir": str(state),
        "config_path": str(cfg_path),
        "base_url": base_url,
        "launchd": launchd_status,
    })


def _verify_sparkle_toolchain(sparkle_cfg: dict, project: str, *, release: bool):
    """cmd_deploy preflight (issue #117): resolve `sign_update` before the
    archive/export/notarize round-trip (minutes), not just at signing time —
    a stale or missing pin then fails in ~1s instead of after the build.
    Reuses _resolve_sparkle_sign_update, the same resolver _sparkle_sign
    calls at signing time, so there is one source of truth for the discovery
    ladder (and an explicit-but-missing env/config pin fails here exactly as
    it would at signing time). Non-fatal warnings (quarantine, deprecated
    cask) print here too, even when the tool IS found; a missing tool only
    fails hard when this deploy will publish a release — for a tailnet-only
    deploy that's left to _sparkle_sign to warn and degrade, unchanged from
    the pre-preflight behavior."""
    resolved = _resolve_sparkle_sign_update(sparkle_cfg, project)
    for w in resolved["warnings"]:
        sys.stderr.write(f"deployit: WARNING — {w}\n")
    if resolved["path"] is None and release:
        fail("deployit: [macos.sparkle] enabled and this deploy publishes a "
             "GitHub release, but no `sign_update` was found (checked env, "
             "config, PATH, SwiftPM artifacts, and the Homebrew cask) — "
             "refusing to build toward an unsigned release. See "
             "references/sparkle.md.")


def cmd_deploy(args):
    if not args.platform:
        fail("--platform required (one of ios | macos | visionos)")
    cwd = Path.cwd()
    _refuse_if_worktree(cwd)
    meta = _derive_metadata(cwd, args.platform)

    # Per-project toolchain pin (.deployit/config.toml [toolchain] — see
    # _resolve_toolchain_developer_dir). None when the project sets none, in
    # which case archive/export inherit the ambient environment unchanged.
    project_cfg = _read_project_config(cwd)
    developer_dir = _resolve_toolchain_developer_dir(project_cfg)
    build_env = {**os.environ, "DEVELOPER_DIR": developer_dir} if developer_dir else None

    if getattr(args, "dump_metadata", False):
        ok({"display": "metadata", **meta, "developer_dir": developer_dir})
        return

    # Semver awareness: when the project tracks its version with the semver
    # plugin, capture that version so the web UI reports it (else build number).
    semver_version = _semver_active_version(cwd)

    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")
    origin_host = urlparse(base_url).netloc

    # GitHub release publishing is on by default for macOS (escape hatches:
    # [github] release = false in config.toml, or --no-release per deploy).
    gh_cfg = cfg.get("github", {})
    do_release = (args.platform == "macos"
                  and gh_cfg.get("release", True)
                  and not getattr(args, "no_release", False))

    # Sparkle toolchain preflight (issue #117): fail fast, before the
    # archive/export/notarize round-trip, rather than after it. [macos.sparkle]
    # is opt-in (absent under tomllib on a config.toml that predates it, unlike
    # the regex fallback's always-present defaulted shape) — .get() chain like
    # every other sparkle_cfg read in this file (e.g. line ~1893 below).
    preflight_sparkle_cfg = cfg.get("macos", {}).get("sparkle", {})
    if args.platform == "macos" and preflight_sparkle_cfg.get("enabled"):
        _verify_sparkle_toolchain(preflight_sparkle_cfg, meta["project"], release=do_release)

    build_id = _build_id(meta["project"], meta["platform"], meta["commit"])
    timestamp = _dt.datetime.now().astimezone().isoformat(timespec="seconds")

    builds_dir = state / "builds"
    builds_dir.mkdir(exist_ok=True)
    archive_path = builds_dir / f"{build_id}.xcarchive"
    export_dir = builds_dir / f"{build_id}.export"
    if archive_path.exists(): _shutil.rmtree(archive_path)
    if export_dir.exists():   _shutil.rmtree(export_dir)
    export_dir.mkdir(parents=True)

    # AGE-28: measure what is about to be built, and refuse an unacknowledged
    # unoptimized archive — before the archive/export/notarize round-trip
    # rather than after it, matching the Sparkle preflight above. `build_env`
    # is passed so the settings resolve under the SAME toolchain the archive
    # uses; without it a [toolchain]-pinned project (Lillist pins min_sdk=27)
    # would be gated on settings from a different Xcode.
    gate = _archive_gate(_archive_build_settings(meta, args.scheme, env=build_env),
                         project_cfg, args.platform, do_release)
    if gate["verdict"] == "refuse":
        fail(_archive_refusal_message(gate, meta, args.scheme))
    for warning in gate["warnings"]:
        print(f"deployit: WARNING — {warning}", file=sys.stderr)

    _xcodebuild_archive(meta, archive_path, args.scheme, env=build_env)
    build_number = _read_archive_build_number(archive_path, meta["project"])
    _xcodebuild_export(archive_path, export_dir, args.plugin_root, args.platform, env=build_env)

    meta_full = {
        **meta,
        "id": build_id,
        "build_number": build_number,
        "semver_version": semver_version,
        "timestamp": timestamp,
        "origin_host": origin_host,
        "origin_base_url": base_url,
        # AGE-28: the durable record of what was built. `optimization_level` is
        # carried alongside the name deliberately — the NAME is the field that
        # can lie, and a Release-named configuration built -Onone is exactly the
        # case a name-only record would whitewash.
        "configuration": gate["configuration"],
        "configuration_source": gate["configuration_source"],
        "optimization_level": gate["optimization_level"],
    }

    if args.platform in ("ios", "visionos"):
        ipa = next(export_dir.glob("*.ipa"), None)
        if ipa is None:
            fail("export produced no .ipa")
        _stage_ios_or_visionos(state, args.plugin_root, build_id, ipa, meta_full)
    elif args.platform == "macos":
        app = next(export_dir.glob("*.app"), None)
        if app is None:
            fail("export produced no .app")
        notarize = cfg["macos"]["notarize"]
        notary_profile = cfg["macos"].get("notary_profile", "")
        notary_keychain = cfg["macos"].get("notary_keychain", "")
        sparkle_cfg = cfg.get("macos", {}).get("sparkle", {})
        _stage_macos(state, args.plugin_root, build_id, app, meta_full,
                     notarize, notary_profile, sparkle_cfg,
                     release=do_release, notary_keychain=notary_keychain)
    else:
        fail(f"unsupported platform: {args.platform}")

    _shutil.rmtree(archive_path, ignore_errors=True)
    _shutil.rmtree(export_dir, ignore_errors=True)

    entry = json.loads((state / "serve" / build_id / "_meta.json").read_text())
    primary = entry.pop("primary_artifact")
    artifact_path = state / "serve" / build_id / primary
    entry["size_bytes"] = artifact_path.stat().st_size
    entry["archived"] = False
    entry["notes"] = None
    entry.pop("release_zip", None)  # tailnet index doesn't track the GitHub asset
    sparkle_detect = entry.pop("sparkle_detect", None)  # advisory only (issue #111); not shared
    entry.pop("sparkle_required", None)  # internal publish-gate marker (issue #117); not shared

    publish = _append_to_index(state, entry, idx=_index_cfg(cfg))
    _refresh_local_backend(cfg["server"]["port"])

    # GitHub release — the final, recoverable step. It runs only after the
    # tailnet build is fully published (index + backend), so a publish failure
    # leaves a deployed, indexed build (retry by re-deploying) rather than an
    # orphaned public release.
    rel = None
    if do_release:
        notes_path = _release_notes_path(args, meta_full, builds_dir)
        rel = _publish_github_release(
            args.plugin_root, cwd, state, build_id, notes_path,
            clobber=(getattr(args, "clobber_release", False) or gh_cfg.get("clobber", False)),
            prerelease=(getattr(args, "prerelease", False) or gh_cfg.get("prerelease", False)),
            attach_dmg=(getattr(args, "attach_dmg", False) or gh_cfg.get("attach_dmg", False)),
        )

    install_url = f"{base_url}/{build_id}/"
    listing_url = f"{base_url}/"
    # Out-of-band post-deploy test (issue #90): fire-and-forget AFTER the build
    # is fully published, so a long suite runs free of the ~60s hook/tool
    # timeout. Never raises; the deploy is already done regardless of outcome.
    post_test = _spawn_post_deploy_test(state, args.plugin_root, cwd, build_id, install_url)
    display = (
        f"deployed: {entry['project']} {entry['platform']} "
        f"{entry['marketing_version']} (build {entry['build_number']})\n"
        f"install:  {install_url}\n"
        f"listing:  {listing_url}"
    )
    result = {
        "build_id": build_id,
        "install_url": install_url,
        "listing_url": listing_url,
        "post_test": post_test.get("status"),
    }
    # Sparkle config-vs-app mismatch warnings (issue #111). Detection is purely
    # advisory: it never gates whether the appcast is produced — `enabled`
    # remains the sole actuator, since signing needs the configured key/tool —
    # but a mismatch must never be a silent no-op.
    if sparkle_detect is not None:
        sp_cfg = cfg.get("macos", {}).get("sparkle", {})
        sparkle_warnings = _sparkle_mismatch_warnings(sparkle_detect, bool(sp_cfg.get("enabled")))
        if sparkle_warnings:
            result["sparkle_warnings"] = sparkle_warnings
            for w in sparkle_warnings:
                display += f"\nwarning:  {w}"
                sys.stderr.write(f"deployit: WARNING — {w}\n")
    # Sparkle: when this build was EdDSA-signed, surface the appcast feed and the
    # public key so the developer can wire SUFeedURL / SUPublicEDKey into the app.
    if entry.get("sparkle"):
        sp_cfg = cfg.get("macos", {}).get("sparkle", {})
        appcast_url = f"{base_url}/p/{quote(entry['bundle_id'], safe='')}/macos/appcast.xml"
        public_ed_key = sp_cfg.get("public_ed_key", "")
        result["appcast_url"] = appcast_url
        result["public_ed_key"] = public_ed_key
        display += (
            f"\nappcast:  {appcast_url}"
            f"\nSUPublicEDKey: "
            f"{public_ed_key or '(set macos.sparkle.public_ed_key in config.toml)'}"
        )
    if rel is not None:
        if rel.get("ok") and rel.get("release_url"):
            result["release_url"] = rel["release_url"]
            display += f"\nrelease:  {rel['release_url']}"
        elif rel.get("ok") and rel.get("skipped"):
            display += "\nrelease:  (skipped)"
        elif not rel.get("ok"):
            result["release_error"] = rel.get("display") or "release publish failed"
            display += (f"\nrelease:  FAILED — {result['release_error']}"
                        "\n          (build is deployed; fix the cause and re-deploy to publish)")
        # GitHub-release appcast (issue #111): a stable, publicly reachable feed
        # for a distributed Developer-ID app, alongside the tailnet-only one.
        if rel.get("appcast_url"):
            result["github_appcast_url"] = rel["appcast_url"]
            display += f"\nappcast:  {rel['appcast_url']} (GitHub release)"
        if rel.get("appcast_skipped"):
            display += f"\nwarning:  {rel['appcast_skipped']}"
            sys.stderr.write(f"deployit: WARNING — {rel['appcast_skipped']}\n")
    # Index publish outcome. A direct push (or an auto-merged PR) lands the entry
    # on the shared index immediately; when auto-merge is off and a ruleset
    # blocked the push, the entry is pending on an open PR — the build is already
    # installable at its direct URL, and the listing updates once the PR merges.
    if not publish["published"]:
        result["index_pending"] = True
        result["index_pr_url"] = publish.get("pr_url")
        pending_ref = publish.get("pr_url") or (
            f"branch {publish.get('branch')}" if publish.get("branch") else "(see index clone)")
        display += (f"\nindex:    pending PR merge — {pending_ref}"
                    "\n          (installable now at the install URL above; the "
                    "listing updates when the PR merges)")
    elif publish.get("pr_url"):
        result["index_pr_url"] = publish["pr_url"]
        display += f"\nindex:    published via PR — {publish['pr_url']}"
    # Post-deploy test outcome. `running` is the norm (the suite is still going
    # out-of-band); the build page shows the pass/fail badge when it finishes.
    # `not_configured` is stated loudly so a missing gate is never a silent no-op.
    pt = post_test.get("status")
    if pt == "running":
        display += (f"\npost_test: running out-of-band → {post_test['log_path']}"
                    "\n           (pass/fail appears on the build page when it finishes)")
    elif pt == "not_configured":
        display += ("\npost_test: no .deployit/post-deploy-test.sh — skipped"
                    "\n           (add one to run your test suite after every deploy)")
    elif pt == "skipped":
        display += "\npost_test: skipped (DEPLOYIT_SKIP_POSTTEST)"
    elif pt == "error":
        display += f"\npost_test: FAILED to start — {post_test.get('detail', '')}"
    result["display"] = display
    ok(result)


def cmd_preflight(args):
    """Read-only pre-deploy check: is a semver version bump needed before this
    deploy? Drives the SKILL's bump prompt. Never builds or mutates anything.

    When semver is inactive the deploy proceeds normally (the web UI reports the
    build number). When active, compares the current VERSION against the newest
    already-published build of this (bundle_id, platform): if unchanged, a bump
    is required so no two published builds share a version."""
    if not args.platform:
        fail("--platform required (one of ios | macos | visionos)")
    cwd = Path.cwd()
    meta = _derive_metadata(cwd, args.platform)
    semver_version = _semver_active_version(cwd)

    if semver_version is None:
        ok({
            "display": "semver inactive — deploy will report the build number",
            "semver_active": False,
            "bump_needed": False,
            "project": meta["project"],
            "bundle_id": meta["bundle_id"],
            "platform": meta["platform"],
        })
        return

    prefix = _semver_prefix(cwd)
    state = _state_dir()
    _pull_index(state)
    try:
        builds = json.loads((state / "index" / "builds.json").read_text()).get("builds", [])
    except (FileNotFoundError, json.JSONDecodeError):
        builds = []
    latest = _latest_build_for(builds, meta["bundle_id"], meta["platform"])
    latest_version = latest.get("semver_version") if latest else None
    version_changed = (latest is None or latest_version is None
                       or latest_version != semver_version)
    bump_needed = not version_changed

    if bump_needed:
        display = (f"semver {semver_version} is already the latest published build of "
                   f"{meta['project']} {meta['platform']} — a version bump is required")
    else:
        display = (f"semver {semver_version} — OK to deploy "
                   f"(latest published: {latest_version or 'none'})")

    ok({
        "display": display,
        "semver_active": True,
        "bump_needed": bump_needed,
        "version_changed": version_changed,
        "current_version": semver_version,
        "latest_version": latest_version,
        "candidates": _next_versions(semver_version, prefix),
        "project": meta["project"],
        "bundle_id": meta["bundle_id"],
        "platform": meta["platform"],
        "dirty_tree": _is_dirty(cwd),
        "current_branch": _current_branch(cwd),
        "target_branch": (_parse_semver_config(cwd) or {}).get("target_branch", "main"),
    })


def cmd_bump(args):
    """Drive a semver version bump as part of a deploy: non-interactive, folding
    any uncommitted changes into the chore(release) commit ("auto-include").

    Delegates the bump to the semver plugin's CLI (discovered at runtime) so all
    of semver's behaviour — changelog, tagging, shell hooks — is reused. Bypasses
    semver's interactive `gather` step: the deploy already chose the component and
    pre-authorised include semantics, so there are no extra prompts. `--force`
    permits a version-only bump when there are no new commits; a pre-existing tag
    is non-fatal."""
    if not args.component:
        fail("--component required (one of major | minor | patch)")
    cwd = Path.cwd()
    _refuse_if_worktree(cwd)
    if _semver_active_version(cwd) is None:
        fail("semver is not active for this project — nothing to bump")
    cli = _find_semver_cli(args.plugin_root)
    if cli is None:
        fail(f"semver CLI not found — run `/semver bump {args.component}` "
             "manually, then re-run the deploy")
    semver_root = cli.parent.parent
    res = subprocess.run(
        ["python3", str(cli), "bump", "execute", args.component,
         "--source", "force", "--force", "--dirty-action", "include",
         "--plugin-root", str(semver_root)],
        capture_output=True, text=True,
    )
    try:
        payload = json.loads(res.stdout)
    except json.JSONDecodeError:
        fail("semver bump produced no JSON",
             stderr=res.stderr.strip() or res.stdout.strip())
    if not payload.get("ok"):
        fail(payload.get("display") or payload.get("message") or "semver bump failed",
             semver=payload)
    old_v, new_v = payload.get("old_version", "?"), payload.get("new_version", "?")
    ok({
        "display": f"semver bump: {old_v} → {new_v} ({args.component})",
        "old_version": old_v,
        "new_version": new_v,
    })


def cmd_release_context(args):
    """Read-only: gather the raw facts the SKILL turns into GitHub release notes —
    the repo, the previous release tag, the commits since it (with URLs), and
    recently closed issues (with URLs). Degrades to commits-only when gh is
    unavailable. Never builds or mutates anything."""
    cwd = Path.cwd()
    res = subprocess.run(["git", "-C", str(cwd), "remote", "get-url", "origin"],
                         capture_output=True, text=True)
    if res.returncode != 0:
        fail("no git remote 'origin' in cwd — cannot build release context")
    owner_repo = _parse_owner_repo(res.stdout)
    if not owner_repo:
        fail(f"could not parse owner/repo from remote URL: {res.stdout.strip()!r}")
    owner, repo = owner_repo.split("/", 1)
    gh = _gh_bin()

    # Previous release tag: the latest GitHub release, else the newest tag.
    prev_tag = None
    rv = subprocess.run([gh, "release", "view", "--repo", owner_repo,
                         "--json", "tagName", "-q", ".tagName"],
                        capture_output=True, text=True)
    if rv.returncode == 0 and rv.stdout.strip():
        prev_tag = rv.stdout.strip()
    else:
        tg = subprocess.run(["git", "-C", str(cwd), "tag", "--sort=-v:refname"],
                            capture_output=True, text=True)
        tags = [t for t in tg.stdout.splitlines() if t.strip()] if tg.returncode == 0 else []
        prev_tag = tags[0] if tags else None

    rng = f"{prev_tag}..HEAD" if prev_tag else "HEAD"
    lg = subprocess.run(["git", "-C", str(cwd), "log", rng,
                         "--pretty=format:%H%x1f%h%x1f%s"], capture_output=True, text=True)
    commits = []
    if lg.returncode == 0:
        for line in lg.stdout.splitlines():
            if not line.strip():
                continue
            parts = (line.split("\x1f") + ["", "", ""])[:3]
            sha, short, subject = parts
            commits.append({"sha": sha, "short": short, "subject": subject,
                            "url": f"https://github.com/{owner_repo}/commit/{sha}"})

    closed = []
    il = subprocess.run([gh, "issue", "list", "--repo", owner_repo, "--state", "closed",
                         "--limit", "50", "--json", "number,title,url,closedAt"],
                        capture_output=True, text=True)
    if il.returncode == 0 and il.stdout.strip():
        try:
            for it in json.loads(il.stdout):
                closed.append({"number": it.get("number"), "title": it.get("title"),
                               "url": it.get("url"), "closed_at": it.get("closedAt")})
        except json.JSONDecodeError:
            pass

    ok({
        "display": (f"release context for {owner_repo}: {len(commits)} commit(s) since "
                    f"{prev_tag or '(no previous tag)'}, {len(closed)} closed issue(s)"),
        "owner": owner, "repo": repo, "owner_repo": owner_repo,
        "prev_tag": prev_tag, "commits": commits, "closed_issues": closed,
    })


def cmd_url(args):
    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")
    ok({"display": f"{base_url}/", "url": f"{base_url}/"})


def cmd_status(args):
    state = _state_dir()
    cfg = _read_config(state)
    port = cfg["server"]["port"]
    base_url = cfg["server"]["base_url"].rstrip("/")
    try:
        with urllib.request.urlopen(
                f"http://127.0.0.1:{port}/deployit/_healthz", timeout=2) as r:
            health = json.loads(r.read())
            backend_ok = bool(health.get("ok"))
    except Exception:
        backend_ok = False

    builds_path = state / "index" / "builds.json"
    try:
        data = json.loads(builds_path.read_text())
        local_builds = [b for b in data["builds"]
                        if b["origin_base_url"] == base_url]
    except FileNotFoundError:
        local_builds = []

    lines = [
        f"backend:  {'up' if backend_ok else 'DOWN'} (port {port})",
        f"base_url: {base_url}/",
        f"recent local deploys:",
    ]
    for b in local_builds[:5]:
        lines.append(f"  - {b['id']}  {b['project']} {b['platform']} "
                     f"{b['marketing_version']} ({b['timestamp']})")
    if not local_builds:
        lines.append("  (none)")
    ok({"display": "\n".join(lines), "backend_ok": backend_ok})


def cmd_list(args):
    state = _state_dir()
    builds_path = state / "index" / "builds.json"
    if not builds_path.exists():
        fail("no local index — run /deployit bootstrap")
    data = json.loads(builds_path.read_text())
    rows = data["builds"]
    if args.platform:
        rows = [b for b in rows if b["platform"] == args.platform]
    if args.project:
        rows = [b for b in rows if b["project"].lower() == args.project.lower()]
    lines = []
    for b in rows[:30]:
        flag = " [archived]" if b.get("archived") else ""
        lines.append(f"{b['id']}{flag}\n"
                     f"  {b['project']} {b['platform']} {b['marketing_version']} "
                     f"(build {b['build_number']}) · {b['timestamp']} · {b['origin_host']}")
    ok({"display": "\n".join(lines) if lines else "(no builds)",
        "count": len(rows)})


def cmd_gc(args):
    if args.keep is None and getattr(args, "older_than", None) is None:
        fail("gc requires --keep N or --older-than DAYS")
    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")

    archived_ids = []

    def mutate(data):
        local = [b for b in data["builds"]
                 if b["origin_base_url"] == base_url and not b.get("archived")]
        local.sort(key=lambda b: b["timestamp"], reverse=True)
        if args.keep is not None:
            to_archive = local[args.keep:]
        else:
            cutoff = _dt.datetime.now(_dt.timezone.utc) - _dt.timedelta(days=args.older_than)
            to_archive = [b for b in local
                          if _dt.datetime.fromisoformat(b["timestamp"]).astimezone(_dt.timezone.utc) < cutoff]
        if not to_archive:
            return None
        for b in to_archive:
            b["archived"] = True
        archived_ids[:] = [b["id"] for b in to_archive]
        return f"chore(deploy): archive {len(to_archive)} build(s) from {base_url}"

    result = _commit_and_push_index(state, mutate, idx=_index_cfg(cfg))

    # Only touch local disk once the index change is final. When a ruleset left
    # it pending on an open PR, keep the serve dirs so the archive stays
    # consistent with the (unchanged) index until the PR merges.
    status = result.get("status") if result else None
    removed = 0
    if _index_change_is_effective(result):
        for bid in archived_ids:
            d = state / "serve" / bid
            if d.exists():
                _shutil.rmtree(d)
                removed += 1
            _prune_post_test_artifacts(state, bid)
        if status != "local_only":
            _refresh_local_backend(cfg["server"]["port"])

    display = f"archived {len(archived_ids)} build(s); removed {removed} local dir(s)"
    payload = {"archived": len(archived_ids), "removed_local": removed}
    # Each arm keys off its own status. Never `not published`: that spelling made
    # the local-only path claim a PR that does not exist (AGE-48).
    if status == "local_only":
        payload["index_local_only"] = True
        display += ("\nindex change is LOCAL ONLY — DEPLOYIT_SKIP_GC_PUSH is set, "
                    "so nothing was pushed and no remote was contacted")
    elif status == "pending":
        payload["index_pending"] = True
        payload["index_pr_url"] = result.get("pr_url")
        display += (f"\nindex archive pending PR merge — "
                    f"{result.get('pr_url') or '(see index clone)'}; "
                    "local dirs kept until it merges")
    ok({"display": display, **payload})


def cmd_rm(args):
    """Delete a single local build (--build ID) or a whole local product
    (--product BUNDLE_ID --platform P): remove the matching entries from the
    shared index and rmtree their serve/ dirs. Scoped to builds this machine
    owns (origin_base_url == base_url) — foreign builds are managed on their
    origin Mac. This is the writer behind the web UI's swipe-to-delete."""
    has_build = bool(args.build)
    has_product = bool(args.product)
    if has_build == has_product:
        fail("rm requires exactly one of --build ID or --product BUNDLE_ID --platform P")
    if has_product and not args.platform:
        fail("rm --product requires --platform")
    if has_build and not _BUILD_ID_RE.match(args.build):
        fail("invalid build id")

    state = _state_dir()
    cfg = _read_config(state)
    base_url = cfg["server"]["base_url"].rstrip("/")
    host = urlparse(base_url).netloc

    if has_build:
        scope = f"build {args.build}"
        match = lambda b: b.get("id") == args.build
    else:
        scope = f"product {args.product} {args.platform}"
        match = lambda b: (b.get("bundle_id") == args.product
                           and b.get("platform") == args.platform)

    removed_ids = []

    def mutate(data):
        targets = [b for b in data["builds"] if match(b)]
        local_ids = {b["id"] for b in targets if b.get("origin_base_url") == base_url}
        if not local_ids:
            hint = " (foreign builds are managed on their origin Mac)" if targets else ""
            fail(f"no local {scope} to delete{hint}")
        data["builds"] = [b for b in data["builds"] if b["id"] not in local_ids]
        removed_ids[:] = sorted(local_ids)
        return f"chore(deploy): rm {scope} via web from {host}"

    result = _commit_and_push_index(state, mutate, idx=_index_cfg(cfg))

    # Delete files only once the index removal is final. A `fail()` inside the
    # publisher (e.g. the launchd daemon can't reach gh) exits before this,
    # leaving the serve dirs intact; a pending PR likewise keeps them until merge.
    status = result.get("status") if result else None
    removed = 0
    if _index_change_is_effective(result):
        for bid in removed_ids:
            d = state / "serve" / bid
            if d.exists():
                _shutil.rmtree(d, ignore_errors=True)
                removed += 1
            _prune_post_test_artifacts(state, bid)
        if status != "local_only":
            _refresh_local_backend(cfg["server"]["port"])

    display = f"removed {len(removed_ids)} build(s); {removed} local dir(s)"
    payload = {"removed": len(removed_ids), "removed_local": removed}
    # Each arm keys off its own status. Never `not published`: that spelling made
    # the local-only path claim a PR that does not exist (AGE-48). This payload
    # reaches a real user over HTTP — deployit-backend:_run_cli_rm forwards it
    # verbatim to the web UI's swipe-to-delete — so the disclosure is not a
    # test-only affordance.
    if status == "local_only":
        payload["index_local_only"] = True
        display += ("\nindex change is LOCAL ONLY — DEPLOYIT_SKIP_GC_PUSH is set, "
                    "so nothing was pushed and no remote was contacted")
    elif status == "pending":
        payload["index_pending"] = True
        payload["index_pr_url"] = result.get("pr_url")
        display += (f"\nindex removal pending PR merge — "
                    f"{result.get('pr_url') or '(see index clone)'}; "
                    "local files kept until it merges")
    ok({"display": display, **payload})


def _plist_is_legacy(state: Path) -> bool:
    """True iff the installed plist references something OTHER than the stable
    <state>/bin/deployit-backend path (i.e., still pins to a cache-hash dir)."""
    plist_path = Path.home() / "Library" / "LaunchAgents" / "com.mikeydotio.deployit.backend.plist"
    if not plist_path.is_file():
        return True
    try:
        body = plist_path.read_text()
    except OSError:
        return True
    return f"{state}/bin/deployit-backend" not in body


def _kickstart_daemon():
    """Restart the launchd-managed backend. Skipped via DEPLOYIT_SKIP_KICKSTART."""
    if os.environ.get("DEPLOYIT_SKIP_KICKSTART"):
        return
    launchctl = os.environ.get("DEPLOYIT_LAUNCHCTL_BIN", "launchctl")
    subprocess.run(
        [launchctl, "kickstart", "-k", f"gui/{os.getuid()}/com.mikeydotio.deployit.backend"],
        check=True, timeout=10,
    )


def _wait_for_health(port: int, timeout_s: float = 5.0) -> bool:
    """Poll /deployit/_healthz until it returns ok or timeout."""
    if os.environ.get("DEPLOYIT_SKIP_VERIFY"):
        return True
    deadline = time.monotonic() + timeout_s
    last_err = ""
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(
                    f"http://127.0.0.1:{port}/deployit/_healthz", timeout=1) as r:
                if json.loads(r.read()).get("ok"):
                    return True
        except Exception as exc:
            last_err = repr(exc)
        time.sleep(0.1)
    sys.stderr.write(f"deployit: health probe failed: {last_err}\n")
    return False


def cmd_redeploy(args):
    """Re-sync the daemon's plugin-root symlinks, repair a legacy plist if
    needed, restart launchd, wait for health, and run verify-live.sh.

    Defaults the target to args.plugin_root (the runtime cache dir). Pass
    --source PATH to point at an arbitrary plugin checkout (e.g., a dev
    repo) for fast iteration without waiting for a new release."""
    state = _state_dir()
    if not state.exists():
        fail("deployit not bootstrapped — run /deployit bootstrap first")
    _ensure_dirs(state)

    target = (args.source if args.source else args.plugin_root).resolve()
    if not (target / "bin" / "deployit-backend").is_file():
        fail(f"target has no bin/deployit-backend: {target}")

    cfg = _read_config(state)
    port = cfg["server"]["port"]

    _sync_plugin_root(state, target)

    # Repair legacy hash-pinned plists from older bootstrap runs.
    plist_rewritten = False
    if _plist_is_legacy(state):
        _install_launchd(state, port)
        plist_rewritten = True

    _kickstart_daemon()

    if not _wait_for_health(port):
        fail(f"daemon did not become healthy on port {port} after kickstart",
             port=port)

    # Live verification: run verify-live.sh against the running daemon.
    if not os.environ.get("DEPLOYIT_SKIP_VERIFY"):
        verify = target / "tests" / "verify-live.sh"
        if not verify.is_file():
            fail(f"verify-live.sh not found at {verify}")
        env = {**os.environ, "DEPLOYIT_STATE_DIR": str(state)}
        res = subprocess.run(
            ["bash", str(verify), "--port", str(port)],
            capture_output=True, text=True, env=env, timeout=15,
        )
        if res.returncode != 0:
            fail("live verification failed",
                 verify_stdout=res.stdout, verify_stderr=res.stderr)

    parts = [f"redeployed daemon: target={target}"]
    if plist_rewritten:
        parts.append("plist rewritten to stable paths")
    parts.append("health + live checks passed")
    ok({
        "display": "\n  ".join(parts),
        "target": str(target),
        "port": port,
        "plist_rewritten": plist_rewritten,
    })


def build_parser():
    parser = JsonArgumentParser(prog="deployit")
    parser.add_argument("--plugin-root", required=True, type=Path)
    parser.add_argument("--version", action="store_true")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("bootstrap").set_defaults(func=cmd_bootstrap)

    p_deploy = sub.add_parser("deploy")
    p_deploy.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_deploy.add_argument("--scheme")
    # GitHub release (macOS): on by default; the agent passes --release-notes-file.
    p_deploy.add_argument("--release-notes-file", dest="release_notes_file")
    p_deploy.add_argument("--no-release", action="store_true", dest="no_release")
    p_deploy.add_argument("--clobber-release", action="store_true", dest="clobber_release")
    p_deploy.add_argument("--prerelease", action="store_true")
    p_deploy.add_argument("--attach-dmg", action="store_true", dest="attach_dmg")
    p_deploy.add_argument("--__dump-metadata", action="store_true",
                          help=argparse.SUPPRESS, dest="dump_metadata")
    p_deploy.set_defaults(func=cmd_deploy)

    p_list = sub.add_parser("list")
    p_list.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_list.add_argument("--project")
    p_list.set_defaults(func=cmd_list)

    sub.add_parser("url").set_defaults(func=cmd_url)
    sub.add_parser("status").set_defaults(func=cmd_status)

    p_gc = sub.add_parser("gc")
    p_gc.add_argument("--keep", type=int)
    p_gc.add_argument("--older-than", type=int, help="days")
    p_gc.set_defaults(func=cmd_gc)

    p_rm = sub.add_parser("rm")
    p_rm.add_argument("--build")
    p_rm.add_argument("--product")
    p_rm.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_rm.set_defaults(func=cmd_rm)

    p_redeploy = sub.add_parser("redeploy")
    p_redeploy.add_argument("--source", type=Path, default=None,
        help="point the daemon at this plugin dir instead of the cached release")
    p_redeploy.set_defaults(func=cmd_redeploy)

    p_preflight = sub.add_parser("preflight")
    p_preflight.add_argument("--platform", choices=["ios", "macos", "visionos"])
    p_preflight.add_argument("--scheme")  # accepted for symmetry with deploy; unused
    p_preflight.set_defaults(func=cmd_preflight)

    p_bump = sub.add_parser("bump")
    p_bump.add_argument("--component", choices=["major", "minor", "patch"])
    p_bump.set_defaults(func=cmd_bump)

    p_relctx = sub.add_parser("release-context")
    p_relctx.add_argument("--platform", choices=["ios", "macos", "visionos"])  # accepted; unused
    p_relctx.set_defaults(func=cmd_release_context)

    return parser


def main(argv):
    args = build_parser().parse_args(argv)
    if args.version:
        ok({"version": __version__})
        return
    if not args.cmd:
        fail("no subcommand given")
    args.func(args)


if __name__ == "__main__":
    main(sys.argv[1:])
