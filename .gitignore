node_modules/
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.swp
*.swo
*~
# .storyhook.toml and .planning/ are version-controlled project data — do not ignore.
# storyhook keeps story data in ONE SQLite store outside every repo (`story help
# storage`); the repo carries only the .storyhook.toml pointer naming its project.
# There is no per-repo storyhook directory to commit — see AGE-11 and AGE-27.

# Freshen plugin signals (ephemeral, consumed on clear)
.freshen/

# RCA investigation artifacts (ephemeral, per-investigation)
.rca/

# Council-vote deliberation artifacts (ephemeral, per-decision)
.council/

# Pre-push budget breadcrumb (ephemeral). Repo-local on purpose: a fixed /tmp path
# would be machine-global state shared with every other project and every concurrent
# run — the AGE-34 defect, with AGE-56 and AGE-57 still open on the same class.
.gate-deadline/

# Forge plugin runtime artifacts (gitignored)
.forge/state.json
.forge/lock.json
.forge/verdicts.jsonl
# .forge/config.json, .forge/plan-mapping.json, .forge/handoffs/, and .forge/fix-cycles/ are version-controlled — do not ignore
.forge-archives/

# issue plugin per-issue git worktrees (working state, never committed)
.claude/worktrees/
