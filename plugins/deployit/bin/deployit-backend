#!/usr/bin/env python3
"""deployit backend — long-running http server.

Endpoints:
  GET    /deployit/                        listing (git pull + render)
  GET    /deployit/<build_id>/             per-build landing page
  GET    /deployit/<build_id>/<artifact>   manifest.plist / ipa / dmg
  DELETE /deployit/<build_id>/             delete a local build (shells to CLI rm)
  DELETE /deployit/p/<bundle>/<platform>/  delete a local product (all its builds)
  POST   /deployit/_internal/refresh       force git pull
  GET    /deployit/_healthz                liveness probe

Stdlib only. Designed to be supervised by launchd.
"""

import argparse
import datetime as _dt
import html
import json
import mimetypes
import os
import re
import string
import subprocess
import sys
import threading
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

import deployit_appcast


_BUILD_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
# Single path segments that look like a build id but never are one — guards the
# DELETE build route against deleting health/internal/static-asset paths.
_RESERVED_BUILD_WORDS = {
    "p", "_healthz", "_internal", "icons",
    "manifest.webmanifest", "app.css", "app.js", "icon.svg",
    "apple-touch-icon.png", "apple-touch-icon-precomposed.png",
}
_pull_lock = threading.Lock()
_last_pull = "never"

# Static assets served from <plugin_root>/assets/. URL → (relative path, content-type).
# Listed explicitly (not directory-served) so the backend's exposed filesystem
# surface stays a closed allowlist.
_STATIC_ASSETS = {
    "/deployit/manifest.webmanifest":             ("manifest.webmanifest",          "application/manifest+json"),
    "/deployit/app.css":                          ("app.css",                       "text/css; charset=utf-8"),
    "/deployit/app.js":                           ("app.js",                        "application/javascript; charset=utf-8"),
    "/deployit/icon.svg":                         ("icons/icon.svg",                "image/svg+xml"),
    "/deployit/apple-touch-icon.png":             ("icons/apple-touch-icon.png",    "image/png"),
    "/deployit/apple-touch-icon-precomposed.png": ("icons/apple-touch-icon.png",    "image/png"),
    "/deployit/icons/icon-192.png":               ("icons/icon-192.png",            "image/png"),
    "/deployit/icons/icon-512.png":               ("icons/icon-512.png",            "image/png"),
    "/deployit/icons/icon-maskable-512.png":      ("icons/icon-maskable-512.png",   "image/png"),
}


def _read_index(root: Path):
    try:
        return json.loads((root / "index" / "builds.json").read_text())
    except FileNotFoundError:
        return {"version": 1, "builds": []}
    except json.JSONDecodeError as exc:
        sys.stderr.write(f"backend: corrupt index/builds.json: {exc}\n")
        return {"version": 1, "builds": []}


# Mirrors the CLI's config.toml parse (deployit-cli `_read_config`). Used to
# decide which rows are "local" (this machine's origin) and thus eligible for
# swipe-to-delete; foreign-origin builds get no delete affordance.
_BASE_URL_RE = re.compile(r'base_url\s*=\s*"([^"]+)"')


def _read_base_url(root: Path):
    """This machine's listing base URL from <root>/config.toml, or None.

    None when the config is absent/unreadable (e.g. test fixtures); callers then
    treat no build as local, so no delete affordance is rendered."""
    try:
        text = (root / "config.toml").read_text()
    except OSError:
        return None
    m = _BASE_URL_RE.search(text)
    return m.group(1).rstrip("/") if m else None


def _relative_time(iso: str) -> str:
    when = _dt.datetime.fromisoformat(iso)
    now = _dt.datetime.now(when.tzinfo)
    delta = now - when
    secs = int(delta.total_seconds())
    if secs < 60:    return f"{secs}s ago"
    if secs < 3600:  return f"{secs // 60}m ago"
    if secs < 86400: return f"{secs // 3600}h ago"
    return f"{secs // 86400}d ago"


def _install_link(build):
    inst = build["install"]
    if inst["kind"] == "itms-services":
        href = "itms-services://?action=download-manifest&url=" + inst["manifest_url"]
        return href, "Install"
    return inst["dmg_url"], "Download"


def _platform_display(platform: str) -> str:
    """Human-facing platform name. The index stores lowercase slugs
    (ios/macos/visionos); the UI shows Apple's canonical casing."""
    return {"ios": "iOS", "macos": "macOS", "visionos": "visionOS"}.get(platform, platform)


def _version_label(build) -> str:
    """The version shown in the UI for a build. When the project tracked its
    version with semver at deploy time, show that (e.g. 'v2.16.1 (build 16)');
    otherwise fall back to the app's build number ('build 16'). `.get` keeps
    pre-semver index entries safe."""
    bn = build.get("build_number", "?")
    sv = build.get("semver_version")
    return f"{sv} (build {bn})" if sv else f"build {bn}"


# The Install link and the Delete button share one fixed-width .actions-slot
# (overflow-clipped) holding a two-button .action-track. At rest the track shows
# Install; a right-to-left swipe translates the track one slot-width left so
# Delete occupies Install's exact rectangle (an in-place swap, not a reveal).
# .swipe-content is the gesture surface; data-href / data-delete stay as direct
# <li> attributes (row nav + delete target).
_ROW_TEMPLATE = string.Template("""<li class="$archived_class"$data_href_attr$data_delete_attr>
  <div class="swipe-content">
    <div class="row">
      $title_block
      <div class="actions-slot"><div class="action-track"><a class="install" href="$install_href">$install_label</a>$delete_button</div></div>
    </div>
    <div class="sub">$origin_host · $commit · $rel$older_html$post_test_badge</div>
  </div>
</li>""")

# Listing rows (one per product) lead with a prominent product name and demote
# platform · version to a muted subline; per-build rows keep the single title.
_LISTING_TITLE_TEMPLATE = string.Template(
    '<div class="titles">'
    '<span class="name">$project</span>'
    '<span class="meta-line">$platform · $version_label</span>'
    '</div>')
_BUILD_TITLE_TEMPLATE = string.Template(
    '<span class="title">$project · $platform · $version_label</span>')

_DELETE_BUTTON_TEMPLATE = string.Template(
    '<button type="button" class="swipe-delete" '
    'aria-label="Delete $delete_label">Delete</button>')


def _product_path(bundle_id: str, platform: str) -> str:
    return f"/deployit/p/{urllib.parse.quote(bundle_id, safe='')}/{platform}/"


def _render_row(build, *, older_count: int, link_to_product: bool, is_local: bool,
                post_test_badge: str = "") -> str:
    href, label = _install_link(build)
    project = html.escape(build["project"])
    platform = html.escape(_platform_display(build["platform"]))
    version_label = html.escape(_version_label(build))
    if link_to_product:
        product_path = _product_path(build["bundle_id"], build["platform"])
        data_attr = f' data-href="{html.escape(product_path, quote=True)}"'
        title_block = _LISTING_TITLE_TEMPLATE.substitute(
            project=project, platform=platform, version_label=version_label)
        delete_path = product_path
        delete_label = f'{build["project"]} {_platform_display(build["platform"])}'
    else:
        data_attr = ""
        title_block = _BUILD_TITLE_TEMPLATE.substitute(
            project=project, platform=platform, version_label=version_label)
        delete_path = f'/deployit/{urllib.parse.quote(build["id"], safe="")}/'
        delete_label = f'{build["project"]} {_version_label(build)}'
    # Delete affordance only for builds this machine owns (origin == base_url);
    # foreign builds can't have their files removed here, so no swipe button.
    if is_local:
        data_delete_attr = f' data-delete="{html.escape(delete_path, quote=True)}"'
        delete_button = _DELETE_BUTTON_TEMPLATE.substitute(
            delete_label=html.escape(delete_label))
    else:
        data_delete_attr = ""
        delete_button = ""
    older_html = (
        f' · <span class="older">+{older_count} older</span>' if older_count > 0 else ""
    )
    return _ROW_TEMPLATE.substitute(
        archived_class="archived" if build.get("archived") else "",
        data_href_attr=data_attr,
        data_delete_attr=data_delete_attr,
        title_block=title_block,
        install_href=html.escape(href, quote=True),
        install_label=label,
        origin_host=html.escape(build["origin_host"]),
        commit=html.escape(build["commit"][:7]),
        rel=html.escape(_relative_time(build["timestamp"])),
        older_html=older_html,
        post_test_badge=post_test_badge,
        delete_button=delete_button,
    )


def _git_pull(root: Path):
    """Pull the index repo. Best-effort; logs and returns on failure."""
    global _last_pull
    with _pull_lock:
        try:
            subprocess.run(
                ["git", "-C", str(root / "index"), "pull", "--rebase", "--quiet"],
                check=True, timeout=15,
            )
            _last_pull = _dt.datetime.now().isoformat(timespec="seconds")
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
            sys.stderr.write(f"backend: git pull failed: {exc}\n")


_TRUST_NOTE_HTML = (
    '<p style="color:#888;font-size:13px;">'
    '<strong>First install only:</strong> if iOS warns about an '
    'untrusted developer, open <em>Settings → General → VPN &amp; '
    'Device Management</em> and trust your team, then re-tap Install.'
    '</p>'
)

_GATEKEEPER_NOTE_HTML = (
    '<p style="color:#888;font-size:13px;">'
    '<strong>First launch only:</strong> if macOS says the app is from an '
    'unidentified developer, right-click (or Control-click) it in '
    '<em>Applications</em>, choose <em>Open</em>, then confirm.'
    '</p>'
)


def _read_build_meta(root: Path, build_id: str):
    meta_path = root / "serve" / build_id / "_meta.json"
    if not meta_path.is_file():
        return None
    return json.loads(meta_path.read_text())


# Out-of-band post-deploy test status (issue #90). Written by the deploy CLI /
# bin/deployit-posttest under <state>/posttest/<id>.json — deliberately OUTSIDE
# serve/<id>/ so a mid-run write can't resurrect a build gc/rm deleted, nor tear
# _meta.json. The page renders whatever status is present; a build that predates
# the feature (no status file) simply shows no badge.
_POST_TEST_LABELS = {
    "passed": "Tests passed",
    "failed": "Tests failed",
    "error": "Test run error",
    "running": "Tests running…",
    "not_configured": "No post-deploy tests",
}


def _read_post_test_status(root: Path, build_id: str):
    path = root / "posttest" / f"{build_id}.json"
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return None


def _post_test_kind(status) -> str:
    kind = (status or {}).get("status")
    return kind if kind in _POST_TEST_LABELS else ""


def _post_test_landing_html(status) -> str:
    """Block-level status badge for the per-build landing page ('' when absent)."""
    kind = _post_test_kind(status)
    if not kind:
        return ""
    return (f'<p class="posttest posttest-{kind}">'
            f'{html.escape(_POST_TEST_LABELS[kind])}</p>')


def _post_test_row_html(status) -> str:
    """Compact inline badge appended to a listing/product row subline ('' when
    absent, e.g. foreign builds whose status lives on their origin Mac)."""
    kind = _post_test_kind(status)
    if not kind:
        return ""
    return (f' · <span class="posttest-inline posttest-{kind}">'
            f'{html.escape(_POST_TEST_LABELS[kind])}</span>')


def _render_build_landing(root: Path, build) -> bytes:
    href, label = _install_link(build)
    tmpl = string.Template((root / "_plugin_root" / "assets" / "index.template.html").read_text())
    return tmpl.substitute(
        TITLE=html.escape(build["project"]),
        PLATFORM=html.escape(_platform_display(build["platform"])),
        ORIGIN_HOST=html.escape(build["origin_host"]),
        VERSION_LABEL=html.escape(_version_label(build)),
        BUILD_NUMBER=html.escape(build["build_number"]),
        COMMIT=html.escape(build["commit"][:7]),
        TIMESTAMP=html.escape(build["timestamp"]),
        POST_TEST_STATUS=_post_test_landing_html(_read_post_test_status(root, build["id"])),
        INSTALL_HREF=html.escape(href, quote=True),
        INSTALL_LABEL=label,
        TRUST_NOTE=(
            _TRUST_NOTE_HTML if build["platform"] in ("ios", "visionos")
            else _GATEKEEPER_NOTE_HTML if build["platform"] == "macos"
            else ""
        ),
    ).encode()


def _group_by_product(builds):
    """Return (newest_per_product, counts) preserving input order.

    Input is expected newest-first (matching builds.json ordering). The first
    occurrence of each (bundle_id, platform) is its newest; subsequent
    occurrences increment its older-count.
    """
    newest = []
    counts = {}
    seen_index = {}
    for b in builds:
        key = (b.get("bundle_id"), b.get("platform"))
        if key not in seen_index:
            seen_index[key] = len(newest)
            newest.append(b)
            counts[key] = 0
        else:
            counts[key] += 1
    return newest, counts


def _render_listing(root: Path, local_host: str) -> bytes:
    data = _read_index(root)
    base_url = _read_base_url(root)
    newest, counts = _group_by_product(data["builds"])
    rows = []
    for b in newest:
        key = (b.get("bundle_id"), b.get("platform"))
        is_local = base_url is not None and b.get("origin_base_url") == base_url
        badge = _post_test_row_html(_read_post_test_status(root, b["id"]))
        rows.append(_render_row(b, older_count=counts[key], link_to_product=True,
                                is_local=is_local, post_test_badge=badge))
    template_path = root / "_plugin_root" / "assets" / "listing.template.html"
    tmpl = string.Template(template_path.read_text())
    return tmpl.substitute(
        LAST_PULL=html.escape(f"last pull: {_last_pull}"),
        TOTAL_PRODUCTS=str(len(newest)),
        TOTAL_BUILDS=str(len(data["builds"])),
        LOCAL_HOST=html.escape(local_host),
        ROWS="\n".join(rows),
    ).encode()


def _render_sparkle_block(bundle_id: str, platform: str, matches) -> str:
    """The product-page Auto-update card: the appcast SUFeedURL (and SUPublicEDKey
    when configured) for copy-paste into the app. Empty for non-macOS products or
    macOS products with no EdDSA-signed builds."""
    if platform != "macos":
        return ""
    signed = [b for b in matches if b.get("sparkle")]
    if not signed:
        return ""
    newest = signed[0]
    appcast_url = (f"{newest['origin_base_url']}/p/"
                   f"{urllib.parse.quote(bundle_id, safe='')}/macos/appcast.xml")
    pub = newest["sparkle"].get("public_ed_key", "")
    pub_row = (f'<dt>SUPublicEDKey</dt><dd><code>{html.escape(pub)}</code></dd>'
               if pub else "")
    return (
        '<section class="sparkle">'
        '<h2>Auto-update (Sparkle)</h2>'
        '<dl>'
        f'<dt>SUFeedURL</dt><dd><code>{html.escape(appcast_url)}</code></dd>'
        f'{pub_row}'
        '</dl>'
        '<p class="meta">Add these to the app’s Info.plist '
        '(see deployit references/sparkle.md).</p>'
        '</section>'
    )


def _render_product(root: Path, bundle_id: str, platform: str):
    """Return (200, html) for a product page, or (404, None) if no builds match."""
    data = _read_index(root)
    matches = [b for b in data["builds"]
               if b.get("bundle_id") == bundle_id and b.get("platform") == platform]
    if not matches:
        return 404, None
    base_url = _read_base_url(root)
    matches.sort(key=lambda b: b["timestamp"], reverse=True)
    rows = [_render_row(b, older_count=0, link_to_product=False,
                        is_local=base_url is not None and b.get("origin_base_url") == base_url,
                        post_test_badge=_post_test_row_html(_read_post_test_status(root, b["id"])))
            for b in matches]
    sparkle_block = _render_sparkle_block(bundle_id, platform, matches)
    template_path = root / "_plugin_root" / "assets" / "product.template.html"
    tmpl = string.Template(template_path.read_text())
    body = tmpl.substitute(
        LAST_PULL=html.escape(f"last pull: {_last_pull}"),
        PROJECT=html.escape(matches[0]["project"]),
        PLATFORM=html.escape(_platform_display(platform)),
        BUNDLE_ID=html.escape(bundle_id),
        TOTAL_BUILDS=str(len(matches)),
        SPARKLE_BLOCK=sparkle_block,
        ROWS="\n".join(rows),
    ).encode()
    return 200, body


def _render_appcast(root: Path, bundle_id: str):
    """Return (200, xml) for a macOS product's Sparkle appcast, or (404, None)
    when the product has no EdDSA-signed builds. Lists every non-archived macOS
    build of bundle_id that carries a `sparkle` object, newest-first. Rendering
    itself (escaping, template substitution) lives in deployit_appcast, shared
    with deployit-release's GitHub-release feed."""
    data = _read_index(root)
    matches = [b for b in data["builds"]
               if b.get("bundle_id") == bundle_id
               and b.get("platform") == "macos"
               and not b.get("archived")
               and b.get("sparkle")]
    if not matches:
        return 404, None
    matches.sort(key=lambda b: b["timestamp"], reverse=True)
    items = []
    for b in matches:
        sp = b["sparkle"]
        items.append(deployit_appcast.render_item(
            title=f'{b["project"]} {_version_label(b)}',
            pubdate=deployit_appcast.rfc822(b["timestamp"]),
            version=sp.get("version", ""),
            short_version=sp.get("short_version", ""),
            enclosure_url=sp["zip_url"],
            length=sp.get("zip_length", ""),
            ed_signature=sp["ed_signature"],
        ))
    newest = matches[0]
    product_url = (f"{newest['origin_base_url']}/p/"
                   f"{urllib.parse.quote(bundle_id, safe='')}/macos/")
    template_path = root / "_plugin_root" / "assets" / "appcast.template.xml"
    body = deployit_appcast.render_appcast(
        template_path.read_text(),
        title=f'{newest["project"]} (macOS)',
        link=product_url,
        items="\n".join(items),
    ).encode()
    return 200, body


def _run_cli_rm(root: Path, *, build=None, product=None):
    """Delete a build/product by spawning the CLI's `rm` subcommand — the single
    writer that owns index commit/push. Returns (http_status, json_payload).

    The backend never mutates the index or pushes directly: it validates input,
    then shells out argv-only (no shell) so a hostile id can't be injected. The
    CLI re-validates and only ever touches builds this machine owns."""
    cli = root / "_plugin_root" / "bin" / "deployit-cli"
    if not cli.is_file():
        sys.stderr.write(f"backend: rm cli not found at {cli}\n")
        return 500, {"ok": False, "error": "cli_unavailable"}
    argv = [sys.executable or "python3", str(cli),
            "--plugin-root", str(root / "_plugin_root"), "rm"]
    if build is not None:
        argv += ["--build", build]
    else:
        bundle_id, platform = product
        argv += ["--product", bundle_id, "--platform", platform]
    try:
        res = subprocess.run(
            argv, capture_output=True, text=True, timeout=90,
            env={**os.environ, "DEPLOYIT_STATE_DIR": str(root)},
        )
    except subprocess.TimeoutExpired:
        sys.stderr.write("backend: rm timed out\n")
        return 504, {"ok": False, "error": "rm_timeout"}
    try:
        payload = json.loads(res.stdout.strip())  # CLI emits exactly one JSON object
    except ValueError:
        sys.stderr.write(f"backend: rm produced no JSON: {res.stdout!r} {res.stderr!r}\n")
        return 500, {"ok": False, "error": "rm_failed"}
    return (200 if payload.get("ok") else 409), payload


class Handler(BaseHTTPRequestHandler):
    root: Path = Path()

    def log_message(self, fmt, *args):
        if self.path == "/deployit/_healthz":
            return
        sys.stderr.write("backend: " + fmt % args + "\n")

    def _send_json(self, status, payload):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_bytes(self, status, ctype, body):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_file(self, status, ctype, path: Path, cache_seconds=None):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(path.stat().st_size))
        if cache_seconds is not None:
            self.send_header("Cache-Control", f"public, max-age={cache_seconds}")
        self.end_headers()
        with path.open("rb") as f:
            while chunk := f.read(64 * 1024):
                self.wfile.write(chunk)

    def do_GET(self):
        try:
            self._dispatch_get()
        except Exception as exc:
            sys.stderr.write(f"backend: GET {self.path} failed: {exc!r}\n")
            self._send_json(500, {"ok": False, "error": "internal_error"})

    def _dispatch_get(self):
        path = self.path
        if path == "/deployit/_healthz":
            self._send_json(200, {"ok": True})
            return
        if path in ("/deployit/", "/deployit"):
            if self.server.git_pull_enabled:
                _git_pull(self.root)
            body = _render_listing(self.root, self.server.local_host)
            self._send_bytes(200, "text/html; charset=utf-8", body)
            return

        static = _STATIC_ASSETS.get(path)
        if static is not None:
            rel, ctype = static
            asset_path = self.root / "_plugin_root" / "assets" / rel
            if not asset_path.is_file():
                self._send_json(404, {"ok": False, "error": "missing_asset"})
                return
            self._send_file(200, ctype, asset_path, cache_seconds=86400)
            return

        product_m = re.match(r"^/deployit/p/([^/]+)/(ios|macos|visionos)/?$", path)
        if product_m:
            bundle_id = urllib.parse.unquote(product_m.group(1))
            platform = product_m.group(2)
            status, body = _render_product(self.root, bundle_id, platform)
            if status == 404:
                self._send_json(404, {"ok": False, "error": "unknown_product"})
                return
            self._send_bytes(200, "text/html; charset=utf-8", body)
            return

        appcast_m = re.match(r"^/deployit/p/([^/]+)/macos/appcast\.xml$", path)
        if appcast_m:
            bundle_id = urllib.parse.unquote(appcast_m.group(1))
            status, body = _render_appcast(self.root, bundle_id)
            if status == 404:
                self._send_json(404, {"ok": False, "error": "unknown_product"})
                return
            self._send_bytes(200, "application/xml; charset=utf-8", body)
            return

        m = re.match(r"^/deployit/([^/]+)/(.*)$", path)
        if not m:
            self._send_json(404, {"ok": False, "error": "not_found"})
            return
        build_id, sub = m.group(1), m.group(2)
        if not _BUILD_ID_RE.match(build_id):
            self._send_json(404, {"ok": False, "error": "bad_build_id"})
            return
        build = _read_build_meta(self.root, build_id)
        if not build:
            self._send_json(404, {"ok": False, "error": "unknown_build"})
            return

        if sub == "" or sub == "/":
            self._send_bytes(200, "text/html; charset=utf-8",
                             _render_build_landing(self.root, build))
            return

        if "/" in sub or sub.startswith(".") or ".." in sub:
            self._send_json(404, {"ok": False, "error": "bad_artifact"})
            return
        artifact_path = self.root / "serve" / build_id / sub
        if not artifact_path.is_file():
            self._send_json(404, {"ok": False, "error": "missing_artifact"})
            return
        ctype, _ = mimetypes.guess_type(sub)
        if sub.endswith(".ipa"):
            ctype = "application/octet-stream"
        elif sub.endswith(".plist"):
            ctype = "application/x-plist"
        self._send_file(200, ctype or "application/octet-stream", artifact_path)

    def do_POST(self):
        try:
            self._dispatch_post()
        except Exception as exc:
            sys.stderr.write(f"backend: POST {self.path} failed: {exc!r}\n")
            self._send_json(500, {"ok": False, "error": "internal_error"})

    def _dispatch_post(self):
        if self.path == "/deployit/_internal/refresh":
            if self.server.git_pull_enabled:
                _git_pull(self.root)
            self._send_json(200, {"ok": True, "last_pull": _last_pull})
            return
        self._send_json(404, {"ok": False, "error": "not_found"})

    def do_DELETE(self):
        try:
            self._dispatch_delete()
        except Exception as exc:
            sys.stderr.write(f"backend: DELETE {self.path} failed: {exc!r}\n")
            self._send_json(500, {"ok": False, "error": "internal_error"})

    def _dispatch_delete(self):
        path = self.path
        # Product delete first, mirroring GET's regex precedence:
        #   DELETE /deployit/p/<bundle>/<platform>/
        product_m = re.match(r"^/deployit/p/([^/]+)/(ios|macos|visionos)/?$", path)
        if product_m:
            bundle_id = urllib.parse.unquote(product_m.group(1))
            platform = product_m.group(2)
            status, payload = _run_cli_rm(self.root, product=(bundle_id, platform))
            self._send_json(status, payload)
            return
        # Single build delete (root only, never an artifact subpath):
        #   DELETE /deployit/<build_id>/
        m = re.match(r"^/deployit/([^/]+)/?$", path)
        if m:
            build_id = m.group(1)
            if build_id in _RESERVED_BUILD_WORDS or not _BUILD_ID_RE.match(build_id):
                self._send_json(404, {"ok": False, "error": "bad_build_id"})
                return
            status, payload = _run_cli_rm(self.root, build=build_id)
            self._send_json(status, payload)
            return
        self._send_json(404, {"ok": False, "error": "not_found"})


def make_handler(root: Path):
    return type("Handler", (Handler,), {"root": root})


def main(argv):
    p = argparse.ArgumentParser()
    p.add_argument("--port", type=int, required=True)
    p.add_argument("--root", type=Path, required=True)
    p.add_argument("--plugin-root", type=Path,
                   help="Plugin root (for template lookup). Defaults to a symlink at <root>/_plugin_root.")
    p.add_argument("--no-git-pull", action="store_true",
                   help="Disable git pull on listing requests (for tests).")
    p.add_argument("--local-host", default="localhost")
    args = p.parse_args(argv)

    if args.plugin_root:
        link = args.root / "_plugin_root"
        # Skip if invoked with --plugin-root pointing at the canonical symlink
        # itself (the stable-path plist does this). Recreating it would produce
        # a self-loop. Whoever launched us is responsible for keeping that
        # symlink fresh (the CLI's _sync_plugin_root).
        if args.plugin_root != link:
            if link.is_symlink() or link.exists():
                link.unlink()
            link.symlink_to(args.plugin_root)

    handler_cls = make_handler(args.root)
    server = ThreadingHTTPServer(("127.0.0.1", args.port), handler_cls)
    server.git_pull_enabled = not args.no_git_pull
    server.local_host = args.local_host
    sys.stderr.write(f"backend: listening on 127.0.0.1:{args.port}, root={args.root}\n")
    server.serve_forever()


if __name__ == "__main__":
    main(sys.argv[1:])
