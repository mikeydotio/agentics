#!/usr/bin/env python3
"""semver-cli: Deterministic semantic versioning operations.

All output is JSON to stdout. Errors are JSON with ok=false.
Exit codes: 0=success, 1=operation failed, 2=usage error,
            3=completed but post-bump hooks could not run.
"""

import argparse
import datetime
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import time


# ─── Constants ───────────────────────────────────────────────────────────────

COMMIT_TYPE_MAP = {
    "feat": "Added",
    "fix": "Fixed",
    "refactor": "Changed",
    "perf": "Changed",
    "docs": "Documentation",
    "test": "Testing",
    "chore": "Maintenance",
    "build": "Maintenance",
    "ci": "Maintenance",
}

CHANGELOG_GROUP_ORDER = [
    "Breaking", "Added", "Fixed", "Changed",
    "Documentation", "Testing", "Maintenance",
]

CHANGELOG_HEADER = (
    "# Changelog\n\n"
    "All notable changes to this project will be documented in this file.\n"
    "The format is based on [Keep a Changelog](https://keepachangelog.com/).\n"
)

CLAUDE_MD_START = "<!-- semver:start -->"
CLAUDE_MD_END = "<!-- semver:end -->"

CLAUDE_MD_TEMPLATE = """<!-- semver:start -->
## Semantic Versioning

This project uses semantic versioning managed by the `/semver` plugin.

### Version Awareness
- Read the `VERSION` file at the start of each conversation to know the current version.
- Read `.semver/config.yaml` to understand the versioning configuration.
- When discussing releases, deployments, or changes, reference the current version.

### Commit Discipline
- Write meaningful, descriptive commit messages. Each commit message may appear in an auto-generated changelog.
- Use conventional-commit-style prefixes when they fit naturally: `feat:`, `fix:`, `docs:`, `refactor:`, `test:`, `chore:`.
- The first line of the commit message should be a concise summary (under 72 characters). Add detail in the body if needed.

### Version Bump Guidance
When recommending or performing a version bump:
- **patch** (0.0.x): Bug fixes, documentation corrections, minor refactors with no behavior change.
- **minor** (0.x.0): New features, new capabilities, non-breaking additions to the public API or user-facing behavior.
- **major** (x.0.0): Breaking changes — removed features, changed interfaces, incompatible API modifications, behavior changes that require consumers to update.

When you notice the user has completed a logical unit of work, suggest running `/semver bump` with the appropriate level.

### Hooks
- Custom pre-bump and post-bump hooks can be added in `.semver/hooks/`.
- Never trigger `/semver bump` from within a hook — this causes infinite recursion.

### Configuration
Versioning settings are in `.semver/config.yaml`. Do not modify this file unless the user explicitly asks to change semver settings.
<!-- semver:end -->"""


# ─── Output helpers ──────────────────────────────────────────────────────────

def output(data, exit_code=0):
    """Print JSON to stdout and exit.

    exit_code defaults to 0 (success). Callers that completed a mutation but
    could not run post-bump hooks pass 3 — see the module docstring's
    exit-code table.
    """
    print(json.dumps(data, indent=2))
    sys.exit(exit_code)


def output_error(error_code, message, detail=None):
    """Print error JSON to stdout and exit 1."""
    result = {"ok": False, "error": error_code, "message": message}
    if detail:
        result["detail"] = detail
    print(json.dumps(result, indent=2))
    sys.exit(1)


def build_display(lines):
    """Build display string from list of lines."""
    return "\n".join(lines)


# ─── Config ──────────────────────────────────────────────────────────────────

class Config:
    """Parse and hold .semver/config.yaml values."""

    DEFAULTS = {
        "tracking": "false",
        "auto_bump": "true",
        "auto_bump_confirm": "true",
        "version_prefix": "v",
        "git_tagging": "true",
        "changelog_format": "grouped",
        "target_branch": "main",
    }

    KEYS_ORDER = [
        "tracking", "auto_bump", "auto_bump_confirm",
        "version_prefix", "git_tagging", "changelog_format", "target_branch",
    ]

    def __init__(self, config_path):
        self.path = config_path
        self.values = dict(self.DEFAULTS)
        self.exists = os.path.isfile(config_path)
        if self.exists:
            with open(config_path) as f:
                for line in f:
                    line = line.strip()
                    if ":" in line and not line.startswith("#"):
                        key, val = line.split(":", 1)
                        self.values[key.strip()] = val.strip().strip("'\"")

    def get(self, key):
        return self.values.get(key, self.DEFAULTS.get(key))

    def get_bool(self, key):
        return self.get(key) == "true"

    def set(self, key, value):
        self.values[key] = str(value)

    def write(self, path=None):
        """Write config to file."""
        target = path or self.path
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "w") as f:
            for key in self.KEYS_ORDER:
                val = self.values.get(key, self.DEFAULTS.get(key, ""))
                if val in ("true", "false"):
                    f.write(f"{key}: {val}\n")
                else:
                    f.write(f'{key}: "{val}"\n')


# ─── Git helpers ─────────────────────────────────────────────────────────────

def git(*args, cwd=None):
    """Run a git command. Returns (returncode, stdout, stderr)."""
    try:
        result = subprocess.run(
            ["git"] + list(args),
            cwd=cwd or os.getcwd(),
            capture_output=True, text=True, timeout=30,
        )
        return result.returncode, result.stdout.strip(), result.stderr.strip()
    except subprocess.TimeoutExpired:
        return 1, "", "git command timed out"
    except FileNotFoundError:
        return 1, "", "git not found"


def git_root(cwd=None):
    """Return the git root directory, or None."""
    rc, out, _ = git("rev-parse", "--show-toplevel", cwd=cwd)
    return out if rc == 0 else None


def ensure_git_root():
    """Verify cwd is git root. Exit with error if not."""
    root = git_root()
    if root is None:
        output_error("not_git_repo", "Not inside a git repository.")
    cwd = os.path.realpath(os.getcwd())
    root = os.path.realpath(root)
    if cwd != root:
        output_error("not_git_root",
                      f"Must run from git root. CWD: {cwd}, Git root: {root}")


def is_linked_worktree(cwd=None):
    """True iff cwd is inside a *linked* git worktree (not the main working tree).

    Detected by comparing the per-worktree git dir against the shared common dir:
    in a linked worktree `--git-dir` resolves to `<repo>/.git/worktrees/<name>`
    while `--git-common-dir` resolves to `<repo>/.git`; in the main tree both are
    the same `.git`. (`--is-inside-work-tree` is true in both, so it cannot tell
    them apart.) Returns False when not inside a repo — no worktree concern.
    """
    base = os.path.realpath(cwd or os.getcwd())
    rc1, gd, _ = git("rev-parse", "--git-dir", cwd=base)
    rc2, cdir, _ = git("rev-parse", "--git-common-dir", cwd=base)
    if rc1 != 0 or rc2 != 0:
        return False
    # git returns these relative to cwd in the main tree (bare ".git") and
    # absolute in a linked worktree — resolve both against base before comparing.
    resolve = lambda p: os.path.realpath(os.path.join(base, p))
    return resolve(gd) != resolve(cdir)


# Subcommands (and command+subcommand pairs) that never mutate VERSION/CHANGELOG,
# config, commits, or tags — safe to run from a linked worktree. Everything else
# is treated as mutating and refused inside a worktree (fail-safe: a new mutating
# subcommand is blocked by default until explicitly listed here).
def _is_readonly_command(args):
    if args.command in ("current", "validate", "recommend"):
        return True
    if args.command == "bump" and getattr(args, "bump_command", None) == "gather":
        return True
    if args.command == "tracking" and getattr(args, "tracking_command", None) == "stop-gather":
        return True
    if args.command == "repair" and getattr(args, "repair_command", None) == "diagnose":
        return True
    return False


def ensure_not_worktree(args):
    """Refuse a mutating op inside a linked worktree (override with
    SEMVER_ALLOW_WORKTREE=1). Versioning happens later from the main tree."""
    if _is_readonly_command(args):
        return
    if os.environ.get("SEMVER_ALLOW_WORKTREE"):
        return
    if is_linked_worktree():
        output_error(
            "in_worktree",
            "Refusing to run a mutating semver operation inside a git worktree. "
            "Versioning happens later from the main working tree on the main "
            "branch, not from a per-issue worktree. Set SEMVER_ALLOW_WORKTREE=1 "
            "to override.")


def current_branch():
    rc, out, _ = git("rev-parse", "--abbrev-ref", "HEAD")
    return out if rc == 0 else None


def is_dirty():
    rc, out, _ = git("status", "--porcelain")
    return bool(out)


def dirty_files():
    rc, out, _ = git("status", "--porcelain")
    if rc != 0 or not out:
        return []
    files = []
    for line in out.splitlines():
        if len(line) > 3:
            files.append(line[3:].strip())
    return files


def last_version_commit():
    """Find the commit that last modified VERSION."""
    rc, out, _ = git("log", "-1", "--format=%H", "--", "VERSION")
    return out if rc == 0 and out else None


def commits_since(commit_hash):
    """Return list of {hash, subject} since commit_hash."""
    if commit_hash:
        rc, out, _ = git("log", f"{commit_hash}..HEAD", "--format=%h\t%s")
    else:
        rc, out, _ = git("log", "--format=%h\t%s")
    if rc != 0 or not out:
        return []
    commits = []
    for line in out.splitlines():
        parts = line.split("\t", 1)
        if len(parts) == 2:
            commits.append({"hash": parts[0], "subject": parts[1]})
    return commits


def commit_count_since(commit_hash):
    if commit_hash:
        rc, out, _ = git("rev-list", f"{commit_hash}..HEAD", "--count")
    else:
        rc, out, _ = git("rev-list", "HEAD", "--count")
    return int(out) if rc == 0 and out.isdigit() else 0


def tag_exists(tag):
    rc, out, _ = git("tag", "-l", tag)
    return bool(out.strip())


def tag_commit(tag):
    rc, out, _ = git("rev-list", "-n", "1", tag)
    return out if rc == 0 and out else None


def all_version_tags(prefix):
    rc, out, _ = git("tag", "-l", f"{prefix}*", "--sort=-v:refname")
    if rc != 0 or not out:
        return []
    return [t.strip() for t in out.splitlines() if t.strip()]


def detect_default_branch():
    rc, out, _ = git("symbolic-ref", "refs/remotes/origin/HEAD")
    if rc == 0 and out:
        return out.replace("refs/remotes/origin/", "")
    return current_branch() or "main"


# ─── Version helpers ─────────────────────────────────────────────────────────

def parse_version(version_str, prefix=""):
    """Parse 'v1.2.3' or '1.2.3' into (major, minor, patch). Returns None on failure."""
    bare = version_str
    if prefix and bare.startswith(prefix):
        bare = bare[len(prefix):]
    m = re.match(r"^(\d+)\.(\d+)\.(\d+)$", bare)
    if not m:
        return None
    return int(m.group(1)), int(m.group(2)), int(m.group(3))


def increment_version(major, minor, patch, bump_type):
    if bump_type == "major":
        return major + 1, 0, 0
    elif bump_type == "minor":
        return major, minor + 1, 0
    else:
        return major, minor, patch + 1


def format_version(major, minor, patch, prefix=""):
    return f"{prefix}{major}.{minor}.{patch}"


def read_version_file(project_dir):
    """Read VERSION file. Returns stripped content or None."""
    vf = os.path.join(project_dir, "VERSION")
    if not os.path.isfile(vf):
        return None
    with open(vf) as f:
        return f.read().strip()


# ─── Changelog ───────────────────────────────────────────────────────────────

def parse_commit_type(subject):
    """Extract conventional commit type from subject line."""
    if "BREAKING CHANGE" in subject or re.match(r"^\w+!:", subject):
        return "Breaking"
    m = re.match(r"^(\w+)(?:\([^)]*\))?:\s", subject)
    if m:
        prefix = m.group(1).lower()
        return COMMIT_TYPE_MAP.get(prefix, "Changed")
    return "Changed"


def clean_commit_subject(subject):
    """Strip conventional commit prefix from subject."""
    return re.sub(r"^\w+(?:\([^)]*\))?!?:\s*", "", subject)


def generate_changelog_entry(commits, version, date_str, fmt, source, force=False):
    """Generate a changelog entry string."""
    # Filter out release commits
    commits = [c for c in commits if not c["subject"].startswith("chore(release):")]

    lines = [f"## [{version}] - {date_str}", ""]

    if force and not commits:
        lines.append("- Version-only adjustment (no new changes)")
        lines.append("")
    elif fmt == "grouped":
        groups = {}
        for c in commits:
            category = parse_commit_type(c["subject"])
            groups.setdefault(category, []).append(c)

        for group in CHANGELOG_GROUP_ORDER:
            if group in groups:
                lines.append(f"### {group}")
                for c in groups[group]:
                    clean = clean_commit_subject(c["subject"])
                    lines.append(f"- {clean} ({c['hash']})")
                lines.append("")
    else:  # flat
        for c in commits:
            lines.append(f"- {c['hash']} {c['subject']}")
        lines.append("")

    indicator = {"manual": "_[manual]_", "auto": "_[auto]_", "force": "_[force]_"}
    lines.append(indicator.get(source, "_[manual]_"))
    lines.append("")

    return "\n".join(lines)


def prepend_changelog_entry(changelog_path, entry):
    """Insert new entry after the changelog header, before existing entries."""
    if not os.path.isfile(changelog_path):
        # Create new changelog with entry
        with open(changelog_path, "w") as f:
            f.write(CHANGELOG_HEADER + "\n" + entry)
        return

    with open(changelog_path) as f:
        content = f.read()

    # Find first ## [ header — insert before it
    m = re.search(r"^## \[", content, re.MULTILINE)
    if m:
        before = content[:m.start()].rstrip() + "\n\n"
        after = content[m.start():]
        # Ensure blank line between new entry and existing entries
        if not entry.endswith("\n\n"):
            entry = entry.rstrip("\n") + "\n\n"
        content = before + entry + after
    else:
        # No existing entries — append after header
        content = content.rstrip() + "\n\n" + entry

    with open(changelog_path, "w") as f:
        f.write(content)


def create_initial_changelog(changelog_path, version, date_str, fmt):
    """Create the initial CHANGELOG.md for tracking start."""
    entry = f"## [{version}] - {date_str}\n\n- Initial version tracking\n\n_[manual]_\n"
    with open(changelog_path, "w") as f:
        f.write(CHANGELOG_HEADER + "\n" + entry)


# ─── File locking ────────────────────────────────────────────────────────────

class FileLock:
    """Cross-platform file lock: fcntl.flock on Linux, mkdir on macOS."""

    def __init__(self, project_dir):
        h = hashlib.md5(project_dir.encode()).hexdigest()[:8]
        self.lock_path = f"/tmp/semver-{h}.lock"
        self._fd = None
        self._lock_dir = f"{self.lock_path}.d"
        self._use_flock = self._check_flock()

    @staticmethod
    def _check_flock():
        try:
            # fcntl.flock is available on Linux
            return hasattr(fcntl, "flock")
        except Exception:
            return False

    def acquire(self):
        if self._use_flock:
            self._fd = open(self.lock_path, "w")
            try:
                fcntl.flock(self._fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True
            except (IOError, OSError):
                self._fd.close()
                self._fd = None
                return False
        else:
            if os.path.isdir(self._lock_dir):
                try:
                    age = time.time() - os.path.getmtime(self._lock_dir)
                    if age > 300:
                        os.rmdir(self._lock_dir)
                except OSError:
                    pass
            try:
                os.mkdir(self._lock_dir)
                return True
            except FileExistsError:
                return False

    def release(self):
        if self._use_flock and self._fd:
            try:
                fcntl.flock(self._fd.fileno(), fcntl.LOCK_UN)
                self._fd.close()
            except Exception:
                pass
            self._fd = None
            try:
                os.remove(self.lock_path)
            except OSError:
                pass
        elif os.path.isdir(self._lock_dir):
            try:
                os.rmdir(self._lock_dir)
            except OSError:
                pass

    def __enter__(self):
        if not self.acquire():
            raise RuntimeError("Another semver operation is in progress.")
        return self

    def __exit__(self, *args):
        self.release()


# ─── CLAUDE.md injection ────────────────────────────────────────────────────

def inject_claude_md(project_dir):
    """Inject or replace the semver section in CLAUDE.md."""
    claude_md = os.path.join(project_dir, "CLAUDE.md")
    if os.path.isfile(claude_md):
        with open(claude_md) as f:
            content = f.read()
        if CLAUDE_MD_START in content:
            content = re.sub(
                rf"{re.escape(CLAUDE_MD_START)}.*?{re.escape(CLAUDE_MD_END)}",
                CLAUDE_MD_TEMPLATE,
                content,
                flags=re.DOTALL,
            )
        else:
            content = content.rstrip() + "\n\n" + CLAUDE_MD_TEMPLATE + "\n"
    else:
        content = CLAUDE_MD_TEMPLATE + "\n"
    with open(claude_md, "w") as f:
        f.write(content)


def remove_claude_md(project_dir):
    """Remove the semver section from CLAUDE.md."""
    claude_md = os.path.join(project_dir, "CLAUDE.md")
    if not os.path.isfile(claude_md):
        return False
    with open(claude_md) as f:
        content = f.read()
    if CLAUDE_MD_START not in content:
        return False
    content = re.sub(
        rf"\n*{re.escape(CLAUDE_MD_START)}.*?{re.escape(CLAUDE_MD_END)}\n*",
        "\n",
        content,
        flags=re.DOTALL,
    )
    with open(claude_md, "w") as f:
        f.write(content)
    return True


# ─── Archive ─────────────────────────────────────────────────────────────────

def build_archive(project_dir, config, items):
    """Build VERSIONING_ARCHIVE.md content."""
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    version = read_version_file(project_dir) or "not set"
    prefix = config.get("version_prefix")

    lines = ["---"]
    lines.append(f'archived_at: "{now}"')
    lines.append(f'last_version: "{version}"')
    lines.append(f'version_prefix: "{prefix}"')
    lines.append(f"git_tagging: {config.get('git_tagging')}")
    lines.append(f'changelog_format: "{config.get("changelog_format")}"')
    lines.append(f'target_branch: "{config.get("target_branch")}"')
    lines.append(f"auto_bump: {config.get('auto_bump')}")
    lines.append(f"auto_bump_confirm: {config.get('auto_bump_confirm')}")
    lines.append("items_archived:")
    for item in items:
        lines.append(f"  - {item}")
    lines.append("---")
    lines.append("")
    lines.append("# Versioning Archive")
    lines.append("")
    lines.append("This file is a historical archive of version tracking data.")
    lines.append("To restore version tracking from this archive, run `/semver tracking start`.")
    lines.append("")

    if "version" in items:
        vf = os.path.join(project_dir, "VERSION")
        if os.path.isfile(vf):
            with open(vf) as f:
                vcontent = f.read()
            lines.append("## VERSION")
            lines.append("")
            lines.append("```")
            lines.append(vcontent.strip())
            lines.append("```")
            lines.append("")

    if "changelog" in items:
        cf = os.path.join(project_dir, "CHANGELOG.md")
        if os.path.isfile(cf):
            with open(cf) as f:
                ccontent = f.read()
            lines.append("## CHANGELOG")
            lines.append("")
            lines.append("```markdown")
            lines.append(ccontent.rstrip())
            lines.append("```")
            lines.append("")

    if "tags" in items:
        _, tag_out, _ = git("tag", "-l", f"{prefix}*",
                            "--format=%(refname:short)\t%(objectname:short)\t%(creatordate:short)\t%(subject)")
        if tag_out:
            # Convert tab-separated to double-space for display
            tag_display = tag_out.replace("\t", "  ")
            lines.append("## Tags")
            lines.append("")
            lines.append("```")
            lines.append(tag_display)
            lines.append("```")
            lines.append("")

    # Always include config
    with open(config.path) as f:
        config_content = f.read()
    lines.append("## Config")
    lines.append("")
    lines.append("```yaml")
    lines.append(config_content.rstrip())
    lines.append("```")
    lines.append("")

    return "\n".join(lines)


def parse_archive(archive_path):
    """Parse VERSIONING_ARCHIVE.md. Returns dict with metadata and sections."""
    if not os.path.isfile(archive_path):
        return None

    with open(archive_path) as f:
        content = f.read()

    result = {"raw": content, "metadata": {}, "sections": {}}

    # Parse YAML frontmatter
    fm_match = re.match(r"^---\n(.*?)\n---", content, re.DOTALL)
    if fm_match:
        for line in fm_match.group(1).splitlines():
            line = line.strip()
            if ":" in line and not line.startswith("-") and not line.startswith(" "):
                key, val = line.split(":", 1)
                result["metadata"][key.strip()] = val.strip().strip('"\'')

    # Parse items_archived list
    items_match = re.search(r"items_archived:\n((?:\s+-\s+\S+\n?)+)", content)
    if items_match:
        result["metadata"]["items_archived"] = [
            line.strip().lstrip("- ")
            for line in items_match.group(1).splitlines()
            if line.strip().startswith("-")
        ]
    else:
        result["metadata"]["items_archived"] = []

    # Parse sections by ## headers + fenced code blocks
    for section_name in ["VERSION", "CHANGELOG", "Tags", "Config"]:
        pattern = rf"## {re.escape(section_name)}\n\n```(?:\w*)\n(.*?)```"
        m = re.search(pattern, content, re.DOTALL)
        if m:
            result["sections"][section_name.lower()] = m.group(1).rstrip("\n")

    return result


# ─── Validation ──────────────────────────────────────────────────────────────

def run_validation_checks(project_dir, config):
    """Run all 6 validation checks. Returns list of check results."""
    checks = []
    prefix = config.get("version_prefix")
    tagging = config.get_bool("git_tagging")

    # Check 1: Config exists and tracking active
    checks.append({
        "name": "config_tracking",
        "status": "PASS",
        "detail": "Config exists and tracking is active",
    })

    # Check 2: VERSION exists and well-formed
    version = read_version_file(project_dir)
    if version is None:
        checks.append({
            "name": "version_wellformed",
            "status": "FAIL",
            "detail": "VERSION file missing",
        })
    elif parse_version(version, prefix) is None:
        checks.append({
            "name": "version_wellformed",
            "status": "FAIL",
            "detail": f"VERSION file malformed: '{version}'",
        })
    else:
        checks.append({
            "name": "version_wellformed",
            "status": "PASS",
            "detail": f"VERSION file: {version}",
        })

    # Check 3: Tag exists for current VERSION
    if not tagging:
        checks.append({
            "name": "tag_exists",
            "status": "SKIP",
            "detail": "Git tagging disabled",
        })
    elif version and parse_version(version, prefix):
        if tag_exists(version):
            checks.append({
                "name": "tag_exists",
                "status": "PASS",
                "detail": f"Tag {version} exists",
            })
        else:
            checks.append({
                "name": "tag_exists",
                "status": "FAIL",
                "detail": f"Tag {version} not found",
            })
    else:
        checks.append({
            "name": "tag_exists",
            "status": "SKIP",
            "detail": "No valid version to check",
        })

    # Check 4: Tag points to correct commit
    if not tagging:
        checks.append({
            "name": "tag_correct_commit",
            "status": "SKIP",
            "detail": "Git tagging disabled",
        })
    elif version and tag_exists(version):
        tc = tag_commit(version)
        lvc = last_version_commit()
        if tc and lvc and tc == lvc:
            checks.append({
                "name": "tag_correct_commit",
                "status": "PASS",
                "detail": f"Tag and VERSION point to same commit ({tc[:7]})",
            })
        elif tc and lvc:
            checks.append({
                "name": "tag_correct_commit",
                "status": "FAIL",
                "detail": f"Tag -> {tc[:7]}, VERSION last modified -> {lvc[:7]}",
            })
        else:
            checks.append({
                "name": "tag_correct_commit",
                "status": "SKIP",
                "detail": "Could not determine commits",
            })
    else:
        checks.append({
            "name": "tag_correct_commit",
            "status": "SKIP",
            "detail": "Tag does not exist",
        })

    # Check 5: CHANGELOG has entry for current VERSION
    changelog_path = os.path.join(project_dir, "CHANGELOG.md")
    if version and os.path.isfile(changelog_path):
        with open(changelog_path) as f:
            cl_content = f.read()
        if f"## [{version}]" in cl_content:
            checks.append({
                "name": "changelog_entry",
                "status": "PASS",
                "detail": f"CHANGELOG entry for {version}",
            })
        else:
            checks.append({
                "name": "changelog_entry",
                "status": "FAIL",
                "detail": f"No CHANGELOG entry for {version}",
            })
    elif not version:
        checks.append({
            "name": "changelog_entry",
            "status": "SKIP",
            "detail": "No version set",
        })
    else:
        checks.append({
            "name": "changelog_entry",
            "status": "FAIL",
            "detail": "CHANGELOG.md missing",
        })

    # Check 6: No orphaned tags
    if not tagging:
        checks.append({
            "name": "orphaned_tags",
            "status": "SKIP",
            "detail": "Git tagging disabled",
        })
    else:
        tags = all_version_tags(prefix)
        if os.path.isfile(changelog_path):
            with open(changelog_path) as f:
                cl_content = f.read()
            orphaned = [t for t in tags if f"## [{t}]" not in cl_content]
            if orphaned:
                checks.append({
                    "name": "orphaned_tags",
                    "status": "WARN",
                    "detail": f"{len(orphaned)} orphaned tag(s): {', '.join(orphaned[:5])}",
                    "orphaned": orphaned,
                })
            else:
                checks.append({
                    "name": "orphaned_tags",
                    "status": "PASS",
                    "detail": "No orphaned tags",
                })
        else:
            checks.append({
                "name": "orphaned_tags",
                "status": "WARN",
                "detail": "CHANGELOG.md missing — cannot check for orphaned tags",
            })

    return checks


# ─── User hooks runner ───────────────────────────────────────────────────────

def _default_plugin_root():
    """Absolute path to this plugin's root, derived from the CLI's own location.

    hooks/run-user-hooks.sh ships with the plugin at a fixed path relative to
    this script, so it can always be found without a caller passing
    --plugin-root. The flag remains available as an explicit override (tests
    use a deliberately bogus one to opt out of hook execution).
    """
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def _pending_post_bump_hooks(project_dir, phase="post-bump"):
    """Names of executable *.sh files in the requested hook phase directory.

    Mirrors run-user-hooks.sh's own discovery rules (*.sh, executable) so the
    two never disagree about what counts as a hook. Used to tell "the project
    defines no scripts for this phase" (safe to report success) apart from "hooks
    are defined but the runner could not execute them" (must be reported).
    Sorted for determinism; Python's default string ordering matches the
    runner's `LC_COLLATE=C` byte-order sort for ASCII filenames.
    """
    hooks_dir = os.path.join(project_dir, ".semver", "hooks", phase)
    if not os.path.isdir(hooks_dir):
        return []
    names = []
    for name in os.listdir(hooks_dir):
        if not name.endswith(".sh"):
            continue
        path = os.path.join(hooks_dir, name)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            names.append(name)
    return sorted(names)


def run_user_hooks(phase, bump_type, old_version, new_version, project_dir, plugin_root):
    """Run user-defined hooks via run-user-hooks.sh. Returns parsed JSON or error dict.

    plugin_root is optional: a falsy value falls back to _default_plugin_root()
    rather than skipping hook execution outright (this was the root cause of
    hooks being silently skipped whenever a caller omitted --plugin-root).

    old_version may be None for operations with no prior version — a fresh
    init or tracking-start's first version, or `set` assigning a first
    version. subprocess.run rejects a bare None in its argv list, and
    run-user-hooks.sh's own blank-argument check would reject an empty
    string as a usage error, so a None is represented to hook scripts as the
    literal sentinel "(none)".
    """
    runner = os.path.join(plugin_root or _default_plugin_root(), "hooks", "run-user-hooks.sh")
    if not os.path.isfile(runner):
        return {"status": "error", "message": f"Hook runner not found at {runner}"}

    try:
        result = subprocess.run(
            ["bash", runner, phase, bump_type, old_version or "(none)", new_version, project_dir],
            capture_output=True, text=True, timeout=120,
        )
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError:
            return {"status": "error", "message": result.stderr or result.stdout or "Hook runner produced no JSON"}
    except subprocess.TimeoutExpired:
        return {"status": "error", "message": f"{phase} hooks timed out after 120s"}
    except FileNotFoundError:
        return {"status": "error", "message": "bash not found"}


def _run_pre_bump_hooks(bump_type, old_version, new_version, project_dir, plugin_root):
    """Gate a version change before any release-owned files are written.

    Hooks own their side effects (for example consumed build numbers). A failed
    hook leaves those effects available for diagnosis; it cannot create a release.
    """
    if os.environ.get("SEMVER_BUMP_IN_PROGRESS") == "1":
        output_error("reentrancy", "A version operation is already in progress.")
    if old_version == new_version:
        return {"hooks_run": 0, "prompt_hook": None, "warnings": []}
    result = run_user_hooks(
        "pre-bump", bump_type, old_version, new_version, project_dir, plugin_root)
    status = result.get("status")
    if status == "blocked":
        output_error("reentrancy", result.get("reason", "Reentrancy blocked"))
    if status == "failed":
        output_error("pre_hook_failed",
                     f"Pre-bump hook '{result.get('failed_hook', '?')}' failed "
                     f"(exit {result.get('exit_code', '?')})",
                     detail=result.get("output", ""))
    if status != "ok" and _pending_post_bump_hooks(project_dir, "pre-bump"):
        output_error("pre_hook_failed", "Pre-bump hooks could not run.",
                     detail=result.get("message", "Invalid hook runner response"))
    return result


def _pre_prompt_state(project_dir):
    """Describe a pre-bump prompt without executing or modifying the project."""
    path = os.path.join(project_dir, ".semver", "hooks", "pre-bump", "PROMPT_HOOK.md")
    return {"has_pre_bump_prompt_hook": os.path.isfile(path),
            "pre_bump_prompt_hook_path": path if os.path.isfile(path) else None}


def _stash_before_version(message):
    """Stash user edits before hooks, returning whether a new stash was made."""
    _, before, _ = git("rev-parse", "--verify", "refs/stash")
    rc, _, err = git("stash", "push", "-m", message)
    if rc != 0:
        raise RuntimeError(f"git stash failed: {err}")
    _, after, _ = git("rev-parse", "--verify", "refs/stash")
    return before != after


# ─── Subcommands ─────────────────────────────────────────────────────────────

def cmd_current(args):
    """Show current version and status."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists:
        output({"ok": True, "tracking": False, "config_exists": False,
                "message": "Version tracking is not active for this project."})

    if not config.get_bool("tracking"):
        output({"ok": True, "tracking": False, "config_exists": True,
                "message": "Version tracking is disabled."})

    version = read_version_file(project_dir)
    result = {
        "ok": True,
        "tracking": True,
        "version": version,
        "version_set": version is not None,
        "auto_bump": config.get_bool("auto_bump"),
        "auto_bump_confirm": config.get_bool("auto_bump_confirm"),
        "target_branch": config.get("target_branch"),
        "git_tagging": config.get_bool("git_tagging"),
        "changelog_format": config.get("changelog_format"),
        "version_prefix": config.get("version_prefix"),
    }

    if version:
        lvc = last_version_commit()
        if lvc:
            result["commit_count_since"] = commit_count_since(lvc)
            _, date_out, _ = git("log", "-1", "--format=%ai", "--", "VERSION")
            result["last_version_date"] = date_out[:10] if date_out else None
            result["last_version_commit"] = lvc
        else:
            result["commit_count_since"] = 0
            result["last_version_date"] = None
            result["last_version_commit"] = None

    # Build display
    lines = []
    if not version:
        lines.append("[semver] No version set — run `/semver bump` to set the first version.")
    else:
        lines.append(f"[semver] {version} — {result.get('commit_count_since', 0)} commit(s) since {result.get('last_version_date', 'unknown')}")
    auto = "on" if result["auto_bump"] else "off"
    if result["auto_bump"]:
        auto += " (confirm)" if result["auto_bump_confirm"] else " (auto)"
    lines.append(f"  Auto-bump: {auto} | Branch: {result['target_branch']} | Tags: {'on' if result['git_tagging'] else 'off'}")
    result["display"] = build_display(lines)

    output(result)


def cmd_validate(args):
    """Run validation checks."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists or not config.get_bool("tracking"):
        output({"ok": True, "tracking": False,
                "message": "Version tracking is not active. Nothing to validate."})

    checks = run_validation_checks(project_dir, config)
    summary = {"pass": 0, "fail": 0, "warn": 0, "skip": 0}
    for c in checks:
        key = c["status"].lower()
        if key in summary:
            summary[key] += 1

    # Build display
    lines = ["[semver] Validation results:"]
    for c in checks:
        status_icon = {"PASS": "PASS", "FAIL": "FAIL", "WARN": "WARN", "SKIP": "SKIP"}[c["status"]]
        lines.append(f"  [{status_icon}] {c['detail']}")
    if summary["fail"] > 0:
        lines.append(f"  Status: {summary['fail']} failure(s) — run `/semver repair` to fix.")
    else:
        lines.append("  Status: All checks passed.")
    display = build_display(lines)

    output({
        "ok": True,
        "tracking": True,
        "checks": checks,
        "summary": summary,
        "all_pass": summary["fail"] == 0,
        "display": display,
    })


def cmd_recommend(args):
    """Recommend a bump level from conventional commits since the last version.

    Deterministic replacement for asking the orchestrator to "analyze the git
    log": any breaking change -> major, any feat -> minor, otherwise -> patch.
    """
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists or not config.get_bool("tracking"):
        output({"ok": True, "tracking": False, "recommended": None,
                "message": "Version tracking is not active."})

    lvc = last_version_commit()
    commits = commits_since(lvc) if lvc else commits_since(None)
    commits = [c for c in commits
               if not c["subject"].startswith("chore(release):")]

    breaking, feats, fixes, other = [], [], [], []
    for c in commits:
        category = parse_commit_type(c["subject"])
        if category == "Breaking":
            breaking.append(c)
        elif category == "Added":
            feats.append(c)
        elif category == "Fixed":
            fixes.append(c)
        else:
            other.append(c)

    counts = {
        "breaking": len(breaking),
        "feat": len(feats),
        "fix": len(fixes),
        "other": len(other),
        "total": len(commits),
    }

    if not commits:
        recommended = None
        rationale = "no commits since the last version change"
    elif breaking:
        recommended = "major"
        rationale = f"{len(breaking)} breaking change(s)"
    elif feats:
        recommended = "minor"
        rationale = f"{len(feats)} new feature(s)"
    else:
        recommended = "patch"
        bits = []
        if fixes:
            bits.append(f"{len(fixes)} fix(es)")
        if other:
            bits.append(f"{len(other)} other change(s)")
        rationale = ", ".join(bits) if bits else "non-feature changes only"

    if recommended:
        display = build_display([
            f"[semver] Recommended bump: {recommended} ({rationale})",
            f"  {counts['breaking']} breaking, {counts['feat']} feat, "
            f"{counts['fix']} fix, {counts['other']} other",
        ])
    else:
        display = build_display(
            ["[semver] No commits to release since the last version change."])

    output({
        "ok": True,
        "tracking": True,
        "recommended": recommended,
        "rationale": rationale,
        "counts": counts,
        "commits_analyzed": len(commits),
        "display": display,
    })


# ─── Shared question builders ────────────────────────────────────────────────
# These produce the exact structured-question dicts the SKILL Question Loop
# consumes (id/header/options/cancel_option/flag_mapping). They are shared by the
# bump gather path and the set path so both stay in lockstep. The `verb`/`gerund`
# params only affect user-facing wording; the defaults reproduce the original
# bump strings byte-for-byte.

def _q_dirty_tree(dirty, verb="bump"):
    file_list = ", ".join(dirty[:10])
    if len(dirty) > 10:
        file_list += f" (+{len(dirty) - 10} more)"
    return {
        "id": "dirty_tree",
        "header": "Dirty tree",
        "question": f"You have uncommitted changes: {file_list}. What would you like to do?",
        "options": [
            {"label": f"Include all in {verb} commit"},
            {"label": f"Stash and {verb} clean"},
            {"label": "Cancel"}
        ],
        "cancel_option": 2,
        "flag_mapping": {
            "0": "--dirty-action include",
            "1": "--dirty-action stash",
        },
    }


def _q_wrong_branch(current, target, gerund="Bumping"):
    return {
        "id": "wrong_branch",
        "header": "Branch",
        "question": f"You're on branch `{current}`, not `{target}`. {gerund} from a non-target branch means the tag may not be reachable from the target branch until merged. Proceed?",
        "options": [
            {"label": "Proceed anyway"},
            {"label": "Cancel"}
        ],
        "cancel_option": 1,
        "flag_mapping": {},
    }


def _q_validation_failed(gerund="Bumping", verb="Bump"):
    return {
        "id": "validation_failed",
        "header": "Sync issue",
        "question": f"Validation found issues. {gerund} on top of broken sync may compound the problem.",
        "options": [
            {"label": "Run repair first"},
            {"label": f"{verb} anyway"},
            {"label": "Cancel"}
        ],
        "cancel_option": 2,
        "flag_mapping": {
            "1": "--skip-validation",
        },
        "special_actions": {
            "0": "run_repair_then_retry",
        },
    }


def _q_tag_conflict(version, detail=""):
    return {
        "id": "tag_conflict",
        "header": "Tag conflict",
        "question": f"Tag `{version}` already exists{detail}. What should happen?",
        "options": [
            {"label": "Overwrite existing tag"},
            {"label": "Skip tag creation"},
            {"label": "Cancel"}
        ],
        "cancel_option": 2,
        "flag_mapping": {
            "0": "--overwrite-tag",
            "1": "--skip-tag",
        },
    }


def cmd_bump_gather(args):
    """Gather all pre-check state for a bump without modifying anything."""
    output(_gather_bump_state(args))


def _gather_bump_state(args):
    """Compute pre-check state for a bump and return it (no process exit).

    Callers decide what to do with the state: ``cmd_bump_gather`` prints it for
    the interactive question loop, while ``cmd_bump_run`` inspects it and
    proceeds straight to execution when no questions or prompt hooks apply.
    """
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)
    bump_type = args.type
    force = args.force

    # Re-entrancy guard
    if os.environ.get("SEMVER_BUMP_IN_PROGRESS") == "1":
        return {"ok": False, "error": "reentrancy",
                "message": "A version bump is already in progress. Nested bumps are not allowed."}

    # Tracking check
    if not config.exists or not config.get_bool("tracking"):
        return {"ok": False, "error": "tracking_inactive",
                "message": "Version tracking is not active. Run /semver tracking start first."}

    prefix = config.get("version_prefix")
    tagging = config.get_bool("git_tagging")
    target = config.get("target_branch")
    version = read_version_file(project_dir)

    result = {
        "ok": True,
        "executed": False,
        "bump_type": bump_type,
        "force": force,
        "version_prefix": prefix,
        "git_tagging": tagging,
        "target_branch": target,
        "changelog_format": config.get("changelog_format"),
        "questions_needed": [],
    }

    # First version check
    if version is None:
        result["version_exists"] = False
        result["questions_needed"].append("first_version")
        result["questions"] = [{
            "id": "first_version",
            "header": "First version",
            "question": "No version is set yet. What should the first version be?",
            "options": [
                {"label": "v0.1.0 (Recommended)"},
                {"label": "v1.0.0"},
                {"label": "v0.0.1"}
            ],
            "type": "first_version",
        }]
        result["display"] = build_display(["[semver] No version set — first version selection required."])
        return result

    result["version_exists"] = True
    result["old_version"] = version

    # Parse and compute new version
    parsed = parse_version(version, prefix)
    if parsed is None:
        return {"ok": False, "error": "version_parse_error",
                "message": f"Cannot parse VERSION file content: '{version}'"}

    new_parts = increment_version(*parsed, bump_type)
    new_version = format_version(*new_parts, prefix=prefix)
    result["new_version"] = new_version

    # Commits since last bump
    lvc = last_version_commit()
    result["last_bump_commit"] = lvc
    count = commit_count_since(lvc) if lvc else commit_count_since(None)
    result["commits_since_last_bump"] = count

    if count == 0 and not force:
        result["no_commits"] = True
        result["message"] = f"No commits since the last version change ({version}). Use --force for a version-only bump."
        result["questions"] = []
        result["display"] = build_display([f"[semver] No commits since {version}. Use --force for a version-only bump."])
        return result

    # Dirty tree
    d_files = dirty_files()
    result["dirty_tree"] = len(d_files) > 0
    result["dirty_files"] = d_files
    if d_files:
        result["questions_needed"].append("dirty_tree")

    # Branch check
    branch = current_branch()
    result["current_branch"] = branch
    result["on_target_branch"] = branch == target
    if branch != target:
        result["questions_needed"].append("wrong_branch")

    # Validation
    checks = run_validation_checks(project_dir, config)
    check_summary = {"pass": 0, "fail": 0, "warn": 0, "skip": 0}
    for c in checks:
        key = c["status"].lower()
        if key in check_summary:
            check_summary[key] += 1

    result["validation"] = {
        "checks": checks,
        "all_pass": check_summary["fail"] == 0,
        "summary": check_summary,
    }
    if check_summary["fail"] > 0:
        result["questions_needed"].append("validation_failed")

    # Tag conflict pre-check
    if tagging and tag_exists(new_version):
        result["tag_conflict"] = True
    else:
        result["tag_conflict"] = False

    # PROMPT_HOOK.md presence
    pre_hook = os.path.join(project_dir, ".semver", "hooks", "pre-bump", "PROMPT_HOOK.md")
    post_hook = os.path.join(project_dir, ".semver", "hooks", "post-bump", "PROMPT_HOOK.md")
    result["has_pre_bump_prompt_hook"] = os.path.isfile(pre_hook)
    if result["has_pre_bump_prompt_hook"]:
        result["pre_bump_prompt_hook_path"] = pre_hook
    result["has_post_bump_prompt_hook"] = os.path.isfile(post_hook)
    if result["has_post_bump_prompt_hook"]:
        result["post_bump_prompt_hook_path"] = post_hook

    # Build structured questions for the LLM (shared builders keep the shape in
    # lockstep with the set path).
    questions = []
    if "dirty_tree" in result["questions_needed"]:
        questions.append(_q_dirty_tree(result["dirty_files"]))

    if "wrong_branch" in result["questions_needed"]:
        questions.append(_q_wrong_branch(result["current_branch"], result["target_branch"]))

    if "validation_failed" in result["questions_needed"]:
        questions.append(_q_validation_failed())

    if result.get("tag_conflict"):
        questions.append(_q_tag_conflict(result["new_version"]))

    result["questions"] = questions

    # Build display for gather
    lines = []
    if result.get("version_exists"):
        lines.append(f"[semver] Preparing {bump_type} bump: {result['old_version']} → {result['new_version']}")
        lines.append(f"  {result['commits_since_last_bump']} commit(s) since last version change")
        if result["questions_needed"]:
            lines.append(f"  Questions to resolve: {', '.join(result['questions_needed'])}")
    else:
        lines.append("[semver] No version set — first version selection required.")
    result["display"] = build_display(lines)

    return result


def cmd_bump_run(args):
    """Single-call bump: gather state, then execute when no interaction is needed.

    On the happy path (clean tree, on target branch, validation passing, no tag
    conflict, no prompt hooks) this executes the bump in one call so the
    orchestrator never needs a second round-trip. Otherwise it returns the
    gather state (identical to ``bump gather``) for the interactive question
    loop, or — with ``--non-interactive`` — aborts safely instead of asking.
    """
    state = _gather_bump_state(args)

    # A hard error (reentrancy / tracking inactive / parse error) is handed
    # straight back; the orchestrator surfaces the message and stops. Exit 1
    # so a caller checking the process exit code (not just ok:false in the
    # JSON) sees the failure too — matching cmd_bump_execute's output_error
    # for these same conditions. (bump gather's own exit code is unchanged:
    # it is a separate, lower-level subcommand not routed through by
    # semver-router.sh, and returning state for a question loop is not
    # itself a failure.)
    if not state.get("ok"):
        output(state, exit_code=1)

    # Reasons a human/orchestrator must intervene before we may execute.
    blockers = []
    if "first_version" in state.get("questions_needed", []):
        blockers.append("no version set yet (first version must be chosen)")
    if state.get("no_commits"):
        blockers.append("no commits since the last version change")
    if state.get("questions"):
        blockers.append("open questions: " + ", ".join(state.get("questions_needed", [])))
    if state.get("has_pre_bump_prompt_hook"):
        blockers.append("a pre-bump PROMPT_HOOK.md must run first")

    if blockers:
        if getattr(args, "non_interactive", False):
            state["ok"] = False
            state["error"] = "non_interactive_blocked"
            state["message"] = ("Cannot auto-bump non-interactively: "
                                + "; ".join(blockers)
                                + ". Re-run /semver bump interactively to resolve.")
            state["display"] = build_display(
                ["[semver] Auto-bump aborted — manual attention needed:"]
                + [f"  - {b}" for b in blockers])
        # Interactive path: return the gather state for the question loop.
        output(state)

    # Happy path: nothing to ask — execute straight through (outputs + exits).
    cmd_bump_execute(args)


def _apply_tag(new_version, tagging, skip_tag, overwrite_tag, result):
    """Create / overwrite / skip the version tag, recording the outcome in result.

    Must run inside the FileLock critical section (it invokes `git tag`). Shared
    by the bump and set execute paths so tag-conflict handling is identical.
    """
    result["tag_created"] = False
    result["tag_skipped"] = False
    if not tagging or skip_tag:
        result["tag_skipped"] = True
    else:
        if tag_exists(new_version):
            if overwrite_tag:
                git("tag", "-d", new_version)
                git("tag", new_version)
                result["tag_created"] = True
                result["tag_overwritten"] = True
            else:
                result["tag_skipped"] = True
                result["tag_conflict"] = True
        else:
            git("tag", new_version)
            result["tag_created"] = True


def _run_post_bump_and_verify(bump_type, old_version, new_version, tagging, skip_tag,
                              project_dir, plugin_root, pre_hooks_result, result):
    """Run post-bump user hooks and populate result['pre_hooks'/'post_hooks'/'verification'].

    Shared by bump, set, and init. Runs outside the FileLock (matching bump's
    original ordering, after the commit and tag already exist).

    Returns True iff the project defines post-bump hooks that could not be
    run at all (hook runner missing, crashed, or timed out) — the caller
    should report this as exit code 3 (see module docstring). A hook that DID
    run and exited non-zero is a different, already-documented case: it stays
    exit 0 with a warning in post_hooks.warnings and no rollback, because the
    version bump is already committed and tagged.
    """
    post_hooks_result = run_user_hooks(
        "post-bump", bump_type, old_version, new_version, project_dir, plugin_root)

    pending = _pending_post_bump_hooks(project_dir)
    skipped = bool(pending) and post_hooks_result.get("status") == "error"

    result["pre_hooks"] = {
        "hooks_run": pre_hooks_result.get("hooks_run", 0),
        "prompt_hook": pre_hooks_result.get("prompt_hook"),
    }
    warnings = list(post_hooks_result.get("warnings", []))
    if skipped:
        warnings.append({
            "reason": "post_bump_hooks_unavailable",
            "detail": post_hooks_result.get("message", "post-bump hook runner could not execute"),
            "hooks_pending": pending,
        })
    result["post_hooks"] = {
        "hooks_run": post_hooks_result.get("hooks_run", 0),
        "prompt_hook": post_hooks_result.get("prompt_hook"),
        "warnings": warnings,
        "skipped": skipped,
    }

    # Post-bump verification
    verification = {}
    v = read_version_file(project_dir)
    verification["version_matches"] = v == new_version
    if tagging and not skip_tag:
        verification["tag_exists"] = tag_exists(new_version)
    changelog_path = os.path.join(project_dir, "CHANGELOG.md")
    if os.path.isfile(changelog_path):
        with open(changelog_path) as f:
            verification["changelog_has_entry"] = f"## [{new_version}]" in f.read()
    result["verification"] = verification
    return skipped


def cmd_bump_execute(args):
    """Execute the bump: lock, write, commit, tag, unlock."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists or not config.get_bool("tracking"):
        output_error("tracking_inactive", "Version tracking is not active.")

    prefix = config.get("version_prefix")
    tagging = config.get_bool("git_tagging")
    fmt = config.get("changelog_format")
    bump_type = args.type
    force = args.force
    source = args.source
    dirty_action = args.dirty_action
    skip_tag = args.skip_tag
    overwrite_tag = args.overwrite_tag
    plugin_root = args.plugin_root

    version = read_version_file(project_dir)
    if version is None:
        output_error("no_version", "VERSION file does not exist. Run first-version first.")

    parsed = parse_version(version, prefix)
    if parsed is None:
        output_error("version_parse_error", f"Cannot parse VERSION: '{version}'")

    new_parts = increment_version(*parsed, bump_type)
    new_version = format_version(*new_parts, prefix=prefix)
    old_version = version
    today = datetime.date.today().isoformat()

    lock = FileLock(project_dir)
    stashed = False
    result = {"ok": True, "executed": True, "old_version": old_version, "new_version": new_version}

    try:
        with lock:
            # Handle dirty tree
            if dirty_action == "include":
                git("add", "-A")
            elif dirty_action == "stash":
                stashed = _stash_before_version("semver: pre-bump stash")

            # Hooks must stage their output after user edits have been stashed.
            pre_hooks_result = _run_pre_bump_hooks(
                bump_type, old_version, new_version, project_dir, plugin_root)

            # Get commits for changelog
            lvc = last_version_commit()
            raw_commits = commits_since(lvc) if lvc else commits_since(None)
            result["commits_included"] = len([c for c in raw_commits
                                               if not c["subject"].startswith("chore(release):")])

            # Generate changelog entry
            effective_source = "force" if force and not raw_commits else source
            entry = generate_changelog_entry(
                raw_commits, new_version, today, fmt, effective_source, force=force)
            result["changelog_preview"] = entry.split("\n\n", 1)[1][:500] if "\n\n" in entry else entry[:500]

            # Write VERSION
            version_path = os.path.join(project_dir, "VERSION")
            with open(version_path, "w") as f:
                f.write(new_version + "\n")

            # Write CHANGELOG
            changelog_path = os.path.join(project_dir, "CHANGELOG.md")
            prepend_changelog_entry(changelog_path, entry)

            # Commit
            git("add", "VERSION", "CHANGELOG.md")
            rc, _, err = git("commit", "-m", f"chore(release): {new_version}")
            if rc != 0:
                raise RuntimeError(f"git commit failed: {err}")

            _, commit_hash, _ = git("rev-parse", "--short", "HEAD")
            result["commit_hash"] = commit_hash

            # Tag
            _apply_tag(new_version, tagging, skip_tag, overwrite_tag, result)

    except SystemExit:
        if stashed:
            git("stash", "pop")
        raise
    except RuntimeError as e:
        # Clean up partial changes
        git("checkout", "VERSION", "CHANGELOG.md")
        if stashed:
            git("stash", "pop")
        output_error("bump_failed", str(e))
    except Exception as e:
        git("checkout", "VERSION", "CHANGELOG.md")
        if stashed:
            git("stash", "pop")
        output_error("bump_failed", f"Unexpected error: {e}")

    # Unstash if needed
    if stashed:
        git("stash", "pop")
        result["stash_applied"] = True

    # Run post-bump hooks + verification (shared with set)
    hooks_skipped = _run_post_bump_and_verify(
        bump_type, old_version, new_version, tagging, skip_tag,
        project_dir, plugin_root, pre_hooks_result, result)

    # Build display
    lines = [f"[semver] Bumped {result['old_version']} → {result['new_version']} ({bump_type})"]
    lines.append(f"  Commits included: {result.get('commits_included', 0)}")
    if result.get("tag_created"):
        tag_note = f"Tag: {new_version} created"
        if result.get("tag_overwritten"):
            tag_note += " (overwritten)"
        lines.append(f"  {tag_note}")
    elif result.get("tag_skipped"):
        if result.get("tag_conflict"):
            lines.append("  Tag: skipped (conflict)")
        elif not tagging:
            lines.append("  Tag: disabled")
        else:
            lines.append("  Tag: skipped")
    if result.get("stash_applied"):
        lines.append("  Stash: restored")
    if hooks_skipped:
        lines.append("  ⚠ post-bump hooks did NOT run — see post_hooks.warnings")
    result["display"] = build_display(lines)

    output(result, exit_code=3 if hooks_skipped else 0)


def cmd_bump_first_version(args):
    """Create initial VERSION + CHANGELOG + commit + optional tag."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists or not config.get_bool("tracking"):
        output_error("tracking_inactive", "Version tracking is not active.")

    prefix = config.get("version_prefix")
    tagging = config.get_bool("git_tagging")
    fmt = config.get("changelog_format")
    today = datetime.date.today().isoformat()

    # Apply prefix to the user-provided version
    raw_version = args.version.strip()
    # If user provided prefix already, don't double-prefix
    if prefix and not raw_version.startswith(prefix):
        version = prefix + raw_version
    else:
        version = raw_version

    # Validate version format
    if parse_version(version, prefix) is None:
        output_error("invalid_version", f"Invalid version format: '{version}'. Expected: {prefix}MAJOR.MINOR.PATCH")

    old_version = read_version_file(project_dir)
    pre_hooks_result = _run_pre_bump_hooks(
        "init", old_version, version, project_dir, None)

    # Write VERSION
    version_path = os.path.join(project_dir, "VERSION")
    with open(version_path, "w") as f:
        f.write(version + "\n")

    # Create CHANGELOG
    changelog_path = os.path.join(project_dir, "CHANGELOG.md")
    create_initial_changelog(changelog_path, version, today, fmt)

    # Commit
    git("add", "VERSION", "CHANGELOG.md")
    rc, _, err = git("commit", "-m", f"chore: initialize version at {version}")
    if rc != 0:
        output_error("commit_failed", f"git commit failed: {err}")

    _, commit_hash, _ = git("rev-parse", "--short", "HEAD")

    # Tag
    tag_created = False
    if tagging:
        git("tag", version)
        tag_created = True

    display_lines = [f"[semver] Initialized at {version}"]
    display_lines.append("  CHANGELOG.md created")
    if tag_created:
        display_lines.append(f"  Tag: {version} created")

    result = {
        "ok": True,
        "version": version,
        "changelog_created": True,
        "tag_created": tag_created,
        "commit_hash": commit_hash,
        "display": build_display(display_lines),
    }
    skipped = _run_post_bump_and_verify(
        "init", old_version, version, tagging, False,
        project_dir, None, pre_hooks_result, result)
    if skipped:
        result["display"] += "\n  ⚠ post-bump hooks did NOT run — see post_hooks.warnings"
    output(result, exit_code=3 if skipped else 0)


# ─── set (assign an explicit version) ────────────────────────────────────────

def _changelog_has_heading(changelog_path, version):
    """True if CHANGELOG.md already contains a `## [<version>]` section."""
    if not os.path.isfile(changelog_path):
        return False
    with open(changelog_path) as f:
        return f"## [{version}]" in f.read()


def _set_recut(project_dir, config, version, tagging):
    """Coherent re-cut when the target equals the CURRENT version.

    Never creates an empty commit (that would break `/semver validate` check 4,
    since an empty commit shares its parent's tree and never becomes VERSION's
    last-touch commit). Instead: if tagging is on and the version tag is missing
    or points off the commit that last set VERSION, (re)place it there; otherwise
    it is a clean no-op. Outputs and exits.
    """
    result = {"ok": True, "executed": True, "operation": "set", "recut": True,
              "old_version": version, "new_version": version}

    if not tagging:
        result["tag_action"] = "none"
        result["display"] = build_display(
            [f"[semver] Already at {version}. Git tagging is disabled — nothing to do."])
        output(result)

    lvc = last_version_commit()
    if not lvc:
        result["tag_action"] = "none"
        result["display"] = build_display(
            [f"[semver] Already at {version}, but VERSION has no commit yet — "
             "run /semver bump or commit VERSION first."])
        output(result)

    if not tag_exists(version):
        git("tag", version, lvc)
        result["tag_action"] = "created"
        result["display"] = build_display(
            [f"[semver] Already at {version}; tag was missing — created it on {lvc[:7]}."])
        output(result)

    if tag_commit(version) != lvc:
        git("tag", "-d", version)
        git("tag", version, lvc)
        result["tag_action"] = "moved"
        result["display"] = build_display(
            [f"[semver] Already at {version}; moved tag onto the VERSION commit ({lvc[:7]})."])
        output(result)

    result["tag_action"] = "noop"
    result["display"] = build_display(
        [f"[semver] Already at {version}; tag already correct. Nothing to do."])
    output(result)


def cmd_set_run(args):
    """Assign an explicit version. Gather state, then execute when no interaction
    is needed (mirrors cmd_bump_run). Returns the same question shapes for the
    SKILL Question Loop, or executes straight through on the happy path.
    """
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    # Re-entrancy guard
    if os.environ.get("SEMVER_BUMP_IN_PROGRESS") == "1":
        output_error("reentrancy",
                     "A version operation is already in progress. Nested operations are not allowed.")

    # Tracking check
    if not config.exists or not config.get_bool("tracking"):
        output_error("tracking_inactive",
                     "Version tracking is not active. Run /semver init first.")

    prefix = config.get("version_prefix")
    tagging = config.get_bool("git_tagging")
    target_branch = config.get("target_branch")

    # Resolve + validate target
    raw = args.version.strip()
    target = prefix + raw if prefix and not raw.startswith(prefix) else raw
    parsed_target = parse_version(target, prefix)
    if parsed_target is None:
        output_error("invalid_version",
                     f"Invalid version format: '{target}'. Expected: {prefix}MAJOR.MINOR.PATCH")

    old = read_version_file(project_dir)
    has_prior = old is not None

    # Same-version re-cut — coherent no-op / re-tag, never an empty commit.
    if has_prior and target == old:
        _set_recut(project_dir, config, target, tagging)  # outputs + exits

    result = {
        "ok": True,
        "executed": False,
        "operation": "set",
        "version_prefix": prefix,
        "git_tagging": tagging,
        "target_branch": target_branch,
        "old_version": old,
        "new_version": target,
        "questions_needed": [],
    }
    questions = []

    # Backward / non-increasing version (only when a prior version exists).
    if has_prior:
        parsed_old = parse_version(old, prefix)
        if parsed_old is not None and parsed_target <= parsed_old:
            result["questions_needed"].append("backward_version")
            questions.append({
                "id": "backward_version",
                "header": "Lower version",
                "question": f"Target `{target}` is not higher than the current version `{old}`. Assign it anyway?",
                "options": [
                    {"label": "Proceed with the lower version"},
                    {"label": "Cancel"}
                ],
                "cancel_option": 1,
                "flag_mapping": {"0": "--allow-backward"},
            })

    # Dirty tree
    d_files = dirty_files()
    result["dirty_tree"] = len(d_files) > 0
    result["dirty_files"] = d_files
    if d_files:
        result["questions_needed"].append("dirty_tree")
        questions.append(_q_dirty_tree(d_files, verb="set"))

    # Branch check
    branch = current_branch()
    result["current_branch"] = branch
    result["on_target_branch"] = branch == target_branch
    if branch != target_branch:
        result["questions_needed"].append("wrong_branch")
        questions.append(_q_wrong_branch(branch, target_branch, gerund="Setting a version"))

    # Validation (only meaningful once a version exists)
    if has_prior:
        checks = run_validation_checks(project_dir, config)
        summary = {"pass": 0, "fail": 0, "warn": 0, "skip": 0}
        for c in checks:
            k = c["status"].lower()
            if k in summary:
                summary[k] += 1
        result["validation"] = {"checks": checks, "all_pass": summary["fail"] == 0, "summary": summary}
        if summary["fail"] > 0:
            result["questions_needed"].append("validation_failed")
            questions.append(_q_validation_failed(gerund="Setting", verb="Set"))

    # Tag conflict (target tag already exists — common for set)
    if tagging and tag_exists(target):
        result["tag_conflict"] = True
        result["questions_needed"].append("tag_conflict")
        questions.append(_q_tag_conflict(target, detail=" (setting moves it off its current commit)"))
    else:
        result["tag_conflict"] = False

    result["questions"] = questions

    # Post-bump PROMPT_HOOK presence
    post_hook = os.path.join(project_dir, ".semver", "hooks", "post-bump", "PROMPT_HOOK.md")
    result["has_post_bump_prompt_hook"] = os.path.isfile(post_hook)
    if result["has_post_bump_prompt_hook"]:
        result["post_bump_prompt_hook_path"] = post_hook

    result.update(_pre_prompt_state(project_dir))

    # Blockers → hand back (or abort when non-interactive)
    blockers = list(result["questions_needed"])
    if result["has_pre_bump_prompt_hook"]:
        blockers.append("a pre-bump PROMPT_HOOK.md must run first")
    if blockers:
        if getattr(args, "non_interactive", False):
            result["ok"] = False
            result["error"] = "non_interactive_blocked"
            result["message"] = "Cannot set non-interactively; open questions: " + ", ".join(blockers)
            result["display"] = build_display(
                ["[semver] Set aborted — manual attention needed:"]
                + [f"  - {b}" for b in blockers])
        else:
            lines = [f"[semver] Preparing to set version: {old or '(none)'} → {target}"]
            lines.append(f"  Questions to resolve: {', '.join(blockers)}")
            result["display"] = build_display(lines)
        output(result, exit_code=0 if result["ok"] else 1)

    # Happy path — execute straight through (outputs + exits).
    cmd_set_execute(args)


def cmd_set_execute(args):
    """Execute an explicit version assignment: lock, write, commit, tag, hooks."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists or not config.get_bool("tracking"):
        output_error("tracking_inactive", "Version tracking is not active.")

    prefix = config.get("version_prefix")
    tagging = config.get_bool("git_tagging")
    fmt = config.get("changelog_format")
    dirty_action = args.dirty_action
    skip_tag = args.skip_tag
    overwrite_tag = args.overwrite_tag
    plugin_root = args.plugin_root

    raw = args.version.strip()
    new_version = prefix + raw if prefix and not raw.startswith(prefix) else raw
    if parse_version(new_version, prefix) is None:
        output_error("invalid_version",
                     f"Invalid version format: '{new_version}'. Expected: {prefix}MAJOR.MINOR.PATCH")

    old_version = read_version_file(project_dir)
    has_prior = old_version is not None
    today = datetime.date.today().isoformat()

    # Re-cut safety net (normally resolved by cmd_set_run before reaching here).
    if has_prior and new_version == old_version:
        _set_recut(project_dir, config, new_version, tagging)  # outputs + exits

    lock = FileLock(project_dir)
    stashed = False
    result = {"ok": True, "executed": True, "operation": "set",
              "old_version": old_version, "new_version": new_version}

    try:
        with lock:
            # Handle dirty tree
            if dirty_action == "include":
                git("add", "-A")
            elif dirty_action == "stash":
                stashed = _stash_before_version("semver: pre-set stash")

            # Hooks must stage their output after user edits have been stashed.
            pre_hooks_result = _run_pre_bump_hooks(
                "set", old_version, new_version, project_dir, plugin_root)

            changelog_path = os.path.join(project_dir, "CHANGELOG.md")
            if has_prior:
                lvc = last_version_commit()
                raw_commits = commits_since(lvc) if lvc else commits_since(None)
                result["commits_included"] = len([c for c in raw_commits
                                                  if not c["subject"].startswith("chore(release):")])
                entry = generate_changelog_entry(raw_commits, new_version, today, fmt, "manual", force=False)
                result["changelog_preview"] = entry.split("\n\n", 1)[1][:500] if "\n\n" in entry else entry[:500]
            else:
                result["commits_included"] = 0

            # Write VERSION
            version_path = os.path.join(project_dir, "VERSION")
            with open(version_path, "w") as f:
                f.write(new_version + "\n")

            # Write CHANGELOG (skip a duplicate heading, e.g. re-assigning a
            # previously released version)
            if has_prior:
                if not _changelog_has_heading(changelog_path, new_version):
                    prepend_changelog_entry(changelog_path, entry)
                    result["changelog_updated"] = True
                else:
                    result["changelog_updated"] = False
            else:
                create_initial_changelog(changelog_path, new_version, today, fmt)
                result["changelog_updated"] = True

            # Commit
            git("add", "VERSION", "CHANGELOG.md")
            rc, _, err = git("commit", "-m", f"chore(release): {new_version}")
            if rc != 0:
                raise RuntimeError(f"git commit failed: {err}")

            _, commit_hash, _ = git("rev-parse", "--short", "HEAD")
            result["commit_hash"] = commit_hash

            # Tag
            _apply_tag(new_version, tagging, skip_tag, overwrite_tag, result)

    except SystemExit:
        if stashed:
            git("stash", "pop")
        raise
    except RuntimeError as e:
        git("checkout", "VERSION", "CHANGELOG.md")
        if stashed:
            git("stash", "pop")
        output_error("set_failed", str(e))
    except Exception as e:
        git("checkout", "VERSION", "CHANGELOG.md")
        if stashed:
            git("stash", "pop")
        output_error("set_failed", f"Unexpected error: {e}")

    if stashed:
        git("stash", "pop")
        result["stash_applied"] = True

    # Post-bump hooks + verification with the same version context as pre-hooks.
    hooks_skipped = _run_post_bump_and_verify(
        "set", old_version, new_version, tagging, skip_tag,
        project_dir, plugin_root, pre_hooks_result, result)

    # Build display
    lines = [f"[semver] Set version → {new_version}"]
    if has_prior:
        lines.append(f"  Previous: {old_version} | Commits included: {result.get('commits_included', 0)}")
    else:
        lines.append("  Initial version (no prior VERSION)")
    if result.get("tag_created"):
        tag_note = f"Tag: {new_version} created"
        if result.get("tag_overwritten"):
            tag_note += " (moved off its previous commit)"
        lines.append(f"  {tag_note}")
    elif result.get("tag_skipped"):
        if result.get("tag_conflict"):
            lines.append("  Tag: skipped (conflict)")
        elif not tagging:
            lines.append("  Tag: disabled")
        else:
            lines.append("  Tag: skipped")
    if result.get("stash_applied"):
        lines.append("  Stash: restored")
    if hooks_skipped:
        lines.append("  ⚠ post-bump hooks did NOT run — see post_hooks.warnings")
    result["display"] = build_display(lines)

    output(result, exit_code=3 if hooks_skipped else 0)


def cmd_tracking_start(args):
    """Initialize version tracking."""
    project_dir = os.getcwd()
    ensure_git_root()

    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    # Already active?
    if config.exists and config.get_bool("tracking"):
        version = read_version_file(project_dir)
        output({"ok": True, "action": "already_active",
                "message": f"Version tracking is already active. Current version: {version}"})

    # Check for archive
    archive_path = os.path.join(project_dir, "VERSIONING_ARCHIVE.md")
    archive = parse_archive(archive_path)

    if archive:
        return _tracking_start_from_archive(project_dir, config_path, archive, archive_path, args)

    # Fresh start
    return _tracking_start_fresh(project_dir, config_path, args)


def _init_fresh_core(project_dir, config_path, *, version, prefix, tagging, fmt, branch,
                     commit_message="chore: initialize semver tracking",
                     raise_on_commit_fail=False, plugin_root=None):
    """Write config + optional VERSION/CHANGELOG + CLAUDE.md, commit, and tag.

    Shared by `tracking start` (version may be None) and `init` (version always
    set). Returns a result dict; does NOT call output(). Enables tracking +
    auto-bump. On invalid version it calls output_error (exits). On commit failure
    it raises RuntimeError when raise_on_commit_fail is set (so `init` can roll
    back the just-created files) or calls output_error otherwise (tracking start's
    original behavior).
    """
    today = datetime.date.today().isoformat()

    old_version = read_version_file(project_dir)
    pre_hooks_result = {"hooks_run": 0, "prompt_hook": None, "warnings": []}
    if version:
        raw = version.strip()
        resolved = prefix + raw if prefix and not raw.startswith(prefix) else raw
        if parse_version(resolved, prefix) is None:
            output_error("invalid_version", f"Invalid version: '{resolved}'")
        pre_hooks_result = _run_pre_bump_hooks(
            "init", old_version, resolved, project_dir, plugin_root)

    # Create config (tracking + auto-bump enabled)
    config = Config(config_path)
    config.set("tracking", "true")
    config.set("auto_bump", "true")
    config.set("auto_bump_confirm", "true")
    config.set("version_prefix", prefix)
    config.set("git_tagging", str(tagging).lower())
    config.set("changelog_format", fmt)
    config.set("target_branch", branch)
    config.write()

    files_created = [".semver/config.yaml"]

    # Optional starting version
    version_set = False
    tag_created = False
    if version:
        version_path = os.path.join(project_dir, "VERSION")
        with open(version_path, "w") as f:
            f.write(resolved + "\n")
        files_created.append("VERSION")

        changelog_path = os.path.join(project_dir, "CHANGELOG.md")
        create_initial_changelog(changelog_path, resolved, today, fmt)
        files_created.append("CHANGELOG.md")
        version_set = True

    # Inject CLAUDE.md
    inject_claude_md(project_dir)
    files_created.append("CLAUDE.md")

    # Commit
    git("add", *files_created)
    rc, _, err = git("commit", "-m", commit_message)
    if rc != 0:
        if raise_on_commit_fail:
            raise RuntimeError(f"git commit failed: {err}")
        output_error("commit_failed", f"git commit failed: {err}")

    _, commit_hash, _ = git("rev-parse", "--short", "HEAD")

    # Tag if version was set and tagging enabled
    if version_set and tagging:
        git("tag", read_version_file(project_dir))
        tag_created = True

    return {
        "old_version": old_version,
        "pre_hooks": pre_hooks_result,
        "version_prefix": prefix,
        "git_tagging": tagging,
        "changelog_format": fmt,
        "target_branch": branch,
        "version_set": version_set,
        "version": read_version_file(project_dir),
        "tag_created": tag_created,
        "files_created": files_created,
        "commit_hash": commit_hash,
    }


def _tracking_start_fresh(project_dir, config_path, args):
    """Fresh tracking start with no archive."""
    # Resolve options
    prefix = "v"
    if args.prefix:
        prefix = "" if args.prefix == "none" else args.prefix
    tagging = not args.no_tags
    fmt = args.changelog or "grouped"
    branch = args.branch or detect_default_branch()

    core = _init_fresh_core(project_dir, config_path, version=args.version, prefix=prefix,
                            tagging=tagging, fmt=fmt, branch=branch, plugin_root=args.plugin_root)

    result = {
        "ok": True,
        "action": "fresh_start",
        "target_branch": branch,
        "git_tagging": tagging,
        "changelog_format": fmt,
        "version_prefix": prefix,
        "version_set": core["version_set"],
        "version": core["version"],
        "tag_created": core["tag_created"],
        "files_created": core["files_created"],
        "commit_hash": core["commit_hash"],
    }

    display_lines = ["[semver] Tracking initialized"]
    display_lines.append(f"  Branch: {branch} | Tags: {'on' if tagging else 'off'} | Changelog: {fmt}")
    if core["version_set"]:
        display_lines.append(f"  Version: {core['version']}")

    # Post-bump hooks (e.g. the plugin-version-sync hook) only make sense when
    # a version was actually written — without --version, tracking start
    # creates no VERSION/tag for them to react to.
    hooks_skipped = False
    if core["version_set"]:
        hooks_skipped = _run_post_bump_and_verify(
            "init", core["old_version"], core["version"], tagging, False,
            project_dir, args.plugin_root,
            core["pre_hooks"], result)
        if hooks_skipped:
            display_lines.append("  ⚠ post-bump hooks did NOT run — see post_hooks.warnings")

    result["display"] = build_display(display_lines)
    output(result, exit_code=3 if hooks_skipped else 0)


def _tracking_start_from_archive(project_dir, config_path, archive, archive_path, args):
    """Restore tracking from an archive."""
    meta = archive["metadata"]
    sections = archive["sections"]
    items = meta.get("items_archived", [])

    # Restore config
    if "config" in sections:
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
            f.write(sections["config"] + "\n")
        # Ensure tracking is on
        config = Config(config_path)
        config.set("tracking", "true")
        config.write()
    else:
        # Create minimal config from archive metadata
        config = Config(config_path)
        config.set("tracking", "true")
        config.set("version_prefix", meta.get("version_prefix", "v"))
        config.set("git_tagging", meta.get("git_tagging", "true"))
        config.set("changelog_format", meta.get("changelog_format", "grouped"))
        config.set("target_branch", meta.get("target_branch", "main"))
        config.set("auto_bump", meta.get("auto_bump", "false"))
        config.set("auto_bump_confirm", meta.get("auto_bump_confirm", "true"))
        config.write()

    restored = ["config"]

    # Restore VERSION
    if "version" in sections:
        with open(os.path.join(project_dir, "VERSION"), "w") as f:
            f.write(sections["version"] + "\n")
        restored.append("version")

    # Restore CHANGELOG
    if "changelog" in sections:
        with open(os.path.join(project_dir, "CHANGELOG.md"), "w") as f:
            f.write(sections["changelog"] + "\n")
        restored.append("changelog")

    # Inject CLAUDE.md
    inject_claude_md(project_dir)

    # Handle tags
    tags_available = "tags" in items and "tags" in sections
    tags_restored = False
    tag_list = []

    if tags_available:
        for line in sections["tags"].splitlines():
            parts = line.split(None, 1)
            if parts:
                tag_list.append(parts[0])

    if tags_available and args.restore_tags:
        tag_data = sections["tags"]
        for line in tag_data.splitlines():
            parts = line.split(None, 2)
            if len(parts) >= 2:
                tag_name = parts[0].strip()
                tag_hash = parts[1].strip()
                rc, _, _ = git("cat-file", "-e", tag_hash)
                if rc == 0:
                    git("tag", tag_name, tag_hash)
        tags_restored = True
        restored.append("tags")

    # Rename archive
    bak_path = archive_path + ".bak"
    os.rename(archive_path, bak_path)

    # Commit
    git("add", "-A")
    rc, _, err = git("commit", "-m", "chore: restore semver tracking from archive")
    if rc != 0:
        output_error("commit_failed", f"git commit failed: {err}")

    _, commit_hash, _ = git("rev-parse", "--short", "HEAD")

    result = {
        "ok": True,
        "action": "archive_restore",
        "archive_date": meta.get("archived_at", "unknown"),
        "last_version": meta.get("last_version", "unknown"),
        "restored": restored,
        "tags_available": tags_available,
        "tags_restored": tags_restored,
        "tag_list": tag_list,
        "commit_hash": commit_hash,
        "questions_needed": [],
    }
    if tags_available and not args.restore_tags:
        result["questions_needed"].append("restore_tags")

    display_lines = [f"[semver] Tracking restored from archive (archived {result['archive_date']})"]
    display_lines.append(f"  Restored: {', '.join(result['restored'])}")
    if result['tags_available'] and not result['tags_restored']:
        display_lines.append(f"  Tags: {len(result['tag_list'])} available — not yet restored")
    result["display"] = build_display(display_lines)

    output(result)


def cmd_tracking_restore_tags(args):
    """Restore tags from archive after user confirms."""
    project_dir = os.getcwd()
    archive_path = os.path.join(project_dir, "VERSIONING_ARCHIVE.md.bak")
    if not os.path.isfile(archive_path):
        archive_path = os.path.join(project_dir, "VERSIONING_ARCHIVE.md")
    archive = parse_archive(archive_path)
    if not archive or "tags" not in archive["sections"]:
        output_error("no_tags", "No tags section found in archive.")

    restored = 0
    skipped = 0
    for line in archive["sections"]["tags"].splitlines():
        parts = line.split(None, 2)
        if len(parts) >= 2:
            tag_name = parts[0].strip()
            tag_hash = parts[1].strip()
            rc, _, _ = git("cat-file", "-e", tag_hash)
            if rc == 0:
                rc2, _, _ = git("tag", tag_name, tag_hash)
                if rc2 == 0:
                    restored += 1
                else:
                    skipped += 1
            else:
                skipped += 1

    output({"ok": True, "tags_restored": restored, "tags_skipped": skipped,
            "display": f"[semver] Tags restored: {restored}, skipped: {skipped}"})


def cmd_tracking_stop_gather(args):
    """Gather state for tracking stop questions."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists or not config.get_bool("tracking"):
        output({"ok": False, "error": "tracking_inactive",
                "message": "Version tracking is not active."})

    prefix = config.get("version_prefix")
    tagging = config.get_bool("git_tagging")
    version = read_version_file(project_dir)
    tags = all_version_tags(prefix) if tagging else []
    has_version = os.path.isfile(os.path.join(project_dir, "VERSION"))
    has_changelog = os.path.isfile(os.path.join(project_dir, "CHANGELOG.md"))

    questions = ["archive_items"]
    if tagging and tags:
        questions.append("tag_deletion")

    # Build structured questions
    questions_list = []

    archive_opts = [{"label": "VERSION file"}, {"label": "CHANGELOG"}]
    if tagging and tags:
        archive_opts.append({"label": "Git tags"})
    questions_list.append({
        "id": "archive_items",
        "header": "Archive",
        "question": "Which items to archive to VERSIONING_ARCHIVE.md before disabling tracking?",
        "options": archive_opts,
        "multi_select": True,
        "answer_mapping": {
            "VERSION file": "version",
            "CHANGELOG": "changelog",
            "Git tags": "tags",
        },
    })

    if tagging and tags:
        questions_list.append({
            "id": "tag_deletion",
            "header": "Remote tags",
            "question": "Delete version tags from the remote too? Warning: this affects all collaborators.",
            "options": [
                {"label": "Delete local only (Recommended)"},
                {"label": "Delete local and remote"},
                {"label": "Don't delete tags"}
            ],
            "flag_mapping": {
                "0": "--delete-tags local",
                "1": "--delete-tags both",
                "2": "--delete-tags none",
            },
            "condition": "tags_selected",
        })

    display_lines = ["[semver] Preparing to stop tracking"]
    display_lines.append(f"  Current version: {version or 'none'}")
    if tagging:
        display_lines.append(f"  Tags: {len(tags)} version tag(s)")

    output({
        "ok": True,
        "tracking": True,
        "version": version,
        "git_tagging": tagging,
        "has_version": has_version,
        "has_changelog": has_changelog,
        "tag_count": len(tags),
        "tags": tags[:20],  # Limit for output size
        "questions_needed": questions,
        "questions": questions_list,
        "display": build_display(display_lines),
    })


def cmd_tracking_stop_execute(args):
    """Execute tracking stop: archive, cleanup, commit."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists or not config.get_bool("tracking"):
        output_error("tracking_inactive", "Version tracking is not active.")

    prefix = config.get("version_prefix")
    items = [i.strip() for i in args.archive.split(",") if i.strip()] if args.archive else []
    delete_tags = args.delete_tags or "none"

    # Build archive
    archive_content = build_archive(project_dir, config, items)
    archive_path = os.path.join(project_dir, "VERSIONING_ARCHIVE.md")
    with open(archive_path, "w") as f:
        f.write(archive_content)

    # Disable tracking
    config.set("tracking", "false")
    config.set("auto_bump", "false")
    config.write()

    # Delete archived files
    files_removed = []
    if "version" in items:
        vp = os.path.join(project_dir, "VERSION")
        if os.path.isfile(vp):
            os.remove(vp)
            files_removed.append("VERSION")
    if "changelog" in items:
        cp = os.path.join(project_dir, "CHANGELOG.md")
        if os.path.isfile(cp):
            os.remove(cp)
            files_removed.append("CHANGELOG.md")

    # Delete tags
    tags_deleted_local = 0
    tags_deleted_remote = 0
    if "tags" in items and delete_tags != "none":
        tags = all_version_tags(prefix)
        for t in tags:
            git("tag", "-d", t)
            tags_deleted_local += 1
            if delete_tags == "both":
                git("push", "origin", "--delete", t)
                tags_deleted_remote += 1

    # Remove CLAUDE.md injection
    claude_md_cleaned = remove_claude_md(project_dir)

    # Commit
    git("add", "-A")
    rc, _, err = git("commit", "-m", "chore: stop semver tracking -- archived to VERSIONING_ARCHIVE.md")
    if rc != 0:
        output_error("commit_failed", f"git commit failed: {err}")

    _, commit_hash, _ = git("rev-parse", "--short", "HEAD")

    display_lines = ["[semver] Tracking stopped"]
    display_lines.append(f"  Archived to: VERSIONING_ARCHIVE.md ({', '.join(items)})")
    if tags_deleted_local > 0:
        display_lines.append(f"  Tags deleted: {tags_deleted_local} local" + (f", {tags_deleted_remote} remote" if tags_deleted_remote > 0 else ""))

    output({
        "ok": True,
        "archive_path": "VERSIONING_ARCHIVE.md",
        "items_archived": items,
        "tags_deleted_local": tags_deleted_local,
        "tags_deleted_remote": tags_deleted_remote,
        "files_removed": files_removed,
        "claude_md_cleaned": claude_md_cleaned,
        "commit_hash": commit_hash,
        "display": build_display(display_lines),
    })


# ─── init (one-shot adoption) ────────────────────────────────────────────────

def _detect_prefix(version, tags, arg_prefix):
    """Resolve the version prefix from an explicit arg, else infer from an
    existing version/tag ('v' when it starts with v<digit>, otherwise '')."""
    if arg_prefix is not None:
        return "" if arg_prefix == "none" else arg_prefix
    sample = version or (tags[0] if tags else None)
    if sample and re.match(r"^v\d", sample):
        return "v"
    if sample:
        return ""
    return "v"


def _init_cleanup(project_dir):
    """Best-effort removal of files created by a failed fresh init.

    Only called on the no-artifacts path, where VERSION/CHANGELOG.md/config did
    not exist beforehand, so removing them fully reverts the attempt. CLAUDE.md
    may have pre-existed, so only the injected block is stripped.
    """
    for rel in ("VERSION", "CHANGELOG.md", os.path.join(".semver", "config.yaml")):
        p = os.path.join(project_dir, rel)
        try:
            if os.path.isfile(p):
                os.remove(p)
        except OSError:
            pass
    remove_claude_md(project_dir)
    git("reset", "-q")  # best-effort unstage; harmless if it fails


def _init_snapshot(project_dir, args):
    """Read-only snapshot of existing semver artifacts."""
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)
    version = read_version_file(project_dir)
    changelog_exists = os.path.isfile(os.path.join(project_dir, "CHANGELOG.md"))
    prefix = config.get("version_prefix") if config.exists else _detect_prefix(version, [], args.prefix)
    tags = all_version_tags(prefix)
    archive_exists = os.path.isfile(os.path.join(project_dir, "VERSIONING_ARCHIVE.md"))
    claude_block = False
    cmd_path = os.path.join(project_dir, "CLAUDE.md")
    if os.path.isfile(cmd_path):
        with open(cmd_path) as f:
            claude_block = CLAUDE_MD_START in f.read()
    has_artifacts = bool(config.exists or version is not None or changelog_exists
                         or tags or archive_exists)
    return {
        "config_exists": config.exists,
        "tracking_active": config.exists and config.get_bool("tracking"),
        "auto_bump_on": config.exists and config.get_bool("auto_bump"),
        "version": version,
        "changelog_exists": changelog_exists,
        "prefix": prefix,
        "tags": tags,
        "archive_exists": archive_exists,
        "claude_block": claude_block,
        "has_artifacts": has_artifacts,
    }


def _init_do_fresh(project_dir, config_path, args):
    """Clean init: enable tracking + auto-bump, seed version (arg or v0.1.0),
    initialize changelog + tag on the new init commit. Outputs and exits."""
    prefix = "" if args.prefix == "none" else (args.prefix or "v")
    tagging = not args.no_tags
    fmt = args.changelog or "grouped"
    branch = args.branch or detect_default_branch()
    raw = (args.version or "0.1.0").strip()
    resolved = prefix + raw if prefix and not raw.startswith(prefix) else raw
    if parse_version(resolved, prefix) is None:
        output_error("invalid_version",
                     f"Invalid version: '{resolved}'. Expected: {prefix}MAJOR.MINOR.PATCH")

    result = {"ok": True, "executed": True, "operation": "init", "action": "fresh_init"}
    lock = FileLock(project_dir)
    try:
        with lock:
            core = _init_fresh_core(
                project_dir, config_path, version=raw, prefix=prefix, tagging=tagging,
                fmt=fmt, branch=branch,
                commit_message=f"chore: initialize semver tracking at {resolved}",
                raise_on_commit_fail=True, plugin_root=args.plugin_root)
    except RuntimeError as e:
        _init_cleanup(project_dir)
        output_error("init_failed", str(e))

    result.update({
        "version": core["version"],
        "version_set": core["version_set"],
        "tag_created": core["tag_created"],
        "target_branch": core["target_branch"],
        "git_tagging": core["git_tagging"],
        "changelog_format": core["changelog_format"],
        "version_prefix": core["version_prefix"],
        "files_created": core["files_created"],
        "commit_hash": core["commit_hash"],
    })
    hooks_skipped = _run_post_bump_and_verify(
        "init", core["old_version"], core["version"], tagging, False,
        project_dir, args.plugin_root,
        core["pre_hooks"], result)
    lines = [f"[semver] Initialized semver tracking at {core['version']}"]
    lines.append(f"  Auto-bump: on | Branch: {branch} | Tags: {'on' if tagging else 'off'} | Changelog: {fmt}")
    if hooks_skipped:
        lines.append("  ⚠ post-bump hooks did NOT run — see post_hooks.warnings")
    result["display"] = build_display(lines)
    output(result, exit_code=3 if hooks_skipped else 0)


def _init_assess(project_dir, args, snap):
    """Artifacts present — return a read-only assessment + tailored options."""
    coherent = snap["tracking_active"] and snap["version"] is not None
    requested = args.version

    options = []
    command_mapping = {}
    idx = 0

    if snap["config_exists"] and (not snap["tracking_active"] or not snap["auto_bump_on"]):
        options.append({"label": "Enable tracking + auto-bump"})
        command_mapping[str(idx)] = "init execute --mode enable"
        idx += 1

    if not snap["config_exists"] and (snap["version"] is not None or snap["tags"]):
        options.append({"label": "Adopt existing setup (write config)"})
        command_mapping[str(idx)] = "init execute --mode adopt"
        idx += 1

    reinit_cmd = "init execute --mode reinit"
    if requested:
        reinit_cmd += f" --version {requested}"
        options.append({"label": f"Re-initialize at {requested}"})
    else:
        options.append({"label": "Re-initialize at a version"})
    command_mapping[str(idx)] = reinit_cmd
    idx += 1

    options.append({"label": "Check integrity (validate)"})
    command_mapping[str(idx)] = "validate"
    idx += 1

    if not coherent:
        options.append({"label": "Repair sync issues"})
        command_mapping[str(idx)] = "repair"
        idx += 1

    options.append({"label": "Cancel"})
    cancel_option = idx

    parts = []
    if snap["tracking_active"]:
        parts.append("tracking active")
    elif snap["config_exists"]:
        parts.append("config present (tracking off)")
    if snap["version"]:
        parts.append(f"VERSION={snap['version']}")
    if snap["tags"]:
        parts.append(f"{len(snap['tags'])} version tag(s)")
    if snap["changelog_exists"]:
        parts.append("CHANGELOG present")
    if snap["archive_exists"]:
        parts.append("archive present")
    assessment = "; ".join(parts) if parts else "existing semver artifacts"

    output({
        **_pre_prompt_state(project_dir),
        "ok": True,
        "executed": False,
        "operation": "init",
        "artifacts": {
            "config_exists": snap["config_exists"],
            "tracking_active": snap["tracking_active"],
            "auto_bump_on": snap["auto_bump_on"],
            "version": snap["version"],
            "changelog_exists": snap["changelog_exists"],
            "tags": snap["tags"],
            "tag_count": len(snap["tags"]),
            "archive_exists": snap["archive_exists"],
        },
        "reinit_needs_version": requested is None,
        "questions_needed": ["init_existing"],
        "questions": [{
            "id": "init_existing",
            "header": "Already set up",
            "question": f"This repo already has semver artifacts ({assessment}). How do you want to proceed?",
            "options": options,
            "cancel_option": cancel_option,
            "command_mapping": command_mapping,
        }],
        "display": build_display([
            f"[semver] Already initialized — {assessment}.",
            "  Choose how to proceed (nothing has changed yet)."]),
    })


def cmd_init_run(args):
    """Detect existing artifacts. With none, run a clean init in one call; with
    any, return a read-only assessment + tailored options (no writes)."""
    project_dir = os.getcwd()
    ensure_git_root()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")

    if os.environ.get("SEMVER_BUMP_IN_PROGRESS") == "1":
        output_error("reentrancy",
                     "A version operation is already in progress. Nested operations are not allowed.")

    snap = _init_snapshot(project_dir, args)
    if not snap["has_artifacts"]:
        prompt = _pre_prompt_state(project_dir)
        if prompt["has_pre_bump_prompt_hook"]:
            output({"ok": True, "executed": False, "operation": "init",
                    "action": "fresh_init", "questions": [], **prompt,
                    "display": "[semver] Run the pre-bump PROMPT_HOOK.md before init execute --mode fresh."})
        _init_do_fresh(project_dir, config_path, args)  # outputs + exits
    _init_assess(project_dir, args, snap)  # outputs + exits


def _init_enable(project_dir, config_path, args):
    """Flip tracking + auto-bump on for an existing config; keep version/tags."""
    config = Config(config_path)
    if not config.exists:
        output_error("no_config", "No .semver/config.yaml found. Use --mode fresh or adopt.")
    config.set("tracking", "true")
    config.set("auto_bump", "true")
    config.write()
    inject_claude_md(project_dir)
    git("add", ".semver/config.yaml", "CLAUDE.md")
    # git diff --cached --quiet: rc 0 == no staged change, rc 1 == changes staged
    rc, _, _ = git("diff", "--cached", "--quiet")
    committed = False
    commit_hash = None
    if rc != 0:
        rc2, _, err = git("commit", "-m", "chore: enable semver tracking + auto-bump")
        if rc2 != 0:
            output_error("commit_failed", f"git commit failed: {err}")
        _, commit_hash, _ = git("rev-parse", "--short", "HEAD")
        committed = True
    output({
        "ok": True, "executed": True, "operation": "init", "action": "enable",
        "tracking": True, "auto_bump": True, "committed": committed, "commit_hash": commit_hash,
        "display": build_display([
            "[semver] Tracking + auto-bump enabled."
            + ("" if committed else " (no changes to commit)")]),
    })


def _init_adopt(project_dir, config_path, args):
    """Write a config over an existing VERSION/tags without changing them."""
    if os.path.isfile(config_path):
        output_error("config_exists", "Config already exists. Use --mode enable or reinit.")
    version = read_version_file(project_dir)
    prefix = _detect_prefix(version, all_version_tags(_detect_prefix(version, [], args.prefix)), args.prefix)
    tags = all_version_tags(prefix)
    tagging = not args.no_tags
    fmt = args.changelog or "grouped"
    branch = args.branch or detect_default_branch()

    config = Config(config_path)
    config.set("tracking", "true")
    config.set("auto_bump", "true")
    config.set("auto_bump_confirm", "true")
    config.set("version_prefix", prefix)
    config.set("git_tagging", str(tagging).lower())
    config.set("changelog_format", fmt)
    config.set("target_branch", branch)
    config.write()
    inject_claude_md(project_dir)
    git("add", ".semver/config.yaml", "CLAUDE.md")
    rc, _, err = git("commit", "-m", "chore: adopt existing version under semver tracking")
    if rc != 0:
        output_error("commit_failed", f"git commit failed: {err}")
    _, commit_hash, _ = git("rev-parse", "--short", "HEAD")
    output({
        "ok": True, "executed": True, "operation": "init", "action": "adopt",
        "version": version, "version_prefix": prefix, "tag_count": len(tags),
        "commit_hash": commit_hash,
        "display": build_display([
            f"[semver] Adopted existing setup under semver tracking (version: {version or 'unset'}).",
            f"  Prefix: '{prefix}' | Tags kept: {len(tags)} | Auto-bump: on"]),
    })


def _init_reinit(project_dir, config_path, args):
    """Reset config + VERSION + tag to an explicit version, keeping git history."""
    if not args.version:
        output_error("missing_version", "--mode reinit requires --version.")

    existing = Config(config_path)
    if existing.exists:
        prefix = existing.get("version_prefix")
        tagging = existing.get_bool("git_tagging")
        fmt = existing.get("changelog_format")
        branch = existing.get("target_branch")
    else:
        cur = read_version_file(project_dir)
        prefix = _detect_prefix(cur, all_version_tags(_detect_prefix(cur, [], args.prefix)), args.prefix)
        tagging = not args.no_tags
        fmt = args.changelog or "grouped"
        branch = args.branch or detect_default_branch()
    # explicit overrides
    if args.prefix is not None:
        prefix = "" if args.prefix == "none" else args.prefix
    if args.no_tags:
        tagging = False
    if args.changelog:
        fmt = args.changelog
    if args.branch:
        branch = args.branch

    raw = args.version.strip()
    resolved = prefix + raw if prefix and not raw.startswith(prefix) else raw
    if parse_version(resolved, prefix) is None:
        output_error("invalid_version", f"Invalid version: '{resolved}'. Expected: {prefix}MAJOR.MINOR.PATCH")

    today = datetime.date.today().isoformat()
    result = {"ok": True, "executed": True, "operation": "init", "action": "reinit",
              "version": resolved}
    lock = FileLock(project_dir)
    with lock:
        old_version = read_version_file(project_dir)
        pre_hooks_result = _run_pre_bump_hooks(
            "init", old_version, resolved, project_dir, args.plugin_root)
        config = Config(config_path)
        config.set("tracking", "true")
        config.set("auto_bump", "true")
        config.set("auto_bump_confirm", "true")
        config.set("version_prefix", prefix)
        config.set("git_tagging", str(tagging).lower())
        config.set("changelog_format", fmt)
        config.set("target_branch", branch)
        config.write()

        with open(os.path.join(project_dir, "VERSION"), "w") as f:
            f.write(resolved + "\n")

        changelog_path = os.path.join(project_dir, "CHANGELOG.md")
        if not os.path.isfile(changelog_path):
            create_initial_changelog(changelog_path, resolved, today, fmt)
        elif not _changelog_has_heading(changelog_path, resolved):
            entry = f"## [{resolved}] - {today}\n\n- Re-initialized version tracking\n\n_[manual]_\n"
            prepend_changelog_entry(changelog_path, entry)

        inject_claude_md(project_dir)
        git("add", ".semver/config.yaml", "VERSION", "CHANGELOG.md", "CLAUDE.md")
        rc, _, err = git("commit", "-m", f"chore: re-initialize semver at {resolved}")
        if rc != 0:
            output_error("commit_failed", f"git commit failed: {err}")
        _, commit_hash, _ = git("rev-parse", "--short", "HEAD")
        result["commit_hash"] = commit_hash
        # Overwrite an existing tag — reinit is a deliberate reset.
        _apply_tag(resolved, tagging, False, True, result)

    hooks_skipped = _run_post_bump_and_verify(
        "init", old_version, resolved, tagging, False,
        project_dir, args.plugin_root,
        pre_hooks_result, result)
    lines = [f"[semver] Re-initialized semver at {resolved}"]
    if result.get("tag_created"):
        lines.append(f"  Tag: {resolved} " + ("moved" if result.get("tag_overwritten") else "created"))
    if hooks_skipped:
        lines.append("  ⚠ post-bump hooks did NOT run — see post_hooks.warnings")
    result["display"] = build_display(lines)
    output(result, exit_code=3 if hooks_skipped else 0)


def cmd_init_execute(args):
    """Apply a chosen init mode selected from the assessment."""
    project_dir = os.getcwd()
    ensure_git_root()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    mode = args.mode
    if mode == "fresh":
        _init_do_fresh(project_dir, config_path, args)
    elif mode == "enable":
        _init_enable(project_dir, config_path, args)
    elif mode == "adopt":
        _init_adopt(project_dir, config_path, args)
    elif mode == "reinit":
        _init_reinit(project_dir, config_path, args)
    else:
        output_error("usage", f"Unknown init mode: {mode}")


def cmd_auto_bump(args):
    """Toggle auto-bump configuration."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists or not config.get_bool("tracking"):
        output_error("tracking_inactive",
                      "Version tracking must be active before configuring auto-bump.")

    action = args.action

    if action == "start":
        if config.get_bool("auto_bump"):
            output({"ok": True, "message": "Auto-bump is already enabled.",
                    "auto_bump": True, "auto_bump_confirm": config.get_bool("auto_bump_confirm"),
                    "display": "[semver] Auto-bump is already enabled."})

        if args.confirm is None:
            output({
                "ok": True,
                "needs_input": True,
                "questions": [{
                    "id": "auto_bump_confirm",
                    "header": "Confirm",
                    "question": "Should Claude ask you to confirm the bump level before executing?",
                    "options": [
                        {"label": "Yes — confirm first (Recommended)"},
                        {"label": "No — fully automatic"}
                    ],
                    "flag_mapping": {
                        "0": "--confirm true",
                        "1": "--confirm false",
                    },
                }],
                "display": "[semver] Configuring auto-bump...",
                "rerun_with_flags": True,
            })

        confirm = args.confirm
        config.set("auto_bump", "true")
        config.set("auto_bump_confirm", confirm)
        config.write()

        confirm_str = "with confirmation" if confirm == "true" else "fully automatic"
        output({
            "ok": True,
            "auto_bump": True,
            "auto_bump_confirm": confirm == "true",
            "target_branch": config.get("target_branch"),
            "message": "Auto-bump is now enabled.",
            "display": f"[semver] Auto-bump enabled ({confirm_str}) | Branch: {config.get('target_branch')}",
        })

    elif action == "stop":
        if not config.get_bool("auto_bump"):
            output({"ok": True, "message": "Auto-bump is not currently enabled.",
                    "auto_bump": False,
                    "display": "[semver] Auto-bump is not currently enabled."})
        config.set("auto_bump", "false")
        config.write()
        output({
            "ok": True,
            "auto_bump": False,
            "message": "Auto-bump is now disabled.",
            "display": "[semver] Auto-bump disabled.",
        })


def cmd_repair_diagnose(args):
    """Run validation and suggest repairs for each failure."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)

    if not config.exists or not config.get_bool("tracking"):
        output({"ok": True, "tracking": False,
                "message": "Version tracking is not active. Nothing to repair."})

    checks = run_validation_checks(project_dir, config)
    summary = {"pass": 0, "fail": 0, "warn": 0, "skip": 0}
    for c in checks:
        key = c["status"].lower()
        if key in summary:
            summary[key] += 1

    if summary["fail"] == 0:
        output({"ok": True, "all_pass": True, "checks": checks, "summary": summary,
                "message": "All integrity checks passed. Nothing to repair.",
                "repairs_needed": [],
                "display": "[semver] All integrity checks passed. Nothing to repair."})

    # Build repair suggestions
    repairs = []
    prefix = config.get("version_prefix")
    tagging = config.get_bool("git_tagging")
    version = read_version_file(project_dir)

    for c in checks:
        if c["status"] != "FAIL":
            continue

        if c["name"] == "version_wellformed":
            repairs.append({
                "issue": "version_malformed",
                "detail": c["detail"],
                "options": ["skip"],
                "context": {},
            })

        elif c["name"] == "tag_exists" and tagging:
            latest_tag = all_version_tags(prefix)
            latest = latest_tag[0] if latest_tag else None
            repairs.append({
                "issue": "tag_missing",
                "detail": c["detail"],
                "options": ["create_tag_and_changelog", "revert_version", "skip"],
                "context": {"current_version": version, "latest_tag": latest},
                "question": {
                    "id": "repair_tag_missing",
                    "header": "Missing tag",
                    "question": f"VERSION says `{version}` but no git tag exists.",
                    "options": [
                        {"label": "Create tag + changelog entry"},
                        {"label": f"Revert VERSION to {latest}" if latest else "Skip"},
                        {"label": "Skip"}
                    ],
                    "command_mapping": {
                        "0": f"repair execute create-tag --version {version}",
                        "1": f"repair execute revert-version --to {latest}" if latest else None,
                        "2": None,
                    },
                },
            })

        elif c["name"] == "tag_correct_commit" and tagging:
            tc = tag_commit(version) if version else None
            lvc = last_version_commit()
            repairs.append({
                "issue": "tag_wrong_commit",
                "detail": c["detail"],
                "options": ["move_tag", "revert_version", "skip"],
                "context": {"version": version, "tag_commit": tc, "version_commit": lvc},
                "question": {
                    "id": "repair_tag_wrong_commit",
                    "header": "Tag mismatch",
                    "question": "Tag and VERSION point to different commits.",
                    "options": [
                        {"label": "Move tag to VERSION's commit"},
                        {"label": "Revert VERSION to match tag"},
                        {"label": "Skip"}
                    ],
                    "command_mapping": {
                        "0": f"repair execute move-tag --version {version} --commit {lvc}",
                        "1": f"repair execute revert-version --to {version}",
                        "2": None,
                    },
                },
            })

        elif c["name"] == "changelog_entry":
            repairs.append({
                "issue": "changelog_missing",
                "detail": c["detail"],
                "options": ["generate_entry", "skip"],
                "context": {"version": version},
                "question": {
                    "id": "repair_changelog_missing",
                    "header": "Missing changelog",
                    "question": f"Version `{version}` has no CHANGELOG entry.",
                    "options": [
                        {"label": "Generate entry"},
                        {"label": "Skip"}
                    ],
                    "command_mapping": {
                        "0": f"repair execute generate-entry --version {version}",
                        "1": None,
                    },
                },
            })

    # Build display
    diag_lines = [f"[semver] Found {summary['fail']} issue(s) to repair:"]
    for r in repairs:
        diag_lines.append(f"  - {r['issue']}: {r['detail']}")
    display = build_display(diag_lines)

    output({
        "ok": True,
        "all_pass": False,
        "checks": checks,
        "summary": summary,
        "repairs_needed": repairs,
        "display": display,
    })


def cmd_repair_execute(args):
    """Execute a specific repair action."""
    project_dir = os.getcwd()
    config_path = os.path.join(project_dir, ".semver", "config.yaml")
    config = Config(config_path)
    prefix = config.get("version_prefix")
    tagging = config.get_bool("git_tagging")
    fmt = config.get("changelog_format")
    today = datetime.date.today().isoformat()
    action = args.action

    if action == "create-tag":
        version = args.version
        if not version:
            output_error("missing_arg", "--version required for create-tag")
        # Generate changelog if missing
        latest_tags = all_version_tags(prefix)
        prev_tag = latest_tags[0] if latest_tags else None
        if prev_tag:
            raw_commits = commits_since(tag_commit(prev_tag))
        else:
            raw_commits = commits_since(None)
        entry = generate_changelog_entry(raw_commits, version, today, fmt, "manual")
        changelog_path = os.path.join(project_dir, "CHANGELOG.md")
        prepend_changelog_entry(changelog_path, entry)
        git("add", "CHANGELOG.md")
        git("commit", "-m", f"chore(release): {version} [repair]")
        git("tag", version)
        output({"ok": True, "action": "create_tag", "version": version,
                "changelog_updated": True, "tag_created": True,
                "display": f"[semver] Repair: create-tag completed."})

    elif action == "revert-version":
        to_version = args.to
        if not to_version:
            output_error("missing_arg", "--to required for revert-version")
        version_path = os.path.join(project_dir, "VERSION")
        with open(version_path, "w") as f:
            f.write(to_version + "\n")
        git("add", "VERSION")
        git("commit", "-m", f"chore: revert VERSION to match tag {to_version}")
        output({"ok": True, "action": "revert_version", "version": to_version,
                "display": f"[semver] Repair: revert-version completed."})

    elif action == "move-tag":
        version = args.version
        commit = args.commit
        if not version or not commit:
            output_error("missing_arg", "--version and --commit required for move-tag")
        git("tag", "-d", version)
        git("tag", version, commit)
        output({"ok": True, "action": "move_tag", "version": version, "commit": commit,
                "display": f"[semver] Repair: move-tag completed."})

    elif action == "generate-entry":
        version = args.version
        if not version:
            output_error("missing_arg", "--version required for generate-entry")
        # Find previous version commit or tag
        lvc = last_version_commit()
        if lvc:
            # Find commit before this one
            _, prev_commit, _ = git("log", "-1", "--format=%H", f"{lvc}^", "--", "VERSION")
            raw_commits = commits_since(prev_commit if prev_commit else lvc)
        else:
            raw_commits = commits_since(None)
        entry = generate_changelog_entry(raw_commits, version, today, fmt, "manual")
        changelog_path = os.path.join(project_dir, "CHANGELOG.md")
        prepend_changelog_entry(changelog_path, entry)
        git("add", "CHANGELOG.md")
        git("commit", "-m", f"chore: add missing CHANGELOG entry for {version} [repair]")
        output({"ok": True, "action": "generate_entry", "version": version,
                "display": f"[semver] Repair: generate-entry completed."})

    elif action == "update-version":
        to_version = args.to
        if not to_version:
            output_error("missing_arg", "--to required for update-version")
        version_path = os.path.join(project_dir, "VERSION")
        with open(version_path, "w") as f:
            f.write(to_version + "\n")
        git("add", "VERSION")
        git("commit", "-m", f"chore: sync VERSION to match tag {to_version}")
        output({"ok": True, "action": "update_version", "version": to_version,
                "display": f"[semver] Repair: update-version completed."})

    elif action == "delete-tag":
        tag = args.tag
        remote = args.remote
        if not tag:
            output_error("missing_arg", "--tag required for delete-tag")
        git("tag", "-d", tag)
        if remote:
            git("push", "origin", "--delete", tag)
        output({"ok": True, "action": "delete_tag", "tag": tag,
                "remote_deleted": bool(remote),
                "display": f"[semver] Repair: delete-tag completed."})

    else:
        output_error("unknown_action", f"Unknown repair action: {action}")


# ─── Main ────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(prog="semver-cli",
                                     description="Deterministic semantic versioning operations")
    subparsers = parser.add_subparsers(dest="command")

    # current
    subparsers.add_parser("current", help="Show current version and status")

    # validate
    subparsers.add_parser("validate", help="Run validation checks")

    # recommend
    subparsers.add_parser("recommend",
                          help="Recommend a bump level from commits since last version")

    # bump
    bump_parser = subparsers.add_parser("bump", help="Version bump operations")
    bump_sub = bump_parser.add_subparsers(dest="bump_command")

    # bump gather
    gather = bump_sub.add_parser("gather", help="Gather pre-check state")
    gather.add_argument("type", choices=["major", "minor", "patch"])
    gather.add_argument("--force", action="store_true")

    # bump execute
    execute = bump_sub.add_parser("execute", help="Execute the bump")
    execute.add_argument("type", choices=["major", "minor", "patch"])
    execute.add_argument("--force", action="store_true")
    execute.add_argument("--source", choices=["manual", "auto", "force"], default="manual")
    execute.add_argument("--dirty-action", choices=["include", "stash", "none"], default="none")
    execute.add_argument("--skip-tag", action="store_true")
    execute.add_argument("--overwrite-tag", action="store_true")
    execute.add_argument("--skip-validation", action="store_true")
    execute.add_argument("--plugin-root", default=None)

    # bump run (single call: gather then execute on the happy path)
    run = bump_sub.add_parser(
        "run", help="Gather then execute in one call when no questions apply")
    run.add_argument("type", choices=["major", "minor", "patch"])
    run.add_argument("--force", action="store_true")
    run.add_argument("--source", choices=["manual", "auto", "force"], default="manual")
    run.add_argument("--dirty-action", choices=["include", "stash", "none"], default="none")
    run.add_argument("--skip-tag", action="store_true")
    run.add_argument("--overwrite-tag", action="store_true")
    run.add_argument("--skip-validation", action="store_true")
    run.add_argument("--plugin-root", default=None)
    run.add_argument("--non-interactive", action="store_true",
                     help="Abort instead of returning questions (unattended auto-bump)")

    # bump first-version
    first_v = bump_sub.add_parser("first-version", help="Set initial version")
    first_v.add_argument("version", help="Version string (e.g., 0.1.0)")

    # set (assign an explicit version)
    set_parser = subparsers.add_parser("set", help="Assign an explicit version")
    set_sub = set_parser.add_subparsers(dest="set_command")
    for _name in ("run", "execute"):
        _p = set_sub.add_parser(_name)
        _p.add_argument("version", help="Target version (e.g., 2.0.0)")
        _p.add_argument("--source", default="set")
        _p.add_argument("--dirty-action", choices=["include", "stash", "none"], default="none")
        _p.add_argument("--skip-tag", action="store_true")
        _p.add_argument("--overwrite-tag", action="store_true")
        _p.add_argument("--skip-validation", action="store_true")
        _p.add_argument("--allow-backward", action="store_true")
        _p.add_argument("--plugin-root", default=None)
        if _name == "run":
            _p.add_argument("--non-interactive", action="store_true")

    # init (one-shot adoption)
    init_parser = subparsers.add_parser("init", help="Enable tracking + auto-bump and initialize")
    init_sub = init_parser.add_subparsers(dest="init_command")
    init_run = init_sub.add_parser("run")
    init_run.add_argument("version", nargs="?", default=None)
    init_run.add_argument("--prefix", default=None)
    init_run.add_argument("--no-tags", action="store_true")
    init_run.add_argument("--changelog", choices=["grouped", "flat"], default=None)
    init_run.add_argument("--branch", default=None)
    init_run.add_argument("--plugin-root", default=None)
    init_exec = init_sub.add_parser("execute")
    init_exec.add_argument("--mode", choices=["fresh", "enable", "adopt", "reinit"], required=True)
    init_exec.add_argument("--version", dest="version", default=None)
    init_exec.add_argument("--prefix", default=None)
    init_exec.add_argument("--no-tags", action="store_true")
    init_exec.add_argument("--changelog", choices=["grouped", "flat"], default=None)
    init_exec.add_argument("--branch", default=None)
    init_exec.add_argument("--plugin-root", default=None)

    # tracking
    tracking_parser = subparsers.add_parser("tracking", help="Tracking operations")
    tracking_sub = tracking_parser.add_subparsers(dest="tracking_command")

    # tracking start
    t_start = tracking_sub.add_parser("start", help="Initialize tracking")
    t_start.add_argument("--version", default=None)
    t_start.add_argument("--prefix", default=None)
    t_start.add_argument("--no-tags", action="store_true")
    t_start.add_argument("--changelog", choices=["grouped", "flat"], default=None)
    t_start.add_argument("--branch", default=None)
    t_start.add_argument("--restore-tags", action="store_true")
    t_start.add_argument("--plugin-root", default=None)

    # tracking stop-gather
    tracking_sub.add_parser("stop-gather", help="Gather state for stop")

    # tracking stop-execute
    t_stop_exec = tracking_sub.add_parser("stop-execute", help="Execute tracking stop")
    t_stop_exec.add_argument("--archive", default="", help="Comma-separated: version,changelog,tags")
    t_stop_exec.add_argument("--delete-tags", choices=["local", "both", "none"], default="none")

    # tracking restore-tags
    tracking_sub.add_parser("restore-tags", help="Restore tags from archive")

    # auto-bump
    ab_parser = subparsers.add_parser("auto-bump", help="Auto-bump configuration")
    ab_sub = ab_parser.add_subparsers(dest="action")

    ab_start = ab_sub.add_parser("start", help="Enable auto-bump")
    ab_start.add_argument("--confirm", choices=["true", "false"], default=None)

    ab_sub.add_parser("stop", help="Disable auto-bump")

    # repair
    repair_parser = subparsers.add_parser("repair", help="Repair operations")
    repair_sub = repair_parser.add_subparsers(dest="repair_command")

    repair_sub.add_parser("diagnose", help="Diagnose issues")

    r_exec = repair_sub.add_parser("execute", help="Execute repair action")
    r_exec.add_argument("action", help="Repair action name")
    r_exec.add_argument("--version", default=None)
    r_exec.add_argument("--to", default=None)
    r_exec.add_argument("--commit", default=None)
    r_exec.add_argument("--tag", default=None)
    r_exec.add_argument("--remote", action="store_true")

    args = parser.parse_args()

    if args.command is None:
        parser.print_help()
        sys.exit(2)

    # Never mutate versioning state from inside a linked git worktree — bumps,
    # tags, and release commits belong to the main working tree on the main
    # branch (exits here for mutating ops; read-only reporting is allowed).
    ensure_not_worktree(args)

    if args.command == "current":
        cmd_current(args)
    elif args.command == "validate":
        cmd_validate(args)
    elif args.command == "recommend":
        cmd_recommend(args)
    elif args.command == "bump":
        if args.bump_command == "gather":
            cmd_bump_gather(args)
        elif args.bump_command == "run":
            cmd_bump_run(args)
        elif args.bump_command == "execute":
            cmd_bump_execute(args)
        elif args.bump_command == "first-version":
            cmd_bump_first_version(args)
        else:
            print(json.dumps({"ok": False, "error": "usage",
                               "message": "Usage: semver-cli bump <run|gather|execute|first-version>"}))
            sys.exit(2)
    elif args.command == "set":
        if args.set_command == "run":
            cmd_set_run(args)
        elif args.set_command == "execute":
            cmd_set_execute(args)
        else:
            print(json.dumps({"ok": False, "error": "usage",
                               "message": "Usage: semver-cli set <run|execute> <version>"}))
            sys.exit(2)
    elif args.command == "init":
        if args.init_command == "run":
            cmd_init_run(args)
        elif args.init_command == "execute":
            cmd_init_execute(args)
        else:
            print(json.dumps({"ok": False, "error": "usage",
                               "message": "Usage: semver-cli init <run|execute> [version]"}))
            sys.exit(2)
    elif args.command == "tracking":
        if args.tracking_command == "start":
            cmd_tracking_start(args)
        elif args.tracking_command == "stop-gather":
            cmd_tracking_stop_gather(args)
        elif args.tracking_command == "stop-execute":
            cmd_tracking_stop_execute(args)
        elif args.tracking_command == "restore-tags":
            cmd_tracking_restore_tags(args)
        else:
            print(json.dumps({"ok": False, "error": "usage",
                               "message": "Usage: semver-cli tracking <start|stop-gather|stop-execute|restore-tags>"}))
            sys.exit(2)
    elif args.command == "auto-bump":
        if args.action in ("start", "stop"):
            cmd_auto_bump(args)
        else:
            print(json.dumps({"ok": False, "error": "usage",
                               "message": "Usage: semver-cli auto-bump <start|stop>"}))
            sys.exit(2)
    elif args.command == "repair":
        if args.repair_command == "diagnose":
            cmd_repair_diagnose(args)
        elif args.repair_command == "execute":
            cmd_repair_execute(args)
        else:
            print(json.dumps({"ok": False, "error": "usage",
                               "message": "Usage: semver-cli repair <diagnose|execute>"}))
            sys.exit(2)
    else:
        parser.print_help()
        sys.exit(2)


if __name__ == "__main__":
    main()
